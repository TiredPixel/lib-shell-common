#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

# -diff, so a failure shows what would change rather than only naming the file.
terraform fmt -recursive -check -diff

terraform init

# Unsaved, with no deploy-cloud to apply it: Terraform Cloud did not support
# plan -out when this was split from test-cli (821627c, February 2023). Whether
# it does now is in HashiCorp's documentation on remote operations.
terraform plan
