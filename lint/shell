#!/usr/bin/env bash
#
# ShellCheck every shell script in the working directory and in bin/, plus any
# file named as an argument. Discovery is by content rather than by extension,
# so an executable carrying no suffix is reached and a .sh that is not a script
# is not. bin/ is optional; a project without one is fine.
#
# A sourced fragment carrying no shebang has to be named as an argument. -x
# alone does not cover it: that follows the file so the definitions it makes
# resolve in the caller, and reports nothing found inside it. Following is not
# checking.
#
# Finding nothing is reported and not fatal, because a project with no shell in
# it is a real project. A caller that requires coverage should name its files,
# which is an assertion this cannot make on its behalf.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

named=("$@")

# Globbed with nullglob in place of failglob, because an empty directory or an
# empty bin/ is a layout with nothing in it, not an error, and failglob would
# end the run there. An empty result is the nothing-found case below.
shopt -u failglob
shopt -s nullglob
roots=(./*)

if [ -d bin ]; then
    roots+=(bin/*)
fi
shopt -u nullglob
shopt -s failglob

# file(1) is run once per file, with -b so its output is the type alone: a name
# holding a colon or a newline then cannot be misparsed as its own type. Its
# status is checked, by assigning rather than testing the substitution, because
# a broken file(1) and a file that is not a script would otherwise look alike,
# and the pass would skip in silence, indistinguishable from one that checked
# everything.
found=()

for f in "${roots[@]}"; do
    type=$(file -b --mime-type -- "$f")

    if [ "$type" = text/x-shellscript ]; then
        found+=("$f")
    fi
done

scripts=()

for f in "${found[@]}"; do
    case $(basename "$f") in
    # Gradle generates these and rewrites them on every wrapper bump, so their
    # style is not the author's to fix. What matters about a wrapper is the
    # integrity of the distribution it names, which is a checksum question --
    # gradle/actions/wrapper-validation is the check for it.
    gradlew | gradlew.bat)
        continue
        ;;
    esac

    scripts+=("$f")
done

# A named file the scan also found is checked once, not twice. The scan writes
# ./run where a caller may name run, so a leading ./ is set aside on both sides
# before the paths are compared as strings.
extra=()

for f in "${named[@]}"; do
    dup=0

    for s in "${scripts[@]}"; do
        if [ "${f#./}" = "${s#./}" ]; then
            dup=1
            break
        fi
    done

    if [ "$dup" -eq 0 ]; then
        extra+=("$f")
    fi
done

named=("${extra[@]}")

if [ ${#scripts[@]} -eq 0 ] && [ ${#named[@]} -eq 0 ]; then
    echo "${0##*/}: no shell scripts found in . or bin/, so nothing was checked" >&2
    exit 0
fi

# Named rather than counted, so the log records what the pass actually covered
# and an absence is visible without anyone having to ask for it.
printf '%s\n' "${named[@]}" "${scripts[@]}" >&2

# -P SCRIPTDIR, so a source of a file beside the script is followed rather than
# reported as unresolved.
shellcheck -x -P SCRIPTDIR -- "${named[@]}" "${scripts[@]}"
