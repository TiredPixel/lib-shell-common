#!/usr/bin/env bash
#
# terraform is faked on PATH, so nothing is initialised. The fake logs each
# call's arguments, prints a line on stdout, which the script must send to
# stderr, fails where its first argument is FAKE_FAIL, and on init copies the
# file FAKE_LOCK_FROM names, where set, to the lock.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

script=$root/terraform/upgrade

cp -p -- "$root/test/fixtures/terraform/upgrade/terraform" "$test_tmp/path/"
export FAKE_LOG=$test_tmp/terraform.calls
: >"$FAKE_LOG"
mkdir -- "$test_tmp/project"
cd -- "$test_tmp/project"

# Writes a lock to $1 holding the PROVIDER VERSION pairs after it.
lock() {
    local file=$1
    shift
    : >"$file"
    while [ $# -gt 0 ]; do
        printf 'provider "%s" {\n  version     = "%s"\n  hashes = [\n    "h1:x",\n  ]\n}\n\n' \
            "$1" "$2" >>"$file"
        shift 2
    done
}

calls=('init -upgrade -backend=false -input=false'
    'providers lock -platform=linux_amd64 -platform=darwin_arm64')
err=$'fake terraform: init\nfake terraform: providers'
a=registry.terraform.io/hashicorp/a
b=registry.terraform.io/hashicorp/b
c=registry.terraform.io/hashicorp/c

# With no lock, every provider comes from none; then one moves, one goes and
# one comes, and one that stays is not printed.
lock "$test_tmp/lock1" "$b" 1.0.0 "$a" 2.0.0
test_check from-none 0 "$a none -> 2.0.0"$'\n'"$b none -> 1.0.0" "$err" \
    env FAKE_LOCK_FROM="$test_tmp/lock1" "$script" linux_amd64 darwin_arm64
test_calls from-none terraform "${calls[@]}"
lock "$test_tmp/lock2" "$a" 2.0.0 "$c" 3.0.0
lock .terraform.lock.hcl "$a" 2.0.0 "$b" 1.0.0
test_check moves 0 "$b 1.0.0 -> none"$'\n'"$c none -> 3.0.0" "$err" \
    env FAKE_LOCK_FROM="$test_tmp/lock2" "$script" linux_amd64 darwin_arm64
test_calls moves terraform "${calls[@]}"

test_check init-fails 1 '' $'fake terraform: init\nfake terraform: init failed' \
    env FAKE_FAIL=init "$script" linux_amd64 darwin_arm64
test_calls init-fails terraform "${calls[0]}"

test_usage no-platform "terraform/upgrade PLATFORM..." "$script"

test_finish
