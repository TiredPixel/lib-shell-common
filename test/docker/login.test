#!/usr/bin/env bash
#
# Runs in a scratch project with docker and git faked on PATH, so nothing logs
# in anywhere. The fake docker logs each call's arguments, then the password it
# read on stdin, a line each. The fake git puts HEAD on branch FAKE_BRANCH, a/b
# unless a case says otherwise, "HEAD" where that is the detached state. Each
# case writes .dockerrepo and checks the server docker login is given, or that
# none is, which is Docker Hub, or that the run is refused before docker is
# called.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

dir=$root/docker
fixtures=$root/test/fixtures/docker/login

mkdir -- "$test_tmp/project"
cp -p -- "$fixtures/docker" "$fixtures/git" "$test_tmp/path/"

export FAKE_LOG=$test_tmp/docker.calls
: >"$FAKE_LOG"
export DOCKER_USERNAME=u DOCKER_PASSWORD=p FAKE_BRANCH=a/b

# Runs docker/login with .dockerrepo holding $3 and the environment after $5,
# and checks its status is $2, docker was called as $4 has it, its stdout is
# empty and its stderr is want_err.
check() {
    local calls=$4
    echo "$3" >"$test_tmp/project/.dockerrepo"
    test_check "$1" "$2" '' "$want_err" env -C "$test_tmp/project" \
        -u CIRCLE_BRANCH -u CIRCLE_TAG -u GITHUB_HEAD_REF -u GITHUB_REF_NAME \
        "${@:5}" "$dir/login"
    test_calls "$1" docker ${calls:+"$calls"}
}

# Runs check expecting docker login to be given server $3, or no server where
# $3 is empty, with the password on stdin, and nothing printed.
logs_in() {
    local name=$1 repo=$2 server=$3
    shift 3
    want_err=""
    check "$name" 0 "$repo" \
        "login -u u --password-stdin${server:+ $server}"$'\n'"stdin p" "$@"
}

logs_in dotted ghcr.io/o/n ghcr.io
logs_in port localhost:5000/n localhost:5000
logs_in localhost localhost/n localhost
logs_in upper Registry/o/n Registry
logs_in hub o/n ""
logs_in hub-library n ""
logs_in hub-dotted-name a.b ""

# Logging in needs no tag, so a detached HEAD with no CI variable to name it
# does not stop it.
logs_in detached ghcr.io/o/n ghcr.io FAKE_BRANCH=HEAD

# A missing credential stops the run before docker is called.
for var in DOCKER_USERNAME DOCKER_PASSWORD; do
    want_err="docker/login: $var: not set or empty; export the registry credentials"
    want_err+=" to log in with"
    check "unset-$var" 1 ghcr.io/o/n "" -u "$var"
    check "empty-$var" 1 ghcr.io/o/n "" "$var="
done

# Any argument is a usage error, refused before docker is called.
echo ghcr.io/o/n >"$test_tmp/project/.dockerrepo"
test_usage argument docker/login env -C "$test_tmp/project" "$dir/login" --help

test_finish
