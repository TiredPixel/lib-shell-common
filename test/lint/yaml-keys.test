#!/usr/bin/env bash
#
# yq and diff run for real but in two cases, which fake a yq that drains its
# stdin first, as any command could, and a diff that fails as on an I/O error.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

keys=$root/lint/yaml-keys

mkdir -- "$test_tmp/y"
printf 'a: 1\nb:\n  c: 2\n  d: 3\n' >"$test_tmp/y/sorted.yml"
printf 'b: 1\na: 2\n' >"$test_tmp/y/top.yml"
printf 'a:\n  d: 1\n  c: 2\n' >"$test_tmp/y/nested.yml"
printf 'b: 1\na: 2\n' >"$test_tmp/y/with space.yml"
printf 'a: [\n' >"$test_tmp/y/invalid.yml"
printf '{a: 1}\n' >"$test_tmp/y/flow.yml"

real_yq=$(command -v yq)
cd -- "$test_tmp/y"

# Gives yaml-keys its arguments NUL-separated on stdin, as bin/lint does.
# shellcheck disable=SC2317 # Called through test_check.
keys_on() {
    printf '%s\0' "$@" | "$keys"
}

# Checks yaml-keys on the paths from $5 on, relative to $test_tmp/y, exits $2
# with stdout $3 and stderr $4.
check() {
    test_check "$1" "$2" "$3" "$4" keys_on "${@:5}"
}

hint="lint/yaml-keys: rewrite with yq -i -P 'sort_keys(..)'"
top_diff="--- top.yml
+++ top.yml (sorted)
@@ -1,2 +1,2 @@
-b: 1
 a: 2
+b: 1"
nested_diff="--- nested.yml
+++ nested.yml (sorted)
@@ -1,3 +1,3 @@
 a:
-  d: 1
   c: 2
+  d: 1"
space_diff="--- with space.yml
+++ with space.yml (sorted)
@@ -1,2 +1,2 @@
-b: 1
 a: 2
+b: 1"

check sorted 0 "" "lint/yaml-keys: checked 1 file(s)" sorted.yml

check unsorted-top 1 "$top_diff" \
    "lint/yaml-keys: top.yml: keys not sorted"$'\n'"lint/yaml-keys: checked 1 file(s)"$'\n'"$hint" \
    top.yml

check unsorted-nested 1 "$nested_diff" \
    "lint/yaml-keys: nested.yml: keys not sorted"$'\n'"lint/yaml-keys: checked 1 file(s)"$'\n'"$hint" \
    nested.yml

# Every offender is named, not only the first, and a sorted one is not.
check every-offender 1 "$top_diff"$'\n'"$space_diff" \
    "lint/yaml-keys: top.yml: keys not sorted"$'\n'"lint/yaml-keys: with space.yml: keys not sorted"$'\n'"lint/yaml-keys: checked 3 file(s)"$'\n'"$hint" \
    top.yml sorted.yml "with space.yml"

# A file yq cannot parse is named as unreadable, not as unsorted, after yq's own
# error, and the others are still checked. The rewrite hint is only for an
# unsorted file.
yq_err=$(yq -P 'sort_keys(..)' invalid.yml 2>&1) || [ $? -eq 1 ]
check invalid 1 "" \
    "$yq_err"$'\n'"lint/yaml-keys: invalid.yml: yq could not read it, so its keys were not checked"$'\n'"lint/yaml-keys: checked 2 file(s)" \
    invalid.yml sorted.yml

check invalid-and-unsorted 1 "$top_diff" \
    "$yq_err"$'\n'"lint/yaml-keys: invalid.yml: yq could not read it, so its keys were not checked"$'\n'"lint/yaml-keys: top.yml: keys not sorted"$'\n'"lint/yaml-keys: checked 2 file(s)"$'\n'"$hint" \
    invalid.yml top.yml

# A command inside the loop that reads stdin cannot eat the paths still to come.
test_stub --stdin yq "exec $(printf %q "$real_yq") \"\$@\""
check stdin-drained 1 "$top_diff"$'\n'"$space_diff" \
    "lint/yaml-keys: top.yml: keys not sorted"$'\n'"lint/yaml-keys: with space.yml: keys not sorted"$'\n'"lint/yaml-keys: checked 3 file(s)"$'\n'"$hint" \
    top.yml sorted.yml "with space.yml"

rm -- "$test_tmp/path/yq" "$test_tmp/yq.calls" "$test_tmp/yq.stdin"

# diff failing other than on a difference stops the run with its status.
test_stub diff 'echo "fake diff: read error" >&2; exit 2'
check diff-fails 2 "" "fake diff: read error" sorted.yml top.yml
rm -- "$test_tmp/path/diff" "$test_tmp/diff.calls"

# A last path with no NUL after it is checked, not dropped.
test_check no-trailing-nul 1 "$top_diff" \
    "lint/yaml-keys: top.yml: keys not sorted"$'\n'"lint/yaml-keys: checked 2 file(s)"$'\n'"$hint" \
    bash -c "printf 'sorted.yml\0top.yml' | $(printf %q "$keys")"

# Key order is kept, and only the layout yq writes is checked.
flow_diff="--- flow.yml
+++ flow.yml (laid out)
@@ -1 +1 @@
-{a: 1}
+a: 1"
test_check keep-order 1 "$flow_diff" "lint/yaml-keys: flow.yml: not laid out
lint/yaml-keys: checked 2 file(s)
lint/yaml-keys: rewrite with yq -i -P '.'" \
    bash -c "printf '%s\0' top.yml flow.yml | $(printf %q "$keys") --keep-order"

# An empty set is reported, not refused.
test_check none 0 '' "lint/yaml-keys: checked 0 file(s)" "$keys"

# A path given as an argument is refused, not ignored while stdin is read.
for args in top.yml --sort-keys "--keep-order top.yml"; do
    read -r -a words <<<"$args"
    test_usage "argument $args" 'lint/yaml-keys [--keep-order] < PATHS' \
        "$keys" "${words[@]}"
done

test_finish
