#!/usr/bin/env bash
#
# Runs one command in each project this project sweeps, and not in this one --
# project/each adds that.
#
# The sweep is .projects, one path per line, and every entry is a submodule of
# this repository. They are the submodules that belong to this project: they
# share its version number and are tagged with it. A submodule that is
# third-party, or versioned on its own, is deliberately absent, which is why the
# list is curated rather than derived from .gitmodules.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=${0##*/}

f_projects=.projects

usage() {
    echo "Usage: $prog [--from PROJECT] COMMAND [ARG...]" >&2
    exit 2
}

# --from resumes a sweep that stopped partway, starting at PROJECT, written as
# .projects lists it.
from=
if [ "${1:-}" = --from ]; then
    if [ $# -lt 2 ] || [ -z "$2" ]; then
        usage
    fi
    from=$2
    shift 2
fi
if [ $# -eq 0 ]; then
    usage
fi

# .projects and the paths in it are relative to the top level, so the sweep is
# the same from any directory in the repository. Assigned on its own, so that
# errexit sees git fail outside a repository.
toplevel=$(git rev-parse --show-toplevel)
cd "$toplevel"

projects=()

# The whole list is read and checked before any command runs, so a bad entry
# stops the sweep before it has changed anything. That also keeps the list from
# a command reading stdin, which would drain the projects not yet visited and
# end the sweep early with nothing reported wrong: `script`, which
# project/upgrade wraps make in to keep a tty, forwards stdin to the pty it
# creates. Each command keeps the terminal on stdin rather than /dev/null, which
# `script` needs to forward keystrokes and a git credential or passphrase prompt
# needs to be answerable at all.
#
# A missing list is tolerated, because project/start and project/stop reach the
# current project through project/each and remain meaningful without one.
if [ -f "$f_projects" ]; then
    while IFS= read -r project <&3 || [ -n "$project" ]; do
        [ -z "$project" ] && continue

        # An entry that is not a submodule does not fail on its own: git
        # discovers this repository from inside any plain directory, so
        # `git tag -l` there answers about this one and the sweep reports having
        # visited a project it never entered. Assigned rather than piped, so the
        # status errexit sees is git's own and not a filter's. :(literal)
        # because a path is a literal, not a pattern.
        entry=$(git ls-files --stage -- ":(literal)$project")

        case $entry in
        '160000 '*) ;;
        *)
            echo "$prog: $project: not a submodule of $PWD," \
                "so it cannot be swept" >&2

            exit 1
            ;;
        esac

        # A submodule not checked out is an empty directory, and answers the
        # same way, so it is refused rather than visited: for the reason
        # project/release-assert gives, its top level is this repository's.
        top=$(git -C "$project" rev-parse --show-toplevel 2>/dev/null) || top=
        if [[ ! $top -ef $project ]]; then
            echo "$prog: $project: submodule of $PWD not checked out," \
                "so it cannot be swept; project/submodule-init checks it out" >&2

            exit 1
        fi

        projects+=("$project")
    done 3<"$f_projects"
fi

# Refused before any command runs, since a name missing from the list would
# otherwise sweep nothing and report success.
if [ -n "$from" ]; then
    for i in "${!projects[@]}"; do
        if [ "${projects[$i]}" = "$from" ]; then
            projects=("${projects[@]:$i}")
            from=
            break
        fi
    done
    if [ -n "$from" ]; then
        echo "$prog: $from: not listed in $PWD/$f_projects," \
            "so the sweep cannot resume from it" >&2
        exit 1
    fi
fi

for project in "${projects[@]}"; do
    pushd "$project" >/dev/null

    # To stderr, for the reason project/each gives.
    echo "$prog: $project" >&2
    "$@"

    popd >/dev/null
done
