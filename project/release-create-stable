#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

# Checked here as well as in project/tag-create, because tag-create runs only
# after project/release-assert has checked the tree.
if [ $# -ne 1 ] || [ -z "$1" ]; then
    echo "Usage: ${0##*/} TAG" >&2
    exit 2
fi
tag=$1

source "$dir/release-onto"

# stable is checked with testing, before anything moves, so an origin without
# it or a stable carrying commits of its own stops the release unpublished.
release_onto "$dir" testing "$tag" stable

# HEAD in every project is now the tag, so stable moves to the release.
release_checkout "$dir" stable

release_push "$dir" stable
