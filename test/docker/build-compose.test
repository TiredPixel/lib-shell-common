#!/usr/bin/env bash
#
# docker and git are faked on PATH, so nothing is built or read from a
# repository. The fake docker logs each call's arguments and exits with
# FAKE_BUILD's status. The fake git describes HEAD as FAKE_DESCRIBE, failing as
# an untagged repository does where that is empty, or as a broken one does where
# it is "broken", and gives FAKE_ORIGIN as the origin remote's URL.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

dir=$root/docker
fixtures=$root/test/fixtures/docker/build-compose

mkdir -- "$test_tmp/project"
cp -p -- "$fixtures/docker" "$fixtures/git" "$test_tmp/path/"

export FAKE_LOG=$test_tmp/docker.calls
: >"$FAKE_LOG"
export FAKE_DESCRIBE=v1.2-3-gabcdef0
export FAKE_ORIGIN=git@github.com:o/r.git
cd "$test_tmp/project"

# Runs docker/build-compose with the arguments after $5 and checks its status is
# $2, docker was called as $3 has it, a line to a call, and its stdout and
# stderr are $4 and $5.
check() {
    local calls=$3
    test_check "$1" "$2" "$4" "$5" "$dir/build-compose" "${@:6}"
    test_calls "$1" docker ${calls:+"$calls"}
}

built="fake docker: built"
building="fake docker: building"
# The source as docker/image-source gives it for FAKE_ORIGIN.
source_arg="--build-arg IMAGE_SOURCE=https://github.com/o/r"

check built 0 \
    "compose build --build-arg GIT_DESCRIBE=$FAKE_DESCRIBE $source_arg" \
    "$built" "$building"

# Its arguments go to docker compose, ahead of build.
check arguments 0 \
    "compose -f a\\ b.yml build --build-arg GIT_DESCRIBE=$FAKE_DESCRIBE \
$source_arg" "$built" "$building" -f "a b.yml"

# Stamped with nothing, and git's fatal: kept off the console.
FAKE_DESCRIBE='' check untagged 0 \
    "compose build --build-arg GIT_DESCRIBE= $source_arg" "$built" "$building"

# Any other failure of git's stops the build before docker is called.
FAKE_DESCRIBE=broken check describe-fails 1 "" "" \
    "fatal: bad object HEAD"$'\n'"docker/build-compose: git describe failed"

FAKE_BUILD=3 check build-fails 3 \
    "compose build --build-arg GIT_DESCRIBE=$FAKE_DESCRIBE $source_arg" \
    "$built" "$building"

test_finish
