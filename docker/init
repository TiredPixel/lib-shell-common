# shellcheck shell=bash
#
# Sourced by the docker/ scripts that build or push $REPO:$TAG images to export
# REPO, from .dockerrepo through docker/repo, TAG, from the branch, and
# DOCKER_BUILDKIT=1. Sets no shell options, since it runs under its caller's,
# and unsets init_detached, which a caller may set as below.

export DOCKER_BUILDKIT=1

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/repo"

# git rev-parse --abbrev-ref HEAD answers the literal "HEAD" in a detached
# checkout, which is what a pull request and a tag push both produce -- so the
# registry collects :HEAD images unless something names the branch first, and
# every consumer otherwise grows its own `git checkout -B` step ahead of the
# build. Resolved here instead, from CircleCI's branch or tag variable, of which
# a build sets one, or from GitHub Actions' pull request branch or ref name,
# which names a pushed tag too.
TAG=$(git rev-parse --abbrev-ref HEAD)

if [ "$TAG" = HEAD ]; then
    TAG=${CIRCLE_BRANCH:-${CIRCLE_TAG:-${GITHUB_HEAD_REF:-${GITHUB_REF_NAME:-}}}}

    # A caller that pushes nothing sets init_detached=commit before sourcing,
    # and its image is then named by the commit, so a build mid-bisect or
    # mid-rebase, as a project's tests run one, needs no branch. A caller that
    # pushes sets nothing and is refused below, so no registry collects an image
    # for every commit built.
    if [ -z "$TAG" ] && [ "${init_detached:-}" = commit ]; then
        TAG=$(git rev-parse --short HEAD)
    fi
fi
unset init_detached

# Empty rather than unset is the risk here: a CI that exports its branch or tag
# variable holding nothing satisfies set -u and leaves the tag empty, which
# pushes $REPO:.dev or $REPO:.prd rather than failing.
#
# Checked and exited explicitly rather than by ${TAG:?}, so the error says what
# to do and the status is 1 even where init is sourced from a bash -c string
# without errexit, where ${TAG:?} exits 127.
if [ -z "$TAG" ]; then
    echo "${0##*/}: TAG: detached HEAD and no CI branch or tag" \
        "variable set; check out a branch" >&2
    exit 1
fi

# Docker's tag grammar is [A-Za-z0-9_][A-Za-z0-9_.-]{0,127}. The letters are
# written out, since a bracket range can match other characters under some
# locales and the caller's shell options, and the cut is at 124 to leave room
# for the .dev and .prd suffixes the build-dev and build-prd scripts add.
init_tag=${TAG//[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.-]/-}

while [ "${init_tag#[.-]}" != "$init_tag" ]; do
    init_tag=${init_tag#?}
done

if [ -z "$init_tag" ]; then
    echo "${0##*/}: TAG: $TAG: no letter, digit or _ to make an image tag" \
        "from; check out a branch named with one" >&2
    exit 1
fi

TAG=${init_tag:0:124}
unset init_tag
export TAG
