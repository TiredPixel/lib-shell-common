#!/usr/bin/env bash
#
# Usage: lint/dockerfile-locks [--] DOCKERFILE...
#
# Refuse each RUN or ONBUILD RUN in each DOCKERFILE that runs an installer from
# PyPI or npm in a way that can fetch what no hashed lock pins, or resolves a
# lock during the build. Each refused RUN is named on stderr as FILE:LINE: and
# why, LINE its first line, and the run exits 1; a usage error exits 2; a file
# that cannot be read, whose escape directive is given twice or is not \ or `,
# whose heredoc has no end line, or whose exec-form RUN jq fails to read, exits
# 3. Each file is read as docker/dockerfile-parse reads it, as docker/upgrade
# reads it too.
#
# A RUN's shell or exec form, its heredocs where they are its script, and the
# script a shell's -c gives are split into simple commands at ; & | ( ) ` and
# newlines. Leading assignments, reserved words such as if or {, and the
# wrappers sudo and env are passed, with their options, -u and -C taking a
# value. The first word that is not an option after a tool is its command. The
# RUN's heredocs are its script where no command reads them, as in RUN <<EOF,
# or where the command reading them, the one holding the << word, wherever it
# sits in the RUN, is a shell given no -c, as in RUN bash <<EOF; otherwise they
# are only that command's input, as in RUN cat <<EOF >file. Refused:
#
#   pip, pip3 or python3 -m pip install, download or wheel
#       unless the RUN is --network=none or pip is given --no-index with no
#       --find-links URL other than a file: one; and unless given
#       --require-hashes, -r FILE, FILE no such URL, and --no-build-isolation or
#       --only-binary=:all:, since pip fetches an sdist's build dependencies
#       with no hash check
#   pipx or python3 -m pipx install or inject
#       unless the RUN is --network=none, --pip-args ARGS carries --no-index
#       and --find-links, python3 -m venv has made a directory ending in
#       /shared earlier in the RUN, pipx's shared venv, which pipx would
#       otherwise make with pip from PyPI, and
#       PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE holds 1, or another value pipx
#       reads as true, and is exported, by an export earlier in the RUN or
#       one after an assignment, the last assignment before the command
#       setting what it holds, or is assigned so before the command, env's or
#       a shell's whose -c script or heredoc runs it included, or the command
#       is given --skip-maintenance, since pipx otherwise upgrades the shared
#       venv's pip from PyPI on an inject or an install into a venv that
#       exists, which are not told apart here; and pipx --preinstall always
#   npm install, update, install-test, link or dedupe, or any alias npm gives
#   them, such as i, add, up or ddp
#       unless the RUN is --network=none, since only npm ci installs a lock as
#       given
#   npm ci or install-ci-test, or any alias npm gives them, such as ic, cit or
#   sit
#       unless given --no-update-notifier, since npm otherwise asks the
#       registry for a newer npm whenever its cache does not show it asked in
#       the last week, which a fresh image's never does, in a RUN
#       --network=none included
#   pip lock, pip-compile, uv pip compile, uv lock, uv export, poetry lock or
#   export, pipenv lock, and pdm lock or export
#       unless the RUN is --network=none, since a lock resolved during the
#       build is committed nowhere
#   yarn alone, but for its version or help, or yarn install, pnpm install or
#   i, bun install or i, and uv sync, but given yarn's --immutable or
#   --frozen-lockfile, pnpm's or bun's --frozen-lockfile, or uv's --locked or
#   --frozen; npx given a command, npm exec or x, but given --no; yarn, pnpm or
#   bun add, uv pip install or sync, uv add, uv tool install, uvx given a
#   command, poetry install or add, pipenv install or sync, pdm install, add or
#   sync, and easy_install
#       unless the RUN is --network=none, since what each fetches is not
#       checked here
#   python3 -m build or pyproject-build but given -n or --no-isolation, uv
#   build but given --no-build-isolation, pdm build but given --no-isolation,
#   and hatch build
#       unless the RUN is --network=none, since an isolated build fetches its
#       build dependencies with no hash check
#
# Every other command passes, bun ci among them. This catches the
# unlocked installs a Dockerfile's author writes by mistake, not those written
# to evade it, which a suppression comment would pass anyway. Not seen: eval,
# find -exec, any other wrapper, such as exec, nice, timeout, flock or xargs, a
# wrapper's option value other than -u's or -C's, a command substitution inside
# double quotes, an option overridden later, as --only-binary=:all: is by
# --no-binary or npx's --no by --yes, abbreviated, grouped or unusual options,
# npm's command prefixes, such as upd for update, an option's value written
# before the command, a command a variable names, a script piped into a shell, a
# requirement pip reads from a URL beside --no-index, a lock from standard
# input, npm init given an initializer, options set in the environment or a
# configuration file, a lock's own options, such as --find-links in it, any
# other installer or build frontend, that yarn 1 ignores --immutable, and that
# bun's --frozen-lockfile and bun ci install with no lock where none is
# committed, a variable set by ENV or in another RUN, since each RUN is read
# alone, that sudo, env -i, env -u, export -n and unset drop a variable, VAR+=,
# the scope of an export made in a subshell, pipeline or command substitution,
# an assignment before a special builtin other than export, which sh keeps, a
# redirection before the command word, a RUN with several heredocs, whose
# bodies are read as one by the first command holding a << word, a << word
# quoted or inside a script, a << word with no command other than as the whole
# RUN, and npm's update-notifier set through npm_config_update_notifier or an
# .npmrc.
#
# A RUN is let through by a comment line among those directly above its first
# line, the nearest such comment taken, REASON required, so one with no reason
# is itself refused:
#
#   # dockerfile-locks ignore: REASON
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=${0##*/}

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../docker/dockerfile-parse"

usage() {
    echo "Usage: $prog [--] DOCKERFILE..." >&2
    exit 2
}

files=()
while [ $# -gt 0 ]; do
    case $1 in
    --)
        shift
        files+=("$@")
        break
        ;;
    -*) usage ;;
    *) files+=("$1") ;;
    esac
    shift
done
[ ${#files[@]} -gt 0 ] || usage

die() {
    echo "$prog: $*" >&2
    exit 3
}

# Adds to reasons, why the RUN being read is refused, its arguments joined.
why() {
    reasons+=("$*")
}

assignment='^[A-Za-z_][A-Za-z0-9_]*\+?='
auto_upgrade='^PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=(.*)$'

# Whether $1 is a value pipx reads as true, as its strtobool does.
true_to_pipx() {
    case ${1,,} in
    1 | t | true | y | yes | on) return 0 ;;
    esac
    return 1
}

# Whether $1 is a URL other than a file: one.
remote() {
    [[ $1 == *://* && $1 != file://* ]]
}

# Refuses lock $1 given to pip -r where it is a URL, since whoever serves it
# chooses its hashes too.
remote_lock() {
    ! remote "$1" ||
        why "pip $sub reads its -r lock from a URL, whose server chooses the" \
            "hashes too"
}

# Checks pip subcommand $1, given the rest.
check_pip() {
    local sub=$1 a prev="" hashes="" lock="" binary="" no_index="" link=""
    local remote_link="" v
    shift
    for a in "$@"; do
        case $prev:$a in
        *:--no-index) no_index=1 ;;
        *:--require-hashes) hashes=1 ;;
        -r:* | --requirement:*) remote_lock "$a" ;;
        *:-r | *:--requirement) lock=1 ;;
        *:-r* | *:--requirement=*)
            lock=1
            v=${a#--requirement=}
            remote_lock "${v#-r}"
            ;;
        -f:* | --find-links:*) link=$a ;;
        *:--find-links=*) link=${a#*=} ;;
        *:-f?*) link=${a#-f} ;;
        *:--only-binary=:all: | *:--no-build-isolation) binary=1 ;;
        --only-binary::all:) binary=1 ;;
        esac
        if [ -n "$link" ]; then
            ! remote "$link" || remote_link=1
            link=""
        fi
        prev=$a
    done
    if [ -n "$no_index" ]; then
        [ -z "$remote_link" ] ||
            why "pip $sub --no-index with a --find-links URL, which fetches" \
                "with no hash check"
        return 0
    fi
    [ -n "$hashes" ] || why "pip $sub without --require-hashes"
    [ -n "$lock" ] || why "pip $sub reads no -r lock"
    [ -n "$binary" ] ||
        why "pip $sub without --only-binary=:all: or --no-build-isolation," \
            "so an sdist's build dependencies are fetched with no hash"
}

# Checks pipx subcommand $1, given the rest.
check_pipx() {
    local sub=$1 a prev="" pip_args="" on
    shift
    for a in "$@"; do
        case $prev:$a in
        *:--preinstall*)
            why "pipx --preinstall runs pip without the --pip-args"
            ;;
        *:--pip-args=*) pip_args=" ${a#*=}" ;;
        --pip-args:*) pip_args=" $a" ;;
        esac
        prev=$a
    done
    [ -n "$offline" ] || why "pipx $sub outside a RUN --network=none"
    [[ $pip_args == *" --no-index"* ]] ||
        why "pipx $sub --pip-args lacks --no-index"
    [[ $pip_args == *" --find-links"* || $pip_args == *" -f"* ]] ||
        why "pipx $sub --pip-args lacks --find-links"
    [ -n "$shared" ] || why "pipx $sub with no python3 -m venv making its" \
        "shared venv, a directory ending in /shared, earlier in this RUN"
    on=""
    [ -z "$exported" ] || on=$value
    [ -z "$prefixed" ] || on=${prefixed/0/}
    [ -n "$on" ] || has --skip-maintenance "$@" ||
        why "pipx $sub with no PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1" \
            "exported earlier in this RUN, nor --skip-maintenance, so pipx" \
            "can upgrade its shared venv's pip from PyPI"
}

# Whether option $1 is among the rest.
has() {
    local o=$1 a
    shift
    for a in "$@"; do
        [ "$a" != "$o" ] || return 0
    done
    return 1
}

# Checks build frontend $1, given the rest: an isolated build fetches its build
# dependencies, such as setuptools, with no hash check.
check_build() {
    local what=$1
    shift
    [ -z "$offline" ] || return 0
    case $what in
    "python3 -m build" | pyproject-build)
        ! has -n "$@" || return 0
        ! has --no-isolation "$@" || return 0
        ;;
    "uv build") ! has --no-build-isolation "$@" || return 0 ;;
    "pdm build") ! has --no-isolation "$@" || return 0 ;;
    esac
    why "$what outside a RUN --network=none, since it fetches build" \
        "dependencies with no hash check"
}

# Checks command $1, given the rest.
check_named() {
    local name=$1 a c="" line n=1 outer_exported outer_value
    local -a pos=()
    shift
    case $name in
    sh | bash | dash | ash)
        while [[ ${1-} == -* ]]; do
            case $1 in
            --*) ;;
            # -o and -O take the next word.
            *[oO]) shift || : ;;
            *c*) c=1 ;;
            esac
            shift || :
        done
        # The shell's prefix reaches its script, a value not exported does
        # not, and its exports reach nothing after it.
        outer_exported=$exported outer_value=$value
        [ -n "$exported" ] || value=""
        [ -z "$prefixed" ] || exported=1 value=${prefixed/0/}
        if [ -n "$c" ]; then
            [ $# -eq 0 ] || check_script "$1"
        elif [ -n "$with_heredoc" ]; then
            read_heredoc
        fi
        exported=$outer_exported value=$outer_value
        return 0
        ;;
    esac
    if [[ $name =~ ^python[0-9.]*$ ]]; then
        while [[ ${1-} == -* && $1 != -m ]]; do
            shift
        done
        [ $# -ge 2 ] || return 0
        if [ "$1" = -m ] && [ "$2" = build ]; then
            check_build "python3 -m build" "${@:3}"
        elif [ "$1" = -m ]; then
            check_named "$2" "${@:3}"
        fi
        return 0
    fi
    [[ ! $name =~ ^pip[0-9.]*$ ]] || name=pip
    [[ $name != easy_install* ]] || name=easy_install
    for a in "$@"; do
        [[ $a == -* ]] || pos+=("$a")
    done
    # The tool and its command, which uv's take two words to name.
    [ "$name" != uv ] || n=2
    line="$name "
    for a in "${pos[@]:0:n}"; do
        line+="$a "
    done
    # yarn given no command installs, unless asked only for its version or help.
    if [ "$line" = "yarn " ]; then
        for a in --version -v --help -h; do
            ! has "$a" "$@" || return 0
        done
        line="yarn install "
    fi
    case $line in
    "pip install "* | "pip download "* | "pip wheel "*)
        [ -n "$offline" ] || check_pip "${pos[0]}" "$@"
        return 0
        ;;
    "pipx install "* | "pipx inject "*)
        check_pipx "${pos[0]}" "$@"
        return 0
        ;;
    "venv "*)
        for a in "${pos[@]}"; do
            [[ ${a%/} != */shared ]] || shared=1
        done
        return 0
        ;;
    # npm ci, install-ci-test and their aliases, which install a lock as given
    # but ask for a newer npm, offline or not.
    "npm ci "* | "npm clean-install "* | "npm ic "* | "npm install-clean "* | \
        "npm isntall-clean "* | "npm install-ci-test "* | "npm cit "* | \
        "npm clean-install-test "* | "npm sit "*)
        ! has --no-update-notifier "$@" ||
            return 0
        why "npm ${pos[0]} without --no-update-notifier, so npm asks the" \
            "registry for a newer npm"
        return 0
        ;;
    esac
    [ -z "$offline" ] || return 0
    case $line in
    # Each npm command that fetches and its aliases, typos such as isntall among
    # them.
    "npm install "* | "npm i "* | "npm in "* | "npm ins "* | "npm inst "* | \
        "npm insta "* | "npm instal "* | "npm isnt "* | "npm isnta "* | \
        "npm isntal "* | "npm isntall "* | "npm add "* | "npm update "* | \
        "npm u "* | "npm up "* | "npm upgrade "* | "npm udpate "* | \
        "npm install-test "* | "npm it "* | "npm link "* | "npm ln "* | \
        "npm dedupe "* | "npm ddp "*)
        why "npm ${pos[0]} resolves versions itself, where npm ci installs a" \
            "lock as given"
        ;;
    "pyproject-build "*) check_build pyproject-build "$@" ;;
    "uv build "*) check_build "uv build" "$@" ;;
    "pdm build "*) check_build "pdm build" "$@" ;;
    "hatch build "*) check_build "hatch build" "$@" ;;
    "pip lock "* | "pip-compile "* | "uv pip compile "* | "uv lock "* | \
        "uv export "* | "poetry lock "* | "poetry export "* | \
        "pipenv lock "* | "pdm lock "* | "pdm export "*)
        why "${line% } outside a RUN --network=none, since a lock resolved" \
            "during the build is committed nowhere"
        ;;
    "yarn install "* | "pnpm install "* | "pnpm i "* | "bun install "* | \
        "bun i "* | "uv sync "* | "npx "?* | "npm exec "* | "npm x "* | \
        "yarn add "* | "pnpm add "* | "bun add "* | "uv pip install "* | \
        "uv pip sync "* | "uv add "* | "uv tool install "* | "uvx "?* | \
        "poetry install "* | "poetry add "* | "pipenv install "* | \
        "pipenv sync "* | "pdm install "* | "pdm add "* | "pdm sync "* | \
        "easy_install "*)
        case $line in
        "yarn install "*)
            ! has --immutable "$@" || return 0
            ! has --frozen-lockfile "$@" || return 0
            ;;
        "pnpm install "* | "pnpm i "* | "bun install "* | "bun i "*)
            ! has --frozen-lockfile "$@" || return 0
            ;;
        "uv sync "*)
            ! has --locked "$@" || return 0
            ! has --frozen "$@" || return 0
            ;;
        "npx "* | "npm exec "* | "npm x "*)
            ! has --no "$@" || return 0
            ;;
        esac
        why "${line% } outside a RUN --network=none, since what it fetches is" \
            "not checked here"
        ;;
    esac
}

# Checks the RUN's heredocs as its script, once.
read_heredoc() {
    local body=$heredoc
    heredoc=""
    [ -z "$body" ] || check_script "$body"
}

# Checks one simple command, its words $@, past any assignments, reserved words
# and wrappers. PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE is followed as value,
# 1 where what it holds pipx reads as true, and exported, each as the RUN's
# shell would have them: an assignment sets prefixed, 1 or 0, for the command
# it precedes, and value where it is the whole command or precedes export,
# which also sets exported. A << word says the command reads the RUN's
# heredocs, which are its script where there is no command or, through
# with_heredoc, where it is a shell.
check_command() {
    local -a w=("$@") rest=()
    local k=0 name a prefix="" docs=""
    for a in "${w[@]}"; do
        if [[ $a =~ $dockerfile_heredoc ]]; then
            docs=1
        else
            rest+=("$a")
        fi
    done
    w=("${rest[@]}")
    while [ "$k" -lt ${#w[@]} ]; do
        name=${w[k]##*/}
        k=$((k + 1))
        case $name in
        '!' | '{' | '}' | if | then | else | elif | do | while | until) ;;
        sudo | env)
            while [[ ${w[k]-} == -* ]]; do
                case ${w[k]} in
                -u | -C) k=$((k + 1)) ;;
                esac
                k=$((k + 1))
            done
            ;;
        export)
            [ -z "$prefix" ] || value=${prefix/0/}
            for a in "${w[@]:k}"; do
                if [[ $a =~ $auto_upgrade ]]; then
                    exported=1
                    if true_to_pipx "${BASH_REMATCH[1]}"; then
                        value=1
                    else
                        value=""
                    fi
                elif [ "$a" = PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE ]; then
                    exported=1
                fi
            done
            return 0
            ;;
        *)
            if [[ ${w[k - 1]} =~ $auto_upgrade ]]; then
                if true_to_pipx "${BASH_REMATCH[1]}"; then
                    prefix=1
                else
                    prefix=0
                fi
                continue
            fi
            [[ ! ${w[k - 1]} =~ $assignment ]] || continue
            prefixed=$prefix
            with_heredoc=""
            case $name in
            sh | bash | dash | ash) with_heredoc=$docs ;;
            *) [ -z "$docs" ] || heredoc="" ;;
            esac
            check_named "$name" "${w[@]:k}"
            return 0
            ;;
        esac
    done
    [ -z "$prefix" ] || value=${prefix/0/}
    [ -z "$docs" ] || read_heredoc
}

# Ends check_script's word, if one has begun.
flush() {
    [ -n "$begun" ] || return 0
    words+=("$word")
    word="" begun=""
}

# Ends check_script's simple command, checking it.
end() {
    flush
    [ ${#words[@]} -eq 0 ] || check_command "${words[@]}"
    words=()
}

# Checks shell text $1, command by command. Quotes are removed and nothing is
# expanded; a quote with no end runs to the end of the text.
check_script() {
    local s=$1 i=0 c q word="" begun=""
    local -a words=()
    while [ "$i" -lt ${#s} ]; do
        c=${s:i:1}
        case $c in
        ' ' | $'\t') flush ;;
        $'\n' | ';' | '&' | '|' | '(' | ')' | \`) end ;;
        \#)
            if [ -n "$begun" ]; then
                word+=$c
            else
                q=${s:i}
                q=${q%%$'\n'*}
                i=$((i + ${#q} - 1))
            fi
            ;;
        \')
            q=${s:i+1}
            q=${q%%\'*}
            word+=$q
            begun=1
            i=$((i + 1 + ${#q}))
            ;;
        \")
            begun=1
            i=$((i + 1))
            while [ "$i" -lt ${#s} ] && [ "${s:i:1}" != \" ]; do
                c=${s:i:1}
                if [ "$c" = \\ ]; then
                    case ${s:i+1:1} in
                    \$ | \` | \" | \\)
                        i=$((i + 1))
                        c=${s:i:1}
                        ;;
                    $'\n')
                        i=$((i + 1))
                        c=""
                        ;;
                    esac
                fi
                word+=$c
                i=$((i + 1))
            done
            ;;
        \\)
            i=$((i + 1))
            if [ "${s:i:1}" != $'\n' ]; then
                word+=${s:i:1}
                begun=1
            fi
            ;;
        *)
            word+=$c
            begun=1
            ;;
        esac
        i=$((i + 1))
    done
    end
}

# Checks the RUN whose text after its keyword is $1, and whose heredoc scripts
# are $2, setting reasons to why it is refused.
check_run() {
    local text=$1 quoted
    reasons=()
    shared=""
    offline=""
    exported=""
    value=""
    prefixed=""
    with_heredoc=""
    heredoc=$2
    while [[ $text =~ ^(--[^[:space:]]*)[[:blank:]]*(.*)$ ]]; do
        text=${BASH_REMATCH[2]}
        [ "${BASH_REMATCH[1]}" != --network=none ] || offline=1
    done
    if [[ $text == '['* ]]; then
        quoted=$(jq -rR 'fromjson? | select(type == "array"
            and all(.[]; type == "string")) | map(@sh) | join(" ")' \
            <<<"$text") || die "$at: jq failed reading the exec form"
        [ -z "$quoted" ] || text=$quoted
    fi
    check_script "$text"
}

# Refuses line $2 of $1 for the reasons after it, kept in check_file's found to
# be said in line order.
refuse_at() {
    local why
    printf -v why '%s; ' "${@:3}"
    found[$2]="$1:$2: ${why%; }"
    refused=1
}

ignore='^[[:space:]]*#[[:space:]]*dockerfile-locks ignore:(.*)$'
run='^[[:space:]]*([Oo][Nn][Bb][Uu][Ii][Ll][Dd][[:space:]]+)?[Rr][Uu][Nn]([[:space:]]+(.*))?$'

check_file() {
    local dockerfile=$1 i k a text reason error
    local -a lines=() logical=() comments=() bodies=() found=()
    # dockerfile_parse sets them, though nothing here reads them.
    # shellcheck disable=SC2034
    local escape ends

    [ -e "$dockerfile" ] || die "$dockerfile: no such file"
    [ -f "$dockerfile" ] || die "$dockerfile: not a regular file"
    dockerfile_parse "$dockerfile" error escape lines logical ends comments \
        bodies || die "$dockerfile: $error"

    for i in "${!logical[@]}"; do
        at=$dockerfile:$((i + 1))
        [[ ${logical[i]} =~ $run ]] || continue
        text=${BASH_REMATCH[3]}
        check_run "$text" "${bodies[i]-}"
        # The nearest in the comment lines directly above, so that another
        # tool's, such as hadolint's, may sit below it.
        k=""
        for ((a = i - 1; a >= 0; a--)); do
            [ -n "${comments[a]-}" ] || break
            if [[ ${lines[a]} =~ $ignore ]]; then
                k=$a
                reason=${BASH_REMATCH[1]}
                break
            fi
        done
        if [ -z "$k" ]; then
            [ ${#reasons[@]} -eq 0 ] ||
                refuse_at "$dockerfile" $((i + 1)) "${reasons[@]}"
        elif [[ ! $reason =~ [^[:space:]] ]]; then
            refuse_at "$dockerfile" $((k + 1)) \
                "dockerfile-locks ignore has no reason"
        fi
    done
    [ ${#found[@]} -eq 0 ] || printf '%s\n' "${found[@]}" >&2
}

reasons=()
shared=""
offline=""
exported=""
value=""
prefixed=""
with_heredoc=""
heredoc=""
at=""
refused=0

for f in "${files[@]}"; do
    check_file "$f"
done
exit "$refused"
