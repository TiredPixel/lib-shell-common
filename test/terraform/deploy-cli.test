#!/usr/bin/env bash
#
# terraform is faked on PATH, so nothing is applied. The fake logs each call's
# arguments, then "plan present" where .terraform.plan exists as it runs, and
# fails where its first argument is FAKE_FAIL.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

script=$root/terraform/deploy-cli

cp -p -- "$root/test/fixtures/terraform/deploy-cli/terraform" "$test_tmp/path/"
export FAKE_LOG=$test_tmp/terraform.calls
: >"$FAKE_LOG"

# Makes the project afresh, holding a saved plan, and enters it.
project() {
    cd -- "$test_tmp"
    rm -rf -- project
    mkdir -- project
    echo plan >project/.terraform.plan
    cd -- project
}

project
test_check applies 0 '' '' "$script"
test_calls applies terraform 'apply .terraform.plan' 'plan present'

project
test_check apply-fails 1 '' 'fake terraform: apply failed' \
    env FAKE_FAIL=apply "$script"
test_calls apply-fails terraform 'apply .terraform.plan' 'plan present'

# Any argument is a usage error, refused before terraform runs, so --help with a
# saved plan present applies nothing.
project
test_usage argument terraform/deploy-cli "$script" --help

test_finish
