#!/usr/bin/env bash
#
# Tests project/start against real repositories in a scratch dir, app and its
# submodule lib, listed in its .projects, with docker faked on PATH. The fake
# logs the project it runs in and its arguments, a line to a call. compose
# config --services prints the project's file fake-services, if any, or fails
# where it holds fake-config-fails; compose up exits FAKE_UP_RC; ps does
# nothing. Any other call fails. Every case builds its fixture afresh and runs
# project/start in app.
#
# Run: test/project/start.test. Exits 1 naming each case that failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

start=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../../project")/start
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

# Nothing from the caller's configuration reaches the fixtures. File URLs are
# refused to submodules by default.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
export GIT_CONFIG_COUNT=4
export GIT_CONFIG_KEY_0=protocol.file.allow GIT_CONFIG_VALUE_0=always
export GIT_CONFIG_KEY_1=user.name GIT_CONFIG_VALUE_1=test
export GIT_CONFIG_KEY_2=user.email GIT_CONFIG_VALUE_2=test@example.com
export GIT_CONFIG_KEY_3=init.defaultBranch GIT_CONFIG_VALUE_3=main

mkdir "$work/bin"
cat >"$work/bin/docker" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
echo "${PWD##*/} $*" >>"$FAKE_LOG"
case $* in
"compose config --services")
    if [ -f fake-config-fails ]; then
        echo "fake docker: invalid compose project" >&2
        exit 1
    fi
    [ ! -f fake-services ] || cat fake-services
    ;;
"compose up -d --pull always --wait --wait-timeout "*)
    exit "${FAKE_UP_RC:-0}"
    ;;
ps) ;;
*) exit 2 ;;
esac
EOF
chmod +x "$work/bin/docker"
export PATH=$work/bin:$PATH
unset DC_WAIT_TIMEOUT

# Reports a failure of case $1 at once, each line of $2 under the program and
# the case, so a later abort cannot hide it.
fail() {
    local line
    while IFS= read -r line <&3; do
        echo "${0##*/}: $1: $line" >&2
    done 3<<<"$2"
    failures=$((failures + 1))
}

failures=0
n=0

# A fresh fixture in $w: app and lib, each with a compose.yaml and the service
# web.
fixture() {
    local p
    n=$((n + 1))
    w=$work/$n
    mkdir "$w"
    git init -q "$w/lib"
    git -C "$w/lib" commit -q --allow-empty -m init
    git init -q "$w/app"
    git -C "$w/app" submodule add -q "$w/lib" lib
    echo lib >"$w/app/.projects"
    for p in app app/lib; do
        touch "$w/$p/compose.yaml"
        echo web >"$w/$p/fake-services"
    done
    export FAKE_LOG=$w/log
    : >"$FAKE_LOG"
}

# Runs project/start in app and records a failure of case $1 unless its status
# is $2, docker was called as $3 has it, its stdout is empty and its stderr is
# $4 exactly.
check() {
    local rc=0
    (cd "$w/app" && "$start") >"$w/out" 2>"$w/err" || rc=$?
    if [ "$rc" != "$2" ]; then
        fail "$1" "exit $rc, not $2: $(<"$w/err")"
    elif [ "$(<"$FAKE_LOG")" != "$3" ]; then
        fail "$1" "docker was called as: $(<"$FAKE_LOG")"
    elif [ -s "$w/out" ]; then
        fail "$1" "stdout is: $(<"$w/out")"
    elif [ "$(<"$w/err")" != "$4" ]; then
        fail "$1" "stderr is: $(<"$w/err")"
    fi
}

# Project $1 asked for its services and, with timeout $2, brought up.
up() {
    printf '%s\n' "$1 compose config --services" \
        "$1 compose up -d --pull always --wait --wait-timeout $2"
}

# What the sweep writes to stderr as it enters lib, and then app.
lib="each-without-project: lib"
both="$lib"$'\n'"each: app"

# Each project is brought up, waiting 300 seconds by default, and the containers
# listed.
fixture
check both 0 "$(up lib 300 && up app 300 && echo "app ps")" "$both"

# DC_WAIT_TIMEOUT overrides the wait.
fixture
DC_WAIT_TIMEOUT=7 check timeout 0 "$(up lib 7 && up app 7 && echo "app ps")" \
    "$both"

# Every name compose looks for is taken.
for f in compose.yml docker-compose.yaml docker-compose.yml; do
    fixture
    mv -- "$w/app/compose.yaml" "$w/app/$f"
    rm -- "$w/app/lib/compose.yaml"
    check "$f" 0 "$(up app 300 && echo "app ps")" "$both"
done

# A project with no compose file is passed over without asking compose.
fixture
rm -- "$w/app/compose.yaml" "$w/app/lib/compose.yaml"
check no-compose 0 "app ps" "$both"

# A project with no service to bring up, such as one whose services all sit
# behind a profile, is passed over.
fixture
: >"$w/app/lib/fake-services"
check no-services 0 "$(echo "lib compose config --services" &&
    up app 300 && echo "app ps")" "$both"

# A project whose configuration compose cannot read fails the sweep, rather than
# passing as one with nothing to bring up.
fixture
touch "$w/app/lib/fake-config-fails"
check config-fails 1 "lib compose config --services" \
    "$lib"$'\n'"fake docker: invalid compose project"

# A project that fails to come up fails the sweep.
fixture
FAKE_UP_RC=1 check up-fails 1 "$(up lib 300)" "$lib"

if [ "$failures" -gt 0 ]; then
    exit 1
fi
