# shellcheck shell=bash
#
# Sourced by project/build, project/each, project/each-without-project and
# project/upgrade for the rule each draws between stages. Sets no shell options,
# since it runs under its caller's.

# tput exits 2 with no terminal -- CI, cron, a make that is not on a tty -- and
# a command substitution used as an argument cannot fail the command it is an
# argument to, so the width would silently be empty and the rule vanish.
# Resolved into a variable first, with a fallback, so the failure is caught
# rather than lost in an argument.
#
# Prints a rule of character $1 as wide as the terminal on stdout.
echo_line() {
    local cols

    cols=$(tput cols 2>/dev/null || echo 80)

    printf %"$cols"s | tr " " "$1"
}
