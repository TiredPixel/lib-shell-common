#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

source "$dir/echo-line"

# At the top level, where project/each-without-project sweeps from, so the
# command runs in this project rather than in whichever directory of it this is
# called from. Assigned on its own, so that errexit sees git fail outside a
# repository.
toplevel=$(git rev-parse --show-toplevel)
cd "$toplevel"

"$dir/each-without-project" "$@"

# To stderr, as the name printed beside it already is. On stdout the rule lands
# in the data: project/tag-create captures this sweep's output to ask whether a
# tag exists anywhere, and the rule, which ends in no newline, would fuse with
# the first tag each project lists, hiding that tag from the check.
echo_line '-' >&2
printf '%s\n\n' "${PWD##*/}" >&2
"$@"
