#!/usr/bin/env bash
#
# terraform is faked on PATH, so nothing is initialised or planned. The fake
# logs each call's arguments, then "plan present" where .terraform.plan exists
# as it runs; it fails where its first argument is FAKE_FAIL, and writes the
# file plan -out names.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

script=$root/terraform/test-cli

cp -p -- "$root/test/fixtures/terraform/test-cli/terraform" "$test_tmp/path/"
export FAKE_LOG=$test_tmp/terraform.calls
: >"$FAKE_LOG"

fmt='fmt -recursive -check -diff'
init='init -backend=false -input=false -lockfile=readonly'

# Makes the project afresh and enters it, holding an earlier plan where $1 is
# "stale".
project() {
    cd -- "$test_tmp"
    rm -rf -- project
    mkdir -- project
    if [ "${1-}" = stale ]; then
        echo stale >project/.terraform.plan
    fi
    cd -- project
}

# Fails case $1 where a plan is left.
no_plan() {
    if [ -e .terraform.plan ]; then
        test_fail "$1" ".terraform.plan is left"
    fi
}

project
test_check order 0 '' '' "$script"
test_calls order terraform "$fmt" "$init" validate test
no_plan order

# Removed, and said so, before terraform first runs.
project stale
test_check stale 0 '' 'terraform/test-cli: .terraform.plan: removing an earlier plan' \
    "$script"
test_calls stale terraform "$fmt" "$init" validate test
no_plan stale

project
test_check fmt-fails 1 '' 'fake terraform: fmt failed' env FAKE_FAIL=fmt "$script"
test_calls fmt-fails terraform "$fmt"
no_plan fmt-fails

project
test_check init-fails 1 '' 'fake terraform: init failed' \
    env FAKE_FAIL=init "$script"
test_calls init-fails terraform "$fmt" "$init"
no_plan init-fails

project
test_check validate-fails 1 '' 'fake terraform: validate failed' \
    env FAKE_FAIL=validate "$script"
test_calls validate-fails terraform "$fmt" "$init" validate
no_plan validate-fails

project
test_check test-fails 1 '' 'fake terraform: test failed' \
    env FAKE_FAIL=test "$script"
test_calls test-fails terraform "$fmt" "$init" validate test
no_plan test-fails

# Any argument is a usage error, refused before the earlier plan is removed or
# terraform runs.
project stale
test_usage argument terraform/test-cli "$script" x
if ! [ -e .terraform.plan ]; then
    test_fail argument "the earlier plan was removed"
fi

test_finish
