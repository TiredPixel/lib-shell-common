#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

script=$root/ansible/inventory-ssh-known-hosts

# Quotes in a hostname must come through as JSON strings.
cat >"$test_tmp/known_hosts" <<'EOF'
# a.example.com is only in a comment
#z.example.com ssh-ed25519 AAAA
  #y.example.com ssh-ed25519 AAAA
a.example.com ssh-ed25519 AAAA
b.example.com,192.0.2.1 ssh-ed25519 AAAA
192.0.2.2,c.example.com ssh-ed25519 AAAA
d.example.org ssh-ed25519 AAAA
notexample.com ssh-ed25519 AAAA
o'neil.example.com ssh-ed25519 AAAA
say"hi.example.com ssh-ed25519 AAAA
e.example.com	ssh-ed25519 AAAA
a.example.com ssh-rsa AAAA
  f.example.com ssh-ed25519 AAAA
[g.example.com]:2222 ssh-ed25519 AAAA
[g.example.com]:2222 ssh-rsa AAAA
[h.example.com]:22 ssh-ed25519 AAAA
*.example.com ssh-ed25519 AAAA
i?.example.com ssh-ed25519 AAAA
!j.example.com ssh-ed25519 AAAA
[*.example.com]:2222 ssh-ed25519 AAAA
@cert-authority *.example.com ssh-ed25519 AAAA
@revoked k.example.com ssh-ed25519 AAAA
|1|bC5leGFtcGxlLmNvbQ==|bC5leGFtcGxlLmNvbQ== ssh-ed25519 AAAA

EOF

# Each host here is on two ports, the bare name standing for port 22.
cat >"$test_tmp/known_hosts_ports" <<'EOF'
l.example.com ssh-ed25519 AAAA
[l.example.com]:2222 ssh-ed25519 AAAA
[m.example.com]:2222 ssh-ed25519 AAAA
[m.example.com]:2200 ssh-ed25519 AAAA
n.example.com ssh-ed25519 AAAA
EOF

# The X stands where a regex would read the dot in example.com as any character.
cat >"$test_tmp/known_hosts_dot" <<'EOF'
web.exampleXcom ssh-ed25519 AAAA
EOF

# Runs the inventory with its arguments, compacting its stdout with jq.
# shellcheck disable=SC2317 # Called through test_check.
compact() {
    local rc=0
    "$script" "$@" >"$test_tmp/raw" || rc=$?
    if [ -s "$test_tmp/raw" ]; then
        jq -c . "$test_tmp/raw"
    fi
    return "$rc"
}

kh=$test_tmp/known_hosts
ports=$test_tmp/known_hosts_ports
p=ansible/inventory-ssh-known-hosts

test_check list 0 \
    '{"ungrouped":{"hosts":["a.example.com","b.example.com","o'"'"'neil.example.com","say\"hi.example.com","e.example.com","f.example.com","g.example.com","h.example.com"]},"_meta":{"hostvars":{"g.example.com":{"ansible_port":2222}}}}' \
    '' compact "$kh" example.com --list
test_check list-dot-literal 1 '' \
    "$p: no host in $test_tmp/known_hosts_dot ends in .example.com" \
    compact "$test_tmp/known_hosts_dot" example.com --list

test_check host 0 '{}' '' compact "$kh" example.com --host a.example.com
test_check host-port 0 '{"ansible_port":2222}' '' \
    compact "$kh" example.com --host g.example.com
test_check host-port-22 0 '{}' '' compact "$kh" example.com --host h.example.com
test_check host-unlisted 0 '{}' '' \
    compact "$kh" example.com --host j.example.com

conflicts="$p: l.example.com has more than one port in $ports"$'\n'"\
$p: m.example.com has more than one port in $ports"
test_check list-ports 1 '' "$conflicts" compact "$ports" example.com --list
test_check host-ports 1 '' "$conflicts" \
    compact "$ports" example.com --host n.example.com

test_check no-match 1 '' "$p: no host in $kh ends in .example.net" \
    compact "$kh" example.net --list

usage="$p KNOWN_HOSTS DOMAIN --list | --host HOST"
test_usage no-arguments "$usage" "$script"
test_usage no-option "$usage" "$script" "$kh" example.com
test_usage empty-path "$usage" "$script" "" example.com --list
test_usage empty-domain "$usage" "$script" "$kh" "" --list
test_usage unknown-option "$usage" "$script" "$kh" example.com --hosts
test_usage host-missing "$usage" "$script" "$kh" example.com --host
test_usage host-extra "$usage" "$script" "$kh" example.com --host a.example.com b
test_usage list-extra "$usage" "$script" "$kh" example.com --list a.example.com

test_finish
