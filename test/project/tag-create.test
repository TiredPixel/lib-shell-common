#!/usr/bin/env bash
#
# Tests project/tag-create in place against real repositories in a scratch dir:
# a parent, app, whose .projects names its submodule lib, each with a bare
# origin, $w/app.git and $w/lib.git, so the real project/each sweeps lib, then
# app. Signing goes through a fake gpg.program in a scratch GNUPGHOME, so no
# real key or pinentry is reached, and a fake timeout on PATH lets a case expire
# an origin. Every case builds its fixture afresh and runs project/tag-create in
# app.
#
# Run: test/project/tag-create.test. Exits 1 naming each case that failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

tag_create=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../../project")/tag-create
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
# Resolved, since project/each runs its command from the path git resolves.
work=$(readlink -f "$work")

mkdir "$work/bin" "$work/gnupg"
chmod 700 "$work/gnupg"
# Answers only the call git makes to sign, with the status line git looks for
# after a newline.
cat >"$work/bin/gpg" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
if [ "$*" != "--status-fd=2 -bsau test-key" ]; then
    echo "fake gpg: unexpected arguments: $*" >&2
    exit 2
fi
cat >/dev/null
printf '[GNUPG:] KEY_CONSIDERED FAKE 0\n[GNUPG:] SIG_CREATED D 1 8 00 0 FAKE\n' >&2
printf -- '-----BEGIN PGP SIGNATURE-----\n\nfake\n-----END PGP SIGNATURE-----\n'
EOF
# Insists on --foreground, which keeps a prompt answerable, and on the bound;
# expires at once in the directory FAKE_EXPIRE names, else runs the command.
cat >"$work/bin/timeout" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
if [ "${1:-}" != --foreground ] || [ "${2:-}" != 60 ]; then
    echo "fake timeout: unexpected arguments: $*" >&2
    exit 2
fi
if [ "$PWD" = "${FAKE_EXPIRE:-}" ]; then
    exit 124
fi
exec "${@:3}"
EOF
chmod +x "$work/bin/gpg" "$work/bin/timeout"
export PATH=$work/bin:$PATH

# Nothing from the caller's configuration reaches the fixtures, and nothing
# above the scratch dir is taken for a repository. File URLs are refused to
# submodules by default.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
export GIT_CEILING_DIRECTORIES=$work GNUPGHOME=$work/gnupg
export GIT_CONFIG_COUNT=6
export GIT_CONFIG_KEY_0=protocol.file.allow GIT_CONFIG_VALUE_0=always
export GIT_CONFIG_KEY_1=user.name GIT_CONFIG_VALUE_1=test
export GIT_CONFIG_KEY_2=user.email GIT_CONFIG_VALUE_2=test@example.com
export GIT_CONFIG_KEY_3=init.defaultBranch GIT_CONFIG_VALUE_3=main
export GIT_CONFIG_KEY_4=gpg.program GIT_CONFIG_VALUE_4=$work/bin/gpg
export GIT_CONFIG_KEY_5=user.signingKey GIT_CONFIG_VALUE_5=test-key

failures=0

# Reports a failure of case $1 at once, each line of $2 under the program and
# the case, so a later abort cannot hide it.
fail() {
    local line
    while IFS= read -r line <&3; do
        echo "${0##*/}: $1: $line" >&2
    done 3<<<"$2"
    failures=$((failures + 1))
}

n=0

# A fresh fixture in $w, as the header describes, each repository holding its
# commits pushed to its origin.
fixture() {
    n=$((n + 1))
    w=$work/$n
    mkdir "$w"
    git init -q --bare "$w/lib.git"
    git init -q "$w/lib.up"
    git -C "$w/lib.up" commit -q --allow-empty -m init
    git -C "$w/lib.up" push -q "$w/lib.git" main
    git init -q --bare "$w/app.git"
    git init -q "$w/app"
    git -C "$w/app" submodule add -q "$w/lib.git" lib
    echo lib >"$w/app/.projects"
    git -C "$w/app" add .projects
    git -C "$w/app" commit -q -m init
    git -C "$w/app" remote add origin "$w/app.git"
    git -C "$w/app" push -q origin main
}

# Runs project/tag-create in app with the arguments given, keeping its status in
# rc and its stderr in $w/err.
run() {
    rc=0
    (cd "$w/app" && "$tag_create" "$@") >"$w/out" 2>"$w/err" || rc=$?
}

# Records a failure of case $1 where $3 is not $4, $2 naming what was asked.
expect() {
    if [ "$3" != "$4" ]; then
        fail "$1" "$2 is $3, not $4: $(<"$w/err")"
    fi
}

# Records a failure of case $1 unless stderr holds $2.
expect_out() {
    grep -qF -- "$2" "$w/err" || fail "$1" "stderr lacks '$2': $(<"$w/err")"
}

# The object tag $2 names in repository $1, or "none".
tag_of() {
    git -C "$1" rev-parse -q --verify "refs/tags/$2" || echo none
}

# Records a failure of case $1 unless tag $2 is signed and annotated alike in
# app and lib and pushed to each one's origin.
expect_tagged() {
    local r
    for r in app app/lib; do
        if ! git -C "$w/$r" cat-file tag "$2" 2>/dev/null |
            grep -qFx -- '-----BEGIN PGP SIGNATURE-----'; then
            fail "$1" "$r has no signed tag $2: $(<"$w/err")"
        fi
        expect "$1" "$r's origin's $2" "$(tag_of "$w/${r##*/}.git" "$2")" \
            "$(tag_of "$w/$r" "$2")"
    done
}

# Records a failure of case $1 unless tag $2 exists in neither app nor app's
# origin: nothing was signed or pushed, app being swept last.
expect_untagged() {
    expect "$1" "app's $2" "$(tag_of "$w/app" "$2")" none
    expect "$1" "app's origin's $2" "$(tag_of "$w/app.git" "$2")" none
}

# A new tag is signed in every project and pushed to every origin.
fixture
run 1.2
expect create status "$rc" 0
expect_tagged create 1.2

# A tag existing in any project is refused before anything is signed.
fixture
git -C "$w/app/lib" tag 1.2
run 1.2
expect local-exists status "$rc" 1
expect_out local-exists "tag-create: 1.2: already exists"
expect_untagged local-exists 1.2

# 1.01 and 1.1 are one version to sort -V but are distinct tags, so either
# existing refuses that one and does not hide the other, in whichever order the
# sweep lists them: lib's tags come first.
fixture
git -C "$w/app" tag v1.01
git -C "$w/app/lib" tag v1.1
run v1.1
expect zeros-exists status "$rc" 1
expect_out zeros-exists "tag-create: v1.1: already exists"
expect_untagged zeros-exists v1.1

fixture
git -C "$w/app" tag v1.1
git -C "$w/app/lib" tag v1.01
run v1.1
expect zeros-exists-after status "$rc" 1
expect_out zeros-exists-after "tag-create: v1.1: already exists"
expect zeros-exists-after "lib's v1.1" "$(tag_of "$w/app/lib" v1.1)" none
expect zeros-exists-after "lib's origin's v1.1" \
    "$(tag_of "$w/lib.git" v1.1)" none
expect zeros-exists-after "app's origin's v1.1" \
    "$(tag_of "$w/app.git" v1.1)" none

# column.ui=always lays out several tags on a line, which must not hide one that
# exists.
fixture
git -C "$w/app/lib" tag 1.1
git -C "$w/app/lib" tag 1.2
git -C "$w/app/lib" tag 1.3
GIT_CONFIG_COUNT=7 GIT_CONFIG_KEY_6=column.ui GIT_CONFIG_VALUE_6=always run 1.2
expect column status "$rc" 1
expect_out column "tag-create: 1.2: already exists"
expect_untagged column 1.2

fixture
git -C "$w/app" tag v1.01
run v1.1
expect zeros-distinct status "$rc" 0
expect_tagged zeros-distinct v1.1

# A tag is matched literally and whole, not as a pattern or a prefix, locally
# and on an origin.
fixture
git -C "$w/app" tag 14X655
git -C "$w/app/lib" tag 14.655.1
git -C "$w/app/lib" tag x/14.655
git -C "$w/app/lib" push -q origin 14.655.1 x/14.655
run 14.655
expect literal status "$rc" 0
expect_tagged literal 14.655

# A tag only on an origin, pushed from another clone, is refused before anything
# is signed. Annotated, so the origin also lists it peeled.
fixture
git -C "$w/lib.up" tag -a -m 1.2 1.2
git -C "$w/lib.up" push -q "$w/lib.git" 1.2
run 1.2
expect remote-exists status "$rc" 1
expect_out remote-exists "tag-create: 1.2: already exists on an origin"
expect remote-exists stdout "$(<"$w/out")" ""
expect_untagged remote-exists 1.2
expect remote-exists "lib's 1.2" "$(tag_of "$w/app/lib" 1.2)" none

# An origin that cannot be reached fails the run before anything is signed.
fixture
git -C "$w/app/lib" remote set-url origin "$w/missing.git"
run 1.2
[ "$rc" -ne 0 ] || fail unreachable "exit 0, not a failure: $(<"$w/err")"
expect_untagged unreachable 1.2
expect unreachable "lib's 1.2" "$(tag_of "$w/app/lib" 1.2)" none

# An origin that does not answer in time fails the run, saying so, before
# anything is signed.
fixture
FAKE_EXPIRE=$w/app/lib run 1.2
expect expired status "$rc" 124
expect_out expired "$w/app/lib: origin did not answer within 60 s"
expect_untagged expired 1.2
expect expired "lib's 1.2" "$(tag_of "$w/app/lib" 1.2)" none

# A tag existing locally is refused without asking any origin, so even one that
# cannot be reached.
fixture
git -C "$w/app/lib" tag 1.2
git -C "$w/app/lib" remote set-url origin "$w/missing.git"
run 1.2
expect local-offline status "$rc" 1
expect_out local-offline "tag-create: 1.2: already exists"
expect local-offline stdout "$(<"$w/out")" ""
expect_untagged local-offline 1.2

# A missing, empty or extra argument is refused with the usage before anything
# runs.
fixture
run
expect no-tag status "$rc" 2
expect no-tag stderr "$(<"$w/err")" "Usage: tag-create TAG"
expect no-tag stdout "$(<"$w/out")" ""
run ""
expect empty-tag status "$rc" 2
expect empty-tag stderr "$(<"$w/err")" "Usage: tag-create TAG"
expect empty-tag stdout "$(<"$w/out")" ""
run 1.2 1.3
expect extra status "$rc" 2
expect extra stderr "$(<"$w/err")" "Usage: tag-create TAG"
expect extra stdout "$(<"$w/out")" ""
expect_untagged extra 1.2

if [ "$failures" -gt 0 ]; then
    exit 1
fi
