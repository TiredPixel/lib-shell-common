#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

if [ $# -ne 0 ]; then
    echo "Usage: ${0##*/}" >&2
    exit 2
fi

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

# Duplicates are removed before the version sort rather than by it: sort -Vu
# counts 1.01 and 1.1 as one version and would list only one of them.
"$dir/each" git tag -l --no-column | sort -u | sort -V | tail
