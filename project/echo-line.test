#!/usr/bin/env bash
#
# Tests project/echo-line, sourced in a shell with no options set and in one
# under the strict mode its callers run, with tput faked on PATH: it prints
# FAKE_COLS, or fails as with no terminal where that is empty. Sourcing must set
# none of the shell's options, and the rule must come out the same in both.
#
# Run: project/echo-line.test. Exits 1 naming each case that failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

helper=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/echo-line
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

mkdir "$work/path"
cat >"$work/path/tput" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
if [ -z "${FAKE_COLS:-}" ]; then
    echo "tput: No value for \$TERM and no -T specified" >&2
    exit 2
fi
echo "$FAKE_COLS"
EOF
chmod +x "$work/path/tput"
export PATH=$work/path:$PATH

# The shells that source the helper are scripts in files rather than -c strings,
# as its callers are, so BASH_SOURCE is set in them as it is in a caller.
cat >"$work/draw" <<'EOF'
if [ "$1" = strict ]; then
    set -Eeuo pipefail
    shopt -s inherit_errexit failglob
fi
source "$2"
echo_line "$3"
EOF
cat >"$work/options" <<'EOF'
before=$SHELLOPTS:$BASHOPTS
source "$1"
[ "$SHELLOPTS:$BASHOPTS" = "$before" ]
EOF

failed=()

# Runs bash with no options or, where $2 is strict, under the callers' strict
# mode; it sources the helper and draws a rule of $3. Checks stdout is $4 and
# stderr empty.
check() {
    local name=$1 mode=$2 char=$3 out=$4 rc=0
    bash --norc --noprofile "$work/draw" "$mode" "$helper" "$char" \
        >"$work/out" 2>"$work/err" || rc=$?
    if [ "$rc" != 0 ]; then
        failed+=("$name: exit $rc: $(<"$work/err")")
    elif [ "$(<"$work/out")" != "$out" ]; then
        failed+=("$name: stdout is: $(<"$work/out")")
    elif [ -s "$work/err" ]; then
        failed+=("$name: stderr is: $(<"$work/err")")
    fi
}

for mode in plain strict; do
    FAKE_COLS=5 check "$mode-equals" "$mode" = "====="
    FAKE_COLS=3 check "$mode-dash" "$mode" - "---"
    # No terminal: tput fails and the rule is 80 wide.
    FAKE_COLS='' check "$mode-no-tty" "$mode" = "$(printf '=%.0s' {1..80})"
done

# Sourcing changes none of the shell's options.
bash --norc --noprofile "$work/options" "$helper" ||
    failed+=("options: sourcing changed the shell's options")

if [ ${#failed[@]} -gt 0 ]; then
    printf 'FAILED %s\n' "${failed[@]}" >&2
    exit 1
fi
echo "ok"
