#!/usr/bin/env bash
#
# What the script does with a branch is tested through the release scripts that
# run it, in test/project/release-create-latest.test and
# test/project/release-create-stable.test.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

ready=$root/project/release-branch-ready

# A missing, empty or extra argument is refused with the usage, with --check or
# without, before git is asked anything: the scratch dir is no repository.
usage='project/release-branch-ready [--check] BRANCH'
cd -- "$test_tmp"
test_usage no-branch "$usage" "$ready"
test_usage empty-branch "$usage" "$ready" ""
test_usage extra "$usage" "$ready" a b
test_usage check-no-branch "$usage" "$ready" --check
test_usage check-empty-branch "$usage" "$ready" --check ""
test_usage check-extra "$usage" "$ready" --check a b

test_finish
