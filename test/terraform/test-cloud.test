#!/usr/bin/env bash
#
# terraform is faked on PATH, so nothing is initialised or planned. The fake
# logs each call's arguments and fails where its first argument is FAKE_FAIL.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

script=$root/terraform/test-cloud

cp -p -- "$root/test/fixtures/terraform/test-cloud/terraform" "$test_tmp/path/"
export FAKE_LOG=$test_tmp/terraform.calls
: >"$FAKE_LOG"
mkdir -- "$test_tmp/project"
cd -- "$test_tmp/project"

fmt='fmt -recursive -check -diff'
init='init -lockfile=readonly'

# The lock file is read-only, so the check cannot move a provider, and the plan
# is not saved.
test_check order 0 '' '' "$script"
test_calls order terraform "$fmt" "$init" plan

test_check fmt-fails 1 '' 'fake terraform: fmt failed' env FAKE_FAIL=fmt "$script"
test_calls fmt-fails terraform "$fmt"
test_check init-fails 1 '' 'fake terraform: init failed' \
    env FAKE_FAIL=init "$script"
test_calls init-fails terraform "$fmt" "$init"
test_check plan-fails 1 '' 'fake terraform: plan failed' \
    env FAKE_FAIL=plan "$script"
test_calls plan-fails terraform "$fmt" "$init" plan

# Any argument is a usage error, refused before terraform runs.
test_usage argument terraform/test-cloud "$script" x

test_finish
