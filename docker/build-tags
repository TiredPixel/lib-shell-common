#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

# REPO and TAG come from init rather than a second derivation here, since init
# resolves a detached HEAD from whichever CI names the branch.
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/init"

release=$(git describe --abbrev=0)
version=$(git describe)

tags=("$TAG")

if [ "$version" = "$release" ]; then
    prefix=$release
    previous=""

    while true; do
        tags+=("$prefix")
        prefix=${prefix%.*}

        if [ "$prefix" = "$previous" ]; then
            break
        else
            previous=$prefix
        fi
    done
fi

tag_args=()
caches=()

for tag in "${tags[@]}"; do
    tag_args+=("-t")
    tag_args+=("$REPO:$tag")
    caches+=("--cache-from")
    caches+=("$REPO:$tag")
done

docker build \
    --build-arg BUILDKIT_INLINE_CACHE=1 \
    --build-arg GIT_DESCRIBE="$version" \
    "${caches[@]}" \
    "${tag_args[@]}" .

for tag in "${tags[@]}"; do
    docker push "$REPO:$tag"
done

echo
echo "version: $version"
echo "repo:    $REPO"
echo "tags:    ${tags[*]}"
