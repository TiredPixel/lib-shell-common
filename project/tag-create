#!/usr/bin/env bash
#
# Signs tag $1 in every project and pushes it to every origin, refusing one that
# already exists in any project or on any origin. --check refuses the same way
# and creates nothing, so a release can learn before its commit, which names
# the tag, that the tag is free. --no-push signs the tag everywhere and pushes
# it nowhere, so a release can push each project's tag in one atomic push with
# its branch.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
prog=${0##*/}

mode=
case ${1:-} in
--check | --no-push)
    mode=$1
    shift
    ;;
esac

# A TAG beginning with - is refused, since git creates no such tag, so that the
# other mode given as well, as in --check --no-push, is never taken for one.
if [ $# -ne 1 ] || [ -z "$1" ] || [[ $1 == -* ]]; then
    echo "Usage: $prog [--check | --no-push] TAG" >&2
    exit 2
fi
tag=$1

# The sweeps' status is checked rather than discarded: as the left operand of an
# && list it would be exempt from errexit, so a sweep that failed, on a
# .projects entry that is not a submodule or a directory missing from the tree,
# would read as "the tag exists nowhere" and the script would go on to sign and
# push it everywhere.
#
# Unsorted, because sort -V counts 1.01 and 1.1 as one version, so -u would keep
# whichever came first and the match below would miss the other.
#
# --no-column because column.ui=always would put several tags on a line, which
# the exact-line match below would never find.
existing=$("$dir/each" git tag -l --no-column)

# -F because a tag is a literal, not a pattern -- as a regex 14.655 also matches
# 14X655 -- and -x because 14.6 is not 14.655. Asked before any origin, so a tag
# that exists here is refused without needing the network.
if grep -qFx -- "$tag" <<<"$existing"; then
    echo "$prog: $tag: already exists" >&2
    exit 1
fi

# Every origin is asked too, since a tag pushed from another clone and never
# fetched here is absent locally, and its push would be refused only after every
# project had been tagged and those before it pushed.
remote=$("$dir/each" "$dir/tag-list-origin" | cut -f2)

if grep -qFx -- "refs/tags/$tag" <<<"$remote"; then
    echo "$prog: $tag: already exists on an origin" >&2
    exit 1
fi

if [ "$mode" = --check ]; then
    exit 0
fi

"$dir/each" git tag -s "$tag" -m "$tag"

if [ "$mode" = --no-push ]; then
    exit 0
fi

# refs/tags/ so a branch of the same name cannot make the refspec ambiguous, and
# --no-follow-tags so push.followTags sends no other tag with it.
"$dir/each" git push --no-follow-tags --recurse-submodules=check origin "refs/tags/$tag"
