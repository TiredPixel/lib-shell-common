#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
prog=${0##*/}

f_projects=.projects

usage() {
    echo "Usage: $prog [--from PROJECT | --skip-upgrade]" >&2
    exit 2
}

# --from resumes the upgrade stage at PROJECT, once the project that stopped the
# sweep before it has been finished by hand. Every other stage covers every
# project, since a stopped sweep never reached them. --skip-upgrade resumes past
# the upgrade stage altogether, for a sweep the last listed project stopped,
# which leaves --from no next project to name.
from=()
skip=
case $# in
0) ;;
1)
    if [ "$1" != --skip-upgrade ]; then
        usage
    fi
    skip=1
    ;;
2)
    if [ "$1" != --from ] || [ -z "$2" ]; then
        usage
    fi
    from=(--from "$2")
    ;;
*) usage ;;
esac

# The sweep is defined by this list, so its absence is a broken checkout rather
# than an empty one: the per-project make stages below would find no project to
# run in, and the run would still complete having run them nowhere.
if [ ! -f "$f_projects" ]; then
    echo "$prog: $PWD: no $f_projects, so there is nothing to sweep" >&2
    exit 1
fi

# Checked here as well as by each-without-project, so a mistyped name stops the
# sweep before the pull moves anything.
if [ ${#from[@]} -gt 0 ] && ! grep -qxF -- "${from[1]}" "$f_projects"; then
    echo "$prog: ${from[1]}: not listed in $PWD/$f_projects," \
        "so the sweep cannot resume from it" >&2
    exit 1
fi

echo "$prog: pull" >&2
"$dir/upgrade-pull"

if [ -z "$skip" ]; then
    echo "$prog: upgrade" >&2
    # make runs under `script` so the tools it drives still see a tty; -e so the
    # status carried back out is make's own rather than script's, which is what
    # tells the sweep an upgrade failed. Which project declares the target is
    # make-if-declared's question, not this one's.
    "$dir/each-without-project" "${from[@]}" "$dir/make-if-declared" upgrade \
        sh -c '
            set -eu
            if script --version >/dev/null 2>&1; then
                script -q -e -c "make upgrade" /dev/null
            else
                script -e /dev/null make upgrade
            fi'
fi

echo "$prog: rebuild" >&2
"$dir/each-without-project" "$dir/make-if-declared" build

echo "$prog: start" >&2
# --pull moves the images Compose does not build to what their tags name now;
# the ones it builds are the rebuild's.
"$dir/start" --pull

echo "$prog: stop" >&2
"$dir/stop"

echo "$prog: completed" >&2
