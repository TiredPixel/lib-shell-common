# shellcheck shell=bash
#
# Sourced by bin/format and bin/lint, from the root of the repository, so the
# two take the same files and the same options and cannot disagree. Sets no
# shell options, since it runs under its caller's; any failure here ends the
# caller's run.

# Before the first command, so it covers the whole file: every array here is
# read only by the runners that source this file, and ShellCheck takes the
# nameref files_find assigns through mapfile for unused.
# shellcheck disable=SC2034

# Indented by 4 spaces, departing from shfmt's default indent (see
# `shfmt --help`), since spaces are the common practice for shell.
shfmt_args=(-i 4)

# Reads into the array named by $1 what find, given the arguments after $2,
# prints, NUL-separated and sorted; a failure ends the run naming directory $2.
# find runs as a background job into a file and its status is checked through
# wait, since bash can lose a process substitution's status. The file is removed
# once it is open for both, so no later exit, by a signal included, leaves it
# behind.
files_find() {
    local -n files_find_into=$1
    local files_find_dir=$2 files_find_out files_find_write files_find_read
    shift 2

    files_find_out=$(mktemp)
    exec {files_find_write}>"$files_find_out"
    exec {files_find_read}<"$files_find_out"
    rm -- "$files_find_out"
    { find "$@" -print0 | LC_ALL=C sort -z; } >&"$files_find_write" &
    wait $! || {
        echo "bin/files: listing $files_find_dir/ failed" >&2
        exit 1
    }
    exec {files_find_write}>&-
    mapfile -t -d '' files_find_into <&"$files_find_read"
    exec {files_find_read}<&-
}

# Appends to shell_files each file directly in directory $1, or at any depth
# where $2 is "recursive", whose first line is a bash shebang or, for a file
# that is sourced and so carries none, ShellCheck's shell=bash directive, since
# the scripts carry no suffix. Checked on this scan's own result, so a directory
# that is missing or yields nothing fails the run rather than quietly narrowing
# the lint.
files_shell_in() {
    local dir=$1 f first
    local shebang='#!.*[/[:space:]]bash([[:space:]]|$)'
    local pattern="^($shebang|# shellcheck shell=bash\$)"
    local -a depth=(-maxdepth 1) entries found=()

    if [ "${2:-}" = recursive ]; then
        depth=()
    fi
    if ! [ -d "$dir" ]; then
        echo "bin/files: $dir/ is missing" >&2
        exit 1
    fi
    files_find entries "$dir" "$dir" -mindepth 1 "${depth[@]}" -type f
    for f in "${entries[@]}"; do
        first=$(head -n 1 -- "$f")
        if [[ $first =~ $pattern ]]; then
            found+=("$f")
        fi
    done
    if [ ${#found[@]} -eq 0 ]; then
        echo "bin/files: $dir/ holds no bash script" >&2
        exit 1
    fi
    shell_files+=("${found[@]}")
}

shell_files=()
for files_dir in ansible docker github lint project terraform bin test/ansible \
    test/bin test/docker test/github test/lint test/project test/terraform; do
    files_shell_in "$files_dir"
done
unset files_dir
# Fixtures sit in a directory for each test, so a new one is reached unlisted.
files_shell_in test/fixtures recursive

compose_files=(docker-compose.yml)
# A proposed workflow waits in .github/workflows.new/ until it is moved into
# .github/workflows/, so either directory may be absent.
workflow_files=()
if [ -d .github ]; then
    files_find workflow_files .github .github -mindepth 2 -maxdepth 2 -type f \
        \( -path '.github/workflows/*' -o -path '.github/workflows.new/*' \) \
        \( -name '*.yml' -o -name '*.yaml' \)
fi
# The review gate's workflow, which projects copy, linted as a live one is.
workflow_files+=(github/review.yml)
# The review gate's action, not a workflow, so linted as YAML alone; actionlint
# reads it only where a workflow uses it.
action_files=(github/review/action.yml)
yaml_files=("${compose_files[@]}" .hadolint.yaml "${workflow_files[@]}"
    "${action_files[@]}")

docker_files=(Dockerfile)
markdown_files=(README.md)
make_files=(Makefile)
dotenv_files=(.env.example)
# --newline, so each keeps its final newline.
dockerfmt_args=(--newline)
# --wrap no, so each paragraph is one line, which renderers reflow.
mdformat_args=(--wrap no)

# No formatter or linter exists for what else is tracked: the .dockerignore,
# .gitignore, .dockerrepo, checkmake.ini, the LICENSE and
# Dockerfile.lock/mdformat/requirements.txt, which docker/upgrade writes.
