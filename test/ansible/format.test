#!/usr/bin/env bash
#
# ansible-lint is faked on PATH, so nothing is fixed. The fake logs each call's
# arguments.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

script=$root/ansible/format

cp -p -- "$root/test/fixtures/ansible/format/ansible-lint" "$test_tmp/path/"
export FAKE_LOG=$test_tmp/ansible-lint.calls
: >"$FAKE_LOG"
mkdir -- "$test_tmp/project"
cd -- "$test_tmp/project"

# The options ansible/test shares, as the fake logs them.
# shellcheck source=ansible/lint-args
source "$root/ansible/lint-args"
lint=$(printf '%q ' "${ansible_lint_args[@]}")
lint=${lint% }

# Fixes with the shared options.
test_check fixes 0 '' '' "$script"
test_calls fixes ansible-lint "$lint --fix --"

# The paths go after --, so --fix cannot take the first for its rule list.
test_check paths 0 '' '' "$script" a b
test_calls paths ansible-lint "$lint --fix -- a b"

test_finish
