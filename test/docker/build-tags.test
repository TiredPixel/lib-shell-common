#!/usr/bin/env bash
#
# Tests docker/build-tags in a scratch project with docker and git faked on
# PATH, so nothing is built, pushed or read from a repository. The fake docker
# logs each call's arguments, a line to a call, and exits with FAKE_BUILD's
# status from a build and FAKE_PUSH's from a push. The fake git puts HEAD on
# branch FAKE_BRANCH, "HEAD" where that is the detached state, and describes it
# as FAKE_DESCRIBE, its latest annotated tag being FAKE_RELEASE; where that is
# empty, both fail as a repository with no annotated tag does. It gives
# FAKE_ORIGIN as the origin remote's URL, failing as a checkout with no origin
# does where that is empty.
#
# Run: test/docker/build-tags.test. Exits 1 naming each case that failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../../docker")
fixtures=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../fixtures/docker/build-tags")
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

mkdir "$work/bin" "$work/project"
cp -p -- "$fixtures/docker" "$fixtures/git" "$work/bin/"
echo r/x >"$work/project/.dockerrepo"

export FAKE_LOG=$work/log
export FAKE_ORIGIN=https://github.com/o/r
cd "$work/project"

failures=0
# Reports a failure of case $1 at once, each line of $2 under the program and
# the case, so a later abort cannot hide it.
fail() {
    local line
    while IFS= read -r line <&3; do
        echo "${0##*/}: $1: $line" >&2
    done 3<<<"$2"
    failures=$((failures + 1))
}

# Runs docker/build-tags with HEAD on branch $3, described as $4 with latest
# annotated tag $5, and the environment after $6, and checks its status is $2,
# docker was called as $6 has it, a line to a call, and its stdout and stderr
# are want_out and want_err.
check() {
    local name=$1 status=$2 branch=$3 version=$4 release=$5 calls=$6 rc=0
    shift 6
    : >"$FAKE_LOG"
    env -u CIRCLE_BRANCH -u CIRCLE_TAG -u GITHUB_HEAD_REF -u GITHUB_REF_NAME \
        -u FAKE_BUILD -u FAKE_PUSH PATH="$work/bin:$PATH" \
        FAKE_BRANCH="$branch" FAKE_DESCRIBE="$version" FAKE_RELEASE="$release" \
        "$@" "$dir/build-tags" >"$work/out" 2>"$work/err" || rc=$?
    if [ "$rc" != "$status" ]; then
        fail "$name" "exit $rc, not $status: $(<"$work/err")"
    elif [ "$(<"$FAKE_LOG")" != "$calls" ]; then
        fail "$name" "docker was called as: $(<"$FAKE_LOG")"
    elif [ "$(<"$work/out")" != "$want_out" ]; then
        fail "$name" "stdout is: $(<"$work/out")"
    elif [ "$(<"$work/err")" != "$want_err" ]; then
        fail "$name" "stderr is: $(<"$work/err")"
    fi
}

# Sets calls to the docker calls for a build stamped $1, sourced from
# FAKE_ORIGIN and tagged with the tags after it, in order, each pushed in turn,
# and want_out and want_err to what a run that goes through prints.
expect() {
    local version=$1 tag build="build --build-arg BUILDKIT_INLINE_CACHE=1"
    shift
    build+=" --build-arg GIT_DESCRIBE=$version"
    build+=" --build-arg IMAGE_SOURCE=$FAKE_ORIGIN"
    for tag in "$@"; do
        build+=" --cache-from r/x:$tag"
    done
    for tag in "$@"; do
        build+=" -t r/x:$tag"
    done
    calls="$build ."
    want_out="fake docker: built"
    want_err="fake docker: building"
    for tag in "$@"; do
        calls+=$'\n'"push r/x:$tag"
        want_out+=$'\n'"fake docker: pushed r/x:$tag"
        want_err+=$'\n'"build-tags: pushed r/x:$tag"
    done
}

# On a plain version release, the release and each shorter prefix are tags too,
# with or without a leading v.
expect 1.2.3 a-b 1.2.3 1.2 1
check on-release 0 a/b 1.2.3 1.2.3 "$calls"
expect v1.4.2 a-b v1.4.2 v1.4 v1
check on-release-v 0 a/b v1.4.2 v1.4.2 "$calls"

# Any other release is a tag under its full name alone, so a prerelease takes
# no version's prefix.
expect v1.4.2-rc.1 a-b v1.4.2-rc.1
check prerelease 0 a/b v1.4.2-rc.1 v1.4.2-rc.1 "$calls"
expect 1.4.2-rc.1 a-b 1.4.2-rc.1
check prerelease-no-v 0 a/b 1.4.2-rc.1 1.4.2-rc.1 "$calls"
expect V1.2 a-b V1.2
check release-upper-v 0 a/b V1.2 V1.2 "$calls"
expect vv1.2 a-b vv1.2
check release-double-v 0 a/b vv1.2 vv1.2 "$calls"
expect 1..2 a-b 1..2
check release-empty-part 0 a/b 1..2 1..2 "$calls"
expect 1.2. a-b 1.2.
check release-trailing-dot 0 a/b 1.2. 1.2. "$calls"

# Past a release, only the branch is.
expect 1.2.3-4-gabcdef0 a-b
check past-release 0 a/b 1.2.3-4-gabcdef0 1.2.3 "$calls"

# A one-part release is a tag once.
expect 1 a-b 1
check one-part 0 a/b 1 1 "$calls"

# On a tag push the branch tag is the release, so it is a tag once.
expect 1.2 1.2 1
check github-tag 0 HEAD 1.2 1.2 "$calls" GITHUB_REF_NAME=1.2
expect v1.2 v1.2 v1
check circle-tag 0 HEAD v1.2 v1.2 "$calls" CIRCLE_TAG=v1.2

# A release as long as Docker's tag grammar allows is a tag.
printf -v r128 '%*s' 128 ''
r128=${r128// /r}
expect "$r128" a-b "$r128"
check release-128 0 a/b "$r128" "$r128" "$calls"

# Upper-case letters and _ are in the grammar too, _ even as the first
# character.
expect V1_x.Y a-b V1_x.Y
check release-upper-underscore 0 a/b V1_x.Y V1_x.Y "$calls"
expect _1 a-b _1
check release-leading-underscore 0 a/b _1 _1 "$calls"

# A release outside Docker's tag grammar stops the run before docker is called,
# under any locale.
want_out=""
for release in v1+x .1 "${r128}r" $'v1\xc3\xa9'; do
    want_err="build-tags: $release: release is not a valid image tag"
    check "bad-release-$release" 1 a/b "$release" "$release" ""
    check "bad-release-utf8-$release" 1 a/b "$release" "$release" "" \
        LC_ALL=en_US.UTF-8
done

# Past a release, it is not a tag, so it is not checked.
expect v1+x-4-gabcdef0 a-b
check past-bad-release 0 a/b v1+x-4-gabcdef0 v1+x "$calls"

# No annotated tag stops the run before docker is called.
want_out=""
want_err="fatal: No names found, cannot describe anything."
check untagged 128 a/b "" "" ""

# A failed build pushes nothing, and a failed push stops the pushes.
expect 1.2 a-b 1.2 1
build=${calls%%$'\n'*}
want_out="fake docker: built"
want_err="fake docker: building"
check build-fails 3 a/b 1.2 1.2 "$build" FAKE_BUILD=3
want_out+=$'\n'"fake docker: pushed r/x:a-b"
check push-fails 4 a/b 1.2 1.2 "$build"$'\n'"push r/x:a-b" FAKE_PUSH=4

# A checkout with no origin to take the source from stops the run before docker
# is called.
want_out=""
want_err="error: No such remote 'origin'"$'\n'
want_err+="build-tags: IMAGE_SOURCE: git remote get-url origin failed"
check no-origin 1 a/b 1.2 1.2 "" FAKE_ORIGIN=

# Any argument is a usage error, refused before docker is called.
: >"$FAKE_LOG"
rc=0
PATH="$work/bin:$PATH" FAKE_BRANCH=a/b FAKE_DESCRIBE=1.2 FAKE_RELEASE=1.2 \
    "$dir/build-tags" --help >"$work/out" 2>"$work/err" || rc=$?
if [ "$rc" != 2 ] || [ -s "$work/out" ] ||
    [ "$(<"$work/err")" != "Usage: build-tags" ]; then
    fail argument "exit $rc: $(<"$work/out")$(<"$work/err")"
elif [ -s "$FAKE_LOG" ]; then
    fail argument "docker was called as: $(<"$FAKE_LOG")"
fi

if [ "$failures" -gt 0 ]; then
    exit 1
fi
