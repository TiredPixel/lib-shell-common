#!/usr/bin/env bash
#
# terraform is faked on PATH, so nothing is initialised or planned. The fake
# logs each call's arguments, then "plan present" where .terraform.plan exists
# as it runs; it fails where its first argument is FAKE_FAIL, and writes "plan"
# to the file plan -out names.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

script=$root/terraform/plan-cli

cp -p -- "$root/test/fixtures/terraform/plan-cli/terraform" "$test_tmp/path/"
export FAKE_LOG=$test_tmp/terraform.calls
: >"$FAKE_LOG"

init='init -lockfile=readonly'
plan='plan -out .terraform.plan'
removing='terraform/plan-cli: .terraform.plan: removing an earlier plan'

# Makes the project afresh and enters it, holding an earlier plan where $1 is
# "stale".
project() {
    cd -- "$test_tmp"
    rm -rf -- project
    mkdir -- project
    if [ "${1-}" = stale ]; then
        echo stale >project/.terraform.plan
    fi
    cd -- project
}

# Fails case $1 unless the plan holds $2, or, where that is empty, no plan is
# left.
plan_is() {
    if [ -z "$2" ]; then
        if [ -e .terraform.plan ]; then
            test_fail "$1" ".terraform.plan is left"
        fi
    elif ! [ -f .terraform.plan ] || [ "$(<.terraform.plan)" != "$2" ]; then
        test_fail "$1" "the plan is not $2"
    fi
}

# The lock file is read-only, so the plan cannot take a provider version nobody
# committed.
project
test_check plans 0 '' '' "$script"
test_calls plans terraform "$init" "$plan"
plan_is plans plan

# The earlier plan is removed, and said so, before terraform first runs.
project stale
test_check stale 0 '' "$removing" "$script"
test_calls stale terraform "$init" "$plan"
plan_is stale plan
project stale
test_check stale-init-fails 1 '' \
    "$removing"$'\n''fake terraform: init failed' env FAKE_FAIL=init "$script"
test_calls stale-init-fails terraform "$init"
plan_is stale-init-fails ''

project
test_check init-fails 1 '' 'fake terraform: init failed' \
    env FAKE_FAIL=init "$script"
test_calls init-fails terraform "$init"
plan_is init-fails ''

project
test_check plan-fails 1 '' 'fake terraform: plan failed' \
    env FAKE_FAIL=plan "$script"
test_calls plan-fails terraform "$init" "$plan"
plan_is plan-fails ''

# Any argument is a usage error, refused before the earlier plan is removed or
# terraform runs, so -target=x never plans everything.
project stale
test_usage argument terraform/plan-cli "$script" -target=x
plan_is argument stale

test_finish
