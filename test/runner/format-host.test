#!/usr/bin/env bash
#
# Runs in scratch git repositories, with docker faked and git reading no
# configuration but each repository's own, so the run's binds show in the docker
# call it would make.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

script=$root/runner/format-host

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
export GIT_CEILING_DIRECTORIES=$test_tmp
export GIT_CONFIG_COUNT=3
export GIT_CONFIG_KEY_0=user.name GIT_CONFIG_VALUE_0=test
export GIT_CONFIG_KEY_1=user.email GIT_CONFIG_VALUE_1=test@example.com
export GIT_CONFIG_KEY_2=init.defaultBranch GIT_CONFIG_VALUE_2=main
mkdir -- "$test_tmp/tmpdir"
export TMPDIR=$test_tmp/tmpdir

# shellcheck disable=SC2016 # The fake expands it.
test_stub docker 'exit "${FAKE_DOCKER:-0}"'

# Makes a git repository at $test_tmp/$1 and prints its path.
repo() {
    local t=$test_tmp/$1
    git init -q -- "$t"
    echo "$t"
}

# Writes a line to each path under repository $1 given after it that is not
# there yet.
write() {
    local t=$1 f
    shift
    for f; do
        if ! [ -e "$t/$f" ]; then
            mkdir -p -- "$(dirname -- "$t/$f")"
            echo a >"$t/$f"
        fi
    done
}

# Writes each path under repository $1 given after it, and adds it to the index.
tracked() {
    write "$@"
    git -C "$1" add -- "${@:2}"
}

# The docker call a run in repository $1 makes, with the options given before --
# and each entry after it bound by its absolute path, read-only where it ends in
# :ro.
call() {
    local t=$1 entry mode
    local -a args=(compose run --rm)
    shift
    while [ "$1" != -- ]; do
        args+=("$1")
        shift
    done
    shift
    args+=(-e FORMAT_MOUNTS=1)
    for entry; do
        mode=
        if [[ $entry == *:ro ]]; then
            mode=:ro
            entry=${entry%:ro}
        fi
        args+=(-v "$t/$entry:/home/x/r/$entry$mode")
    done
    args+=(tooling format)
    printf ' %q' "${args[@]}" | cut -c 2-
}

# Each top-level entry, untracked ones too, is bound by its absolute path; an
# untracked file in a tracked directory comes with it.
t=$(repo top)
tracked "$t" README.md src/a.css src/b/c.css .github/w.yml
write "$t" new.md docs/x.md src/new.css
test_check top 0 '' '' env -C "$t" "$script" --build -T -- tooling format
test_calls top docker \
    "$(call "$t" --build -T -- .github README.md docs new.md src)"

# A directory holding an ignored path or a submodule is taken entry by entry, so
# neither is bound, and an untracked dot entry is left out.
t=$(repo ignored)
printf '/tmp/\n*.log\n' >"$t/.gitignore"
tracked "$t" .gitignore src/a.css lib/own.sh
write "$t" tmp/state debug.log src/x.log src/.a.css.swp .a.swp \
    .idea/workspace.xml lib/sub/f
git -C "$t/lib/sub" init -q
git -C "$t/lib/sub" add f
git -C "$t/lib/sub" commit -q -m a
sub=$(git -C "$t/lib/sub" rev-parse HEAD)
git -C "$t" update-index --add --cacheinfo "160000,$sub,lib/sub"
test_check ignored 0 '' '' env -C "$t" "$script" -- tooling format
test_calls ignored docker "$(call "$t" -- .gitignore lib/own.sh src/a.css)"

# A run from below the root binds the same entries, from the root.
test_check subdirectory 0 '' '' env -C "$t/src" "$script" -- tooling format
test_calls subdirectory docker \
    "$(call "$t" -- .gitignore lib/own.sh src/a.css)"

# An untracked dot file or directory at the top is left out.
t=$(repo dots-1)
tracked "$t" README.md
write "$t" .netrc .aws/credentials
test_check dot-top 0 '' '' env -C "$t" "$script" -- tooling format
test_calls dot-top docker "$(call "$t" -- README.md)"

# One at any depth in a tracked directory, a symlink included, has each parent
# taken entry by entry, so the rest of the directory is still bound.
t=$(repo dots-2)
tracked "$t" src/a.css src/b/c.css
write "$t" src/.netrc src/b/.aws/credentials src/new.css
ln -s a.css "$t/src/.link"
test_check dot-nested 0 '' '' env -C "$t" "$script" -- tooling format
test_calls dot-nested docker \
    "$(call "$t" -- src/a.css src/b/c.css src/new.css)"

# A tracked dot path stays bound, beside an untracked one in the same directory.
t=$(repo dots-3)
tracked "$t" .gitignore .config/own
write "$t" .config/.netrc
test_check dot-tracked 0 '' '' env -C "$t" "$script" -- tooling format
test_calls dot-tracked docker "$(call "$t" -- .config/own .gitignore)"

# An untracked proposal below .github is bound through it, the single leading
# .github/ not being counted.
t=$(repo dots-4)
tracked "$t" .github/workflows/build.yml
write "$t" .github/workflows.new/build.yml
test_check dot-proposal 0 '' '' env -C "$t" "$script" -- tooling format
test_calls dot-proposal docker "$(call "$t" -- .github)"

# An untracked repository is left out whole, dot-named or not, with or without a
# commit, and the rest of its directory is still bound.
t=$(repo dots-5)
tracked "$t" src/a.css
write "$t" src/.embedded/f src/vendor/f src/new.css top/f
for nested in src/.embedded src/vendor top; do
    git -C "$t/$nested" init -q
done
git -C "$t/src/vendor" add f
git -C "$t/src/vendor" commit -q -m a
test_check dot-repository 0 '' '' env -C "$t" "$script" -- tooling format
test_calls dot-repository docker "$(call "$t" -- src/a.css src/new.css)"

# A dot-named file in an untracked directory, at any depth, leaves that
# directory's other files bound one by one.
t=$(repo dots-6)
tracked "$t" src/a.css
write "$t" newdir/.netrc newdir/kept src/newdir/.netrc src/newdir/kept
test_check dot-new-directory 0 '' '' env -C "$t" "$script" -- tooling format
test_calls dot-new-directory docker \
    "$(call "$t" -- newdir/kept src/a.css src/newdir/kept)"

# An untracked file below a tracked dot directory is left out, not only a
# dot-named one, while the tracked file beside it stays bound.
t=$(repo dots-7)
tracked "$t" .ssh/known_hosts
write "$t" .ssh/id_ed25519
test_check dot-beside-tracked 0 '' '' env -C "$t" "$script" -- tooling format
test_calls dot-beside-tracked docker "$(call "$t" -- .ssh/known_hosts)"

# A dot-named path below .github is left out, and the proposal beside it is
# bound by name.
t=$(repo dots-8)
tracked "$t" .github/workflows/build.yml
write "$t" .github/workflows.new/build.yml .github/workflows.new/.netrc \
    .github/.netrc
test_check dot-in-proposal 0 '' '' env -C "$t" "$script" -- tooling format
test_calls dot-in-proposal docker \
    "$(call "$t" -- .github/workflows .github/workflows.new/build.yml)"

# Only a single leading .github/ is not counted: a second, one further down and
# an untracked file of that name are.
t=$(repo dots-9)
tracked "$t" src/a.css
write "$t" .github/.github/f src/.github/f
test_check dot-github-once 0 '' '' env -C "$t" "$script" -- tooling format
test_calls dot-github-once docker "$(call "$t" -- src/a.css)"
t=$(repo dots-10)
tracked "$t" README.md
write "$t" .github
test_check dot-github-file 0 '' '' env -C "$t" "$script" -- tooling format
test_calls dot-github-file docker "$(call "$t" -- README.md)"

# Each name make reads is bound read-only at any depth, over a directory bound
# whole, and a name that only resembles one stays writable with its directory.
t=$(repo make-files)
tracked "$t" Makefile env.mk env/Makefile env/main.tf deep/er/GNUmakefile \
    deep/er/rules.mk low/makefile other/Makefile.bak other/mk
test_check make-files 0 '' '' env -C "$t" "$script" -- tooling format
test_calls make-files docker \
    "$(call "$t" -- Makefile:ro deep deep/er/GNUmakefile:ro deep/er/rules.mk:ro \
        env env.mk:ro env/Makefile:ro low low/makefile:ro other)"

# An untracked make file is bound as its directory is, not read-only; a tracked
# one that is deleted or a symlink, or below a symlinked directory, is left out;
# and a submodule's is not reached, even one whose path reads as a make file.
t=$(repo make-skipped)
tracked "$t" kept/Makefile gone/Makefile real/Makefile mod/own.sh
write "$t" kept/new.mk mod/sub/Makefile mod/sub.mk/f
ln -s Makefile "$t/kept/link.mk"
git -C "$t" add kept/link.mk
rm -r -- "$t/gone"
mv -- "$t/real" "$t/moved"
ln -s moved "$t/real"
for sub in mod/sub mod/sub.mk; do
    git -C "$t/$sub" init -q
    git -C "$t/$sub" add .
    git -C "$t/$sub" commit -q -m a
    git -C "$t" update-index --add --cacheinfo \
        "160000,$(git -C "$t/$sub" rev-parse HEAD),$sub"
done
test_check make-skipped 0 '' '' env -C "$t" "$script" -- tooling format
test_calls make-skipped docker \
    "$(call "$t" -- kept kept/Makefile:ro mod/own.sh moved)"

# A deleted file and a symlink, tracked or not, are left out.
t=$(repo links)
tracked "$t" kept.md gone.md
ln -s kept.md "$t/link"
git -C "$t" add link
rm -- "$t/gone.md"
ln -s kept.md "$t/untracked-link"
test_check links 0 '' '' env -C "$t" "$script" -- tooling format
test_calls links docker "$(call "$t" -- kept.md)"

if [ -n "$(ls -A -- "$TMPDIR")" ]; then
    test_fail tmpdir "TMPDIR holds: $(ls -A -- "$TMPDIR")"
fi

test_check status 3 '' '' env -C "$t" FAKE_DOCKER=3 "$script" -- tooling format
test_calls status docker "$(call "$t" -- kept.md)"

for args in '' tooling '-- tooling' '--build tooling format'; do
    read -r -a words <<<"$args"
    test_usage "usage $args" \
        'runner/format-host [RUN_OPTION...] -- SERVICE COMMAND...' \
        env -C "$t" "$script" "${words[@]}"
done

test_finish
