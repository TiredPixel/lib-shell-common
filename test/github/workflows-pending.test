#!/usr/bin/env bash
#
# Tests github/workflows-pending in scratch repositories, each a fresh
# repository with whatever .github/workflows.new/ the case gives it.
#
# Run: test/github/workflows-pending.test. Exits 1 naming each case that failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

pending=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../../github")/workflows-pending
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

# Nothing from the caller's configuration reaches the fixtures, and nothing
# above the scratch dir is taken for a repository.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_CEILING_DIRECTORIES=$work
# Fixes the order the glob lists entries in.
export LC_ALL=C

# Reports a failure of case $1 at once, each line of $2 under the program and
# the case, so a later abort cannot hide it.
fail() {
    local line
    while IFS= read -r line <&3; do
        echo "${0##*/}: $1: $line" >&2
    done 3<<<"$2"
    failures=$((failures + 1))
}

failures=0
n=0

# A fresh repository in $r, with a subdirectory sub.
fixture() {
    n=$((n + 1))
    r=$work/$n
    git init -q "$r"
    mkdir "$r/sub"
}

# Runs workflows-pending from directory $1 of $r, as path $2 with any further
# arguments, keeping its status in rc and its stdout and stderr in $r.out and
# $r.err.
run() {
    rc=0
    (cd "$r/$1" && "${@:2}") >"$r.out" 2>"$r.err" || rc=$?
}

# Records a failure of case $1 unless the run exited $2, printed nothing on
# stdout and printed $3 on stderr.
check() {
    if [ "$rc" != "$2" ]; then
        fail "$1" "exit $rc, not $2: $(<"$r.err")"
    elif [ -s "$r.out" ]; then
        fail "$1" "stdout is: $(<"$r.out")"
    elif [ "$(<"$r.err")" != "$3" ]; then
        fail "$1" "stderr is: $(<"$r.err")"
    fi
}

fixture
run . "$pending"
check absent 0 ""

fixture
mkdir -p "$r/.github/workflows.new"
run . "$pending"
check empty 0 ""

# Every entry is listed, a dot file and a directory included, and the pointer to
# workflows-approve sits beside the path workflows-pending was run as, here from
# a subdirectory.
fixture
mkdir -p "$r/.github/workflows.new/dir"
: >"$r/.github/workflows.new/build.yml"
: >"$r/.github/workflows.new/.hidden"
cp -- "$pending" "$r/sub/workflows-pending"
run sub ./workflows-pending
check pending 1 "workflows-pending: .github/workflows.new/.hidden
workflows-pending: .github/workflows.new/build.yml
workflows-pending: .github/workflows.new/dir
workflows-pending: proposals pending; approve them with ./workflows-approve"

# Any argument is a usage error, even with proposals pending.
fixture
mkdir -p "$r/.github/workflows.new"
: >"$r/.github/workflows.new/build.yml"
run . "$pending" x
check usage 2 "Usage: workflows-pending"

fixture
mkdir "$r/.github"
: >"$r/.github/workflows.new"
run . "$pending"
check not-dir 1 "workflows-pending: .github/workflows.new is not a directory"

if [ "$failures" -gt 0 ]; then
    exit 1
fi
