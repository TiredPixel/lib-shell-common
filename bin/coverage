#!/usr/bin/env bash
#
# Runs bin/test under kcov, with any test names it is given, covering only the
# repository's own scripts, not test/, whose lines say nothing of what the tests
# reach, and writes the report to tmp/coverage/, replacing the last one, since
# kcov otherwise merges into whatever is there. Runs from the root of the
# repository.
#
# kcov names a script by the path bash ran, so a script is measured only where
# its test runs it where it is, never as a copy in a scratch tree.
#
# With --tar, the report is made in a scratch directory and written to stdout
# as a tar instead, everything the run itself prints going to stderr, so it can
# leave a container that mounts nothing; the tar is written whether or not the
# tests pass, and the exit status is still theirs. --extract, on the host, reads
# such a tar from stdin and puts it in place of tmp/coverage/ only once it is
# wholly unpacked, so a run that exports nothing or is cut short leaves the last
# report.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

bin=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
out=$PWD/tmp/coverage
measured=(--include-path="$PWD" --exclude-path="$PWD/test")

usage() {
    echo "Usage: bin/coverage [--tar] [test/DIR/NAME.test...]" >&2
    echo "       bin/coverage --extract" >&2
    exit 2
}

if [ "${1-}" = --extract ]; then
    if [ $# -ne 1 ]; then
        usage
    fi
    new=$out.new
    if [ -e "$new" ]; then
        echo "bin/coverage: removing ${new:?}" >&2
        rm -rf -- "${new:?}"
    fi
    mkdir -p -- "$new"
    # index.html is the last member --tar writes, so its presence shows the
    # stream ended where it should.
    if ! tar -x --no-same-owner -f - -C "$new" ||
        ! [ -f "$new/index.html" ]; then
        echo "bin/coverage: no complete report on stdin;" \
            "tmp/coverage/ is left as it was" >&2
        echo "bin/coverage: removing ${new:?}" >&2
        rm -rf -- "${new:?}"
        exit 1
    fi
    if [ -e "$out" ]; then
        echo "bin/coverage: removing ${out:?}" >&2
        rm -rf -- "${out:?}"
    fi
    mv -- "$new" "$out"
    echo "bin/coverage: report written to tmp/coverage/index.html" >&2
    exit 0
fi

tar=
if [ "${1-}" = --tar ]; then
    tar=1
    shift
fi

# Checked here as bin/test checks them, so a bad name leaves the last report.
for t in "$@"; do
    if ! [[ $t =~ ^test/[^/]+/[^/]+\.test$ ]]; then
        printf 'bin/coverage: %q is not a test/*/*.test\n' "$t" >&2
        usage
    fi
done

if [ -n "$tar" ]; then
    report=$(mktemp -d)
    trap 'rm -rf -- "$report"' EXIT
    rc=0
    kcov "${measured[@]}" "$report" "$bin/test" "$@" >&2 || rc=$?
    cd -- "$report"
    # kcov links test to the run's own directory by its absolute path, which
    # would dangle once the report leaves the container, so each such link is
    # made relative; a link anywhere else is left as it is. failglob would end
    # the run on an empty report, before tar names the missing index.html, and
    # it takes precedence over nullglob.
    shopt -u failglob
    shopt -s nullglob
    entries=(./*)
    shopt -u nullglob
    shopt -s failglob
    for l in "${entries[@]}"; do
        if [ -L "$l" ]; then
            target=$(readlink -- "$l")
            ln -sfn -- "${target#"$report"/}" "$l"
        fi
    done
    {
        find . -mindepth 1 -maxdepth 1 ! -name index.html -print0
        printf '%s\0' ./index.html
    } | tar --null -T - -cf -
    exit "$rc"
fi

if [ -e "$out" ]; then
    echo "bin/coverage: removing ${out:?}" >&2
    rm -rf -- "${out:?}"
fi
mkdir -p -- "$out"

kcov "${measured[@]}" "$out" "$bin/test" "$@"

echo "bin/coverage: report written to tmp/coverage/index.html" >&2
