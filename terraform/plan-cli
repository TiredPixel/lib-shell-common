#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

if [ $# -ne 0 ]; then
    echo "Usage: ${0##*/}" >&2
    exit 2
fi

f_plan=.terraform.plan

# Removed first, so a run that fails leaves no earlier plan for
# terraform/deploy-cli to apply.
if [ -e $f_plan ]; then
    echo "plan-cli: $f_plan: removing an earlier plan" >&2
    rm -- $f_plan
fi

# The lock file read-only, so no provider version reaches the plan, and through
# terraform/deploy-cli the infrastructure, that nobody reviewed or committed:
# init fails where it would change .terraform.lock.hcl. A plain terraform init,
# run by hand and its lock committed, adds an entry that is missing.
terraform init -lockfile=readonly

# Saved for terraform/deploy-cli, run later in the same directory, so the change
# applied is the one this run showed rather than a fresh plan.
terraform plan -out $f_plan
