#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=docker/build-dev-latest

usage() {
    echo "Usage: $prog" >&2
    exit 2
}

[ $# -eq 0 ] || usage

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

source "$dir/init"

"$dir/build-dev-latest-nopush"

docker push "$REPO:$TAG.dev"
