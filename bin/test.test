#!/usr/bin/env bash
#
# Tests bin/test in scratch trees, with bin/lint and nproc faked. The fake
# bin/lint logs "lint" and exits with FAKE_LINT's status; the fake nproc prints
# FAKE_NPROC. Each fake test logs "start" and "end" with its name, prints its
# name, and exits with the status in its own name, as in a/fail3.test. Where
# FAKE_GATES is set, between start and end it reads a line from the FIFO there
# named after its file, so the case decides when it ends.
#
# Run: bin/test.test. Reports each case that failed on stderr, and exits 1 if
# any did.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

runner=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/test
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

mkdir "$work/path"
cat >"$work/path/nproc" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
echo "$FAKE_NPROC"
EOF
chmod +x "$work/path/nproc"

export FAKE_LOG=$work/log
export FAKE_NPROC=4
export PATH=$work/path:$PATH

# Makes a tree at $work/$1 holding bin/test, the fake bin/lint, and a fake test
# at each of the remaining paths, and prints its path.
tree() {
    local t=$work/$1 f
    shift
    mkdir -p "$t/bin"
    cp -- "$runner" "$t/bin/test"
    cat >"$t/bin/lint" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
echo lint >>"$FAKE_LOG"
exit "${FAKE_LINT:-0}"
EOF
    chmod +x "$t/bin/lint"
    for f in "$@"; do
        mkdir -p "$t/$(dirname "$f")"
        cat >"$t/$f" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
echo "start $0" >>"$FAKE_LOG"
if [ -n "${FAKE_GATES-}" ]; then
    read -r _ <"$FAKE_GATES/${0##*/}"
fi
echo "end $0" >>"$FAKE_LOG"
echo "said $0"
[[ $0 =~ fail([0-9]+) ]] && exit "${BASH_REMATCH[1]}"
exit 0
EOF
        chmod +x "$t/$f"
    done
    echo "$t"
}

failures=0

# Reports that case $1 failed with detail $2, then each line of file $3 where
# given, every line prefixed.
fail() {
    local l
    echo "${0##*/}: $1: $2" >&2
    if [ -n "${3-}" ]; then
        while IFS= read -r l <&3; do
            echo "${0##*/}: $1: $l" >&2
        done 3<"$3"
    fi
    failures=$((failures + 1))
}

# Runs bin/test with the remaining arguments in tree $2, and checks its status
# is $3, it prints nothing on stdout, and its stderr holds each line of $4 and
# nothing else but tests' headings and output. Returns 1 where a check failed,
# so the caller checks the log only after a run as expected.
check() {
    local name=$1 t=$2 status=$3 said=$4 rc=0 line summary
    shift 4
    : >"$FAKE_LOG"
    (cd "$t" && bin/test "$@") >"$work/out" 2>"$work/err" || rc=$?
    if [ "$rc" != "$status" ]; then
        fail "$name" "exit $rc, not $status" "$work/err"
        return 1
    fi
    if [ -s "$work/out" ]; then
        fail "$name" "stdout is not empty" "$work/out"
        return 1
    fi
    while IFS= read -r line <&3; do
        if [ -n "$line" ] && ! grep -qxF -- "$line" "$work/err"; then
            fail "$name" "stderr lacks '$line'" "$work/err"
            return 1
        fi
    done 3<<<"$said"
    summary='^bin/test: .* (failed|passed)$'
    # grep -c prints 0 and exits 1 on no match.
    if [ "$(grep -cE "$summary" "$work/err" || :)" != \
        "$(grep -cE "$summary" <<<"$said" || :)" ]; then
        fail "$name" "stderr has other summary lines" "$work/err"
        return 1
    fi
    # Beyond those, only a test's heading and its output, and no blank line.
    while IFS= read -r line <&3; do
        if [[ $line =~ ^bin/test:\ [^/\ ]+/[^/\ ]+\.test$ ||
            $line =~ ^said\ \./[^/\ ]+/[^/\ ]+\.test$ ]]; then
            continue
        fi
        if [ -z "$line" ] || ! grep -qxF -- "$line" <<<"$said"; then
            fail "$name" "stderr has '$line'" "$work/err"
            return 1
        fi
    done 3< <(cat -- "$work/err")
}

# Checks, for case $1, that bin/test's stderr shows the line $3 directly after
# the line $2.
follows() {
    if [ "$(grep -A 1 -xF -- "$2" "$work/err" | tail -n 1)" != "$3" ]; then
        fail "$1" "'$3' does not follow '$2'" "$work/err"
    fi
}

# Checks the log of case $1 is $2.
logged() {
    if [ "$(<"$FAKE_LOG")" != "$2" ]; then
        fail "$1" "the log is:" "$FAKE_LOG"
    fi
}

# Checks the log of case $1 is the lint, then each test in the rest starting and
# ending, in any order, since they run in parallel.
linted_then_ran() {
    local name=$1 first rest
    shift
    first=$(head -n 1 -- "$FAKE_LOG")
    rest=$(tail -n +2 -- "$FAKE_LOG" | sort)
    if [ "$first" != lint ] || [ "$rest" != "$(ran "$@")" ]; then
        fail "$name" "the log is:" "$FAKE_LOG"
    fi
}

# Checks the log of case $1 is each test in the rest starting and ending, in any
# order, with no lint.
ran_only() {
    local name=$1
    shift
    if [ "$(sort -- "$FAKE_LOG")" != "$(ran "$@")" ]; then
        fail "$name" "the log is:" "$FAKE_LOG"
    fi
}

# Each test in $@ starting and ending, sorted.
ran() {
    local f
    for f in "$@"; do
        echo "end ./$f"
        echo "start ./$f"
    done | sort
}

t=$(tree all-pass a/one.test b/two.test)
if check all-pass "$t" 0 "said ./a/one.test"$'\n'"said ./b/two.test"$'\n'"bin/test: 2 tests passed"; then
    follows all-pass "bin/test: a/one.test" "said ./a/one.test"
    follows all-pass "bin/test: b/two.test" "said ./b/two.test"
    linted_then_ran all-pass a/one.test b/two.test
fi

if FAKE_LINT=5 check lint-fails "$t" 5 ""; then
    logged lint-fails lint
fi

if check named "$t" 0 "said ./b/two.test"$'\n'"bin/test: 1 test passed" b/two.test; then
    ran_only named b/two.test
fi

for args in a/one one.test a/b/c.test ./a/one.test "a/one.test b/two"; do
    read -r -a names <<<"$args"
    bad=${names[-1]}
    if check "refused $args" "$t" 2 "bin/test: $bad is not a */*.test"$'\n'"Usage: bin/test [DIR/NAME.test...]" \
        "${names[@]}"; then
        logged "refused $args" ""
    fi
done

t=$(tree one-fails a/one.test b/fail3.test c/three.test)
if check one-fails "$t" 1 "said ./a/one.test"$'\n'"said ./b/fail3.test"$'\n'"said ./c/three.test"$'\n'"bin/test: b/fail3.test failed"; then
    follows one-fails "bin/test: b/fail3.test" "said ./b/fail3.test"
    linted_then_ran one-fails a/one.test b/fail3.test c/three.test
fi

if check named-fails "$t" 1 "said ./b/fail3.test"$'\n'"bin/test: b/fail3.test failed" \
    b/fail3.test; then
    ran_only named-fails b/fail3.test
fi

t=$(tree two-fail a/fail2.test b/one.test c/fail4.test)
if check two-fail "$t" 1 "bin/test: a/fail2.test failed"$'\n'"bin/test: c/fail4.test failed"; then
    linted_then_ran two-fail a/fail2.test b/one.test c/fail4.test
fi

# A file not at */*.test is not a test.
t=$(tree no-tests a/one.tests a/b/c.test)
if check no-tests "$t" 1 "bin/test: no */*.test found"; then
    logged no-tests ""
fi

# The gated cases hold each test until released, so once bin/test has started
# some and the kernel shows it blocked waiting for a child, it has started every
# test it will before one ends, and its children are exactly those, whatever the
# timing. Each gate is held open read-write on the fd gate_fd names, so a
# release is buffered for a test not yet started rather than blocking.
declare -A gate_fd=([one.test]=4 [two.test]=5 [three.test]=6)

# Runs bin/test in the background in tree $2, with nproc faked as $3 and its
# tests held at gates in $work/gates-$1, and sets pid.
gated() {
    local gates=$work/gates-$1 f
    mkdir "$gates"
    for f in "${!gate_fd[@]}"; do
        mkfifo "$gates/$f"
    done
    exec 4<>"$gates/one.test" 5<>"$gates/two.test" 6<>"$gates/three.test"
    : >"$FAKE_LOG"
    (cd "$2" && FAKE_NPROC=$3 FAKE_GATES=$gates exec bin/test 4>&- 5>&- 6>&-) \
        >"$work/out" 2>"$work/err" &
    pid=$!
}

# Waits until $2 tests have started and bin/test is blocked waiting for a child,
# or else records that case $1 never got there and returns 1. Bounded so a
# bin/test that never settles fails the case rather than hanging; the sleep only
# paces the polling, and no result depends on it.
settled() {
    local _
    for _ in {1..3000}; do
        if [ "$(grep -c '^start ' "$FAKE_LOG" || :)" -ge "$2" ] &&
            [ -r "/proc/$pid/wchan" ] &&
            [ "$(<"/proc/$pid/wchan")" = do_wait ]; then
            return 0
        fi
        sleep 0.01
    done
    fail "$1" "never waited with $2 test(s) started:" "$FAKE_LOG"
    return 1
}

# Checks, for case $1, that bin/test has $2 children. Counted from the parent
# field of each process's /proc/<pid>/stat, which every Linux kernel provides,
# where /proc/<pid>/task/<pid>/children needs CONFIG_PROC_CHILDREN. The fields
# after the last ) are state, then parent. A process that exits mid-scan is
# skipped.
children() {
    local n=0 stat line fields
    for stat in /proc/[0-9]*/stat; do
        read -r line 2>/dev/null <"$stat" || continue
        read -r -a fields <<<"${line##*) }"
        if [ "${fields[1]}" = "$pid" ]; then
            n=$((n + 1))
        fi
    done
    if [ "$n" -ne "$2" ]; then
        fail "$1" "$n tests ran at once, not $2"
    fi
}

# Releases every gate, waits for bin/test and closes the gates. Returns 1,
# recording case $1's failure, unless bin/test passed all three tests.
ungated() {
    local rc=0
    echo >&4
    echo >&5
    echo >&6
    wait "$pid" || rc=$?
    exec 4>&- 5>&- 6>&-
    if [ "$rc" -ne 0 ] || ! grep -qxF "bin/test: 3 tests passed" "$work/err"; then
        fail "$1" "exit $rc:" "$work/err"
        return 1
    fi
}

# One at a time, each test ends before the next starts, in glob order: at each
# point, the test started last is bin/test's only child.
t=$(tree serial b/two.test a/one.test c/three.test)
gated serial "$t" 1
n=0
for f in a/one.test b/two.test c/three.test; do
    n=$((n + 1))
    settled serial "$n" || break
    last=$(grep '^start ' "$FAKE_LOG" | tail -n 1)
    if [ "$last" != "start ./$f" ]; then
        fail serial "$f did not start next:" "$FAKE_LOG"
        break
    fi
    children serial 1
    echo >&"${gate_fd[${f##*/}]}"
done
if ungated serial; then
    logged serial "lint"$'\n'"$(printf 'start ./%s\nend ./%s\n' \
        a/one.test a/one.test b/two.test b/two.test c/three.test c/three.test)"
fi

# Two at a time, no third test starts before one ends.
t=$(tree capped a/one.test b/two.test c/three.test)
gated capped "$t" 2
if settled capped 2; then
    children capped 2
fi
if ungated capped; then
    linted_then_ran capped a/one.test b/two.test c/three.test
fi

if [ "$failures" -gt 0 ]; then
    exit 1
fi
