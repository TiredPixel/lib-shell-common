#!/usr/bin/env bash
#
# terraform is faked on PATH, so nothing is formatted. The fake logs each call's
# arguments and fails where its first argument is FAKE_FAIL.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

script=$root/terraform/format

cp -p -- "$root/test/fixtures/terraform/format/terraform" "$test_tmp/path/"
export FAKE_LOG=$test_tmp/terraform.calls
: >"$FAKE_LOG"
mkdir -- "$test_tmp/project"
cd -- "$test_tmp/project"

test_check formats 0 '' '' "$script"
test_calls formats terraform 'fmt -recursive'

test_check fmt-fails 1 '' 'fake terraform: fmt failed' env FAKE_FAIL=fmt "$script"
test_calls fmt-fails terraform 'fmt -recursive'

# Any argument is a usage error, refused before terraform runs.
test_usage argument terraform/format "$script" x

test_finish
