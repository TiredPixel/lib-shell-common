#!/usr/bin/env bash
#
# Refuses a release taken from a repository that is in no state to release from,
# and reports the submodules the release will not tag.
#
# It runs before the sweep rather than beside the commit, so a refusal costs
# nothing: no branch has been switched, nothing fetched, no tag signed. That
# placement is also what makes project/release-commit-submodules sound -- the
# sweep only ever leaves submodule pointers differing from HEAD here, so a tree
# carrying nothing else now is still carrying nothing else when the commit
# comes.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

if [ $# -ne 0 ]; then
    echo "Usage: ${0##*/}" >&2
    exit 2
fi

# lastpipe so the loop below runs in this shell and keeps what it reads, and so
# pipefail sees git's status. A process substitution hides it entirely:
# `mapfile -d "" -t x < <(false)` succeeds, leaving an empty array that reads as
# "no submodules".
#
# lastpipe needs job control off, and a script reached through its shebang
# always has it off: the setting is not inherited across the exec, so a caller
# running with job control on cannot pass it in. Only a `set -m` here would take
# it back, and it would do so silently -- the loop would run in a subshell and
# the array arrive empty.
shopt -s lastpipe

prog=${0##*/}
f_projects=.projects

top=$(git rev-parse --show-toplevel)

# .projects is read from the current directory and only the submodules under it
# are checked, so below the top level the checks would cover only part of the
# repository and every submodule would read as missing from .projects, yet the
# release commit records pointers across the whole repository.
if [[ ! $PWD -ef $top ]]; then
    echo "$prog: $PWD: refusing to release from below the top level" >&2
    echo "$prog: run it from $top" >&2

    exit 1
fi

# --ignore-submodules=all hides every submodule change, so whatever is left is
# by definition work outside them, and no path list is needed to say so.
# gitmodules(5) states that --ignore-submodules on the command line overrides
# submodule.<name>.ignore in .gitmodules and in .git/config, so a consumer
# cannot configure this away. --untracked-files=normal because
# status.showUntrackedFiles=no would otherwise hide exactly the build output
# this exists to catch; ignored files stay hidden, which is what .gitignore is
# for.
dirty=$(git status --porcelain --ignore-submodules=all --untracked-files=normal)

# git's own lines pass through unaltered between the program's.
if [ -n "$dirty" ]; then
    echo "$prog: $PWD: refusing to release, the tree carries work outside" \
        "its submodules:" >&2
    printf '%s\n' "$dirty" >&2
    echo "$prog: a release commit records submodule pointers and nothing else," \
        "so commit or discard these first" >&2
    echo "$prog: docker/upgrade is one way to arrive here: its digest re-pin" \
        "of Dockerfile is a tracked change like any other" >&2

    exit 1
fi

# git status reports none of these. During a merge, a cherry-pick or a rebase
# stopped on a conflicting pick, git commit --only refuses to run, failing after
# the sweep as `fatal: cannot do a partial commit during a merge` (or
# `a cherry-pick`, `a rebase`); during a revert, an am or any other rebase stop
# it runs, and the release commit lands inside that operation. Either way it is
# caught here, saying what it is about.
git_dir=$(git rev-parse --git-dir)

for f in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
    if [ -e "$git_dir/$f" ]; then
        echo "$prog: $PWD: $f: an operation is in progress," \
            "so this is no state to release from" >&2

        exit 1
    fi
done

# The submodules this release will not tag. .projects is a curated list -- see
# project/each-without-project -- so an omission is usually deliberate, and this
# reports rather than refuses. It is the only place the other kind of omission
# shows: a submodule that does belong, added without a line, is otherwise never
# checked out, never moved to a release branch and never tagged, and the
# release reports success without it.
modules=()

git ls-files -z --stage |
    while IFS= read -r -d '' entry; do
        [[ $entry == '160000 '* ]] || continue

        modules+=("${entry#*$'\t'}")
    done

for module in "${modules[@]}"; do
    # A submodule git cannot resolve is invisible rather than loud: git tests
    # the gitlink by reading the repository the directory holds, and where there
    # is none it answers unchanged. So a directory carrying content but no
    # repository of its own -- a deinit that left files, a broken vendoring, a
    # checkout interrupted -- makes the pointer read as unchanged, and the
    # release records the commit it already held while the tree carries
    # something else. Nothing raises anywhere.
    #
    # An empty directory is the other case and is left alone: it is a submodule
    # nobody initialised, so its pointer cannot move, and for a submodule
    # .projects does not name, that is the normal state.
    if [ ! -d "$module" ]; then
        echo "$prog: $PWD: $module: not checked out," \
            "so a release cannot record it" >&2

        exit 1
    fi

    [ -n "$(find "$module" -mindepth 1 -maxdepth 1 -print -quit)" ] || continue

    # Repository discovery walks up, so this answers with the containing
    # repository for a directory that is not one of its own. -ef is an inode
    # test, so ./ and a symlink compare equal.
    module_top=$(git -C "$module" rev-parse --show-toplevel 2>/dev/null) ||
        module_top=

    if [[ ! $module_top -ef $module ]]; then
        echo "$prog: $PWD: $module: has content but is not a repository" \
            "of its own" >&2
        echo "$prog: git reads its pointer as unchanged, so a release would" \
            "record the commit already held rather than what is in the tree" >&2

        exit 1
    fi
done

if [ -f "$f_projects" ]; then
    listed=$(cat "$f_projects")
else
    listed=
fi

unlisted=()

for module in "${modules[@]}"; do
    # -F and -x because a path is a literal, not a pattern, and because lib/a is
    # not lib/ab -- the distinction project/tag-create draws for a tag.
    grep -qFx -- "$module" <<<"$listed" || unlisted+=("$module")
done

if [ "${#unlisted[@]}" -gt 0 ]; then
    echo "$prog: $PWD: not named in $f_projects," \
        "so this release will not tag:" >&2
    printf '%s\n' "${unlisted[@]/#/$prog: }" >&2
fi
