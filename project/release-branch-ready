#!/usr/bin/env bash
#
# Readies branch $1 in every project to release what the tree holds, and pulls
# nothing in: a commit origin holds that the tree lacks was never built or
# tested here, and bringing one in is an upgrade's work. Each listed project
# moves $1 to its HEAD, the commit built, which the release tags; this project
# checks out $1, leaving its submodules where they are, for its caller to take
# to commit $2: by default $1 itself, which the release commits onto, and for a
# promotion the tag it moves to, so a local $1 merely behind its origin's is
# taken there too. Every project is checked before any moves, so a refusal
# leaves each where it was.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
prog=${0##*/}

# An empty argument is refused too, since it would name no branch or commit;
# ${2-x} is empty only where $2 is given empty.
if [ $# -lt 1 ] || [ $# -gt 2 ] || [ -z "$1" ] || [ -z "${2-x}" ]; then
    echo "Usage: $prog BRANCH [COMMIT]" >&2
    exit 2
fi
branch=$1
target=${2:-refs/heads/$branch}

# Assigned on its own, so that errexit sees git fail outside a repository.
toplevel=$(git rev-parse --show-toplevel)
cd "$toplevel"

# Fetches origin's branch $1 and refuses unless commit $2 already holds it and
# the local branch $1, where there is one. $2 missing, as for a branch this
# project has yet to check out, stands for origin's. --is-ancestor answers 1 for
# "no" and any other non-zero for an error, so the status is read rather than
# tested. The string is for sh, which runs it in each project with this
# program's name as $0.
# shellcheck disable=SC2016
check='
    set -eu
    branch=$1 rev=$2
    origin=refs/remotes/origin/$branch
    git fetch -q --no-recurse-submodules origin "+refs/heads/$branch:$origin"
    git rev-parse -q --verify "$rev^{commit}" >/dev/null || rev=$origin
    for ref in "$origin" "refs/heads/$branch"; do
        git rev-parse -q --verify "$ref^{commit}" >/dev/null || continue
        rc=0
        git merge-base --is-ancestor "$ref" "$rev" || rc=$?
        case $rc in
        0) ;;
        1)
            echo "$0: $PWD: $ref has commits $rev lacks, and a release" \
                "pulls nothing in; upgrade to take them" >&2
            exit 1
            ;;
        *) exit "$rc" ;;
        esac
    done'

"$dir/each-without-project" sh -c "$check" "$prog" "$branch" HEAD
sh -c "$check" "$prog" "$branch" "$target"

# -B with no start point moves the branch to HEAD and keeps the working tree;
# the check above has made that a fast-forward.
"$dir/each-without-project" git checkout --no-recurse-submodules -B "$branch"
git checkout "$branch" --no-recurse-submodules
