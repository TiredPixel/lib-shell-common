#!/usr/bin/env bash
#
# docker and git are faked on PATH, so nothing is built, pushed or read from a
# repository. The fake docker logs each call's arguments and exits with
# FAKE_BUILD's status from a build and FAKE_PUSH's from a push. The fake git
# puts HEAD on branch a/b, or detached at commit 1a2b3c4 where FAKE_BRANCH is
# HEAD, and describes it as FAKE_DESCRIBE, failing as an untagged repository
# does where that is empty, or as a broken one does where it is "broken"; it
# gives FAKE_ORIGIN as the origin remote's URL.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

dir=$root/docker
fixtures=$root/test/fixtures/docker/build-dev

mkdir -- "$test_tmp/project"
cp -p -- "$fixtures/docker" "$fixtures/git" "$test_tmp/path/"
echo r/x >"$test_tmp/project/.dockerrepo"

export FAKE_LOG=$test_tmp/docker.calls
: >"$FAKE_LOG"
export FAKE_DESCRIBE=v1.2-3-gabcdef0
export FAKE_ORIGIN=https://github.com/o/r.git
# A CI running these tests names its own branch or tag in them, which would name
# the detached cases' images.
unset CIRCLE_BRANCH CIRCLE_TAG GITHUB_HEAD_REF GITHUB_REF_NAME
cd "$test_tmp/project"

# Runs docker/$2 with the arguments after $6 and checks its status is $3, docker
# was called as $4 has it, a line to a call, and its stdout is $5 and its stderr
# $6.
check() {
    local calls=$4
    test_check "$1" "$3" "$5" "$6" "$dir/$2" "${@:7}"
    test_calls "$1" docker ${calls:+"$calls"}
}

# The build docker is called for, from the cache tags $1, stamped $2 and
# sourced from FAKE_ORIGIN as docker/image-source gives it.
build() {
    echo "build --target dev $1 --build-arg BUILDKIT_INLINE_CACHE=1" \
        "--build-arg GIT_DESCRIBE=$2" \
        "--build-arg IMAGE_SOURCE=https://github.com/o/r -t r/x:a-b.dev ."
}

push="push r/x:a-b.dev"
pushed="fake docker: pushed r/x:a-b.dev"
broken="fatal: bad object HEAD"$'\n'

for model in latest stable; do
    caches="--cache-from r/x:a-b.dev --cache-from r/x:latest.dev"
    if [ "$model" = stable ]; then
        caches+=" --cache-from r/x:testing.dev --cache-from r/x:stable.dev"
    fi
    built=$(build "$caches" "$FAKE_DESCRIBE")
    unstamped=$(build "$caches" "")

    check "$model-nopush" "build-dev-$model-nopush" 0 "$built" \
        "fake docker: built" "fake docker: building"

    FAKE_BUILD=3 check "$model-nopush-build-fails" "build-dev-$model-nopush" \
        3 "$built" "fake docker: built" "fake docker: building"

    # Stamped with nothing, and git's fatal: kept off the console.
    FAKE_DESCRIBE='' check "$model-nopush-untagged" "build-dev-$model-nopush" \
        0 "$unstamped" "fake docker: built" "fake docker: building"

    # Any other failure of git's stops the build before docker is called.
    for script in "build-dev-$model-nopush" "build-dev-$model"; do
        FAKE_DESCRIBE=broken check "$script-describe-fails" "$script" 1 "" "" \
            "${broken}docker/build-dev-$model-nopush: git describe failed"
    done

    check "$model" "build-dev-$model" 0 "$built"$'\n'"$push" \
        "fake docker: built"$'\n'"$pushed" "fake docker: building"

    FAKE_BUILD=3 check "$model-build-fails" "build-dev-$model" 3 "$built" \
        "fake docker: built" "fake docker: building"

    FAKE_PUSH=4 check "$model-push-fails" "build-dev-$model" 4 \
        "$built"$'\n'"$push" "fake docker: built"$'\n'"$pushed" \
        "fake docker: building"

    # On a detached HEAD outside CI, the build that pushes nothing is named by
    # the commit.
    FAKE_BRANCH=HEAD check "$model-nopush-detached" "build-dev-$model-nopush" \
        0 "${built//a-b.dev/1a2b3c4.dev}" "fake docker: built" \
        "fake docker: building"

    # Any argument is a usage error, refused before docker is called.
    for script in "build-dev-$model-nopush" "build-dev-$model"; do
        test_usage "$script-argument" "docker/$script" "$dir/$script" --help
    done
done

test_finish
