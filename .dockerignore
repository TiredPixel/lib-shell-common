# Docker reads no global excludes, so every top-level dot path is kept out and
# the project's own are let back in by name; **/.git also reaches a nested
# repository's .git, which /.* does not. A Compose override holds a checkout's
# settings, not the tree's.
/.*
**/.git
/docker-compose.*.yml
/tmp/

!/.env.example
!/.github
!/.hadolint.yaml
!/.mdformat.toml
!/.shellcheckrc
!/.yamllint.yaml
