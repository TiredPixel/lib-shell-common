#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=docker/build-prd-latest

usage() {
    echo "Usage: $prog" >&2
    exit 2
}

[ $# -eq 0 ] || usage

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

source "$dir/init"
source "$dir/describe"
source "$dir/image-source"
source "$dir/build-image"

build_image prd "$REPO:$TAG.prd" \
    "$REPO:$TAG.dev" \
    "$REPO:$TAG.prd" \
    "$REPO:latest.dev" \
    "$REPO:latest.prd"

docker push "$REPO:$TAG.prd"
