#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

if [ $# -ne 0 ]; then
    echo "Usage: ${0##*/}" >&2
    exit 2
fi

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

# Nothing is pushed, so a detached HEAD outside CI is named by its commit.
init_detached=commit source "$dir/init"
source "$dir/describe"

docker build \
    --target dev \
    --cache-from "$REPO:$TAG.dev" \
    --cache-from "$REPO:latest.dev" \
    --cache-from "$REPO:testing.dev" \
    --cache-from "$REPO:stable.dev" \
    --build-arg BUILDKIT_INLINE_CACHE=1 \
    --build-arg GIT_DESCRIBE="$describe" \
    -t "$REPO:$TAG.dev" .
