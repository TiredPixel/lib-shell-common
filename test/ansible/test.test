#!/usr/bin/env bash
#
# ansible-lint is faked on PATH, so nothing is linted. The fake logs each call's
# arguments and, where FAKE_FAIL is set, fails with that status.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

script=$root/ansible/test

cp -p -- "$root/test/fixtures/ansible/test/ansible-lint" "$test_tmp/path/"
export FAKE_LOG=$test_tmp/ansible-lint.calls
: >"$FAKE_LOG"
mkdir -- "$test_tmp/project"
cd -- "$test_tmp/project"

# The options ansible/format shares, as the fake logs them.
# shellcheck source=ansible/lint-args
source "$root/ansible/lint-args"
lint=$(printf '%q ' "${ansible_lint_args[@]}")
lint=${lint% }

# Checks with the shared options and fixes nothing.
test_check lints 0 '' '' "$script"
test_calls lints ansible-lint "$lint --"

# ansible-lint's own status is the run's.
test_check lint-fails 2 '' 'fake ansible-lint: failed' env FAKE_FAIL=2 "$script"
test_calls lint-fails ansible-lint "$lint --"

test_finish
