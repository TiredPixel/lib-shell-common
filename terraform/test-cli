#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

f_plan=.terraform.plan

# This script saves no plan, so one found here came from an earlier run and is
# removed before terraform/deploy-cli can apply it.
if [ -e $f_plan ]; then
    echo "test-cli: $f_plan: removing an earlier plan" >&2
    rm -- $f_plan
fi

# -diff, so a failure shows what would change rather than only naming the file.
terraform fmt -recursive -check -diff

# No backend, so the checks read no state and need no credentials for it. The
# lock file read-only, so a check never writes it: init fails where it would
# change .terraform.lock.hcl, and only terraform/upgrade moves a provider.
terraform init -backend=false -input=false -lockfile=readonly
terraform validate
terraform test
