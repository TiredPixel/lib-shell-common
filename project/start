#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")

# Two questions, cheapest first: is this a compose project, and has it
# anything to bring up. They cannot be folded into one -- compose resolves a
# project from any directory inside it, so dropping the file test would let a
# project carrying none adopt an ancestor's. The second catches services that
# all sit behind a profile, which selects nothing and which compose calls an
# error rather than nothing to do.
#
# --wait, so a service that dies on start or never turns healthy fails the
# project it belongs to. The daemon-wide health poll this replaced filtered on
# health status, which an exited container does not have, so a crash on start
# passed; and it stalled on an unhealthy container from an unrelated project.
# A one-shot service exiting 0 fails --wait too, unless it is a
# service_completed_successfully dependency of a service that stays up.
# Override the bound with DC_WAIT_TIMEOUT.
# shellcheck disable=SC2016
"$dir/each" sh -c '
    test ! -f docker-compose.yml ||
        test -z "$(docker compose config --services)" ||
        docker compose up -d --pull always --wait --wait-timeout "${DC_WAIT_TIMEOUT:-300}"'

docker ps
