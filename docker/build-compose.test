#!/usr/bin/env bash
#
# Tests docker/build-compose in a scratch directory with docker and git faked on
# PATH, so nothing is built or read from a repository. The fake docker logs each
# call's arguments, a line to a call, and exits with FAKE_BUILD's status. The
# fake git describes HEAD as FAKE_DESCRIBE, failing as an untagged repository
# does where that is empty, or as a broken one does where it is "broken".
#
# Run: docker/build-compose.test. Exits 1 naming each case that failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

mkdir "$work/bin" "$work/project"
cat >"$work/bin/docker" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
args=$(printf '%q ' "$@")
echo "${args% }" >>"$FAKE_LOG"
[ "$1" = compose ] || exit 2
echo "fake docker: building" >&2
echo "fake docker: built"
exit "${FAKE_BUILD:-0}"
EOF
cat >"$work/bin/git" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
[ "$*" = describe ] || exit 2
case ${FAKE_DESCRIBE:-} in
"")
    echo "fatal: No names found, cannot describe anything." >&2
    exit 128
    ;;
broken)
    echo "fatal: bad object HEAD" >&2
    exit 128
    ;;
*) echo "$FAKE_DESCRIBE" ;;
esac
EOF
chmod +x "$work/bin/docker" "$work/bin/git"

export FAKE_LOG=$work/log
export FAKE_DESCRIBE=v1.2-3-gabcdef0
export PATH=$work/bin:$PATH
cd "$work/project"

failed=()

# Runs docker/build-compose with the arguments after $5 and checks its status
# is $2, docker was called as $3 has it, and its stdout and stderr are $4 and
# $5.
check() {
    local name=$1 status=$2 calls=$3 out=$4 err=$5 rc=0
    shift 5
    : >"$FAKE_LOG"
    "$dir/build-compose" "$@" >"$work/out" 2>"$work/err" || rc=$?
    if [ "$rc" != "$status" ]; then
        failed+=("$name: exit $rc, not $status: $(<"$work/err")")
    elif [ "$(<"$FAKE_LOG")" != "$calls" ]; then
        failed+=("$name: docker was called as: $(<"$FAKE_LOG")")
    elif [ "$(<"$work/out")" != "$out" ]; then
        failed+=("$name: stdout is: $(<"$work/out")")
    elif [ "$(<"$work/err")" != "$err" ]; then
        failed+=("$name: stderr is: $(<"$work/err")")
    fi
}

built="fake docker: built"
building="fake docker: building"

check built 0 "compose build --build-arg GIT_DESCRIBE=$FAKE_DESCRIBE" \
    "$built" "$building"

# Its arguments go to docker compose, ahead of build.
check arguments 0 \
    "compose -f a\\ b.yml build --build-arg GIT_DESCRIBE=$FAKE_DESCRIBE" \
    "$built" "$building" -f "a b.yml"

# Stamped with nothing, and git's fatal: kept off the console.
FAKE_DESCRIBE='' check untagged 0 "compose build --build-arg GIT_DESCRIBE=" \
    "$built" "$building"

# Any other failure of git's stops the build before docker is called.
FAKE_DESCRIBE=broken check describe-fails 1 "" "" \
    "fatal: bad object HEAD"$'\n'"build-compose: git describe failed"

FAKE_BUILD=3 check build-fails 3 \
    "compose build --build-arg GIT_DESCRIBE=$FAKE_DESCRIBE" "$built" "$building"

# Every line of a failure carries the program and the case, captured output
# included.
if [ ${#failed[@]} -gt 0 ]; then
    for f in "${failed[@]}"; do
        failed_case=${f%%: *}
        while IFS= read -r failed_line <&3; do
            echo "${0##*/}: $failed_case: $failed_line" >&2
        done 3<<<"${f#"$failed_case: "}"
    done
    exit 1
fi
