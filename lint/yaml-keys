#!/usr/bin/env bash
#
# Check every YAML path given on stdin, NUL-separated, against what
# `yq -P 'sort_keys(..)'` would write, with --keep-order `yq -P .`, or after --
# yq with the arguments given, as the caller's formatter runs it, and report the
# ones that differ, each as a unified diff on stdout from the file to that form.
# Reports and never rewrites: this is the read-only half of a formatting pass,
# and the writing half is the caller's. Both should take the same path set, or
# one will rewrite a file the other never checks.
#
# Every offender is named rather than only the first, since one formatting run
# fixes them all either way -- stopping at the first only costs the reader a
# second run to find the second. A file yq cannot read is named apart from one
# whose keys are out of order, since rewriting it would not help.
#
# Requires yq (mikefarah), whose sort_keys expression the Python jq wrapper of
# the same name does not implement.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=lint/yaml-keys

usage() {
    echo "Usage: $prog [--keep-order | -- YQ_ARG...] < PATHS" >&2
    exit 2
}

args=(-P 'sort_keys(..)')
form=sorted
what='keys not sorted'
case ${1-} in
--keep-order)
    args=(-P .)
    form='laid out'
    what='not laid out'
    shift
    ;;
--)
    shift
    [ $# -gt 0 ] || usage
    # Reported as sorted only where these are the default's arguments.
    if [ "$*" != "${args[*]}" ]; then
        form=formatted
        what='not as formatted'
    fi
    args=("$@")
    set --
    ;;
esac
[ $# -eq 0 ] || usage

unsorted=0
unreadable=0
checked=0

sorted=$(mktemp)
trap 'rm -f -- "$sorted"' EXIT

# The path list is read from fd 3 and stdin is /dev/null, so nothing run inside
# the loop can consume the paths still to come. A last path with no NUL after
# it is still checked, rather than dropped in silence.
while IFS= read -r -d '' f <&3 || [ -n "$f" ]; do
    checked=$((checked + 1))

    # Written to a file rather than piped into diff, so yq's own status is seen
    # and a file it cannot parse is not reported as merely unsorted.
    if ! yq "${args[@]}" "$f" >"$sorted"; then
        echo "$prog: $f: yq could not read it, so its keys were not checked" >&2
        unreadable=1
        continue
    fi

    # diff exits 1 on a difference and above that on trouble, which is fatal.
    rc=0
    diff -u --label "$f" --label "$f ($form)" -- "$f" "$sorted" || rc=$?
    case $rc in
    0) ;;
    1)
        echo "$prog: $f: $what" >&2
        unsorted=1
        ;;
    *) exit "$rc" ;;
    esac
done 3<&0 </dev/null

# Reported rather than fatal: an empty set is a project with no YAML as easily
# as a caller whose own path list came out wrong, and only the caller can tell
# those apart. Saying how many were checked is what stops nothing-was-checked
# reading like everything-passed.
echo "$prog: checked $checked file(s)" >&2

if [ "$unsorted" -ne 0 ]; then
    hint=()
    for arg in "${args[@]}"; do
        case $arg in
        -*) hint+=("$arg") ;;
        *) hint+=("'$arg'") ;;
        esac
    done
    echo "$prog: rewrite with yq -i ${hint[*]}" >&2
fi

if [ "$unsorted" -ne 0 ] || [ "$unreadable" -ne 0 ]; then
    exit 1
fi
