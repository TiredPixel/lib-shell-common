#!/usr/bin/env bash
#
# Fakes the gh api calls github/review-gate makes on repository o/p. Logs each
# call's arguments, shell-quoted, to FAKE_LOG, a GraphQL query logged as
# query=...; answers each read from the file of its name in FAKE_DIR, failing
# where the file is missing, pull request NUMBER's from pull-NUMBER where there
# is one, else from pull; and logs each write to FAKE_WRITES, as POST or PATCH
# ID then the body read on stdin with its keys sorted. Fails with status 3, as a
# broken request would but with a status of its own, on the call whose logged
# line FAKE_FAIL holds whole.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

args=()
for arg in "$@"; do
    case $arg in
    query=*) args+=("query=...") ;;
    *) args+=("$arg") ;;
    esac
done
line=$(printf '%q ' "${args[@]}")
line=${line% }
echo "$line" >>"$FAKE_LOG"
if [ "$line" = "${FAKE_FAIL-}" ]; then
    echo "gh: fake failure" >&2
    exit 3
fi

# An answer of 404 alone stands for that HTTP status, which gh reports as below,
# printing the body GitHub sends, and exits 1.
answer() {
    if [ "$(<"$FAKE_DIR/$1")" = 404 ]; then
        echo '{"message": "Not Found", "status": "404"}'
        echo "gh: Not Found (HTTP 404)" >&2
        exit 1
    fi
    cat -- "$FAKE_DIR/$1"
}

case $* in
"api --paginate repos/o/p/pulls/"*"/commits?per_page=100") answer commits ;;
"api --paginate repos/o/p/pulls/"*"/reviews?per_page=100") answer reviews ;;
"api --paginate repos/o/p/pulls?state=open&per_page=100") answer open ;;
"api repos/o/p/pulls/"*)
    if [ -e "$FAKE_DIR/pull-${2##*/}" ]; then
        answer "pull-${2##*/}"
    else
        answer pull
    fi
    ;;
"api --paginate repos/o/p/rules/branches/"*) answer rules ;;
"api graphql --paginate -f owner=o -f name=p -F number="*" -f query="*)
    answer comments
    ;;
"api graphql -f owner=o -f name=p -F number="*" -f query="*) answer bases ;;
"api graphql --paginate -f id="*" -f query="*) answer edits ;;
"api --paginate repos/o/p/commits/"*"/check-runs?check_name="*) answer runs ;;
"api -X POST repos/o/p/check-runs --input -")
    echo "POST $(jq -cS .)" >>"$FAKE_WRITES"
    echo '{"id": 900}'
    ;;
"api -X PATCH repos/o/p/check-runs/"*" --input -")
    id=${4##*/}
    echo "PATCH $id $(jq -cS .)" >>"$FAKE_WRITES"
    echo "{\"id\": $id}"
    ;;
*)
    echo "gh: unexpected call: $line" >&2
    exit 1
    ;;
esac
