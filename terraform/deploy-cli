#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

f_plan=.terraform.plan

if ! [ -e $f_plan ]; then
    echo "deploy-cli: $f_plan: no saved plan; run terraform/plan-cli first" >&2
    exit 1
fi

# The plan terraform/plan-cli saved, so only the change it showed is applied;
# Terraform refuses a saved plan once the state has moved on since it was made.
terraform apply $f_plan
