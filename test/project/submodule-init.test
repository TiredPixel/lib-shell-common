#!/usr/bin/env bash
#
# Tests project/submodule-init against real repositories in a scratch dir: a
# parent, app, whose submodule lib has a submodule of its own, deep, each with a
# bare remote and an upstream clone that commits to it. Every case builds its
# fixture afresh, app cloned without its submodules unless the case says
# otherwise, and runs project/submodule-init in app.
#
# Run: test/project/submodule-init.test. Exits 1 naming each case that failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

init=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../../project")/submodule-init
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

# Nothing from the caller's configuration reaches the fixtures, and nothing
# above the scratch dir is taken for a repository. File URLs are refused to
# submodules by default.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
export GIT_CEILING_DIRECTORIES=$work
export GIT_CONFIG_COUNT=4
export GIT_CONFIG_KEY_0=protocol.file.allow GIT_CONFIG_VALUE_0=always
export GIT_CONFIG_KEY_1=user.name GIT_CONFIG_VALUE_1=test
export GIT_CONFIG_KEY_2=user.email GIT_CONFIG_VALUE_2=test@example.com
export GIT_CONFIG_KEY_3=init.defaultBranch GIT_CONFIG_VALUE_3=main

# Reports a failure of case $1 at once, each line of $2 under the program and
# the case, so a later abort cannot hide it.
fail() {
    local line
    while IFS= read -r line <&3; do
        echo "${0##*/}: $1: $line" >&2
    done 3<<<"$2"
    failures=$((failures + 1))
}

failures=0
n=0

# Creates bare remote $w/$1.git and $w/$1.up, a clone holding one commit.
mkrepo() {
    git init -q --bare "$w/$1.git"
    git init -q "$w/$1.up"
    git -C "$w/$1.up" commit -q --allow-empty -m init
    git -C "$w/$1.up" remote add origin "$w/$1.git"
    git -C "$w/$1.up" push -q -u origin main
}

# Makes an empty commit, message $2, in $w/$1.up and pushes it.
upcommit() {
    git -C "$w/$1.up" commit -q --allow-empty -m "$2"
    git -C "$w/$1.up" push -q
}

# Adds bare remote $w/$2.git to $w/$1.up as submodule $2 and pushes it.
upadd() {
    git -C "$w/$1.up" submodule add -q "$w/$2.git" "$2"
    git -C "$w/$1.up" commit -q -m "add $2"
    git -C "$w/$1.up" push -q
}

# A fresh fixture in $w, with app cloned to $w/app, its submodules checked out
# recursively where $1 is "recursive", else none of them.
fixture() {
    local recurse=()
    n=$((n + 1))
    w=$work/$n
    mkdir "$w"
    mkrepo deep
    mkrepo lib
    upadd lib deep
    mkrepo app
    upadd app lib
    if [ "${1:-}" = recursive ]; then
        recurse=(--recurse-submodules)
    fi
    git clone -q "${recurse[@]}" "$w/app.git" "$w/app"
}

# Whether $1 is the top of a repository: git would otherwise answer the
# questions below from the repository above it.
is_repo() {
    local top
    top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || top=
    [[ -n $top && $top -ef $1 ]]
}

# The commit $1 has checked out, or "no repository".
head_of() {
    if is_repo "$1"; then
        git -C "$1" rev-parse HEAD
    else
        echo "no repository"
    fi
}

# The commit repository $1 records for its submodule $2.
recorded() {
    git -C "$1" rev-parse "HEAD:$2"
}

# project/submodule-init's stdout and stderr, $w shown as W so a report reads
# the same from run to run.
output() {
    local out err
    out=$(<"$w/out")
    err=$(<"$w/err")
    echo "stdout: ${out//"$w"/W}"
    echo "stderr: ${err//"$w"/W}"
}

# Runs project/submodule-init in app, or in its subdirectory $1, with the
# arguments after it, keeping its status in rc, its stdout in $w/out and its
# stderr in $w/err.
run() {
    rc=0
    (cd "$w/app/${1:-}" && "$init" "${@:2}") >"$w/out" 2>"$w/err" || rc=$?
}

# Records a failure of case $1 where $3 is not $4, $2 naming what was asked.
expect() {
    if [ "$3" != "$4" ]; then
        fail "$1" "$2 is $3, not $4: $(output)"
    fi
}

# A submodule not checked out is checked out at the commit recorded for it,
# though its remote has moved on, and its own submodules are left to it.
fixture
upcommit lib lib2
run
expect missing status "$rc" 0
expect missing "lib's commit" "$(head_of "$w/app/lib")" \
    "$(recorded "$w/app" lib)"
expect missing "deep's commit" "$(head_of "$w/app/lib/deep")" "no repository"

# Run from a subdirectory, it works from the top level.
fixture
mkdir "$w/app/sub"
run sub
expect subdirectory status "$rc" 0
expect subdirectory "lib's commit" "$(head_of "$w/app/lib")" \
    "$(recorded "$w/app" lib)"

# A submodule already checked out, here ahead of the commit recorded for it, is
# left where it is.
fixture recursive
git -C "$w/app/lib" checkout -q main
git -C "$w/app/lib" commit -q --allow-empty -m local
own=$(head_of "$w/app/lib")
run
expect ahead status "$rc" 0
expect ahead "lib's commit" "$(head_of "$w/app/lib")" "$own"

# A URL moved in .gitmodules reaches the configuration and the checked-out
# submodule's remote.
fixture recursive
git -C "$w/app" config -f .gitmodules submodule.lib.url "$w/lib-moved.git"
run
expect moved status "$rc" 0
expect moved "app's lib URL" "$(git -C "$w/app" config submodule.lib.url)" \
    "$w/lib-moved.git"
expect moved "lib's remote" "$(git -C "$w/app/lib" remote get-url origin)" \
    "$w/lib-moved.git"

# An update of none, set in .gitmodules, is overridden: honoured, it would leave
# the submodule empty.
fixture
git -C "$w/app" config -f .gitmodules submodule.lib.update none
run
expect update-none status "$rc" 0
expect update-none "lib's commit" "$(head_of "$w/app/lib")" \
    "$(recorded "$w/app" lib)"

# Outside any repository, git's failure stops it.
fixture
mkdir "$w/none"
rc=0
(cd "$w/none" && "$init") >"$w/out" 2>"$w/err" || rc=$?
if [ "$rc" -eq 0 ]; then
    fail no-repo "exit 0, not a failure: $(output)"
fi

# Any argument is a usage error, refused before anything is checked out.
fixture
run "" x
expect argument status "$rc" 2
expect argument stdout "$(<"$w/out")" ""
expect argument stderr "$(<"$w/err")" "Usage: submodule-init"
expect argument "lib's commit" "$(head_of "$w/app/lib")" "no repository"

if [ "$failures" -gt 0 ]; then
    exit 1
fi
