#!/usr/bin/env bash
#
# Each case writes its own Dockerfile, read with the real jq but in one case,
# which fakes a failing jq. Nothing is built, since the lint only reads the
# file.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

locks=$root/lint/dockerfile-locks

# Runs dockerfile-locks in $test_tmp with the arguments from $4 on, and checks
# its status is $2, its stdout is empty and its stderr is $3.
run() {
    test_check "$1" "$2" '' "$3" env -C "$test_tmp" "$locks" "${@:4}"
}

# Writes stdin to $test_tmp/Dockerfile and checks dockerfile-locks on it as run
# does, its status $2 and its stderr $3.
check() {
    cat >"$test_tmp/Dockerfile"
    run "$1" "$2" "$3" Dockerfile
}

# Checks commands $2 in a RUN let through.
pass() {
    check "$1" 0 "" < <(printf 'FROM x\nRUN %s\n' "$2")
}

# Checks commands $2 in a RUN refused, at Dockerfile:2, for reasons $3.
refuse() {
    check "$1" 1 "lint/dockerfile-locks: Dockerfile:2: $3" < <(printf 'FROM x\nRUN %s\n' "$2")
}

# Checks commands $2 refused as refuse does, and let through in a RUN
# --network=none.
twin() {
    refuse "$@"
    check "$1-offline" 0 "" < <(printf 'FROM x\nRUN --network=none %s\n' "$2")
}

pipx_args="--pip-args='--disable-pip-version-check --no-index --find-links=/wheels'"
usage="lint/dockerfile-locks [--] DOCKERFILE..."
no_hashes="pip install without --require-hashes"
no_lock="pip install reads no -r lock"
no_binary="pip install without --only-binary=:all: or --no-build-isolation, so an sdist's build dependencies are fetched with no hash"
pip_all="$no_hashes; $no_lock; $no_binary"
locked="--require-hashes --only-binary=:all: -r /lock/requirements.txt"
fetch_tail=" outside a RUN --network=none, since what it fetches is not checked here"
lock_tail=" outside a RUN --network=none, since a lock resolved during the build is committed nowhere"
npm_install="npm install resolves versions itself, where npm ci installs a lock as given"
online="pipx install outside a RUN --network=none"
no_shared="pipx install with no python3 -m venv making its shared venv, a directory ending in /shared, earlier in this RUN"
no_auto="pipx install with no PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 exported earlier in this RUN, nor --skip-maintenance, so pipx can upgrade its shared venv's pip from PyPI"
venv="python3 -m venv \"\$PIPX_HOME/shared\""
auto="export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1"

# Arguments.
test_usage no-arguments "$usage" env -C "$test_tmp" "$locks"
test_usage option "$usage" env -C "$test_tmp" "$locks" -x
test_usage option-after-file "$usage" env -C "$test_tmp" "$locks" Dockerfile \
    --help
test_usage only-separator "$usage" env -C "$test_tmp" "$locks" --
run missing 3 "lint/dockerfile-locks: nope: no such file" nope
mkdir -- "$test_tmp/dir"
run directory 3 "lint/dockerfile-locks: dir: not a regular file" dir
printf 'FROM x\n' >"$test_tmp/-dash"
run separator 0 "" -- -dash
if [ "$(id -u)" -ne 0 ]; then
    printf 'FROM x\n' >"$test_tmp/locked"
    chmod 000 "$test_tmp/locked"
    run unreadable 3 "lint/dockerfile-locks: locked: cannot be read" locked
fi
printf 'FROM x\nRUN npm install\n' >"$test_tmp/a.Dockerfile"
printf 'FROM x\n\nRUN npm i\n' >"$test_tmp/b.Dockerfile"
run files 1 "lint/dockerfile-locks: a.Dockerfile:2: $npm_install"$'\n'"lint/dockerfile-locks: b.Dockerfile:3: ${npm_install/install/i}" \
    a.Dockerfile b.Dockerfile

# The form this repository's image takes: a wheels stage fetching the lock with
# hashes, and pipx installing offline from it into a shared venv made first.
check two-stage 0 "" <<DOCKERFILE
FROM docker.io/library/debian@sha256:0 AS wheels
RUN --mount=type=bind,source=Dockerfile.lock/mdformat,target=/lock \\
    python3 -m pip download --disable-pip-version-check --require-hashes \\
        --no-deps --only-binary=:all: -d /wheels -r /lock/requirements.txt
FROM docker.io/library/debian@sha256:0 AS dev
RUN --network=none \\
    --mount=type=bind,from=wheels,source=/wheels,target=/wheels \\
    export PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin \\
        PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 \\
    && $venv \\
    && pipx install $pipx_args mdformat \\
    && pipx inject $pipx_args mdformat mdformat-gfm mdformat-frontmatter
RUN npm ci --prefix /opt/js --ignore-scripts --no-update-notifier
DOCKERFILE

pass nothing "apt-get update && apt-get install -y pipx"

# pip, by each name, and each subcommand that fetches.
twin pip "pip install mdformat" "$pip_all"
refuse pip3-path "/opt/venv/bin/pip3.13 install mdformat" "$pip_all"
refuse python-m-pip "python3 -I -m pip install mdformat" "$pip_all"
refuse pip-download "pip download x" "${pip_all//install/download}"
refuse pip-wheel "pip wheel x" "${pip_all//install/wheel}"
pass pip-other "pip list && pip --version && pip"
pass python-script "python3 -c 'import pip' && python3 pip install x && python3 -m"

# pip's hashed lock, its options in each form read.
pass pip-locked "pip install $locked"
pass pip-requirement "pip install --require-hashes --only-binary=:all: --requirement /l"
pass pip-joined "pip install --require-hashes --only-binary=:all: -r/l --requirement=/m"
pass pip-no-isolation "pip install --require-hashes --no-build-isolation -r /l"
pass pip-no-index "pip install --no-index x"
pass pip-no-index-local "pip install --no-index -f /w --find-links=file:///w --find-links /w -f/w x"
# A source whose server chooses what pip installs is refused, in each form.
n=0
remote_link="pip install --no-index with a --find-links URL, which fetches with no hash check"
for data in "-f https://h/" "-fhttps://h/" "--find-links=http://h/" \
    "--find-links https://h/"; do
    n=$((n + 1))
    refuse "pip-no-index-remote-$n" "pip install --no-index -f /w $data x" "$remote_link"
done
remote_lock="pip install reads its -r lock from a URL, whose server chooses the hashes too"
for data in "-r https://h/l" "-rhttps://h/l" "--requirement=https://h/l" \
    "--requirement https://h/l"; do
    n=$((n + 1))
    refuse "pip-remote-lock-$n" "pip install --require-hashes --only-binary=:all: -r /l $data" "$remote_lock"
done
pass pip-file-lock "pip install --require-hashes --only-binary=:all: -r file:///l"
refuse pip-hashes-only "pip install --require-hashes x --only-binary :all:" "$no_lock"
pass pip-binary-spaced "pip install --require-hashes --only-binary :all: -r /l"
refuse pip-lock-only "pip install -r /l" "$no_hashes; $no_binary"

# pipx, offline from wheels into the shared venv made first, its pip kept from
# upgrading.
check pipx 0 "" <<DOCKERFILE
FROM x
RUN --network=none $auto && $venv && pipx install $pipx_args mdformat
DOCKERFILE

check pipx-separate 0 "" <<'DOCKERFILE'
FROM x
RUN --network=none python3 -m venv /opt/pipx/shared/ \
    && export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 \
    && python3 -m pipx install --pip-args="--no-index -f /wheels" mdformat
DOCKERFILE

check pipx-online 1 "lint/dockerfile-locks: Dockerfile:2: $online" <<DOCKERFILE
FROM x
RUN $auto && $venv && pipx install $pipx_args mdformat
DOCKERFILE

check pipx-no-pip-args 1 "lint/dockerfile-locks: Dockerfile:2: pipx inject --pip-args lacks --no-index; pipx inject --pip-args lacks --find-links" <<DOCKERFILE
FROM x
RUN --network=none $auto && $venv && pipx inject mdformat mdformat-gfm
DOCKERFILE

check pipx-pip-args-spaced 0 "" <<DOCKERFILE
FROM x
RUN --network=none $auto && $venv && pipx install --pip-args '--no-index --find-links=/w' mdformat
DOCKERFILE

check pipx-no-venv 1 "lint/dockerfile-locks: Dockerfile:2: $no_shared" <<DOCKERFILE
FROM x
RUN --network=none $auto && pipx install $pipx_args mdformat
DOCKERFILE

check pipx-venv-after 1 "lint/dockerfile-locks: Dockerfile:2: $no_shared" <<DOCKERFILE
FROM x
RUN --network=none $auto && pipx install $pipx_args mdformat && $venv
DOCKERFILE

check pipx-preinstall 1 "lint/dockerfile-locks: Dockerfile:2: pipx --preinstall runs pip without the --pip-args" <<DOCKERFILE
FROM x
RUN --network=none $auto && $venv && pipx install $pipx_args --preinstall=pip mdformat
DOCKERFILE

pass pipx-other "pipx list && pipx --version"

# The variable keeping pipx from upgrading the shared venv's pip: each form
# that reaches the command, and each that does not.
check pipx-no-auto-upgrade 1 "lint/dockerfile-locks: Dockerfile:2: $no_auto" <<DOCKERFILE
FROM x
RUN --network=none $venv && pipx install $pipx_args mdformat
DOCKERFILE

check pipx-no-auto-upgrade-inject 1 "lint/dockerfile-locks: Dockerfile:2: ${no_auto/install/inject}" <<DOCKERFILE
FROM x
RUN --network=none $venv && pipx inject $pipx_args mdformat mdformat-gfm
DOCKERFILE

check pipx-all 1 "lint/dockerfile-locks: Dockerfile:2: $online; $no_shared; $no_auto" <<DOCKERFILE
FROM x
RUN pipx install $pipx_args mdformat
DOCKERFILE

n=0
for data in "export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=True &&" \
    "export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE='yes' PIPX_HOME=/opt/pipx &&" \
    "export PIPX_HOME=/opt/pipx PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=on &&" \
    "PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 && export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE &&" \
    "PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=t" \
    "PIPX_HOME=/opt/pipx PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=y" \
    "env PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1" \
    "sudo PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1"; do
    n=$((n + 1))
    check "pipx-auto-upgrade-off-$n" 0 "" <<DOCKERFILE
FROM x
RUN --network=none $venv && $data pipx install $pipx_args mdformat
DOCKERFILE
done
check pipx-skip-maintenance 0 "" <<DOCKERFILE
FROM x
RUN --network=none $venv && pipx install $pipx_args --skip-maintenance mdformat && pipx inject --skip-maintenance $pipx_args mdformat mdformat-gfm
DOCKERFILE

n=0
for data in "export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=0 &&" \
    "export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=enabled &&" \
    "export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE= &&" \
    "export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE &&" \
    "PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 &&" \
    "PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 true &&" \
    "PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=0 && export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE &&" \
    "PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=false" \
    "env -i PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=no"; do
    n=$((n + 1))
    check "pipx-auto-upgrade-on-$n" 1 "lint/dockerfile-locks: Dockerfile:2: $no_auto" <<DOCKERFILE
FROM x
RUN --network=none $venv && $data pipx install $pipx_args mdformat
DOCKERFILE
done
check pipx-export-after 1 "lint/dockerfile-locks: Dockerfile:2: $no_auto" <<DOCKERFILE
FROM x
RUN --network=none $venv && pipx install $pipx_args mdformat && $auto
DOCKERFILE

# A later value pipx reads as false undoes an earlier true one, exported or
# not.
n=0
for data in "PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 && PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=0 && export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE &&" \
    "$auto && export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=0 &&" \
    "$auto && PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=0 &&" \
    "$auto && PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=0 && export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE &&" \
    "PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=0" \
    "$auto && PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=off"; do
    n=$((n + 1))
    check "pipx-auto-upgrade-undone-$n" 1 "lint/dockerfile-locks: Dockerfile:2: $no_auto" <<DOCKERFILE
FROM x
RUN --network=none $venv && $data pipx install $pipx_args mdformat
DOCKERFILE
done
check pipx-auto-upgrade-redone 0 "" <<DOCKERFILE
FROM x
RUN --network=none $venv && export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=0 && PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 pipx install $pipx_args mdformat
DOCKERFILE

# A shell's prefix reaches the script it runs, from -c or a heredoc, and its
# exports reach nothing after it.
check pipx-shell-prefix 0 "" <<DOCKERFILE
FROM x
RUN --network=none $venv && PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 sh -c "pipx install $pipx_args mdformat"
RUN --network=none ["env", "PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1", "sh", "-c", "$venv && pipx install $pipx_args mdformat"]
RUN --network=none PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 bash <<EOF
$venv && pipx install $pipx_args mdformat
EOF
DOCKERFILE

check pipx-shell-prefix-false 1 "lint/dockerfile-locks: Dockerfile:2: $no_auto" <<DOCKERFILE
FROM x
RUN --network=none $venv && $auto && PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=0 sh -c "pipx install $pipx_args mdformat"
DOCKERFILE

check pipx-shell-export 1 "lint/dockerfile-locks: Dockerfile:2: $no_auto" <<DOCKERFILE
FROM x
RUN --network=none $venv && sh -c "$auto" && pipx install $pipx_args mdformat
DOCKERFILE

check pipx-shell-unexported 1 "lint/dockerfile-locks: Dockerfile:2: $no_auto" <<DOCKERFILE
FROM x
RUN --network=none $venv && PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 && sh -c "export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE && pipx install $pipx_args mdformat"
DOCKERFILE

# The variable once exported holds its last value, and a prefix before export
# is what it exports.
check pipx-exported-then-set 0 "" <<DOCKERFILE
FROM x
RUN --network=none $venv && export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=0 && PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 && pipx install $pipx_args mdformat
RUN --network=none $venv && export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE && PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=yes && pipx install $pipx_args mdformat
RUN --network=none $venv && PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 export PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE && pipx install $pipx_args mdformat
DOCKERFILE

# The heredoc's reader is the command holding the << word, wherever it sits,
# with its own prefix, and what runs after it counts for nothing in the body.
check pipx-heredoc-reader 1 "lint/dockerfile-locks: Dockerfile:5: $no_auto
lint/dockerfile-locks: Dockerfile:8: $no_auto" <<DOCKERFILE
FROM x
RUN --network=none PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 bash <<EOF && true
$venv && pipx install $pipx_args mdformat
EOF
RUN --network=none bash <<EOF && PIPX_DISABLE_SHARED_LIBS_AUTO_UPGRADE=1 true
$venv && pipx install $pipx_args mdformat
EOF
RUN --network=none bash <<EOF && $auto
$venv && pipx install $pipx_args mdformat
EOF
RUN --network=none $auto && cd /tmp && bash <<EOF
$venv && pipx install $pipx_args mdformat
EOF
DOCKERFILE

# npm.
twin npm-install "npm install" "$npm_install"
refuse npm-add "npm --no-save add x" "${npm_install/install/add}"
# Each alias npm gives a command that fetches.
for c in i in ins inst insta instal isnt isnta isntal isntall u up upgrade \
    udpate update install-test it link ln dedupe ddp; do
    refuse "npm-$c" "npm $c x" "${npm_install/install/$c}"
done
pass npm-ci "npm ci --no-update-notifier && npm run build && npm test"
pass npm-other "npm un x && npm uninstall x && npm ls && npm ll && npm list"
# npm ci installs the lock as given, but asks for a newer npm unless told not
# to, offline too.
npm_ci="npm ci without --no-update-notifier, so npm asks the registry for a newer npm"
refuse npm-ci-notifier "npm ci --prefix /opt/js" "$npm_ci"
check npm-ci-notifier-offline 1 "lint/dockerfile-locks: Dockerfile:2: $npm_ci" < <(printf 'FROM x\nRUN --network=none npm ci\n')
for c in clean-install ic install-clean isntall-clean install-ci-test cit \
    clean-install-test sit; do
    refuse "npm-$c" "npm $c" "${npm_ci/ci/$c}"
    pass "npm-$c-notifier" "npm $c --no-update-notifier"
done

# Lock generators.
for c in "pip lock" pip-compile "uv pip compile" "uv lock" "uv export" \
    "poetry lock" "poetry export" "pipenv lock" "pdm lock" "pdm export"; do
    twin "${c// /-}" "$c" "$c$lock_tail"
done

# Other tools' installs, each named by the tool and its command alone.
for c in "yarn install" "pnpm install" "pnpm i" "bun install" "bun i" \
    "uv sync" "yarn add" "pnpm add" "bun add" "uv pip install" \
    "uv pip sync" "uv add" "uv tool install" "uvx ruff" "npx semistandard" \
    "npm exec" "npm x" "poetry install" "poetry add" "pipenv install" \
    "pipenv sync" "pdm install" "pdm add" "pdm sync" easy_install; do
    twin "${c// /-}" "$c" "$c$fetch_tail"
done
twin yarn yarn "yarn install$fetch_tail"

# Build frontends, isolated by default, and their switches building without.
build_tail=" outside a RUN --network=none, since it fetches build dependencies with no hash check"
for c in "python3 -m build" pyproject-build "uv build" "pdm build" \
    "hatch build"; do
    twin "${c// /-}" "$c --wheel" "$c$build_tail"
done
pass build-no-isolation "python3 -m build -n && python3 -m build --no-isolation && pyproject-build -n && uv build --no-build-isolation && pdm build --no-isolation"
pass build-source "python3 -m build -n . && pyproject-build -n src && uv build . --no-build-isolation && pdm build --no-isolation ."
refuse build-source-isolated "uv build ." "uv build$build_tail"
pass build-script "./build && make build"
refuse named-alone "npx prettier --check . && uv pip install --system x y" \
    "npx prettier$fetch_tail; uv pip install$fetch_tail"
refuse easy-install-version "easy_install-3.8 x" "easy_install x$fetch_tail"
refuse frozen-other-command "pnpm add --frozen-lockfile x" "pnpm add$fetch_tail"
pass runners-bare "uvx --version && npx --version"
pass yarn-info "yarn --version && yarn -v && yarn --help && yarn -h && yarn --silent -v"
pass tools-other "yarn build && pnpm run test && uv --version && bun ci"

# The frozen forms, which install the committed lock or fail, and the runners
# kept from fetching.
for c in "yarn install --immutable" "yarn install --frozen-lockfile" \
    "yarn --immutable" "pnpm install --frozen-lockfile" \
    "pnpm i --frozen-lockfile" "bun install --frozen-lockfile" \
    "bun i --frozen-lockfile" "uv sync --locked" "uv sync --frozen" \
    "npx --no tsc" "npm exec --no -- tsc" "npm x --no tsc"; do
    pass "${c// /-}" "$c"
done

# Splitting into simple commands.
for c in "true;npm i" "true||npm i" "true|npm i" "true&npm i" "(npm i)" \
    "{ npm i; }" "echo \`npm i\`" "x=\$(npm i)" "! npm i" \
    "if npm i; then :; fi" "while npm i; do :; done"; do
    refuse "split $c" "$c" "${npm_install/install/i}"
done

# Quoting.
refuse quoted-command "'n'\"p\"m i" "${npm_install/install/i}"
refuse escaped-command "n\\pm i" "${npm_install/install/i}"
refuse double-quote-escape 'echo "a \" b \\" && npm i' "${npm_install/install/i}"
pass quoted-separator "echo 'a; npm i' \"b && npm i\""
pass empty-word "'' npm i"
pass comment "echo x # && npm i"
refuse hash-in-word "echo a#b && npm i" "${npm_install/install/i}"
pass quote-no-end "echo 'a && npm i"

# Assignments and wrappers.
for c in "A=1 B+=2 npm i" "sudo -E -u x npm i" "env -i -u A -C /d B=1 npm i" \
    "/usr/bin/env npm i"; do
    refuse "wrapper $c" "$c" "${npm_install/install/i}"
done

# Shells.
for c in "sh -c 'npm i'" "bash -euo pipefail -c 'npm i'" "/bin/bash -ec 'npm i'" \
    "dash --norc -c 'npm i'"; do
    refuse "shell $c" "$c" "${npm_install/install/i}"
done
pass shell-script "bash npm i && sh -c"

# The exec form, read with jq; anything else is the shell form.
refuse exec-form '["npm", "install"]' "$npm_install"
refuse exec-form-shell '["sh", "-c", "npm i"]' "${npm_install/install/i}"
refuse shell-form-bracket "[ -f x ] && npm i" "${npm_install/install/i}"
pass exec-form-not-strings '[1]'

test_stub jq 'exit 3'
printf 'FROM x\nRUN ["npm", "install"]\n' >"$test_tmp/Dockerfile"
run exec-form-jq-fails 3 \
    "lint/dockerfile-locks: Dockerfile:2: jq failed reading the exec form" \
    Dockerfile
rm -- "$test_tmp/path/jq" "$test_tmp/jq.calls"

# Heredocs: a body that is the RUN's script, or a shell's, is read, any other
# passed over.
check heredoc-script 1 "lint/dockerfile-locks: Dockerfile:2: $npm_install
lint/dockerfile-locks: Dockerfile:8: ${npm_install/install/i}" <<'DOCKERFILE'
FROM x
RUN <<EOF
echo "a\
b"
npm \
install
EOF
RUN <<EOF bash <<'EOF2'
EOF
npm i
EOF2
RUN --network=none <<EOF
npm i
EOF
DOCKERFILE

check heredoc-shell 1 "lint/dockerfile-locks: Dockerfile:2: ${npm_install/install/i}" <<'DOCKERFILE'
FROM x
RUN --mount=type=cache,target=/x /bin/bash <<-"EOF"
	npm i
	EOF
DOCKERFILE

# A shell past assignments, quoted or not, wrappers and earlier commands still
# runs the heredoc, and a shell given -c reads it as input alone.
check heredoc-shell-wrapped 1 "lint/dockerfile-locks: Dockerfile:2: ${npm_install/install/i}
lint/dockerfile-locks: Dockerfile:5: ${npm_install/install/i}
lint/dockerfile-locks: Dockerfile:8: ${npm_install/install/i}
lint/dockerfile-locks: Dockerfile:11: ${npm_install/install/i}
lint/dockerfile-locks: Dockerfile:14: ${npm_install/install/i}" <<'DOCKERFILE'
FROM x
RUN A=1 bash <<EOF
npm i
EOF
RUN env -u A B=1 sh <<EOF
npm i
EOF
RUN sudo -E -u x -- sh <<EOF
npm i
EOF
RUN A="a b" bash <<EOF
npm i
EOF
RUN export A=1 && cd /x && bash <<EOF
npm i
EOF
RUN A=1 cat <<EOF
npm i
EOF
RUN bash -c true <<EOF
npm i
EOF
DOCKERFILE

check heredoc-other 0 "" <<'DOCKERFILE'
FROM x
RUN cat <<EOF >/etc/x
npm i
EOF
RUN <<EOF cat >/etc/y
npm i
EOF
COPY <<EOF /x
RUN npm i
EOF
DOCKERFILE

check heredoc-no-end 3 "lint/dockerfile-locks: Dockerfile: a heredoc's body has no end line EOF" <<'DOCKERFILE'
FROM x
RUN <<EOF
npm i
DOCKERFILE

# Instructions, on logical lines.
check continued 1 "lint/dockerfile-locks: Dockerfile:2: ${npm_install/install/i}" <<'DOCKERFILE'
FROM x
RUN apt-get update \
# a comment inside, skipped
    && npm i
DOCKERFILE

check escape-directive 1 "lint/dockerfile-locks: Dockerfile:4: ${npm_install/install/i}" <<'DOCKERFILE'
# syntax=docker/dockerfile:1
# escape=`
FROM x
RUN true `
    && npm i
DOCKERFILE

# Parser directives end at an unknown one, as Docker's do, so the escape
# directive after it is a comment.
check escape-after-unknown 1 "lint/dockerfile-locks: Dockerfile:5: ${npm_install/install/i}" <<'DOCKERFILE'
# unknown=x
# escape=`
FROM x
RUN true `
RUN npm i
DOCKERFILE

check escape-bad 3 "lint/dockerfile-locks: Dockerfile: escape directive x is not \\ or \`" \
    < <(printf '# escape=x\nFROM x\nRUN npm i\n')

check continued-at-end 1 "lint/dockerfile-locks: Dockerfile:2: ${npm_install/install/i}" < <(printf 'FROM x\nrun npm i \\\n')

check onbuild 1 "lint/dockerfile-locks: Dockerfile:2: ${npm_install/install/i}" <<'DOCKERFILE'
FROM x
onbuild RUN npm i
ONBUILD
DOCKERFILE

# The suppression.
check ignore 0 "" <<'DOCKERFILE'
FROM x
# dockerfile-locks ignore: a scratch stage, never shipped
# hadolint ignore=DL3016
RUN npm i
DOCKERFILE

check ignore-no-reason 1 "lint/dockerfile-locks: Dockerfile:3: dockerfile-locks ignore has no reason" \
    < <(printf 'FROM x\n# dockerfile-locks ignore: not the nearest\n# dockerfile-locks ignore:\t \nRUN npm i\n')

check ignore-detached 1 "lint/dockerfile-locks: Dockerfile:4: ${npm_install/install/i}" <<'DOCKERFILE'
FROM x
# dockerfile-locks ignore: a blank line between

RUN npm i
DOCKERFILE

check ignore-past-instruction 1 "lint/dockerfile-locks: Dockerfile:4: ${npm_install/install/i}" <<'DOCKERFILE'
FROM x
# dockerfile-locks ignore: another instruction between
FROM y
RUN npm i
DOCKERFILE

test_finish
