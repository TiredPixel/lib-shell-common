# shellcheck shell=bash

# Sets no shell options, since it runs under its caller's.
# shellcheck disable=SC2034 # Read by the scripts that source this file.
ansible_lint_args=(
    # A run reaches no network: no requirements.yml install, schema refresh or
    # version check.
    --offline
    # Without it, ansible-lint looks upward for .git and, in a container's copy
    # or mount of the tree, which has none, takes / as the project root.
    --project-dir .
    # --strict, so a warning fails as an error does.
    --strict
    # Submodules are linted in their own repositories, and vault files are
    # encrypted.
    --exclude lib/
    --exclude 'group_vars/*/*vault.yml'
)
