#!/usr/bin/env bash
#
# Lists the tags on this repository's origin, as git ls-remote prints them, one
# refs/tags/ line each: --refs drops the peeled ^{} lines. project/tag-create
# runs it in every project through project/each.
#
# timeout because a remote that hangs would hold the release forever.
# --foreground because timeout otherwise runs git in a background process
# group, where an ssh or credential prompt is stopped by SIGTTIN and the run
# stalls until expiry; tag-create's check is a release's first contact with any
# origin, so such a prompt must be answerable here. On expiry it signals git
# alone, which ends the query.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

if [ $# -ne 0 ]; then
    echo "Usage: ${0##*/}" >&2
    exit 2
fi

limit=60
status=0
timeout --foreground "$limit" git ls-remote --tags --refs origin || status=$?

if [ "$status" -eq 124 ]; then
    echo "${0##*/}: $PWD: origin did not answer within $limit s" >&2
fi

exit "$status"
