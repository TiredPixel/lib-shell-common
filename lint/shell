#!/usr/bin/env bash
#
# ShellCheck every shell script in the working directory and in bin/, plus any
# file named as an argument. Discovery is by content rather than by extension,
# so an executable carrying no suffix is reached and a .sh that is not a script
# is not. bin/ is optional; a project without one is fine.
#
# A sourced fragment carrying no shebang has to be named as an argument. -x
# alone does not cover it: that follows the file so the definitions it makes
# resolve in the caller, and reports nothing found inside it. Following is not
# checking.
#
# Finding nothing is reported and not fatal, because a project with no shell in
# it is a real project. A caller that requires coverage should name its files,
# which is an assertion this cannot make on its behalf.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

named=("$@")

# Built rather than globbed inline, because failglob turns an absent bin/ into
# a bash "no match" and ends the run on a layout that is merely different.
roots=(./*)

if [ -d bin ]; then
    roots+=(bin/*)
fi

# file(1) is run on its own so its status is checked. Folded into the pipeline
# it could not be: a broken file(1) and a clean no-match both arrive as an
# empty result, and the pass then skips in silence, indistinguishable from one
# that checked everything. grep exiting 1 on no match stays tolerated, because
# no shell scripts at all is a legitimate answer.
typed=$(file --mime-type "${roots[@]}")

mapfile -t found < <(grep 'text/x-shellscript' <<<"$typed" | cut -d':' -f1 || true)

scripts=()

for f in "${found[@]}"; do
    case $(basename "$f") in
    # Gradle generates these and rewrites them on every wrapper bump, so
    # their style is not the author's to fix. What matters about a wrapper
    # is the integrity of the distribution it names, which is a checksum
    # question -- gradle/actions/wrapper-validation is the check for it.
    gradlew | gradlew.bat)
        continue
        ;;
    esac

    scripts+=("$f")
done

if [ ${#scripts[@]} -eq 0 ] && [ ${#named[@]} -eq 0 ]; then
    echo "$(basename "$0"): no shell scripts found in . or bin/, so nothing was checked" >&2
    exit 0
fi

# Named rather than counted, so the log records what the pass actually covered
# and an absence is visible without anyone having to ask for it.
printf '%s\n' "${named[@]}" "${scripts[@]}" | sed 's/^/  /' >&2

shellcheck -x "${named[@]}" "${scripts[@]}"
