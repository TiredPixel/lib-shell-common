#!/usr/bin/env bash
#
# Fast-forwards the repository, then moves every submodule, recursively, to the
# head of its origin's default branch: an upgrade's first step, which
# project/upgrade runs. From a branch other than the default, each listed
# project takes a branch of the same name instead. project/pull brings the tree
# in line with origin without moving any submodule past the commit recorded for
# it.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
prog=${0##*/}

f_projects=.projects

# --ff-only here and below, whatever the caller's pull.rebase or pull.ff: a
# diverged branch stops the sweep, where a merge or a rebase would succeed,
# unseen, and a release would go on to push it.
git pull --ff-only --no-recurse-submodules

# foreach visits only submodules that are checked out, so one added upstream
# would be skipped without a word, and a URL changed in .gitmodules would never
# reach .git/config, leaving every later fetch on the old remote. Each level
# therefore brings its own submodules in line with the .gitmodules it has just
# pulled -- this one here, each submodule inside the sweep below, before foreach
# lists and descends into its children. It is not recursive, since the recursion
# is foreach's; exported, so the sweep's sh can reach it.
export PROJECT_SUBMODULE_INIT=$dir/submodule-init
"$PROJECT_SUBMODULE_INIT"

# Run from a branch other than the repository's default, as a sweep for a pull
# request is, each listed project takes the upgrade on a branch of the same
# name, since its default branch may take changes only through a pull request.
# Only listed projects commit an upgrade, so no other submodule is branched.
# HEAD is a branch here, since the pull above refuses a detached one. A
# repository made with git init and pushed has no origin/HEAD, so origin is
# asked where it is missing.
branch=$(git symbolic-ref --short HEAD)
if ref=$(git symbolic-ref -q --short refs/remotes/origin/HEAD); then
    default=${ref#origin/}
else
    # Assigned on its own, so that errexit sees git fail.
    heads=$(git ls-remote --symref origin HEAD)
    default=
    while IFS= read -r line <&3; do
        case $line in
        "ref: refs/heads/"*$'\t'HEAD)
            line=${line#ref: refs/heads/}
            default=${line%$'\t'HEAD}
            break
            ;;
        esac
    done 3<<<"$heads"
    if [ -z "$default" ]; then
        echo "$prog: origin names no default branch" >&2
        exit 1
    fi
fi

unset PROJECT_BRANCH
if [ "$branch" != "$default" ] && [ -f "$f_projects" ]; then
    export PROJECT_BRANCH=$branch PROJECT_PROG=$prog
    PROJECT_TOP=$(git rev-parse --show-toplevel)
    export PROJECT_TOP PROJECT_LIST=$PROJECT_TOP/$f_projects

    # A branch of that name that exists only on origin is refused, before any
    # submodule moves: the upgrade would run its Makefile, and anyone able to
    # push a branch could have put it there. One held locally is the caller's
    # own, so it is taken as it stands, and a resumed sweep goes on where it
    # left off. The string is for the sh each-without-project runs, which
    # expands it.
    # shellcheck disable=SC2016
    "$dir/each-without-project" sh -c '
        set -eu
        git fetch -q origin
        if ! git show-ref --verify -q "refs/heads/$PROJECT_BRANCH" &&
            git show-ref --verify -q "refs/remotes/origin/$PROJECT_BRANCH"
        then
            echo "$PROJECT_PROG: $PWD: origin/$PROJECT_BRANCH exists with no" \
                "local $PROJECT_BRANCH; check it out once reviewed" >&2
            exit 1
        fi'
fi

# One sweep, from here, over every submodule of this repository, whether
# .projects names it or not -- and --recursive reaches theirs in turn. Run from
# inside each project instead, the recursion would start one level too low: it
# would bring each project's own submodules current but never the project, so a
# stage that reports having pulled everything would leave every project on
# whatever commit its working tree happened to sit on.
#
# checkout before pull, because a submodule is checked out at a recorded commit
# and a detached HEAD has nothing to pull into. The branch comes from
# origin/HEAD rather than a literal, so a project whose default branch is not
# the usual one still follows its own. git submodule update --remote is not
# used: it also defaults to the remote HEAD, but under --rebase or --merge acts
# on whatever branch the submodule already has checked out. Only the remote's
# name is stripped, since a branch name may itself hold a slash.
#
# A listed project on the sweep's branch takes it here, in place of its default
# branch, so its submodules are brought in line with that branch before foreach
# descends into them. A new one starts from origin's default branch with no
# upstream, so a push names its own. The string is for the sh foreach runs in
# each submodule, which expands it.
# shellcheck disable=SC2016
git submodule foreach --recursive '
    set -eu
    ref=$(git symbolic-ref --short refs/remotes/origin/HEAD)
    branch=${ref#origin/}
    if [ -n "${PROJECT_BRANCH:-}" ] && [ "$toplevel" -ef "$PROJECT_TOP" ] &&
        grep -qxF -- "$sm_path" "$PROJECT_LIST"; then
        if git show-ref --verify -q "refs/heads/$PROJECT_BRANCH"; then
            git checkout --no-recurse-submodules "$PROJECT_BRANCH"
        else
            git checkout --no-recurse-submodules -b "$PROJECT_BRANCH" \
                --no-track "origin/$branch"
        fi
    else
        git checkout --no-recurse-submodules "$branch"
        git pull --ff-only --no-recurse-submodules
    fi
    "$PROJECT_SUBMODULE_INIT"'
