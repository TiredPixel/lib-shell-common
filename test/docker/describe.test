#!/usr/bin/env bash
#
# Sourced in a shell with no options set and in one under the strict mode its
# callers run, with git faked on PATH: the fake describes HEAD as FAKE_GIT has
# it, and gives its no-tag messages in German unless LC_ALL is C, as a
# translated git does under LANGUAGE=de, which each case sets with LC_ALL unset.
# LANGUAGE stands in for a German locale, which bash would warn of where it is
# not installed. Each case prints what the sourcing shell then holds in describe
# and describe_err, and must leave its TMPDIR empty. Sourcing must set none of
# the shell's options.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

describe=$root/docker/describe
fixtures=$root/test/fixtures/docker/describe

mkdir -- "$test_tmp/tmp"
cp -p -- "$fixtures/git" "$test_tmp/path/"

# The shells that source describe are scripts in files rather than -c strings,
# as its callers are, so $0 names the script as it names a caller.
cp -p -- "$fixtures/source" "$fixtures/options" "$test_tmp/"

# Sources describe with FAKE_GIT set to $3, in a bash with no options or, where
# $2 is strict, under the callers' strict mode, with TMPDIR $4, and checks its
# status is $5, its stdout $6 and its stderr $7, and that TMPDIR is left empty.
check() {
    local left
    test_check "$1" "$5" "$6" "$7" env -u LC_ALL LANGUAGE=de FAKE_GIT="$3" \
        TMPDIR="$4" bash --norc --noprofile "$test_tmp/source" "$2" "$describe"
    left=$(find "$test_tmp/tmp" -mindepth 1)
    if [ -n "$left" ]; then
        test_fail "$1" "left behind: $left"
        find "$test_tmp/tmp" -mindepth 1 -delete
    fi
}

if no_tmpdir=$(env -u LC_ALL LANGUAGE=de TMPDIR="$test_tmp/missing" mktemp 2>&1); then
    echo "${0##*/}: missing-tmpdir: mktemp made a file in a missing directory" >&2
    exit 1
fi

for mode in plain strict; do
    check "$mode-tagged" "$mode" tagged "$test_tmp/tmp" 0 "v1.2-3-gabcdef0|unset" ""
    # A warning beside a description is passed on.
    check "$mode-warned" "$mode" warned "$test_tmp/tmp" 0 "v1.2|unset" \
        "warning: tag 'v1.2' is externally known as 'v1.3'"
    # Each of git's no-tag failures leaves describe empty, silently.
    for fake in no-names no-annotated no-tags; do
        check "$mode-$fake" "$mode" "$fake" "$test_tmp/tmp" 0 "|unset" ""
    done
    # With describe_exact_match=1, only a tag on HEAD itself describes it, and
    # git's message that none does leaves describe empty too.
    describe_exact_match=1 check "$mode-exact-tagged" "$mode" exact-tagged \
        "$test_tmp/tmp" 0 "v1.2|unset" ""
    describe_exact_match=1 check "$mode-exact-untagged" "$mode" exact-untagged \
        "$test_tmp/tmp" 0 "|unset" ""
    # Any other failure is passed on, and exits 1 before the caller goes on.
    check "$mode-broken" "$mode" broken "$test_tmp/tmp" 1 "" \
        "fatal: not a git repository (or any of the parent directories): .git"$'\n'"source: git describe failed"
    check "$mode-mentions" "$mode" mentions "$test_tmp/tmp" 1 "" \
        "fatal: bad object: No names found, cannot describe anything."$'\n'"source: git describe failed"
    # No temporary file for git's stderr: mktemp says why, in its own words
    # here, and git never runs.
    check "$mode-no-tmpdir" "$mode" broken "$test_tmp/missing" 1 "" "$no_tmpdir"
done

# Sourcing changes none of the shell's options.
FAKE_GIT=tagged TMPDIR=$test_tmp/tmp bash --norc --noprofile "$test_tmp/options" \
    "$describe" ||
    test_fail options "sourcing changed the shell's options"

test_finish
