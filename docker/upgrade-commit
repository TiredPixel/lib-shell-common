#!/usr/bin/env bash
#
# Usage: docker/upgrade-commit RECORD [PATH...]
#
# Commits what docker/upgrade --record RECORD wrote, once the build and tests
# after it have passed, as "Upgrade pins" with the body a list, an item for
# each move RECORD holds, written "- " then the move as docker/upgrade gave it.
# It stages exactly the paths RECORD lists and each PATH, such as a library
# submodule taken forwards beside the upgrade, and refuses, listing them, where
# any other path is already staged, since the commit would carry it. A
# submodule PATH that moved adds an item as PATH OLD -> NEW, each commit cut to
# 7 hex digits, so a PATH that changed is committed even where no pin moved.
# Where neither a pin nor a PATH moved, it commits nothing. It never pushes.
# RECORD is removed once used, so a second run cannot commit it again.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

if [ -z "${1:-}" ]; then
    echo "Usage: ${0##*/} RECORD [PATH...]" >&2
    exit 2
fi
record=$1
extra=("${@:2}")

if [ ! -e "$record" ]; then
    echo "${0##*/}: $record: no such file" >&2
    exit 1
elif [ ! -f "$record" ]; then
    echo "${0##*/}: $record: not a regular file" >&2
    exit 1
fi

# Outside a repository, git diff would take --cached as a file comparison's
# unknown option rather than say so.
git rev-parse --git-dir >/dev/null

nothing() {
    echo "${0##*/}: $record: nothing moved, so there is nothing to commit" >&2
    rm -- "$record"
    exit 0
}

# Empty where no pin moved; else the paths written, then a blank line, then the
# moves.
mapfile -t lines <"$record"
paths=()
moves=()
if [ ${#lines[@]} -gt 0 ]; then
    blank=""
    for i in "${!lines[@]}"; do
        if [ -z "${lines[$i]}" ]; then
            blank=$i
            break
        fi
    done
    paths=("${lines[@]:0:${blank:-0}}")
    moves=("${lines[@]:${blank:-0}+1}")
    if [ -z "$blank" ] || [ ${#paths[@]} -eq 0 ] || [ ${#moves[@]} -eq 0 ]; then
        echo "${0##*/}: $record: not a record docker/upgrade --record writes" >&2
        exit 1
    fi
    for i in "${!moves[@]}"; do
        if [ -z "${moves[$i]}" ]; then
            echo "$record:$((blank + i + 2)): a second blank line" >&2
            exit 1
        fi
    done
fi
if [ ${#paths[@]} -eq 0 ] && [ ${#extra[@]} -eq 0 ]; then
    nothing
fi

# :(literal) so a path is never read as a pattern; --no-renames so a staged
# rename lists the path it leaves as well as the one it makes. Every diff here
# takes --ignore-submodules=none, since a submodule.<name>.ignore setting would
# otherwise hide a staged gitlink from it.
specs=()
excludes=()
for path in "${paths[@]}" "${extra[@]}"; do
    specs+=(":(literal)$path")
    excludes+=(":(exclude,literal)$path")
done
others=$(git diff --cached --no-renames --ignore-submodules=none --name-only \
    -- ':/' "${excludes[@]}")
if [ -n "$others" ]; then
    printf '%s\n' "$others" >&2
    echo "${0##*/}: already staged beside the upgrade; commit or unstage it" \
        "first" >&2
    exit 1
fi

git add -- "${specs[@]}"

# Each raw entry is ":OLDMODE NEWMODE OLD NEW STATUS" then the path, both ended
# by NUL under -z; 160000 on both sides is a submodule that moved. Through a
# file rather than a process substitution, whose failure errexit would miss.
if [ ${#extra[@]} -gt 0 ]; then
    raw=$(mktemp)
    trap 'rm -f -- "$raw"' EXIT
    git diff --cached --raw -z --no-renames --ignore-submodules=none \
        --no-abbrev -- "${specs[@]:${#paths[@]}}" >"$raw"
    while IFS= read -r -d '' meta <&3 && IFS= read -r -d '' name <&3; do
        read -r old_mode new_mode old new _ <<<"${meta#:}"
        if [ "$old_mode" = 160000 ] && [ "$new_mode" = 160000 ]; then
            moves+=("$name ${old:0:7} -> ${new:0:7}")
        fi
    done 3<"$raw"
fi

if git diff --cached --ignore-submodules=none --quiet; then
    nothing
fi
if [ ${#moves[@]} -gt 0 ]; then
    git commit -m "Upgrade pins" -m "$(printf -- '- %s\n' "${moves[@]}")"
else
    git commit -m "Upgrade pins"
fi
rm -- "$record"
