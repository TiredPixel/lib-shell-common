#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=project/build

usage() {
    echo "Usage: $prog" >&2
    exit 2
}

[ $# -eq 0 ] || usage

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

"$dir/projects-assert" "$prog"

echo "$prog: build" >&2
"$dir/each-without-project" "$dir/make-if-declared" build

echo "$prog: start" >&2
"$dir/start"

echo "$prog: stop" >&2
"$dir/stop"

echo "$prog: completed" >&2
