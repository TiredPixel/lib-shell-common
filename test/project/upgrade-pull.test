#!/usr/bin/env bash
#
# Tests project/upgrade-pull against real repositories in a scratch dir: a
# parent, app, whose submodule lib has a submodule of its own, deep, each with a
# bare remote and an upstream clone that commits to it. lib's default branch
# holds a slash and deep's is not the parent's, so the sweep is seen following
# each one's own. Every case builds its fixture afresh and runs
# project/upgrade-pull in app.
#
# Run: test/project/upgrade-pull.test. Exits 1 naming each case that failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

pull=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../../project")/upgrade-pull
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

# Nothing from the caller's configuration reaches the fixtures. File URLs are
# refused to submodules by default.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
export GIT_CONFIG_COUNT=4
export GIT_CONFIG_KEY_0=protocol.file.allow GIT_CONFIG_VALUE_0=always
export GIT_CONFIG_KEY_1=user.name GIT_CONFIG_VALUE_1=test
export GIT_CONFIG_KEY_2=user.email GIT_CONFIG_VALUE_2=test@example.com
export GIT_CONFIG_KEY_3=init.defaultBranch GIT_CONFIG_VALUE_3=main

# Reports a failure of case $1 at once, each line of $2 under the program and
# the case, so a later abort cannot hide it.
fail() {
    local line
    while IFS= read -r line <&3; do
        echo "${0##*/}: $1: $line" >&2
    done 3<<<"$2"
    failures=$((failures + 1))
}

failures=0
n=0

# Creates bare remote $w/$1.git, its default branch $2, and $w/$1.up, a clone
# holding one commit on it.
mkrepo() {
    git init -q --bare "$w/$1.git"
    git -C "$w/$1.git" symbolic-ref HEAD "refs/heads/$2"
    git init -q -b "$2" "$w/$1.up"
    git -C "$w/$1.up" commit -q --allow-empty -m init
    git -C "$w/$1.up" remote add origin "$w/$1.git"
    git -C "$w/$1.up" push -q -u origin "$2"
}

# Makes an empty commit, message $2, on $w/$1.up's current branch and pushes it.
upcommit() {
    git -C "$w/$1.up" commit -q --allow-empty -m "$2"
    git -C "$w/$1.up" push -q
}

# Adds bare remote $w/$2.git to $w/$1.up as submodule $2 and pushes it.
upadd() {
    git -C "$w/$1.up" submodule add -q "$w/$2.git" "$2"
    git -C "$w/$1.up" commit -q -m "add $2"
    git -C "$w/$1.up" push -q
}

# Moves bare remote $w/$2.git to $w/$2-moved.git, points $w/$2.up at it, and
# records the new URL in $w/$1.up's .gitmodules.
upmove() {
    mv -- "$w/$2.git" "$w/$2-moved.git"
    git -C "$w/$2.up" remote set-url origin "$w/$2-moved.git"
    git -C "$w/$1.up" config -f .gitmodules "submodule.$2.url" \
        "$w/$2-moved.git"
    git -C "$w/$1.up" commit -q -am "move $2"
    git -C "$w/$1.up" push -q
}

# A fresh fixture in $w, with app cloned to $w/app and every submodule
# initialised.
fixture() {
    n=$((n + 1))
    w=$work/$n
    mkdir "$w"
    mkrepo deep trunk
    mkrepo lib release/x
    upadd lib deep
    mkrepo app main
    upadd app lib
    git clone -q --recurse-submodules "$w/app.git" "$w/app"
}

# Whether $1 is the top of a repository: git would otherwise answer the
# questions below from the repository above it.
is_repo() {
    local top
    top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || top=
    [[ -n $top && $top -ef $1 ]]
}

# The commit $1 has checked out, or "no repository".
head_of() {
    if is_repo "$1"; then
        git -C "$1" rev-parse HEAD
    else
        echo "no repository"
    fi
}

# The branch $1 has checked out, "detached", or "no repository".
branch_of() {
    if is_repo "$1"; then
        git -C "$1" symbolic-ref -q --short HEAD || echo detached
    else
        echo "no repository"
    fi
}

# project/upgrade-pull's stdout and stderr, $w shown as W so a report reads the
# same from run to run.
output() {
    local out err
    out=$(<"$w/out")
    err=$(<"$w/err")
    echo "stdout: ${out//"$w"/W}"
    echo "stderr: ${err//"$w"/W}"
}

# Runs project/upgrade-pull in app for case $1, keeping its status in rc, its
# stdout in $w/out and its stderr in $w/err, and records a failure for each line
# of either that is the scripts' own rather than git's. git's text varies with
# its version, so it is not compared; a line of their own is told by its shape:
# a program's prefix, a shell trace, or a leading path, as a FILE: message has.
run() {
    local stream line
    rc=0
    (cd "$w/app" && "$pull") >"$w/out" 2>"$w/err" || rc=$?
    for stream in out err; do
        while IFS= read -r line <&3; do
            line=${line//"$w"/W}
            case $line in
            upgrade-pull:* | submodule-init:* | +* | /* | W/*)
                fail "$1" "std$stream has a line of its own: $line"
                ;;
            esac
        done 3<"$w/$stream"
    done
}

# Records a failure of case $1 where $3 is not $4, $2 naming what was asked.
expect() {
    if [ "$3" != "$4" ]; then
        fail "$1" "$2 is $3, not $4: $(output)"
    fi
}

# Records a failure of case $1 unless project/upgrade-pull failed.
expect_failure() {
    if [ "$rc" -eq 0 ]; then
        fail "$1" "exit 0, not a failure: $(output)"
    fi
}

# On a feature branch, the parent follows that branch's upstream, and each
# submodule its own default branch rather than one named for the parent's.
fixture
git -C "$w/app.up" checkout -q -b topic
git -C "$w/app.up" push -q -u origin topic
git -C "$w/app" fetch -q
git -C "$w/app" checkout -q topic
upcommit app topic2
upcommit lib lib2
upcommit deep deep2
run feature
expect feature status "$rc" 0
expect feature "app's branch" "$(branch_of "$w/app")" topic
expect feature "app's commit" "$(head_of "$w/app")" \
    "$(git -C "$w/app.git" rev-parse topic)"
expect feature "lib's branch" "$(branch_of "$w/app/lib")" release/x
expect feature "lib's commit" "$(head_of "$w/app/lib")" \
    "$(git -C "$w/lib.git" rev-parse release/x)"
expect feature "deep's branch" "$(branch_of "$w/app/lib/deep")" trunk
expect feature "deep's commit" "$(head_of "$w/app/lib/deep")" \
    "$(git -C "$w/deep.git" rev-parse trunk)"

# Puts app on branch topic, pushed with its upstream, and lists lib in its
# .projects.
topic() {
    git -C "$w/app.up" checkout -q -b topic
    git -C "$w/app.up" push -q -u origin topic
    git -C "$w/app" fetch -q
    git -C "$w/app" checkout -q topic
    printf 'lib\n' >"$w/app/.projects"
}

# On a feature branch, a listed project takes a new branch of the parent's
# name, from origin's default branch and with no upstream, while a submodule not
# listed, deep, stays on its own default branch.
fixture
topic
upcommit lib lib2
run branch-new
expect branch-new status "$rc" 0
expect branch-new "lib's branch" "$(branch_of "$w/app/lib")" topic
expect branch-new "lib's commit" "$(head_of "$w/app/lib")" \
    "$(git -C "$w/lib.git" rev-parse release/x)"
expect branch-new "lib's upstream" \
    "$(git -C "$w/app/lib" config branch.topic.remote || echo none)" none
expect branch-new "deep's branch" "$(branch_of "$w/app/lib/deep")" trunk

# A project .projects spells otherwise than git records it, as ./lib, is still
# known as listed and branched.
fixture
topic
printf './lib\n' >"$w/app/.projects"
run branch-spelling
expect branch-spelling status "$rc" 0
expect branch-spelling "lib's branch" "$(branch_of "$w/app/lib")" topic

# A listed project's branch of that name that already exists is taken as it
# stands, holding a commit the default branch lacks.
fixture
topic
git -C "$w/app/lib" checkout -q -b topic
git -C "$w/app/lib" commit -q --allow-empty -m upgrade
before=$(head_of "$w/app/lib")
upcommit lib lib2
run branch-local
expect branch-local status "$rc" 0
expect branch-local "lib's branch" "$(branch_of "$w/app/lib")" topic
expect branch-local "lib's commit" "$(head_of "$w/app/lib")" "$before"

# A branch of that name only on a listed project's origin is refused before any
# submodule moves, since the upgrade would run its Makefile unreviewed. The
# refusal is the script's own line, so the case runs it apart from run.
fixture
topic
git -C "$w/lib.up" checkout -q -b topic
git -C "$w/lib.up" commit -q --allow-empty -m upgrade
git -C "$w/lib.up" push -q -u origin topic
git -C "$w/lib.up" checkout -q release/x
upcommit lib lib2
upcommit deep deep2
before_lib=$(head_of "$w/app/lib")
before_deep=$(head_of "$w/app/lib/deep")
rc=0
(cd "$w/app" && "$pull") >"$w/out" 2>"$w/err" || rc=$?
expect_failure branch-remote
expect branch-remote "lib's commit" "$(head_of "$w/app/lib")" "$before_lib"
expect branch-remote "deep's commit" "$(head_of "$w/app/lib/deep")" \
    "$before_deep"
if ! grep -qxF "upgrade-pull: $w/app/lib: origin/topic exists with no local \
topic; check it out once reviewed" "$w/err"; then
    fail branch-remote "stderr lacks the refusal: $(output)"
fi

# A listed project's existing branch whose .gitmodules adds a submodule its
# default branch lacks has that submodule initialised and followed.
fixture
topic
mkrepo more trunk
git -C "$w/lib.up" checkout -q -b topic
git -C "$w/lib.up" submodule add -q "$w/more.git" more
git -C "$w/lib.up" commit -q -m "add more"
git -C "$w/lib.up" push -q -u origin topic
git -C "$w/app/lib" fetch -q
git -C "$w/app/lib" branch -q --no-track topic origin/topic
run branch-nested
expect branch-nested status "$rc" 0
expect branch-nested "lib's branch" "$(branch_of "$w/app/lib")" topic
expect branch-nested "more's branch" "$(branch_of "$w/app/lib/more")" trunk
expect branch-nested "more's commit" "$(head_of "$w/app/lib/more")" \
    "$(git -C "$w/more.git" rev-parse trunk)"

# With no origin/HEAD in the parent, as after git init and a push, the default
# branch is asked of origin: on it, a listed project stays on its own default
# branch, and on a feature branch takes one of that name. followRemoteHEAD is
# never, since a fetch from git 2.48 on would otherwise recreate the ref; older
# git ignores it.
no_origin_head() {
    git -C "$w/app" symbolic-ref --delete refs/remotes/origin/HEAD
    git -C "$w/app" config remote.origin.followRemoteHEAD never
}
fixture
printf 'lib\n' >"$w/app/.projects"
no_origin_head
upcommit lib lib2
run no-origin-head
expect no-origin-head status "$rc" 0
expect no-origin-head "lib's branch" "$(branch_of "$w/app/lib")" release/x
expect no-origin-head "lib's commit" "$(head_of "$w/app/lib")" \
    "$(git -C "$w/lib.git" rev-parse release/x)"
fixture
topic
no_origin_head
run no-origin-head-branch
expect no-origin-head-branch status "$rc" 0
expect no-origin-head-branch "lib's branch" "$(branch_of "$w/app/lib")" topic

# On the default branch, a listed project stays on its own default branch.
fixture
printf 'lib\n' >"$w/app/.projects"
upcommit lib lib2
run listed-default
expect listed-default status "$rc" 0
expect listed-default "lib's branch" "$(branch_of "$w/app/lib")" release/x
expect listed-default "lib's commit" "$(head_of "$w/app/lib")" \
    "$(git -C "$w/lib.git" rev-parse release/x)"

# A submodule added to the parent upstream is initialised and followed.
fixture
mkrepo extra trunk
upadd app extra
run added
expect added status "$rc" 0
expect added "extra's branch" "$(branch_of "$w/app/extra")" trunk
expect added "extra's commit" "$(head_of "$w/app/extra")" \
    "$(git -C "$w/extra.git" rev-parse trunk)"

# A submodule added inside a submodule upstream is initialised by its parent's
# step of the sweep, before the sweep descends into it.
fixture
mkrepo more trunk
upadd lib more
run nested-added
expect nested-added status "$rc" 0
expect nested-added "more's branch" "$(branch_of "$w/app/lib/more")" trunk
expect nested-added "more's commit" "$(head_of "$w/app/lib/more")" \
    "$(git -C "$w/more.git" rev-parse trunk)"

# A URL moved in the parent's .gitmodules reaches its configuration and the
# submodule's remote, and the pull fetches from it: the old one is gone.
fixture
upmove app lib
upcommit lib lib2
run moved
expect moved status "$rc" 0
expect moved "app's lib URL" "$(git -C "$w/app" config submodule.lib.url)" \
    "$w/lib-moved.git"
expect moved "lib's remote" "$(git -C "$w/app/lib" remote get-url origin)" \
    "$w/lib-moved.git"
expect moved "lib's commit" "$(head_of "$w/app/lib")" \
    "$(git -C "$w/lib-moved.git" rev-parse release/x)"

# As above, for a URL moved in a submodule's .gitmodules.
fixture
upmove lib deep
upcommit deep deep2
run nested-moved
expect nested-moved status "$rc" 0
expect nested-moved "lib's deep URL" \
    "$(git -C "$w/app/lib" config submodule.deep.url)" "$w/deep-moved.git"
expect nested-moved "deep's remote" \
    "$(git -C "$w/app/lib/deep" remote get-url origin)" "$w/deep-moved.git"
expect nested-moved "deep's commit" "$(head_of "$w/app/lib/deep")" \
    "$(git -C "$w/deep-moved.git" rev-parse trunk)"

# An update of none, set in .gitmodules, is overridden: honoured, it would leave
# a submodule added upstream empty.
fixture
mkrepo extra trunk
git -C "$w/app.up" submodule add -q "$w/extra.git" extra
git -C "$w/app.up" config -f .gitmodules submodule.extra.update none
git -C "$w/app.up" add .gitmodules
git -C "$w/app.up" commit -q -m "add extra"
git -C "$w/app.up" push -q
run update-none
expect update-none status "$rc" 0
expect update-none "extra's branch" "$(branch_of "$w/app/extra")" trunk
expect update-none "extra's commit" "$(head_of "$w/app/extra")" \
    "$(git -C "$w/extra.git" rev-parse trunk)"

# A submodule already checked out is not checked out again at the commit app
# records: lib, ahead of it, holds an uncommitted edit to a file changed since,
# which that checkout would refuse to overwrite.
fixture
echo upstream >"$w/lib.up/file"
git -C "$w/lib.up" add file
git -C "$w/lib.up" commit -q -m file
git -C "$w/lib.up" push -q
git -C "$w/app/lib" checkout -q release/x
git -C "$w/app/lib" pull -q --ff-only
echo local >"$w/app/lib/file"
upcommit lib lib2
run dirty-ahead
expect dirty-ahead status "$rc" 0
expect dirty-ahead "lib's branch" "$(branch_of "$w/app/lib")" release/x
expect dirty-ahead "lib's commit" "$(head_of "$w/app/lib")" \
    "$(git -C "$w/lib.git" rev-parse release/x)"
expect dirty-ahead "lib's file" "$(<"$w/app/lib/file")" local

# A parent branch with no upstream, as one made for the sweep, has nothing to
# fast-forward and goes on to move the submodules.
fixture
git -C "$w/app" checkout -q -b local
upcommit lib lib2
run no-upstream
expect no-upstream status "$rc" 0
expect no-upstream "app's branch" "$(branch_of "$w/app")" local
expect no-upstream "app's commit" "$(head_of "$w/app")" \
    "$(git -C "$w/app.git" rev-parse main)"
expect no-upstream "lib's commit" "$(head_of "$w/app/lib")" \
    "$(git -C "$w/lib.git" rev-parse release/x)"

# A parent branch with no upstream behind origin's default branch is
# fast-forwarded to it.
fixture
git -C "$w/app" checkout -q -b local
upcommit app app2
run no-upstream-behind
expect no-upstream-behind status "$rc" 0
expect no-upstream-behind "app's branch" "$(branch_of "$w/app")" local
expect no-upstream-behind "app's commit" "$(head_of "$w/app")" \
    "$(git -C "$w/app.git" rev-parse main)"

# A parent branch whose upstream origin no longer holds, as once a merged pull
# request's branch is deleted, is fast-forwarded to origin's default branch,
# though its remote-tracking ref is still present.
fixture
topic
git -C "$w/app.up" checkout -q main
git -C "$w/app.up" push -q origin --delete topic
upcommit app app2
run upstream-deleted
expect upstream-deleted status "$rc" 0
expect upstream-deleted "app's branch" "$(branch_of "$w/app")" topic
expect upstream-deleted "app's commit" "$(head_of "$w/app")" \
    "$(git -C "$w/app.git" rev-parse main)"

# A parent branch with commits of its own whose upstream origin no longer holds,
# as once a pull request merged by squash or rebase has its branch deleted, has
# diverged from origin's default branch and fails before any submodule moves.
fixture
topic
git -C "$w/app" commit -q --allow-empty -m own
git -C "$w/app" push -q
git -C "$w/app.up" checkout -q main
git -C "$w/app.up" push -q origin --delete topic
upcommit app squashed
upcommit lib lib2
before=$(head_of "$w/app/lib")
run upstream-deleted-squashed
expect_failure upstream-deleted-squashed
expect upstream-deleted-squashed "lib's commit" "$(head_of "$w/app/lib")" \
    "$before"

# A parent branch whose upstream's remote cannot be reached fails before any
# submodule moves, rather than being taken for one with no upstream.
fixture
git -C "$w/app" remote add gone "$w/gone.git"
git -C "$w/app" checkout -q -b local
git -C "$w/app" config branch.local.remote gone
git -C "$w/app" config branch.local.merge refs/heads/main
upcommit lib lib2
before=$(head_of "$w/app/lib")
run upstream-unreachable
expect_failure upstream-unreachable
expect upstream-unreachable "lib's commit" "$(head_of "$w/app/lib")" "$before"

# A parent branch with no upstream diverged from origin's default branch fails
# before any submodule moves.
fixture
git -C "$w/app" checkout -q -b local
git -C "$w/app" commit -q --allow-empty -m local
upcommit app app2
upcommit lib lib2
before=$(head_of "$w/app/lib")
run no-upstream-diverged
expect_failure no-upstream-diverged
expect no-upstream-diverged "lib's commit" "$(head_of "$w/app/lib")" "$before"

# A detached HEAD is refused before any submodule moves, with its own message.
# The refusal is the script's own line, so the case runs it apart from run.
fixture
git -C "$w/app" checkout -q --detach
upcommit lib lib2
before=$(head_of "$w/app/lib")
rc=0
(cd "$w/app" && "$pull") >"$w/out" 2>"$w/err" || rc=$?
expect_failure detached
expect detached "lib's commit" "$(head_of "$w/app/lib")" "$before"
if ! grep -qxF "upgrade-pull: HEAD is detached; check out a branch" \
    "$w/err"; then
    fail detached "stderr lacks the refusal: $(output)"
fi

# Outside any repository, git's own message stands alone, with no claim of a
# detached HEAD.
fixture
mkdir "$w/none"
rc=0
(cd "$w/none" && GIT_CEILING_DIRECTORIES=$w "$pull") >"$w/out" 2>"$w/err" ||
    rc=$?
expect_failure no-repo
if grep -q "^upgrade-pull:" "$w/err"; then
    fail no-repo "stderr has a line of its own: $(output)"
fi

# A parent diverged from its upstream fails before any submodule moves.
fixture
git -C "$w/app" commit -q --allow-empty -m local
upcommit app app2
upcommit lib lib2
before=$(head_of "$w/app/lib")
run diverged
expect_failure diverged
expect diverged "lib's commit" "$(head_of "$w/app/lib")" "$before"

# A submodule diverged from its upstream fails.
fixture
git -C "$w/app/lib" checkout -q release/x
git -C "$w/app/lib" commit -q --allow-empty -m local
upcommit lib lib2
run sub-diverged
expect_failure sub-diverged

if [ "$failures" -gt 0 ]; then
    exit 1
fi
