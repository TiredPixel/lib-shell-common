#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
source "$dir/lint-args"

# --fix takes an optional rule list, so -- ends the options before the paths.
# 8 is ansible-lint's FIXED_VIOLATIONS: files rewritten, nothing left to report.
status=0
ansible-lint "${ansible_lint_args[@]}" --fix -- "$@" || status=$?
case $status in
0 | 8) ;;
*) exit "$status" ;;
esac
