#!/usr/bin/env bash
#
# Tests project/release-create-stable in place against real repositories in a
# scratch dir: a parent, app, whose .projects names its submodule lib, each with
# a bare origin, $w/app.git and $w/lib.git, holding branches testing, the
# default, and stable, and an upstream clone, $w/app.up and $w/lib.up. app is a
# clone of app.git recording lib at its first commit, one, where both branches
# start, and lib.up has since pushed a second, two, to testing, which a case
# takes as an upgrade would, by checking lib out at it, so a release has a
# pointer to commit. Signing goes through a fake gpg.program in a scratch
# GNUPGHOME, so no real key or pinentry is reached. Every case builds its
# fixture afresh and runs project/release-create-stable in app.
#
# Run: test/project/release-create-stable.test. Exits 1 naming each case that
# failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

release=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../../project")/release-create-stable
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

mkdir "$work/bin" "$work/gnupg"
chmod 700 "$work/gnupg"
# Answers only the call git makes to sign, with the status line git looks for
# after a newline.
cat >"$work/bin/gpg" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
if [ "$*" != "--status-fd=2 -bsau test-key" ]; then
    echo "fake gpg: unexpected arguments: $*" >&2
    exit 2
fi
cat >/dev/null
printf '[GNUPG:] KEY_CONSIDERED FAKE 0\n[GNUPG:] SIG_CREATED D 1 8 00 0 FAKE\n' >&2
printf -- '-----BEGIN PGP SIGNATURE-----\n\nfake\n-----END PGP SIGNATURE-----\n'
EOF
chmod +x "$work/bin/gpg"

# Nothing from the caller's configuration reaches the fixtures, and nothing
# above the scratch dir is taken for a repository. File URLs are refused to
# submodules by default.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
export GIT_CEILING_DIRECTORIES=$work GNUPGHOME=$work/gnupg
export GIT_CONFIG_COUNT=6
export GIT_CONFIG_KEY_0=protocol.file.allow GIT_CONFIG_VALUE_0=always
export GIT_CONFIG_KEY_1=user.name GIT_CONFIG_VALUE_1=test
export GIT_CONFIG_KEY_2=user.email GIT_CONFIG_VALUE_2=test@example.com
export GIT_CONFIG_KEY_3=init.defaultBranch GIT_CONFIG_VALUE_3=main
export GIT_CONFIG_KEY_4=gpg.program GIT_CONFIG_VALUE_4=$work/bin/gpg
export GIT_CONFIG_KEY_5=user.signingKey GIT_CONFIG_VALUE_5=test-key

failures=0

# Reports a failure of case $1 at once, each line of $2 under the program and
# the case, so a later abort cannot hide it.
fail() {
    local line
    while IFS= read -r line <&3; do
        echo "${0##*/}: $1: $line" >&2
    done 3<<<"$2"
    failures=$((failures + 1))
}

n=0

# Creates bare remote $w/$1.git, its default branch testing, and $w/$1.up, a
# repository on testing pushing to it.
mkrepo() {
    git init -q --bare "$w/$1.git"
    git -C "$w/$1.git" symbolic-ref HEAD refs/heads/testing
    git init -q -b testing "$w/$1.up"
    git -C "$w/$1.up" remote add origin "$w/$1.git"
}

# A fresh fixture in $w, as the header describes, with one and two naming lib's
# commits and init app's.
fixture() {
    n=$((n + 1))
    w=$work/$n
    mkdir "$w"
    mkrepo lib
    git -C "$w/lib.up" commit -q --allow-empty -m one
    git -C "$w/lib.up" push -q origin testing testing:stable
    mkrepo app
    git -C "$w/app.up" submodule add -q "$w/lib.git" lib
    echo lib >"$w/app.up/.projects"
    git -C "$w/app.up" add .projects
    git -C "$w/app.up" commit -q -m init
    git -C "$w/app.up" push -q origin testing testing:stable
    git clone -q --recurse-submodules "$w/app.git" "$w/app"
    git -C "$w/lib.up" commit -q --allow-empty -m two
    git -C "$w/lib.up" push -q origin testing
    one=$(git -C "$w/lib.up" rev-parse HEAD~)
    two=$(git -C "$w/lib.up" rev-parse HEAD)
    init=$(git -C "$w/app" rev-parse HEAD)
}

# Checks lib out at two, detached, as the commit built.
upgraded() {
    git -C "$w/app/lib" fetch -q
    git -C "$w/app/lib" checkout -q --detach "$two"
}

# Runs project/release-create-stable in app with the arguments given, keeping
# its status in rc and its stderr in $w/err.
run() {
    rc=0
    (cd "$w/app" && "$release" "$@") >"$w/out" 2>"$w/err" || rc=$?
}

# Records a failure of case $1 where $3 is not $4, $2 naming what was asked.
expect() {
    if [ "$3" != "$4" ]; then
        fail "$1" "$2 is $3, not $4: $(<"$w/err")"
    fi
}

# The commit $2 names in repository $1, or "none".
commit_of() {
    git -C "$1" rev-parse -q --verify "$2^{commit}" || echo none
}

# Records a failure of case $1 unless the release of tag 1.2 onto testing went
# through: lib's testing moved to two, its pointer committed in app as "Release
# 1.2", both tagged and signed there, and tag and testing pushed to each origin.
expect_testing() {
    local r
    expect "$1" "lib's 1.2" "$(commit_of "$w/app/lib" 1.2)" "$two"
    expect "$1" "app's 1.2:lib" \
        "$(git -C "$w/app" rev-parse -q --verify 1.2:lib || echo none)" "$two"
    expect "$1" "app's 1.2 parent" "$(commit_of "$w/app" 1.2~)" "$init"
    expect "$1" "app's 1.2 message" \
        "$(git -C "$w/app" log --no-show-signature -1 --format=%s 1.2)" \
        "Release 1.2"
    for r in app app/lib; do
        if ! git -C "$w/$r" cat-file tag 1.2 |
            grep -qFx -- '-----BEGIN PGP SIGNATURE-----'; then
            fail "$1" "$r's 1.2 is not signed: $(<"$w/err")"
        fi
        expect "$1" "$r's origin's 1.2" \
            "$(git -C "$w/${r##*/}.git" rev-parse -q --verify refs/tags/1.2)" \
            "$(git -C "$w/$r" rev-parse refs/tags/1.2)"
        expect "$1" "$r's origin's testing" \
            "$(commit_of "$w/${r##*/}.git" testing)" "$(commit_of "$w/$r" 1.2)"
    done
}

# A whole release: onto testing, then stable fast-forwarded to the tag and
# pushed to each origin.
fixture
upgraded
run 1.2
expect release status "$rc" 0
expect_testing release
for r in app app/lib; do
    expect release "$r's origin's stable" \
        "$(commit_of "$w/${r##*/}.git" stable)" "$(commit_of "$w/$r" 1.2)"
done

# A failure on testing leaves stable alone: testing is not pushed, and stable is
# neither checked out nor pushed.
fixture
upgraded
git -C "$w/app/lib" tag 1.2 "$one"
run 1.2
expect tag-fails status "$rc" 1
expect tag-fails "app's 1.2" "$(commit_of "$w/app" 1.2)" none
expect tag-fails "app's origin's testing" "$(commit_of "$w/app.git" testing)" \
    "$init"
expect tag-fails "app's origin's stable" "$(commit_of "$w/app.git" stable)" \
    "$init"
expect tag-fails "lib's origin's stable" "$(commit_of "$w/lib.git" stable)" \
    "$one"
expect tag-fails "lib's stable" "$(commit_of "$w/app/lib" refs/heads/stable)" \
    none

# Stable carrying commits of its own cannot fast-forward to the tag, so it is
# pushed nowhere, though testing and the tag already were.
fixture
upgraded
git -C "$w/app.up" checkout -q stable
git -C "$w/app.up" commit -q --allow-empty -m own
git -C "$w/app.up" push -q origin stable
own=$(git -C "$w/app.up" rev-parse HEAD)
run 1.2
[ "$rc" -ne 0 ] || fail merge-fails "exit 0, not a failure: $(<"$w/err")"
expect_testing merge-fails
expect merge-fails "app's origin's stable" "$(commit_of "$w/app.git" stable)" \
    "$own"
expect merge-fails "lib's origin's stable" "$(commit_of "$w/lib.git" stable)" \
    "$one"

# Nothing is pulled in: lib's origin's testing holds a commit beyond one, which
# lib, left there, lacks, so the release stops before any project moves.
fixture
run 1.2
expect testing-ahead status "$rc" 1
expect testing-ahead stderr \
    "$(grep -F -- "$w/app/lib: refs/remotes/origin/testing" "$w/err")" \
    "release-branch-ready: $w/app/lib: refs/remotes/origin/testing has commits HEAD lacks, and a release pulls nothing in; upgrade to take them"
expect testing-ahead "app's HEAD" "$(git -C "$w/app" rev-parse HEAD)" "$init"
expect testing-ahead "lib's HEAD" "$(git -C "$w/app/lib" rev-parse HEAD)" \
    "$one"
for r in app app/lib; do
    expect testing-ahead "$r's 1.2" "$(commit_of "$w/$r" 1.2)" none
done

# Stable is readied as testing is: lib's origin's stable holding a commit the
# tag lacks stops the release after testing and before stable moves anywhere.
fixture
upgraded
git -C "$w/lib.up" checkout -q stable
git -C "$w/lib.up" commit -q --allow-empty -m own
git -C "$w/lib.up" push -q origin stable
own=$(git -C "$w/lib.up" rev-parse HEAD)
run 1.2
expect stable-ahead status "$rc" 1
expect_testing stable-ahead
expect stable-ahead stderr \
    "$(grep -F -- "$w/app/lib: refs/remotes/origin/stable" "$w/err")" \
    "release-branch-ready: $w/app/lib: refs/remotes/origin/stable has commits HEAD lacks, and a release pulls nothing in; upgrade to take them"
expect stable-ahead "app's branch" \
    "$(git -C "$w/app" symbolic-ref --short HEAD)" testing
expect stable-ahead "lib's stable" "$(commit_of "$w/app/lib" refs/heads/stable)" \
    none
expect stable-ahead "app's origin's stable" "$(commit_of "$w/app.git" stable)" \
    "$init"
expect stable-ahead "lib's origin's stable" "$(commit_of "$w/lib.git" stable)" \
    "$own"

# A missing, empty or extra argument is refused with the usage before anything
# runs: lib is not checked out on testing and app commits nothing.
for args in no-tag empty-tag extra; do
    fixture
    case $args in
    no-tag) run ;;
    empty-tag) run "" ;;
    extra) run 1.2 1.3 ;;
    esac
    expect "$args" status "$rc" 2
    expect "$args" stderr "$(<"$w/err")" "Usage: release-create-stable TAG"
    expect "$args" stdout "$(<"$w/out")" ""
    expect "$args" "app's HEAD" "$(git -C "$w/app" rev-parse HEAD)" "$init"
    expect "$args" "lib's HEAD" "$(git -C "$w/app/lib" rev-parse HEAD)" "$one"
    if git -C "$w/app/lib" symbolic-ref -q HEAD >/dev/null; then
        fail "$args" "lib was checked out on a branch"
    fi
done

if [ "$failures" -gt 0 ]; then
    exit 1
fi
