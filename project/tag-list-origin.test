#!/usr/bin/env bash
#
# Tests project/tag-list-origin against a real repository in a scratch dir, app,
# with a bare origin. A fake timeout on PATH expires at once where FAKE_EXPIRE
# is set, else runs the command. Every case builds its fixture afresh.
#
# Run: project/tag-list-origin.test. Exits 1 naming each case that failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

list=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tag-list-origin
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

mkdir "$work/bin"
# Insists on --foreground, which keeps a prompt answerable, and on the bound.
cat >"$work/bin/timeout" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
if [ "${1:-}" != --foreground ] || [ "${2:-}" != 60 ]; then
    echo "fake timeout: unexpected arguments: $*" >&2
    exit 2
fi
if [ -n "${FAKE_EXPIRE:-}" ]; then
    exit 124
fi
exec "${@:3}"
EOF
chmod +x "$work/bin/timeout"
export PATH=$work/bin:$PATH

# Nothing from the caller's configuration reaches the fixtures, and nothing
# above the scratch dir is taken for a repository.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
export GIT_CEILING_DIRECTORIES=$work
export GIT_CONFIG_COUNT=3
export GIT_CONFIG_KEY_0=user.name GIT_CONFIG_VALUE_0=test
export GIT_CONFIG_KEY_1=user.email GIT_CONFIG_VALUE_1=test@example.com
export GIT_CONFIG_KEY_2=init.defaultBranch GIT_CONFIG_VALUE_2=main

failed=()
n=0

# A fresh fixture in $w: app, holding one commit, with a lightweight tag 1.1
# and an annotated tag 1.2 pushed to its bare origin, $w/app.git, and a tag 1.3
# that is not.
fixture() {
    n=$((n + 1))
    w=$work/$n
    mkdir "$w"
    git init -q --bare "$w/app.git"
    git init -q "$w/app"
    git -C "$w/app" commit -q --allow-empty -m init
    git -C "$w/app" tag 1.1
    git -C "$w/app" tag -a -m 1.2 1.2
    git -C "$w/app" tag 1.3
    git -C "$w/app" remote add origin "$w/app.git"
    git -C "$w/app" push -q origin main 1.1 1.2
}

# Runs project/tag-list-origin in app, and checks its status is $2, its stdout
# is $3 and its stderr holds $4, where $4 is given.
check() {
    local name=$1 status=$2 want=$3 err=${4:-} rc=0
    (cd "$w/app" && "$list") >"$w/out" 2>"$w/err" || rc=$?
    if [ "$rc" != "$status" ]; then
        failed+=("$name: exit $rc, not $status: $(<"$w/err")")
    fi
    if [ "$(<"$w/out")" != "$want" ]; then
        failed+=("$name: listed: $(<"$w/out")")
    fi
    if [ -n "$err" ] && ! grep -qF -- "$err" "$w/err"; then
        failed+=("$name: stderr lacks '$err': $(<"$w/err")")
    fi
}

# The origin's tags, each once, without the annotated one's peeled line, and
# not the tag only held locally.
fixture
check lists 0 "$(printf '%s\trefs/tags/%s\n' \
    "$(git -C "$w/app" rev-parse 1.1)" 1.1 \
    "$(git -C "$w/app" rev-parse 1.2)" 1.2)"

# An origin that does not answer in time fails, saying so.
fixture
FAKE_EXPIRE=1 check expired 124 "" \
    "tag-list-origin: $w/app: origin did not answer within 60 s"

# An origin that cannot be reached fails with git's status, not as an expiry.
fixture
git -C "$w/app" remote set-url origin "$w/missing.git"
check unreachable 128 ""
if grep -qF "did not answer" "$w/err"; then
    failed+=("unreachable: reported as an expiry: $(<"$w/err")")
fi

# Every line of a failure carries the program and the case, captured output
# included.
if [ ${#failed[@]} -gt 0 ]; then
    for f in "${failed[@]}"; do
        failed_case=${f%%: *}
        while IFS= read -r failed_line <&3; do
            echo "${0##*/}: $failed_case: $failed_line" >&2
        done 3<<<"${f#"$failed_case: "}"
    done
    exit 1
fi
