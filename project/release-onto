# shellcheck shell=bash
#
# Sourced by project/release-create-latest and project/release-create-stable,
# which release onto a branch by the same steps. Sets no shell options, since it
# runs under its caller's.
#
# Every step returns its status on failure, because errexit cannot be relied on
# to: it is off in a caller that sets no options, and bash ignores it throughout
# a function called under if, while, ! or before && or ||, even in a caller that
# sets it.

# Readies branch $2 in every project, through project/release-branch-ready in
# directory $1, moving it to HEAD.
release_checkout() {
    local dir=$1

    "$dir/release-branch-ready" "$2" || return
}

# Pushes branch $2 in every project, through project/each in directory $1, with
# tag $3 where one is given. Remote and refspecs named, whatever the caller's
# push.default, remote.pushDefault or push.followTags; refs/tags/ so a branch of
# the same name cannot make the tag's refspec ambiguous. --atomic so an origin
# that refuses either ref takes neither, and never holds a tag no branch
# contains; a project swept before the one refused stays pushed.
release_push() {
    local dir=$1 branch=$2 refs

    refs=("$branch:$branch")
    if [ $# -gt 2 ]; then
        refs+=("refs/tags/$3")
    fi

    "$dir/each" git push --atomic --no-follow-tags \
        --recurse-submodules=check origin "${refs[@]}" || return
}

# Releases tag $3 from branch $2 in every project, through the project/ scripts
# in directory $1: refuses a tree in no state to release, a tag that already
# exists and a branch not ready, then readies each project's $2, commits the
# submodule pointers, tags, and pushes $2 with the tag. Each branch after $3 is
# one the caller moves to the tag afterwards, checked here so that one not ready
# stops the release before anything moves, rather than once it is half
# published.
release_onto() {
    local dir=$1 branch=$2 tag=$3 later

    "$dir/release-assert" || return

    # Before the commit, which names the tag, so a tag refused leaves no
    # "Release TAG" commit behind for a rerun with another tag to build on.
    "$dir/tag-create" --check "$tag" || return

    for later in "${@:4}"; do
        "$dir/release-branch-ready" --check "$later" || return
    done

    release_checkout "$dir" "$branch" || return

    "$dir/release-commit-submodules" "$tag" || return

    # Signed everywhere first, so a signing failure publishes nothing, then
    # pushed with the branch.
    "$dir/tag-create" --no-push "$tag" || return

    release_push "$dir" "$branch" "$tag" || return
}
