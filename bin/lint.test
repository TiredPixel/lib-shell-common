#!/usr/bin/env bash
#
# Tests bin/lint in a scratch tree beside a stub bin/files, so the case decides
# which files it lists, independent of the real list, and a stub lint/yaml-keys,
# with every tool it runs faked on PATH. Each fake logs its name and arguments,
# each shell-quoted, and exits 7 where FAKE_FAIL names it, or on the one call
# whose log line FAKE_FAIL holds whole; the stub yaml-keys logs the names it
# reads in place of arguments. A case checks the whole log, so a tool given any
# argument other than those expected fails it.
#
# Run: bin/lint.test. Reports each case that failed on stderr, and exits 1 if
# any did.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

lint=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lint
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

tools=(shellcheck shfmt yamllint docker-compose actionlint dockerfmt hadolint
    mdformat checkmake dotenv-linter)

mkdir "$work/path"
cat >"$work/path/fake" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
l=$(
    printf %s "${0##*/}"
    printf ' %q' "$@"
)
echo "$l" >>"$FAKE_LOG"
if [ "${0##*/}" = "${FAKE_FAIL-}" ] || [ "$l" = "${FAKE_FAIL-}" ]; then
    exit 7
fi
EOF
chmod +x "$work/path/fake"
for tool in "${tools[@]}"; do
    ln -s fake "$work/path/$tool"
done
export FAKE_LOG=$work/log
export PATH=$work/path:$PATH

t=$work/tree
mkdir -p "$t/bin" "$t/lint"
cp -- "$lint" "$t/bin/lint"
cat >"$t/bin/files" <<'EOF'
# shellcheck shell=bash
shfmt_args=(--fake-shfmt)
shell_files=('s/a b' s/c)
compose_files=(c1.yml c2.yml)
workflow_files=()
if [ -n "${FAKE_WORKFLOWS-}" ]; then
    workflow_files=(w/a.yml 'w/b c.yml')
fi
yaml_files=(a.yml 'b c.yml')
docker_files=(Dockerfile)
dockerfmt_args=(--fake-dockerfmt)
markdown_files=(README.md)
mdformat_args=(--fake-mdformat)
make_files=(Makefile)
dotenv_files=(.env.example)
EOF
cat >"$t/lint/yaml-keys" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
mapfile -t -d '' names
{
    printf yaml-keys
    printf ' %q' "${names[@]}"
    echo
} >>"$FAKE_LOG"
if [ "${FAKE_FAIL-}" = yaml-keys ]; then
    exit 7
fi
EOF
chmod +x "$t/lint/yaml-keys"

# A log line as a fake writes it, for command $1 with the rest as arguments.
line() {
    printf %s "$1"
    shift
    printf ' %q' "$@"
    echo
}

# The whole log of a run that fails nowhere; with $1 set, the workflows too.
expected() {
    line shellcheck -x -P SCRIPTDIR 's/a b' s/c
    line shfmt --fake-shfmt -d 's/a b' s/c
    line yaml-keys a.yml 'b c.yml'
    line yamllint --strict a.yml 'b c.yml'
    line docker-compose -f c1.yml config -q
    line docker-compose -f c2.yml config -q
    if [ -n "${1-}" ]; then
        line actionlint w/a.yml 'w/b c.yml'
    fi
    line dockerfmt --fake-dockerfmt --check Dockerfile
    line hadolint Dockerfile
    line mdformat --fake-mdformat --check README.md
    line checkmake Makefile
    line dotenv-linter check .env.example
}

# The lines of $2 up to and including the first for command $1, or the line $1.
upto() {
    local l
    while IFS= read -r l <&3; do
        echo "$l"
        if [[ $l == "$1 "* || $l == "$1" ]]; then
            return
        fi
    done 3<<<"$2"
    echo "${0##*/}: upto: no line for $1" >&2
    exit 1
}

failures=0

# Reports that case $1 failed with detail $2, then each line of file $3 where
# given, every line prefixed.
fail() {
    local l
    echo "${0##*/}: $1: $2" >&2
    if [ -n "${3-}" ]; then
        while IFS= read -r l <&3; do
            echo "${0##*/}: $1: $l" >&2
        done 3<"$3"
    fi
    failures=$((failures + 1))
}

# The whole stderr of a run that fails nowhere, since the fakes print nothing;
# with $1 set, for 2 workflows, else for none.
progress() {
    local workflows=0
    if [ -n "${1-}" ]; then
        workflows=2
    fi
    echo "bin/lint: checking 2 shell file(s)"
    echo "bin/lint: checking 2 YAML file(s)"
    echo "bin/lint: checking c1.yml"
    echo "bin/lint: checking c2.yml"
    echo "bin/lint: checking $workflows workflow(s)"
    echo "bin/lint: checking 1 Dockerfile(s)"
    echo "bin/lint: checking 1 Markdown file(s)"
    echo "bin/lint: checking 1 Makefile(s)"
    echo "bin/lint: checking 1 dotenv file(s)"
}

# The progress line before each tool's check, where it fails on its first call.
declare -A section=(
    [shellcheck]="bin/lint: checking 2 shell file(s)"
    [shfmt]="bin/lint: checking 2 shell file(s)"
    ["yaml-keys"]="bin/lint: checking 2 YAML file(s)"
    [yamllint]="bin/lint: checking 2 YAML file(s)"
    ["docker-compose"]="bin/lint: checking c1.yml"
    [actionlint]="bin/lint: checking 2 workflow(s)"
    [dockerfmt]="bin/lint: checking 1 Dockerfile(s)"
    [hadolint]="bin/lint: checking 1 Dockerfile(s)"
    [mdformat]="bin/lint: checking 1 Markdown file(s)"
    [checkmake]="bin/lint: checking 1 Makefile(s)"
    ["dotenv-linter"]="bin/lint: checking 1 dotenv file(s)"
)

# Runs bin/lint in the tree and checks its status is $2, its log is $3, its
# stdout is empty and its stderr is $4.
check() {
    local name=$1 status=$2 log=$3 said=$4 rc=0
    : >"$FAKE_LOG"
    (cd "$t" && bin/lint) >"$work/out" 2>"$work/err" || rc=$?
    if [ "$rc" != "$status" ]; then
        fail "$name" "exit $rc, not $status" "$work/err"
    elif [ "$(<"$FAKE_LOG")" != "$log" ]; then
        fail "$name" "the log is:" "$FAKE_LOG"
    elif [ -s "$work/out" ]; then
        fail "$name" "stdout is not empty:" "$work/out"
    elif [ "$(<"$work/err")" != "$said" ]; then
        fail "$name" "stderr is:" "$work/err"
    fi
}

# With no workflow, actionlint is not run, since given no file it would look for
# workflows itself.
check no-workflows 0 "$(expected)" "$(progress)"

FAKE_WORKFLOWS=1 check workflows 0 "$(expected 1)" "$(progress 1)"

# Any failing check ends the run with its status, running nothing after it.
all=$(expected 1)
said=$(progress 1)
for tool in "${tools[@]}" yaml-keys; do
    want=$(upto "$tool" "$all")
    heard=$(upto "${section[$tool]}" "$said")
    FAKE_WORKFLOWS=1 FAKE_FAIL=$tool check "fails-$tool" 7 "$want" "$heard"
done

# A failure on a later compose file ends the run too, after it says which.
c2=$(line docker-compose -f c2.yml config -q)
want=$(upto "$c2" "$all")
heard=$(upto "bin/lint: checking c2.yml" "$said")
FAKE_WORKFLOWS=1 FAKE_FAIL=$c2 check fails-compose-c2 7 "$want" "$heard"

if [ "$failures" -gt 0 ]; then
    exit 1
fi
