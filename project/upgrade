#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
prog=${0##*/}

f_projects=.projects

# The sweep is defined by this list, so its absence is a broken checkout rather
# than an empty one: the per-project make stages below would find no project to
# run in, and the run would still complete having run them nowhere.
if [ ! -f "$f_projects" ]; then
    echo "$prog: $PWD: no $f_projects, so there is nothing to sweep" >&2
    exit 1
fi

echo "$prog: pull" >&2
"$dir/pull"

echo "$prog: upgrade" >&2
# make runs under `script` so the tools it drives still see a tty; -e so the
# status carried back out is make's own rather than script's, which is what
# tells the sweep an upgrade failed. Which project declares the target is
# make-if-declared's question, not this one's.
"$dir/each-without-project" "$dir/make-if-declared" upgrade sh -c '
    set -eu
    if script --version >/dev/null 2>&1; then
        script -q -e -c "make upgrade" /dev/null
    else
        script -e /dev/null make upgrade
    fi'

echo "$prog: rebuild" >&2
"$dir/each-without-project" "$dir/make-if-declared" build

echo "$prog: start" >&2
"$dir/start"

echo "$prog: stop" >&2
"$dir/stop"

echo "$prog: completed" >&2
