#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

# --ff-only here and below, whatever the caller's pull.rebase or pull.ff: a
# diverged branch stops the sweep, where a merge or a rebase would succeed,
# unseen, and a release would go on to push it.
git pull --ff-only --no-recurse-submodules

# foreach visits only submodules that are checked out, so one added upstream
# would be skipped without a word, and a URL changed in .gitmodules would never
# reach .git/config, leaving every later fetch on the old remote. Each level
# therefore syncs and initialises its own submodules from the .gitmodules it
# has just pulled -- this one here, each submodule inside the sweep below,
# before foreach lists and descends into its children. Neither is recursive,
# since the recursion is foreach's. --checkout overrides a
# submodule.<name>.update of rebase, merge or none, which would otherwise
# rebase or merge a branch onto the recorded commit, or skip the submodule.
# Initialising detaches a submodule already checked out onto the recorded
# commit; the sweep puts it back on its branch at once.
git submodule sync
git submodule update --init --checkout

# One sweep, from here, whose submodules are the projects .projects names --
# and --recursive reaches theirs in turn. It used to run from inside each
# project instead, which started the recursion one level too low: it brought
# each project's own submodules current but never the project, so a stage that
# reports having pulled everything left every project on whatever commit its
# working tree happened to sit on.
#
# checkout before pull, because a submodule is checked out at a recorded commit
# and a detached HEAD has nothing to pull into. The branch comes from
# origin/HEAD rather than a literal, so a project whose default branch is not
# the usual one still follows its own -- which is also why this cannot be
# git submodule update --remote, whose --rebase and --merge act on the branch
# the parent recorded instead. Only the remote's name is stripped, since a
# branch name may itself hold a slash.
# The string is for the sh foreach runs in each submodule, which expands it.
# shellcheck disable=SC2016
git submodule foreach --recursive '
    set -eu
    ref=$(git symbolic-ref --short refs/remotes/origin/HEAD)
    branch=${ref#origin/}
    git checkout --no-recurse-submodules "$branch"
    git pull --ff-only --no-recurse-submodules
    git submodule sync
    git submodule update --init --checkout'
