#!/usr/bin/env bash
#
# Tests project/release-assert against real repositories in a scratch dir: a
# parent, app, with submodules lib and ext, each with a bare remote. app's
# .projects names lib and ext2, so ext is the submodule the release leaves out.
# Every case builds its fixture afresh and runs project/release-assert in app.
#
# Run: project/release-assert.test. Exits 1 naming each case that failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

assert=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/release-assert
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

# Nothing from the caller's configuration reaches the fixtures, and nothing
# above the scratch dir is taken for a repository. File URLs are refused to
# submodules by default.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
export GIT_CEILING_DIRECTORIES=$work
export GIT_CONFIG_COUNT=4
export GIT_CONFIG_KEY_0=protocol.file.allow GIT_CONFIG_VALUE_0=always
export GIT_CONFIG_KEY_1=user.name GIT_CONFIG_VALUE_1=test
export GIT_CONFIG_KEY_2=user.email GIT_CONFIG_VALUE_2=test@example.com
export GIT_CONFIG_KEY_3=init.defaultBranch GIT_CONFIG_VALUE_3=main

failed=()
n=0

# A fresh fixture in $w, as the header describes.
fixture() {
    n=$((n + 1))
    w=$work/$n
    mkdir "$w"
    local r
    for r in lib ext; do
        git init -q --bare "$w/$r.git"
        git init -q "$w/$r.up"
        git -C "$w/$r.up" commit -q --allow-empty -m init
        git -C "$w/$r.up" push -q "$w/$r.git" main
    done
    git init -q "$w/app"
    git -C "$w/app" submodule add -q "$w/lib.git" lib
    git -C "$w/app" submodule add -q "$w/ext.git" ext
    printf '%s\n' lib ext2 >"$w/app/.projects"
    git -C "$w/app" add .projects
    git -C "$w/app" commit -q -m init
    unlisted="$w/app: not named in .projects, so this release will not tag:"
}

# Runs project/release-assert in app, or in its subdirectory $1, keeping its
# status in rc and its output in $w/out.
run() {
    rc=0
    (cd "$w/app/${1:-}" && "$assert") >"$w/out" 2>&1 || rc=$?
}

# Records a failure of case $1 unless project/release-assert exited $2 and its
# output holds each line after it, matched whole.
expect() {
    local name=$1 status=$2 line
    shift 2
    if [ "$rc" != "$status" ]; then
        failed+=("$name: exit $rc, not $status: $(<"$w/out")")
        return
    fi
    for line in "$@"; do
        grep -qFx -- "$line" "$w/out" ||
            failed+=("$name: output lacks '$line': $(<"$w/out")")
    done
}

# A clean tree passes, reporting the submodule .projects does not name whole:
# ext2 is not ext.
fixture
run
expect clean 0 "$unlisted" "  ext"
grep -qFx "  lib" "$w/out" && failed+=("clean: lib reported: $(<"$w/out")")

# With every submodule named, nothing is reported.
fixture
printf '%s\n' lib ext >"$w/app/.projects"
git -C "$w/app" commit -q -am "name ext"
run
expect all-listed 0
[ -s "$w/out" ] && failed+=("all-listed: output: $(<"$w/out")")

# Without .projects, every submodule is reported.
fixture
git -C "$w/app" rm -q .projects
git -C "$w/app" commit -q -m "drop .projects"
run
expect no-projects 0 "$unlisted" "  lib" "  ext"

# Below the top level, the release is refused.
fixture
mkdir "$w/app/sub"
run sub
expect subdir 1 \
    "$w/app/sub: refusing to release from below the top level, $w/app:"

# Work outside the submodules is refused, untracked included even where status
# is configured to hide it.
fixture
echo x >"$w/app/junk"
git -C "$w/app" config status.showUntrackedFiles no
run
expect untracked 1 \
    "$w/app: refusing to release, the tree carries work outside its submodules:" \
    "?? junk"

fixture
echo x >>"$w/app/.projects"
run
expect modified 1 \
    "$w/app: refusing to release, the tree carries work outside its submodules:" \
    " M .projects"

# A submodule's own work, or a pointer the sweep has moved, is not refused.
fixture
echo x >"$w/app/lib/junk"
git -C "$w/app/ext" commit -q --allow-empty -m moved
run
expect submodule-work 0 "$unlisted"

# An unmerged path is refused, a submodule's pointer included, with no
# operation in progress to catch it.
fixture
lib=$(git -C "$w/app" rev-parse HEAD:lib)
printf '%s\t%s\n' "0 0000000000000000000000000000000000000000" lib \
    "160000 $lib 1" lib "160000 $lib 2" lib "160000 $lib 3" lib |
    git -C "$w/app" update-index --index-info
run
expect unmerged 1 \
    "$w/app: refusing to release, the tree carries work outside its submodules:" \
    "UU lib"

# An operation in progress is refused.
fixture
head=$(git -C "$w/app" rev-parse HEAD)
for f in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    echo "$head" >"$w/app/.git/$f"
    run
    expect "op-$f" 1 \
        "$w/app: $f: an operation is in progress, so this is no state to release from"
    rm -- "$w/app/.git/$f"
done
for f in rebase-merge rebase-apply; do
    mkdir "$w/app/.git/$f"
    run
    expect "op-$f" 1 \
        "$w/app: $f: an operation is in progress, so this is no state to release from"
    rmdir -- "$w/app/.git/$f"
done

# A submodule whose directory is gone is refused.
fixture
rm -rf -- "$w/app/ext"
run
expect missing 1 "$w/app: ext: not checked out, so a release cannot record it"

# A submodule nobody initialised, its directory empty, is left alone.
fixture
git -C "$w/app" submodule deinit -q -f ext
run
expect uninitialised 0 "$unlisted" "  ext"

# A submodule directory holding content but no repository of its own is
# refused.
fixture
git -C "$w/app" submodule deinit -q -f ext
echo x >"$w/app/ext/file"
run
expect not-a-repository 1 \
    "$w/app: ext: has content but is not a repository of its own,"

if [ ${#failed[@]} -gt 0 ]; then
    printf 'FAILED %s\n' "${failed[@]}" >&2
    exit 1
fi
echo "ok"
