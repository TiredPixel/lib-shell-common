#!/usr/bin/env bash
#
# Prints the tag after the newest MAJOR.MINOR tag in this project and every
# project it sweeps: that tag with its minor raised by one.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=project/tag-next
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

usage() {
    echo "Usage: $prog" >&2
    exit 2
}

[ $# -eq 0 ] || usage

tags=$("$dir/each" git tag -l --no-column)
last=$({ grep -xE '[0-9]+\.[0-9]+' <<<"$tags" || [ $? -eq 1 ]; } |
    sort -V | sed -n '$p')

echo "${last%.*}.$((10#${last#*.} + 1))"
