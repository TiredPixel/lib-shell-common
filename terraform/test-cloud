#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=terraform/test-cloud

usage() {
    echo "Usage: $prog" >&2
    exit 2
}

[ $# -eq 0 ] || usage

export CHECKPOINT_DISABLE=1

# -diff, so a failure shows what would change rather than only naming the file.
terraform fmt -recursive -check -diff

# The lock file read-only, for the reason terraform/test-cli gives.
terraform init -lockfile=readonly

# Unsaved, with no deploy-cloud to apply it. HCP Terraform saves a plan under
# plan -out only from Terraform CLI v1.6.0 (HashiCorp's "CLI-driven run
# workflow", developer.hashicorp.com, read 2026-11-20).
terraform plan
