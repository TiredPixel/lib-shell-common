#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
prog=${0##*/}

if [ $# -eq 0 ]; then
    echo "Usage: $prog COMMAND [ARG...]" >&2
    exit 2
fi

# At the top level, where project/each-without-project sweeps from, so the
# command runs in this project rather than in whichever directory of it this is
# called from. Assigned on its own, so that errexit sees git fail outside a
# repository.
toplevel=$(git rev-parse --show-toplevel)
cd "$toplevel"

"$dir/each-without-project" "$@"

# To stderr, so stdout carries only the command's own output: project/tag-create
# captures this sweep's output to ask whether a tag exists anywhere.
echo "$prog: ${PWD##*/}" >&2
"$@"
