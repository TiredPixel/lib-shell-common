#!/usr/bin/env bash
#
# Tests ansible/inventory-ssh-known-hosts on a scratch known_hosts file: which
# hosts it lists, its refusal of no match or of an unreadable file, and its usage
# errors. It reads only that file, so nothing is faked.
#
# Run: ansible/inventory-ssh-known-hosts.test. Exits 1 naming each case that
# failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

inventory=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/inventory-ssh-known-hosts
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

failed=()

# Quotes in a hostname must come through as JSON strings.
cat >"$work/known_hosts" <<'EOF'
# a.example.com is only in a comment
#z.example.com ssh-ed25519 AAAA
  #y.example.com ssh-ed25519 AAAA
a.example.com ssh-ed25519 AAAA
b.example.com,192.0.2.1 ssh-ed25519 AAAA
192.0.2.2,c.example.com ssh-ed25519 AAAA
d.example.org ssh-ed25519 AAAA
notexample.com ssh-ed25519 AAAA
o'neil.example.com ssh-ed25519 AAAA
say"hi.example.com ssh-ed25519 AAAA
e.example.com	ssh-ed25519 AAAA

EOF

# The X stands where a regex would read the dot in example.com as any
# character.
cat >"$work/known_hosts_dot" <<'EOF'
web.exampleXcom ssh-ed25519 AAAA
EOF

# Runs the inventory with arguments $4..., and checks its status is $2, its
# stdout, compacted by jq where not empty, is $3, and its stderr holds $said
# where that is set or is empty where it is not.
check() {
    local name=$1 status=$2 out=$3 rc=0 got
    shift 3
    "$inventory" "$@" >"$work/out" 2>"$work/err" || rc=$?
    got=$(<"$work/out")
    if [ -n "$got" ]; then
        got=$(jq -c . <<<"$got")
    fi
    if [ "$rc" != "$status" ]; then
        failed+=("$name: exit $rc, not $status: $(<"$work/err")")
    elif [ "$got" != "$out" ]; then
        failed+=("$name: stdout is: $got")
    elif [ -z "$said" ] && [ -s "$work/err" ]; then
        failed+=("$name: stderr is: $(<"$work/err")")
    elif [ -n "$said" ] && ! grep -qF -- "$said" "$work/err"; then
        failed+=("$name: stderr lacks '$said': $(<"$work/err")")
    fi
}

kh=$work/known_hosts
usage="Usage: $inventory KNOWN_HOSTS DOMAIN --list | --host HOST"

said=""
check list 0 \
    '{"ungrouped":{"hosts":["a.example.com","b.example.com","o'"'"'neil.example.com","say\"hi.example.com","e.example.com"]},"_meta":{"hostvars":{}}}' \
    "$kh" example.com --list
said="$inventory: no host in $work/known_hosts_dot ends in .example.com"
check list-dot-literal 1 "" "$work/known_hosts_dot" example.com --list

said=""
check host 0 '{}' "$kh" example.com --host a.example.com

said="$inventory: no host in $kh ends in .example.net"
check no-match 1 "" "$kh" example.net --list

said="$inventory: $work/missing is not a readable file"
check missing-file 1 "" "$work/missing" example.com --list
said="$inventory: $work is not a readable file"
check directory-file 1 "" "$work" example.com --list

said=$usage
check no-arguments 2 ""
check no-option 2 "" "$kh" example.com
check empty-file 2 "" "" example.com --list
check empty-domain 2 "" "$kh" "" --list
check unknown-option 2 "" "$kh" example.com --hosts
check host-missing 2 "" "$kh" example.com --host
check host-extra 2 "" "$kh" example.com --host a.example.com b
check list-extra 2 "" "$kh" example.com --list a.example.com

# Every line of a failure carries the program and the case, captured output
# included.
if [ ${#failed[@]} -gt 0 ]; then
    for f in "${failed[@]}"; do
        failed_case=${f%%: *}
        while IFS= read -r failed_line <&3; do
            echo "${0##*/}: $failed_case: $failed_line" >&2
        done 3<<<"${f#"$failed_case: "}"
    done
    exit 1
fi
echo "ok"
