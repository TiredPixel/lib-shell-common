#!/usr/bin/env bash
#
# Fail unless VERSION names a release a mobile client could actually publish.
# A server-side build may legitimately carry a version like 14.654.4-gdd8f39ac,
# describing a commit that is not exactly on a tag; a store field may not. Play
# accepts any string as a versionName, but the number shown there is the same
# one iOS puts in CFBundleShortVersionString, which takes at most three
# period-separated integers and nothing else (Android's "Version your app",
# developer.android.com/studio/publish/versioning, and Apple's
# CFBundleShortVersionString reference, under
# developer.apple.com/documentation/bundleresources, checked 2026-11; Apple's
# gives the format as three). One rule for both clients is what keeps the two
# stores showing the same version, and it lives here so an iOS and an Android
# client cannot compute different numbers from one tag.
#
# 0.0 is rejected by name. It is what project.pbxproj and app/build.gradle.kts
# each hold for a build nobody gave a version to -- correct for a dev build, and
# the one value that must never reach a store. Nothing else here would catch it,
# because it is a perfectly legal version string.
#
# Callers decide whether an absent VERSION is an error. The stamping paths call
# this only once they have one, so a dev build skips both the stamp and the
# check; a publishing path calls it unconditionally and gets the presence check
# with it.

set -Eeuo pipefail
shopt -s inherit_errexit failglob

# :? rather than ?, because the risk here is empty rather than unset: a
# workflow that resolves no version still exports the variable, holding
# nothing, and set -u does not catch that.
: "${VERSION:?must be set to the version to stamp}"

if [ "$VERSION" = "0.0" ]; then
    echo "VERSION is 0.0, which is the unstamped placeholder, not a release." >&2
    exit 1
fi

if ! echo "$VERSION" | grep -qE '^[0-9]+\.[0-9]+$'; then
    echo "VERSION is '$VERSION'; a release is major.minor and nothing else." >&2
    echo "A build that is not exactly on a tag has no release number to claim." >&2
    exit 1
fi

# The multiplier is this library's convention rather than either store's, and a
# caller adopting it has to compute the same expression at the point that
# stamps.
# Both clients derive their store build number as major * 10000 + minor, so a
# minor that reached the multiplier would carry into the next major's .0 and
# collide with a number Play may already have accepted -- which it then refuses,
# having no way to tell the two apart (Android's "Version your app", as above).
# Checked here rather than in either expression, so one rule covers both clients
# and neither restates it. The test builtin reads a leading zero as decimal,
# unlike arithmetic evaluation, so a minor written 0659 compares as 659 rather
# than failing as bad octal.
if [ "${VERSION##*.}" -ge 10000 ]; then
    echo "VERSION minor is ${VERSION##*.}; the build number needs under 10000." >&2
    exit 1
fi

# The other end of the same expression, and the reason the multiplier is not
# wider: Play refuses a versionCode above 2,100,000,000 (Android's "Version your
# app", as above), so the two halves share one budget and every digit given to
# the minor comes out of the major.
# 209,999 is the largest major for which every minor fits: with the largest
# minor above it gives 2,099,999,999, while 210,000 overflows with any minor
# above 0. Stated as a bound on the major rather than on the computed number, so
# the formula lives in the two places that use it and not in a third.
if [ "${VERSION%%.*}" -gt 209999 ]; then
    echo "VERSION major is ${VERSION%%.*}; the build number needs 209999 or under." >&2
    exit 1
fi
