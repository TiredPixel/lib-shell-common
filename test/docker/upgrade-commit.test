#!/usr/bin/env bash
#
# Runs against real repositories in a scratch dir: app, with a bare remote and a
# submodule lib, in which an upgrade has rewritten the Dockerfile, proposed a
# workflow and left a record of it, and lib has moved forwards. Every case
# builds its fixture afresh and runs upgrade-commit in app.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

commit=$root/docker/upgrade-commit

# Nothing from the caller's configuration reaches the fixtures, and no fixture
# finds a repository above the scratch dir. The file protocol, local paths
# included, is refused to submodules by default.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
export GIT_CEILING_DIRECTORIES=$test_tmp
export GIT_CONFIG_COUNT=5
export GIT_CONFIG_KEY_0=protocol.file.allow GIT_CONFIG_VALUE_0=always
export GIT_CONFIG_KEY_1=user.name GIT_CONFIG_VALUE_1=test
export GIT_CONFIG_KEY_2=user.email GIT_CONFIG_VALUE_2=test@example.com
export GIT_CONFIG_KEY_3=init.defaultBranch GIT_CONFIG_VALUE_3=main
# Rename detection is on, so the staged rename below shows that upgrade-commit
# turns it off.
export GIT_CONFIG_KEY_4=diff.renames GIT_CONFIG_VALUE_4=true

n=0
moves=("V 1.0.0 -> 1.2.3" "o/r@v1 v0 -> 3333333")
staged="docker/upgrade-commit: already staged beside the upgrade; commit or unstage it first"
stray="docker/upgrade-commit: untracked beside the upgrade; git add it to commit it, or remove it"
dot=.

# A fresh fixture in $w: app at $w/app, pushed to $w/app.git, with lib at
# $w/app/lib one commit past what app records, the upgrade's changes made and
# its record at $w/record. pushed holds the commit $w/app.git's main is at, and
# lib_move the line upgrade-commit writes for lib.
fixture() {
    n=$((n + 1))
    w=$test_tmp/$n
    mkdir "$w"
    git init -q --bare "$w/lib.git"
    git init -q "$w/lib.up"
    git -C "$w/lib.up" commit -q --allow-empty -m init
    git -C "$w/lib.up" push -q "$w/lib.git" main
    git init -q --bare "$w/app.git"
    git init -q "$w/app"
    mkdir -p "$w/app/.github/workflows"
    printf 'ARG V=1.0.0\n' >"$w/app/Dockerfile"
    printf 'uses: o/r@v0\n' >"$w/app/.github/workflows/build.yml"
    printf 'notes\n' >"$w/app/notes.txt"
    git -C "$w/app" submodule add -q "$w/lib.git" lib
    git -C "$w/app" add Dockerfile .github notes.txt
    git -C "$w/app" commit -q -m init
    git -C "$w/app" remote add origin "$w/app.git"
    git -C "$w/app" push -q origin main
    pushed=$(git -C "$w/app.git" rev-parse main)
    git -C "$w/app/lib" commit -q --allow-empty -m forwards
    local old new
    old=$(git -C "$w/app" rev-parse HEAD:lib)
    new=$(git -C "$w/app/lib" rev-parse HEAD)
    lib_move="lib ${old:0:7} -> ${new:0:7}"

    printf 'ARG V=1.2.3\n' >"$w/app/Dockerfile"
    mkdir "$w/app/.github/workflows.new"
    printf 'uses: o/r@%s\n' "$(printf '3%.0s' {1..40})" \
        >"$w/app/.github/workflows.new/build.yml"
    local app
    app=$(readlink -f "$w/app")
    printf '%s\n' "$app/Dockerfile" "$app/.github/workflows.new/build.yml" "" \
        "${moves[@]}" >"$w/record"
}

# Runs upgrade-commit in $w/app$1 with the arguments after it, setting rc and
# err.
run() {
    local dir=$w/app$1
    rc=0
    (cd "$dir" && "$commit" "${@:2}") >"$w/out" 2>"$w/err" || rc=$?
    err=$(<"$w/err")
}

# Fails case $1 where HEAD has moved from the fixture's commit or the remote
# has, or the record is gone.
unchanged() {
    if [ "$(git -C "$w/app" rev-parse HEAD)" != "$pushed" ]; then
        test_fail "$1" "a commit was made"
    elif [ "$(git -C "$w/app.git" rev-parse main)" != "$pushed" ]; then
        test_fail "$1" "something was pushed"
    elif ! [ -f "$w/record" ]; then
        test_fail "$1" "the record was removed"
    fi
}

# Fails case $1 unless HEAD is one commit past the fixture's, changing exactly
# the paths after $1, as "Upgrade pins" with a body listing, each as "- MOVE",
# the moves where Dockerfile or a lock under Dockerfile.lock is among them and
# then lib_move where lib is, the remote untouched and the record removed.
committed() {
    local name=$1 want message=("Upgrade pins") body=()
    want=$(printf '%s\n' "${@:2}")
    if [[ $'\n'$want$'\n' == *$'\nDockerfile\n'* ]] ||
        [[ $'\n'$want == *$'\nDockerfile.lock/'* ]]; then
        body+=("${moves[@]}")
    fi
    if [[ $'\n'$want$'\n' == *$'\nlib\n'* ]]; then
        body+=("$lib_move")
    fi
    if [ ${#body[@]} -gt 0 ]; then
        message+=("" "${body[@]/#/- }")
    fi
    if [ "$rc" != 0 ]; then
        test_fail "$name" "exit $rc, not 0: $err"
    elif [ "$(git -C "$w/app" rev-parse HEAD~1)" != "$pushed" ]; then
        test_fail "$name" "HEAD is not one commit past the fixture's"
    elif [ "$(git -C "$w/app" log -1 --no-show-signature --format=%B)" != \
        "$(printf '%s\n' "${message[@]}")" ]; then
        test_fail "$name" "the message is: $(git -C "$w/app" log -1 --no-show-signature --format=%B)"
    elif [ "$(git -C "$w/app" diff-tree --ignore-submodules=none --no-commit-id --name-only -r HEAD)" != "$want" ]; then
        test_fail "$name" "the commit changes: $(git -C "$w/app" diff-tree --ignore-submodules=none --no-commit-id --name-only -r HEAD)"
    elif [ "$(git -C "$w/app.git" rev-parse main)" != "$pushed" ]; then
        test_fail "$name" "something was pushed"
    elif [ -e "$w/record" ]; then
        test_fail "$name" "the record was kept"
    fi
}

# The recorded paths and the submodule are committed; unstaged and untracked
# work beside them is not.
fixture
printf 'more notes\n' >>"$w/app/notes.txt"
printf 'x\n' >"$w/app/untracked"
run "" "$w/record" lib
committed commits .github/workflows.new/build.yml Dockerfile lib
if [ "$(git -C "$w/app" status --porcelain)" != $' M notes.txt\n?? untracked' ]; then
    test_fail commits "the tree is now: $(git -C "$w/app" status --porcelain)"
fi

# From a subdirectory, a PATH is read from there, and the recorded paths are
# absolute.
fixture
run /.github "$w/record" ../lib
committed subdirectory .github/workflows.new/build.yml Dockerfile lib

# A recorded path already staged is no other path.
fixture
git -C "$w/app" add Dockerfile
run "" "$w/record"
committed own-staged .github/workflows.new/build.yml Dockerfile

# A submodule PATH that did not move adds no line.
fixture
git -C "$w/app/lib" checkout -q HEAD~1
run "" "$w/record" lib
committed lib-unmoved .github/workflows.new/build.yml Dockerfile

# Where no pin moved, a PATH that changed is still committed: a submodule with
# its move as the body, any other path with no body.
fixture
: >"$w/record"
run "" "$w/record" lib
committed lib-only lib
fixture
: >"$w/record"
printf 'more notes\n' >>"$w/app/notes.txt"
run "" "$w/record" notes.txt
committed path-only notes.txt

# A record whose only move is a lock's content, in a directory new to the
# repository, commits that lock with the line as the body.
fixture
mkdir -p "$w/app/Dockerfile.lock/m"
printf 'm-d==1.0 --hash=sha256:%s\n' "$(printf '5%.0s' {1..64})" \
    >"$w/app/Dockerfile.lock/m/requirements.txt"
printf '%s\n' "$(readlink -f "$w/app")/Dockerfile.lock/m/requirements.txt" "" \
    "LOCK m: files changed" >"$w/record"
saved=("${moves[@]}")
moves=("LOCK m: files changed")
run "" "$w/record"
committed lock-content-only Dockerfile.lock/m/requirements.txt
moves=("${saved[@]}")

# A submodule's ignore setting hides it from neither the commit nor its body,
# nor from the check for other paths staged.
fixture
git -C "$w/app" config submodule.lib.ignore all
: >"$w/record"
run "" "$w/record" lib
committed lib-only-ignored lib
fixture
git -C "$w/app" config submodule.lib.ignore all
git -C "$w/app" add lib
test_check other-staged-ignored 1 '' "lib"$'\n'"$staged" \
    env -C "$w/app" "$commit" "$w/record"
unchanged other-staged-ignored

# Where neither a pin nor a PATH moved, nothing is staged or committed, and the
# record goes; with no PATH, what is already staged is not looked at.
for how in unmoved-path no-path; do
    fixture
    : >"$w/record"
    if [ "$how" = unmoved-path ]; then
        git -C "$w/app/lib" checkout -q HEAD~1
        set -- lib
    else
        git -C "$w/app" add lib
        set --
    fi
    test_check "nothing-moved-$how" 0 '' \
        "docker/upgrade-commit: $w/record: nothing moved, so there is nothing to commit" \
        env -C "$w/app" "$commit" "$w/record" "$@"
    if [ "$(git -C "$w/app" rev-parse HEAD)" != "$pushed" ]; then
        test_fail "nothing-moved-$how" "a commit was made"
    elif [ "$how" = unmoved-path ] &&
        [ -n "$(git -C "$w/app" diff --cached --name-only)" ]; then
        test_fail "nothing-moved-$how" "something was staged"
    elif [ -e "$w/record" ]; then
        test_fail "nothing-moved-$how" "the record was kept"
    fi
done

# A record docker/upgrade-record makes from no moves is one where nothing moved.
fixture
rm -- "$w/record"
"$root/docker/upgrade-record" "$w/record" Package.resolved </dev/null
test_check nothing-moved-recorded 0 '' \
    "docker/upgrade-commit: $w/record: nothing moved, so there is nothing to commit" \
    env -C "$w/app" "$commit" "$w/record"
if [ "$(git -C "$w/app" rev-parse HEAD)" != "$pushed" ]; then
    test_fail nothing-moved-recorded "a commit was made"
elif [ -e "$w/record" ]; then
    test_fail nothing-moved-recorded "the record was kept"
fi

# Where no pin moved, any other path staged is still refused.
fixture
: >"$w/record"
git -C "$w/app" add notes.txt Dockerfile
test_check lib-only-other-staged 1 '' "Dockerfile"$'\n'"$staged" \
    env -C "$w/app" "$commit" "$w/record" lib
unchanged lib-only-other-staged

# Any other path staged is refused, listed as git lists it, before anything is
# staged; a staged rename lists both its paths.
for how in modified renamed; do
    fixture
    if [ "$how" = modified ]; then
        printf 'more\n' >>"$w/app/notes.txt"
        git -C "$w/app" add notes.txt
        want=notes.txt
    else
        git -C "$w/app" mv notes.txt renamed.txt
        want=$'notes.txt\nrenamed.txt'
    fi
    test_check "other-staged-$how" 1 '' "$want"$'\n'"$staged" \
        env -C "$w/app" "$commit" "$w/record" lib
    if [ "$(git -C "$w/app" diff --cached --no-renames --name-only)" != "$want" ]; then
        test_fail "other-staged-$how" "the index is now: $(git -C "$w/app" diff --cached --no-renames --name-only)"
    fi
    unchanged "other-staged-$how"
done

# A recorded path and a PATH are read literally, never as patterns: f[1] names
# no f1, so f1 is neither committed with them nor taken as one of them when
# staged.
for how in unstaged staged; do
    fixture
    printf 'x\n' >"$w/app/f[1]"
    printf 'x\n' >"$w/app/g[1]"
    printf 'x\n' >"$w/app/f1"
    printf 'x\n' >"$w/app/g1"
    git -C "$w/app" add 'f[1]' 'g[1]' f1 g1
    git -C "$w/app" commit -q -m globs
    git -C "$w/app" push -q origin main
    pushed=$(git -C "$w/app" rev-parse HEAD)
    printf 'y\n' | tee -a "$w/app/f[1]" "$w/app/g[1]" "$w/app/f1" >>"$w/app/g1"
    app=$(readlink -f "$w/app")
    printf '%s\n' "$app/Dockerfile" "$app/f[1]" "" "${moves[@]}" >"$w/record"
    if [ "$how" = unstaged ]; then
        run "" "$w/record" 'g[1]'
        committed glob-unstaged Dockerfile 'f[1]' 'g[1]'
        if [ "$(git -C "$w/app" status --porcelain -- f1 g1)" != $' M f1\n M g1' ]; then
            test_fail glob-unstaged "f1 and g1 are now: $(git -C "$w/app" status --porcelain -- f1 g1)"
        fi
    else
        git -C "$w/app" add f1 g1
        test_check glob-staged 1 '' $'f1\ng1\n'"$staged" \
            env -C "$w/app" "$commit" "$w/record" 'g[1]'
        unchanged glob-staged
    fi
done

# A record docker/upgrade could not have written is refused.
n_bad=0
for bad in $'/x\n/y\n' $'\nV 1 -> 2\n' $'/x\n\n' $'/x\n\nV 1 -> 2\n\nW 1 -> 2\n'; do
    n_bad=$((n_bad + 1))
    fixture
    printf '%s' "$bad" >"$w/record"
    case $n_bad in
    4) said="docker/upgrade-commit: $w/record:4: a second blank line" ;;
    *) said="docker/upgrade-commit: $w/record: not a record docker/upgrade --record writes" ;;
    esac
    test_check "bad-record-$n_bad" 1 '' "$said" \
        env -C "$w/app" "$commit" "$w/record"
    unchanged "bad-record-$n_bad"
done

# Each form docker/upgrade --record writes passes, and so does a step's own
# SUBJECT of several words, such as a provider after its environment's name.
saved=("${moves[@]}")
moves=(
    "docker.io/library/debian:13 sha256:2dc419c6d7fe -> sha256:9c6e381421d0"
    "V 1.0.0 -> 1.2.3"
    "o/r@v1 v0 -> 3333333"
    "LOCK m m-d none -> 2.0.1"
    "LOCK js @s/n.d 1.0 -> none"
    "LOCK m: 1 dependency moved"
    "LOCK js: 12 dependencies moved"
    "LOCK m.x: files changed"
    "prd registry.terraform.io/hashicorp/aws 5.0.0 -> 5.1.0"
)
fixture
run "" "$w/record"
committed record-forms .github/workflows.new/build.yml Dockerfile
moves=("${saved[@]}")

# A line a step passes through docker/upgrade-record is one this commits.
saved=("${moves[@]}")
for line in 'prd registry.terraform.io/hashicorp/aws 5.0.0 -> 5.1.0' \
    'o/font v1 -> v2' 'LOCK m: 3 dependencies moved' 'LOCK m: files changed'; do
    moves=("${saved[@]}")
    fixture
    "$root/docker/upgrade-record" "$w/record" notes.txt <<<"$line" >/dev/null
    moves+=("$line")
    run "" "$w/record"
    committed "recorded-$line" .github/workflows.new/build.yml Dockerfile
done
moves=("${saved[@]}")

# A file laid out like a record, whose lines after the blank are no move, is
# refused at the first such line before anything is staged or removed.
for bad in 'further text' 'TOKEN: secret' 'V 1.0.0 ->' '-> 1.2.3' 'V -> 1.2.3' \
    'V  1 -> 2' 'V 1 -> 2 3' 'V 1 -> 2 -> 3' 'V 1 -> -> 3' $'V 1 -> 2\r' \
    'LOCK m: 0 dependencies moved' 'LOCK m: 1 dependencies moved' \
    'LOCK m: 2 dependency moved' 'LOCK a:b: files changed' 'LOCK m: files'; do
    fixture
    printf '%s\n' "$w/app/notes.txt" "" "V 1.0.0 -> 1.2.3" "$bad" >"$w/record"
    test_check "bad-move-$bad" 1 '' \
        "docker/upgrade-commit: $w/record:4: not a move docker/upgrade --record writes" \
        env -C "$w/app" "$commit" "$w/record" .
    unchanged "bad-move-$bad"
    if [ -n "$(git -C "$w/app" diff --cached --name-only)" ]; then
        test_fail "bad-move-$bad" "the index is now: $(git -C "$w/app" diff --cached --name-only)"
    fi
done

# A tracked file laid out like a record, given with ., is neither committed nor
# removed, and its text reaches no commit.
fixture
printf 'notes.txt\n\nfurther text\n' >"$w/app/notes.txt"
test_check record-shaped 1 '' \
    "docker/upgrade-commit: notes.txt:3: not a move docker/upgrade --record writes" \
    env -C "$w/app" "$commit" notes.txt .
unchanged record-shaped
if [ "$(<"$w/app/notes.txt")" != $'notes.txt\n\nfurther text' ]; then
    test_fail record-shaped "the file was changed or removed"
elif [ -n "$(git -C "$w/app" diff --cached --name-only)" ]; then
    test_fail record-shaped "the index is now: $(git -C "$w/app" diff --cached --name-only)"
fi

# A missing record, or one that is no regular file, commits nothing.
fixture
test_check record-missing 1 '' \
    "docker/upgrade-commit: $w/absent: no such file" \
    env -C "$w/app" "$commit" "$w/absent" .
unchanged record-missing
mkdir "$w/dir"
test_check record-directory 1 '' \
    "docker/upgrade-commit: $w/dir: not a regular file" \
    env -C "$w/app" "$commit" "$w/dir" .
unchanged record-directory

# Another file named as the record stays, and with . its contents reach neither
# the index nor a commit.
fixture
printf 'TOKEN=secret\n' >"$w/app/.env"
test_check not-a-record 1 '' \
    "docker/upgrade-commit: .env: not a record docker/upgrade --record writes" \
    env -C "$w/app" "$commit" .env .
unchanged not-a-record
if [ ! -f "$w/app/.env" ]; then
    test_fail not-a-record "the file was removed"
elif [ -n "$(git -C "$w/app" diff --cached --name-only)" ]; then
    test_fail not-a-record "the index is now: $(git -C "$w/app" diff --cached --name-only)"
fi

# Runs upgrade-commit with $dot in $w/app$2, which case $1 expects to refuse,
# naming the lines after $2 and leaving HEAD, the remote, the record, the index
# and the tree as they were.
refused() {
    local name=$1 sub=$2 status record_was
    shift 2
    status=$(git -C "$w/app" status --porcelain --untracked-files=all)
    record_was=$(<"$w/record")
    test_check "$name" 1 '' "$(printf '%s\n' "$@" "$stray")" \
        env -C "$w/app$sub" "$commit" "$w/record" "$dot"
    unchanged "$name"
    if [ "$(<"$w/record")" != "$record_was" ]; then
        test_fail "$name" "the record was changed"
    elif [ "$(git -C "$w/app" status --porcelain --untracked-files=all)" != "$status" ]; then
        test_fail "$name" "the index or tree is now: $(git -C "$w/app" status --porcelain --untracked-files=all)"
    fi
}

# With ., an untracked file is refused, a dot file included, before anything is
# staged; added with git add, it is committed on the next run.
fixture
printf 'TOKEN=secret\n' >"$w/app/.netrc"
refused stray-refused "" .netrc
git -C "$w/app" add .netrc
run "" "$w/record" .
committed stray-added .github/workflows.new/build.yml .netrc Dockerfile lib

# Where no pin moved, the record lists nothing, so every untracked file is
# refused, the fixture's proposal among them.
fixture
: >"$w/record"
printf 'x\n' >"$w/app/stray"
refused stray-no-moves "" .github/workflows.new/build.yml stray

# A new file the record lists passes, a lock in a new directory included, and
# only the file beside it is named.
fixture
mkdir -p "$w/app/Dockerfile.lock/m"
printf 'x\n' >"$w/app/Dockerfile.lock/m/requirements.txt"
app=$(readlink -f "$w/app")
printf '%s\n' "$app/Dockerfile" "$app/.github/workflows.new/build.yml" \
    "$app/Dockerfile.lock" "" "${moves[@]}" >"$w/record"
printf 'x\n' >"$w/app/stray"
refused stray-recorded-dir "" stray
git -C "$w/app" add stray
run "" "$w/record" .
committed recorded-dir-passes .github/workflows.new/build.yml Dockerfile \
    Dockerfile.lock/m/requirements.txt lib stray

# An ignored file is not named, and stays out of the commit.
fixture
printf '/ignored\n' >"$w/app/.git/info/exclude"
printf 'x\n' >"$w/app/ignored"
printf 'x\n' >"$w/app/stray"
refused stray-ignored "" stray
git -C "$w/app" add stray
run "" "$w/record" .
committed ignored-left-out .github/workflows.new/build.yml Dockerfile lib stray

# A tracked edit does not stop the run and is committed once the stray file is
# dealt with.
fixture
printf 'more notes\n' >>"$w/app/notes.txt"
printf 'x\n' >"$w/app/stray"
refused stray-tracked-edit "" stray
git -C "$w/app" add stray
run "" "$w/record" .
committed tracked-edit-committed .github/workflows.new/build.yml Dockerfile \
    lib notes.txt stray

# Recorded paths match literally: f[1] and "a b" pass, and f1 and a are named.
fixture
printf 'x\n' | tee "$w/app/f[1]" "$w/app/f1" "$w/app/a b" >"$w/app/a"
app=$(readlink -f "$w/app")
printf '%s\n' "$app/Dockerfile" "$app/.github/workflows.new/build.yml" \
    "$app/f[1]" "$app/a b" "" "${moves[@]}" >"$w/record"
refused stray-literal "" a f1
git -C "$w/app" add a f1
run "" "$w/record" .
committed literal-passes .github/workflows.new/build.yml Dockerfile a 'a b' \
    f1 'f[1]' lib

# From a subdirectory, . reaches only that directory, so only a file there is
# named, by its path from there.
fixture
printf 'x\n' | tee "$w/app/outside" >"$w/app/.github/inside"
refused stray-subdirectory /.github inside

# ./ is read as . is.
fixture
printf 'x\n' >"$w/app/stray"
dot=./
refused stray-dot-slash "" stray
dot=.
git -C "$w/app" add stray
run "" "$w/record" ./
committed dot-slash-passes .github/workflows.new/build.yml Dockerfile lib stray

# Another PATH passes where it is exactly the file, and a file below a directory
# named that way does not.
fixture
mkdir "$w/app/named"
printf 'x\n' | tee "$w/app/extra" >"$w/app/named/below"
test_check stray-named-directory 1 '' "named/below"$'\n'"$stray" \
    env -C "$w/app" "$commit" "$w/record" . extra named
unchanged stray-named-directory
fixture
printf 'x\n' >"$w/app/extra"
run "" "$w/record" . extra
committed named-path-passes .github/workflows.new/build.yml Dockerfile extra lib

# Below a recorded directory, a file passes unless a component below it is
# dot-named, and a recorded dot file passes, however each path is written.
for form in bare slash dotted; do
    fixture
    mkdir -p "$w/app/src/fonts/deep" "$w/app/env"
    printf 'x\n' | tee "$w/app/src/fonts/new.ttf" "$w/app/src/fonts/deep/b.ttf" \
        >"$w/app/env/.terraform.lock.hcl"
    case $form in
    bare) fonts=src/fonts lock=env/.terraform.lock.hcl ;;
    slash) fonts=src/fonts/ lock=env/.terraform.lock.hcl ;;
    dotted) fonts=./src/fonts lock=./env/.terraform.lock.hcl ;;
    esac
    printf '%s\n' Dockerfile .github/workflows.new/build.yml "$fonts" "$lock" "" \
        "${moves[@]}" >"$w/record"
    run "" "$w/record" .
    committed "recorded-forms-$form" .github/workflows.new/build.yml Dockerfile \
        env/.terraform.lock.hcl lib src/fonts/deep/b.ttf src/fonts/new.ttf
done

# A dot-named component below a recorded directory is refused, at any depth,
# with the rest of the directory not named.
fixture
mkdir -p "$w/app/src/fonts/.cache" "$w/app/src/fonts/deep"
printf 'x\n' | tee "$w/app/src/fonts/new.ttf" "$w/app/src/fonts/.netrc" \
    "$w/app/src/fonts/.cache/f" >"$w/app/src/fonts/deep/.netrc"
app=$(readlink -f "$w/app")
printf '%s\n' "$app/Dockerfile" "$app/.github/workflows.new/build.yml" \
    "$app/src/fonts" "" "${moves[@]}" >"$w/record"
refused stray-dot-below-recorded "" src/fonts/.cache/f src/fonts/.netrc \
    src/fonts/deep/.netrc

# A directory that is only a dot file's parent is no recorded directory, so a
# file beside the recorded dot file is named.
fixture
mkdir "$w/app/env"
printf 'x\n' | tee "$w/app/env/.terraform.lock.hcl" >"$w/app/env/beside"
app=$(readlink -f "$w/app")
printf '%s\n' "$app/Dockerfile" "$app/.github/workflows.new/build.yml" \
    "$app/env/.terraform.lock.hcl" "" "${moves[@]}" >"$w/record"
refused stray-beside-recorded-file "" env/beside

# A nested repository below a recorded directory holds a .git, so it is refused.
fixture
mkdir -p "$w/app/src/fonts/vendor"
git -C "$w/app/src/fonts/vendor" init -q
printf 'x\n' >"$w/app/src/fonts/vendor/f"
app=$(readlink -f "$w/app")
printf '%s\n' "$app/Dockerfile" "$app/.github/workflows.new/build.yml" \
    "$app/src/fonts" "" "${moves[@]}" >"$w/record"
refused stray-nested-repository "" src/fonts/vendor/

# A recorded directory outside the current one is still checked, since git add
# takes it from there too, and its file is named by its path from there.
fixture
mkdir -p "$w/app/src/fonts"
printf 'x\n' >"$w/app/src/fonts/.netrc"
app=$(readlink -f "$w/app")
printf '%s\n' "$app/Dockerfile" "$app/.github/workflows.new/build.yml" \
    "$app/src/fonts" "" "${moves[@]}" >"$w/record"
refused stray-recorded-outside /.github ../src/fonts/.netrc

# Spaces, leading dashes, newlines and glob characters are matched literally
# and listed one to a line, a newline as git quotes it.
fixture
nl=$'n\nl'
printf 'x\n' | tee "$w/app/-dash" "$w/app/s p" "$w/app/g[1]*" "$w/app/g1" \
    >"$w/app/$nl"
refused stray-odd-names "" -dash g1 'g[1]*' '"n\nl"' 's p'

# The same names pass where the record lists them or a PATH names them, and g1
# is not taken for g[1].
app=$(readlink -f "$w/app")
printf '%s\n' "$app/Dockerfile" "$app/.github/workflows.new/build.yml" \
    "$app/-dash" "$app/s p" "$app/g[1]*" "" "${moves[@]}" >"$w/record"
test_check odd-names-literal 1 '' "g1"$'\n'"$stray" \
    env -C "$w/app" "$commit" "$w/record" . "$nl"
unchanged odd-names-literal
git -C "$w/app" add g1
run "" "$w/record" . "$nl"
committed odd-names-pass -dash .github/workflows.new/build.yml Dockerfile g1 \
    'g[1]*' lib '"n\nl"' 's p'

# A refusal naming more than one call's arguments can hold is listed in full,
# with exit 1. A stack of 256K holds the limit to the kernel's floor of 128K, so
# a few hundred long names pass it.
# shellcheck disable=SC2317 # Called through test_check.
small_stack() {
    (
        ulimit -s 256
        "$@"
    )
}
fixture
long=('"n\nl"')
for i in {0..799}; do
    printf -v name 'stray-%04d-%0200d' "$i" 0
    : >"$w/app/$name"
    long+=("$name")
done
printf 'x\n' >"$w/app/$nl"
test_check stray-beyond-arg-limit 1 '' "$(printf '%s\n' "${long[@]}" "$stray")" \
    small_stack env -C "$w/app" "$commit" "$w/record" .
unchanged stray-beyond-arg-limit

# A recorded directory is matched literally too, so d 1 is not taken for d [1].
fixture
mkdir "$w/app/d [1]" "$w/app/d 1"
printf 'x\n' | tee "$w/app/d [1]/f" >"$w/app/d 1/f"
app=$(readlink -f "$w/app")
printf '%s\n' "$app/Dockerfile" "$app/.github/workflows.new/build.yml" \
    "$app/d [1]" "" "${moves[@]}" >"$w/record"
refused stray-literal-directory "" 'd 1/f'

# With no PATH, an untracked dot file neither stops the run nor is committed.
fixture
printf 'x\n' >"$w/app/.netrc"
run "" "$w/record"
committed stray-no-path .github/workflows.new/build.yml Dockerfile
if [ "$(git -C "$w/app" status --porcelain -- .netrc)" != '?? .netrc' ]; then
    test_fail stray-no-path "the tree is now: $(git -C "$w/app" status --porcelain -- .netrc)"
fi

# A form without . takes no untracked file and is not stopped by one.
fixture
printf 'x\n' >"$w/app/stray"
run "" "$w/record" lib
committed stray-without-dot .github/workflows.new/build.yml Dockerfile lib
if [ "$(git -C "$w/app" status --porcelain)" != '?? stray' ]; then
    test_fail stray-without-dot "the tree is now: $(git -C "$w/app" status --porcelain)"
fi

# A recorded path git cannot add fails the run, and the record stays. git's
# words vary by release, so only the path is matched.
fixture
printf '%s\n' "$w/app/absent" "" "${moves[@]}" >"$w/record"
run "" "$w/record"
if [ "$rc" = 0 ] || [[ "$err" != *absent* ]]; then
    test_fail add-fails "exit $rc: $err"
fi
unchanged add-fails

for how in none empty; do
    fixture
    if [ "$how" = none ]; then
        set --
    else
        set -- ""
    fi
    test_usage "usage-$how" 'docker/upgrade-commit RECORD [PATH...]' \
        env -C "$w/app" "$commit" "$@"
    unchanged "usage-$how"
done

test_finish
