#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=project/start

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

usage() {
    echo "Usage: $prog [--pull]" >&2
    exit 2
}

if [ $# -gt 1 ] || { [ $# -eq 1 ] && [ "$1" != --pull ]; }; then
    usage
fi
pull=${1:+1}

# --wait, so a service that dies on start or never turns healthy fails the
# project it belongs to. A daemon-wide health poll would not do: filtering on
# health status misses an exited container, which has none, so a crash on start
# would pass, and it would stall on an unhealthy container from an unrelated
# project. A one-shot service exiting 0 fails --wait too, unless it is a
# service_completed_successfully dependency of a service that stays up (observed
# with Compose 5.6.1; Compose's up reference, docs.docker.com, read 2026-11-20,
# does not say). Override the bound with DC_WAIT_TIMEOUT.
#
# up pulls only images missing here, so a start runs what make build has just
# built: Compose pulls even an image it builds under --pull always, or under a
# service's own pull_policy: always unless --pull overrides it, replacing the
# build with whatever a registry holds under its tag; --pull never would fail on
# an image nothing has pulled yet (observed with Compose 5.7.0). --pull, which
# only project/upgrade passes, first pulls each image Compose cannot build,
# --ignore-buildable leaving the rest.
#
# compose ps, run in each project, lists that project's running containers;
# docker ps would list every running container on the daemon, whichever project
# or user started it.
# shellcheck disable=SC2016 # Expanded by bash in each project.
"$dir/each" bash -c '
    set -Eeuo pipefail
    shopt -s inherit_errexit failglob
    services=$("$1")
    [ -n "$services" ] || exit 0
    [ -z "$2" ] || docker compose pull --ignore-buildable
    docker compose up -d --pull missing --wait \
        --wait-timeout "${DC_WAIT_TIMEOUT:-300}"
    docker compose ps' \
    _ "$dir/compose-services" "$pull"
