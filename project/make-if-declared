#!/usr/bin/env bash
#
# Runs one make target for the project this is called in, if that project
# declares it. The sweeps in project/build and project/upgrade reach every
# project through it.
#
# The decision cannot be taken from `make -q`'s exit status: it answers 2 for
# every error it meets -- a target it holds no rule for, a Makefile it cannot
# parse, a directory holding no Makefile at all -- so reading 2 as "nothing to
# do here" drops a project whose Makefile is broken out of the sweep and reports
# success having skipped it. An uninitialised submodule is an empty directory,
# and looks exactly the same.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=${0##*/}

if [ $# -eq 0 ] || [ -z "$1" ]; then
    echo "Usage: $prog TARGET [COMMAND...]" >&2
    exit 2
fi
target=$1
shift

# Defaults to the target just asked about. project/upgrade passes a command
# instead, because it runs make under `script` to hold a tty.
if [ "$#" -eq 0 ]; then
    set -- make "$target"
fi

# Asked separately because make cannot answer it: "No rule to make target" is
# what it says both for a Makefile lacking the rule and for no Makefile at all,
# and only the first of those is a project with nothing to do.
if [ ! -f Makefile ] && [ ! -f makefile ] && [ ! -f GNUmakefile ]; then
    echo "$prog: $PWD: no Makefile, so make $target cannot be swept here" >&2
    exit 1
fi

# -q answers 0 when the target is up to date and 1 when it needs remaking, and
# either means the rule exists, which is the whole question here. It runs no
# ordinary recipe line, but still runs those marked + or naming $(MAKE), and
# reading the Makefile expands its $(shell) calls, as any make does. stdout is
# dropped and stderr kept, because the wording of the diagnostic is what
# separates the two failures below; LC_ALL=C, because make translates it.
status=0
err=$(LC_ALL=C make -q "$target" 2>&1 >/dev/null) || status=$?

case $status in
0 | 1)
    exec "$@"
    ;;
esac

# Undeclared only where the target make found no rule for is the one asked
# about. make words a missing prerequisite, or a missing included Makefile, the
# same way under another name -- GNU make adds "needed by" -- and that project
# declares the target but cannot make it. GNU make quotes the name 'build' or,
# in older releases, `build', and ends the line "  Stop." only without -k, which
# MAKEFLAGS passes down from a calling make; so each line is matched from the
# name to its end. BSD make's wording is assumed, not checked against a BSD
# make. Neither gives it an exit status of its own. Anything else make said is a
# fault in the project, and stops the sweep rather than quietly narrowing it.
while IFS= read -r line <&3; do
    case $line in
    *"No rule to make target '$target'." | \
        *"No rule to make target '$target'.  Stop." | \
        *"No rule to make target \`$target'." | \
        *"No rule to make target \`$target'.  Stop." | \
        *"don't know how to make $target. Stop")
        exit 0
        ;;
    esac
done 3<<<"$err"

printf '%s\n' "$err" >&2
exit 1
