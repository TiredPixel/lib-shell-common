#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

if [ $# -ne 0 ]; then
    echo "Usage: ${0##*/}" >&2
    exit 2
fi

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

source "$dir/init"
source "$dir/describe"

docker build \
    --target prd \
    --cache-from "$REPO:$TAG.dev" \
    --cache-from "$REPO:$TAG.prd" \
    --cache-from "$REPO:latest.dev" \
    --cache-from "$REPO:latest.prd" \
    --build-arg BUILDKIT_INLINE_CACHE=1 \
    --build-arg GIT_DESCRIBE="$describe" \
    -t "$REPO:$TAG.prd" .

docker push "$REPO:$TAG.prd"
