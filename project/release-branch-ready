#!/usr/bin/env bash
#
# Readies branch $1 in every project, this one included, to release what the
# tree holds, and pulls nothing in: a commit origin holds that the tree lacks
# was never built or tested here, and bringing one in is an upgrade's work. Each
# project moves $1 to its HEAD, the commit built, which the release tags, and
# keeps its working tree, so this project's submodules stay where they are and
# a release run from another branch releases that branch's commits. A promotion
# readies its branch after the release, when HEAD in every project is the tag.
# Every project is checked before any moves, so a refusal leaves each where it
# was.
#
# --check fetches and checks every project and moves nothing, so a release can
# learn before it moves anything that a branch it will promote is ready.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
prog=${0##*/}

check_only=
if [ "${1:-}" = --check ]; then
    check_only=1
    shift
fi

# An empty argument is refused too, since it would name no branch.
if [ $# -ne 1 ] || [ -z "$1" ]; then
    echo "Usage: $prog [--check] BRANCH" >&2
    exit 2
fi
branch=$1

# Fetches origin's branch $1 and refuses unless HEAD already holds it and the
# local branch $1, where there is one. A HEAD the branch has commits beyond is
# refused, whether it is behind the branch or diverged from it, since moving
# the branch there would drop them. --is-ancestor answers 1 for "no" and any
# other non-zero for an error, so the status is read rather than tested. The
# string is for sh, which runs it in each project with this program's name as
# $0.
# shellcheck disable=SC2016
check='
    set -eu
    branch=$1
    origin=refs/remotes/origin/$branch
    git fetch -q --no-recurse-submodules origin "+refs/heads/$branch:$origin"
    for ref in "$origin" "refs/heads/$branch"; do
        git rev-parse -q --verify "$ref^{commit}" >/dev/null || continue
        rc=0
        git merge-base --is-ancestor "$ref" HEAD || rc=$?
        case $rc in
        0) ;;
        1)
            echo "$0: $PWD: $ref has commits HEAD lacks, and a release" \
                "pulls nothing in; upgrade to take them" >&2
            exit 1
            ;;
        *) exit "$rc" ;;
        esac
    done'

"$dir/each" sh -c "$check" "$prog" "$branch"

if [ -n "$check_only" ]; then
    exit 0
fi

# -B with no start point moves the branch to HEAD and keeps the working tree;
# the check above has made that a fast-forward.
"$dir/each" git checkout --no-recurse-submodules -B "$branch"
