#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
case $* in
"rev-parse --abbrev-ref HEAD") echo a/b ;;
describe)
    case ${FAKE_DESCRIBE:-} in
    "")
        echo "fatal: No names found, cannot describe anything." >&2
        exit 128
        ;;
    broken)
        echo "fatal: bad object HEAD" >&2
        exit 128
        ;;
    *) echo "$FAKE_DESCRIBE" ;;
    esac
    ;;
"remote get-url origin")
    if [ -z "${FAKE_ORIGIN:-}" ]; then
        echo "error: No such remote 'origin'" >&2
        exit 2
    fi
    echo "$FAKE_ORIGIN"
    ;;
*) exit 2 ;;
esac
