#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

if [ $# -ne 0 ]; then
    echo "Usage: ${0##*/}" >&2
    exit 2
fi

# -diff, so a failure shows what would change rather than only naming the file.
terraform fmt -recursive -check -diff

# The lock file read-only, for the reason terraform/test-cli gives.
terraform init -lockfile=readonly

# Unsaved, with no deploy-cloud to apply it: Terraform Cloud did not support
# plan -out as of February 2023. Whether it does now is in HashiCorp's
# documentation on remote operations.
terraform plan
