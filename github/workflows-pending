#!/usr/bin/env bash
#
# Fails while a workflow proposal waits in .github/workflows.new/ of the
# repository holding the current directory, listing each pending path, so CI
# cannot pass with a proposal left unapproved. Passes when the directory is
# absent or empty.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

me=${0##*/}
new=.github/workflows.new

if [ $# -ne 0 ]; then
    echo "Usage: $me" >&2
    exit 2
fi

cd "$(git rev-parse --show-toplevel)"

if ! [ -e "$new" ]; then
    exit 0
fi
if ! [ -d "$new" ]; then
    echo "$me: $new is not a directory" >&2
    exit 1
fi
# Dot files included. failglob would end the run on an empty directory, and it
# takes precedence over nullglob.
shopt -u failglob
shopt -s dotglob nullglob
entries=("$new"/*)
shopt -u dotglob nullglob
shopt -s failglob
if [ ${#entries[@]} -eq 0 ]; then
    exit 0
fi
printf '%s\n' "${entries[@]}" >&2
echo "$me: proposals pending; approve them with" \
    "$(dirname -- "$0")/workflows-approve" >&2
exit 1
