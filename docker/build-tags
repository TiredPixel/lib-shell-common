#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

# REPO and TAG rather than a second derivation of each: init resolves a
# detached HEAD, which the copy here did not, and CircleCI's branch variable
# moved there with it so every caller gets both.
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/init"

release=$(git describe --abbrev=0)
version=$(git describe)

tags=("$TAG")

if [ "$version" = "$release" ]; then
    r=$release
    r_=""

    while true; do
        tags+=("$r")
        r=${r%.*}

        if [ "$r" = "$r_" ]; then
            break
        else
            r_=$r
        fi
    done
fi

args=()
caches=()

for tag in "${tags[@]}"; do
    args+=("-t")
    args+=("$REPO:$tag")
    caches+=("--cache-from")
    caches+=("$REPO:$tag")
done

docker build \
    --build-arg BUILDKIT_INLINE_CACHE=1 \
    --build-arg GIT_DESCRIBE="$version" \
    "${caches[@]}" \
    "${args[@]}" .

for tag in "${tags[@]}"; do
    docker push "$REPO:$tag"
done

echo
echo "version: $version"
echo "repo:    $REPO"
echo "tags:    ${tags[*]}"
