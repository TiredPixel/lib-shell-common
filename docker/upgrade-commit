#!/usr/bin/env bash
#
# Commits what docker/upgrade --record RECORD wrote, once the build and tests
# after it have passed, as "Upgrade pins" with the body a list, an item for
# each move RECORD holds, written "- " then the move as docker/upgrade gave it.
# It stages exactly the paths RECORD lists and each PATH, such as a library
# submodule taken forwards beside the upgrade, leaving out each --except PATH,
# and refuses, listing them, where any other path is already staged, since the
# commit would carry it. Given the PATH . or ./, it also refuses, listing them,
# untracked files it would stage that are neither exactly a path RECORD lists or
# another PATH, nor below a directory RECORD lists with no dot-named component
# below that directory, since one made after docker/upgrade-guard ran, such as a
# credential, would be committed. git add lets one through, and tracked edits
# are committed, since a fix to a failed upgrade and the formatter's rewrites
# belong in it. --except PATH, given once for each path to leave out and before
# RECORD, keeps PATH out of the git add, so it is neither staged nor checked
# among the untracked files, and a submodule there adds no item; . with an
# --except for each listed project commits the rest of the tree, as a
# repository sweeping projects needs, since a release commits their pointers. A
# change already staged at or below an excepted PATH is still refused, since
# git commit takes the whole index. Refused too, before anything is staged or
# removed, is an excepted PATH that a path RECORD lists is at, above or below,
# since RECORD is removed with that path never committed, and one that another
# PATH is at or below, since that PATH would commit nothing. A submodule
# PATH that moved adds an item as PATH OLD -> NEW, each commit cut to 7 hex
# digits, so a PATH that changed is committed even where no pin moved. Where
# neither a pin nor a PATH moved, it commits nothing. It never pushes. RECORD is
# removed once used, so a second run cannot commit it again. A file whose lines
# after the blank are not moves as docker/upgrade --record writes them is
# refused before anything is staged or removed, since its text would become the
# commit's body.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=docker/upgrade-commit

usage() {
    echo "Usage: $prog [--except PATH]... RECORD [PATH...]" >&2
    exit 2
}

except=()
while [ "${1:-}" = --except ]; do
    [ -n "${2:-}" ] || usage
    path=$2
    # Trailing slashes are stripped, as rooted strips them for the overlap check
    # below, since git reads a pathspec ending in / as a directory's or a
    # submodule's only, and would stage a file excepted as f/.
    while [[ $path == */ ]] && [ "$path" != / ]; do
        path=${path%/}
    done
    except+=("$path")
    shift 2
done
[ -n "${1:-}" ] || usage
record=$1
extra=("${@:2}")

if [ ! -e "$record" ]; then
    echo "$prog: $record: no such file" >&2
    exit 1
elif [ ! -f "$record" ]; then
    echo "$prog: $record: not a regular file" >&2
    exit 1
fi

nothing() {
    echo "$prog: $record: nothing moved, so there is nothing to commit" >&2
    rm -- "$record"
    exit 0
}

# shellcheck source=docker/upgrade-move
source "$(dirname -- "${BASH_SOURCE[0]}")/upgrade-move"

# Empty where no pin moved; else the paths written, then a blank line, then the
# moves. Anything else is refused before it is staged or removed, since RECORD
# can name any file, and its lines would be taken as paths and a commit's body.
mapfile -t lines <"$record"
paths=()
moves=()
if [ ${#lines[@]} -gt 0 ]; then
    blank=""
    for i in "${!lines[@]}"; do
        if [ -z "${lines[$i]}" ]; then
            blank=$i
            break
        fi
    done
    paths=("${lines[@]:0:${blank:-0}}")
    moves=("${lines[@]:${blank:-0}+1}")
    if [ -z "$blank" ] || [ ${#paths[@]} -eq 0 ] || [ ${#moves[@]} -eq 0 ]; then
        echo "$prog: $record: not a record docker/upgrade --record writes" >&2
        exit 1
    fi
    for i in "${!moves[@]}"; do
        if [ -z "${moves[$i]}" ]; then
            echo "$prog: $record:$((blank + i + 2)): a second blank line" >&2
            exit 1
        elif ! is_move "${moves[$i]}"; then
            echo "$prog: $record:$((blank + i + 2)): not a move docker/upgrade" \
                "--record writes" >&2
            exit 1
        fi
    done
fi
if [ ${#paths[@]} -eq 0 ] && [ ${#extra[@]} -eq 0 ]; then
    nothing
fi

top=$(git rev-parse --show-toplevel)
top=$(cd -P -- "$top" && printf '%s/' "${PWD%/}")

# Sets root_path to path $1, read from the current directory as git add reads
# it, as its path from the root, empty for the root itself, through the
# filesystem since a record's path may be absolute, root_leaf to its last
# component where $1 is no directory, and root_ok to 1, or to empty where its
# leading directories are missing or it lies outside the tree. Always returns
# 0, so it is called bare and root_ok tested after it: called as the left of ||
# it would run with errexit off, and a cd that failed would go unnoticed.
rooted() {
    local path=$1 dir
    root_path=""
    root_leaf=""
    root_ok=""
    while [[ $path == */ ]] && [ "$path" != / ]; do
        path=${path%/}
    done
    # ./ keeps a leading dash and CDPATH from cd.
    [[ $path == /* ]] || path=./$path
    if [ -L "$path" ] || ! [ -d "$path" ]; then
        root_leaf=${path##*/}
        path=${path%/*}/
    fi
    [ -d "$path" ] || return 0
    # The closing slash keeps a name ending in a newline through $(...).
    dir=$(cd -P -- "$path" && printf '%s/' "${PWD%/}")$root_leaf
    [[ $dir == "$top"* ]] || return 0
    dir=${dir#"$top"}
    root_path=${dir%/}
    root_ok=1
}

# An excepted path that a recorded one is at, above or below is refused, since
# RECORD is removed once used and that path would never be committed; so is one
# that a PATH is at or below, since that PATH would commit nothing. One whose
# leading directories are missing is passed over, since nothing below it exists
# to be left out, and so is one outside the tree, since git refuses that loudly
# at the first diff below, before anything is staged or removed.
if [ ${#except[@]} -gt 0 ]; then
    held=()
    held_as=()
    for path in "${paths[@]}"; do
        rooted "$path"
        [ -n "$root_ok" ] || continue
        held+=("$root_path")
        held_as+=("$path")
    done
    given=()
    given_as=()
    for path in "${extra[@]}"; do
        rooted "$path"
        [ -n "$root_ok" ] || continue
        given+=("$root_path")
        given_as+=("$path")
    done
    for path in "${except[@]}"; do
        rooted "$path"
        [ -n "$root_ok" ] || continue
        for i in "${!held[@]}"; do
            p=${held[$i]}
            if [ "$root_path" = "$p" ] || [ -z "$root_path" ] ||
                [[ $p == "$root_path"/* ]] || [ -z "$p" ] ||
                [[ $root_path == "$p"/* ]]; then
                echo "$prog: $path: excepted, but ${held_as[$i]} is to be" \
                    "committed" >&2
                exit 1
            fi
        done
        for i in "${!given[@]}"; do
            p=${given[$i]}
            if [ "$root_path" = "$p" ] || [ -z "$root_path" ] ||
                [[ $p == "$root_path"/* ]]; then
                echo "$prog: $path: excepted, but ${given_as[$i]} is to be" \
                    "committed" >&2
                exit 1
            fi
        done
    done
fi

# :(literal) so a path is never read as a pattern; --no-renames so a staged
# rename lists the path it leaves as well as the one it makes. Every diff here
# takes --ignore-submodules=none, since a submodule.<name>.ignore setting would
# otherwise hide a staged gitlink from it. An excepted path is excluded from
# every pathspec that git add, the listings and the diffs take.
specs=()
excludes=()
for path in "${paths[@]}" "${extra[@]}"; do
    specs+=(":(literal)$path")
    excludes+=(":(exclude,literal)$path")
done
except_specs=()
except_excludes=()
for path in "${except[@]}"; do
    except_specs+=(":(literal)$path")
    except_excludes+=(":(exclude,literal)$path")
done
others=$(git diff --cached --no-renames --ignore-submodules=none --name-only \
    -- ':/' "${excludes[@]}" "${except_excludes[@]}")
# What is staged at or below an excepted path is listed on its own, since a PATH
# above it, such as ., excludes it from the first listing, yet git commit would
# take it; only with an excepted path, since a diff given no pathspec lists the
# whole index.
if [ ${#except[@]} -gt 0 ]; then
    under=$(git diff --cached --no-renames --ignore-submodules=none \
        --name-only -- "${except_specs[@]}")
    if [ -n "$under" ]; then
        others+=${others:+$'\n'}$under
    fi
fi
if [ -n "$others" ]; then
    printf '%s\n' "$others" >&2
    echo "$prog: already staged beside the upgrade; commit or unstage it" \
        "first" >&2
    exit 1
fi

declare -A allowed=()
allowed_dirs=()

# Lets through path $1, read from the current directory as git add reads it,
# and with $2 set and $1 a directory, what is below it, each held by its path
# from the root. One whose leading directories are missing adds nothing, as git
# add then refuses it.
allow() {
    rooted "$1"
    [ -n "$root_ok" ] || return 0
    [ -z "$root_path" ] || allowed[$root_path]=1
    if [ -z "$root_leaf" ] && [ -n "$2" ]; then
        allowed_dirs+=("$root_path")
    fi
}

# Whether untracked path $1, from the root, is let through. A nested repository,
# which git lists with a trailing slash, holds a dot-named .git, so it passes
# only where named exactly.
passes() {
    local name=$1 dir
    [ -z "${allowed[${name%/}]+set}" ] || return 0
    [[ $name != */ ]] || return 1
    for dir in "${allowed_dirs[@]}"; do
        if [ -z "$dir" ] || [[ $name == "$dir"/* ]]; then
            [[ /${name#"$dir"/} == */.* ]] || return 0
        fi
    done
    return 1
}

whole=""
for path in "${extra[@]}"; do
    if [ "$path" = . ] || [ "$path" = ./ ]; then
        whole=1
        break
    fi
done
if [ -n "$whole" ]; then
    for path in "${paths[@]}"; do
        allow "$path" below
    done
    for path in "${extra[@]}"; do
        if [ "$path" != . ] && [ "$path" != ./ ]; then
            allow "$path" ""
        fi
    done
    # Every path git add is about to take, since a recorded directory can lie
    # outside the current one. A pipeline rather than a process substitution,
    # so pipefail sees git's status, and lastpipe so mapfile runs in this shell.
    shopt -s lastpipe
    git ls-files -z --others --exclude-standard --full-name -- "${specs[@]}" \
        "${except_excludes[@]}" | mapfile -t -d '' untracked
    # The same list in the same order as git prints it for a person, from the
    # current directory and with a newline quoted so each stays on one line.
    # Taken whole and picked from here, since naming each refused path to git
    # could pass the argument limit.
    git ls-files --others --exclude-standard -- "${specs[@]}" \
        "${except_excludes[@]}" | mapfile -t shown
    if [ ${#shown[@]} -ne ${#untracked[@]} ]; then
        echo "$prog: the untracked files changed while being listed" >&2
        exit 1
    fi
    refused=()
    for i in "${!untracked[@]}"; do
        passes "${untracked[$i]}" || refused+=("${shown[$i]}")
    done
    if [ ${#refused[@]} -gt 0 ]; then
        printf '%s\n' "${refused[@]}" >&2
        echo "$prog: untracked beside the upgrade; git add it to commit" \
            "it, or remove it" >&2
        exit 1
    fi
fi

git add -- "${specs[@]}" "${except_excludes[@]}"

# Each raw entry is ":OLDMODE NEWMODE OLD NEW STATUS" then the path, both ended
# by NUL under -z; 160000 on both sides is a submodule that moved. Through a
# file rather than a process substitution, whose failure errexit would miss.
if [ ${#extra[@]} -gt 0 ]; then
    raw=$(mktemp)
    trap 'rm -f -- "$raw"' EXIT
    git diff --cached --raw -z --no-renames --ignore-submodules=none \
        --no-abbrev -- "${specs[@]:${#paths[@]}}" "${except_excludes[@]}" \
        >"$raw"
    while IFS= read -r -d '' meta <&3 && IFS= read -r -d '' name <&3; do
        read -r old_mode new_mode old new _ <<<"${meta#:}"
        if [ "$old_mode" = 160000 ] && [ "$new_mode" = 160000 ]; then
            moves+=("$name ${old:0:7} -> ${new:0:7}")
        fi
    done 3<"$raw"
fi

if git diff --cached --ignore-submodules=none --quiet; then
    nothing
fi
if [ ${#moves[@]} -gt 0 ]; then
    git commit -m "Upgrade pins" -m "$(printf -- '- %s\n' "${moves[@]}")"
else
    git commit -m "Upgrade pins"
fi
rm -- "$record"
