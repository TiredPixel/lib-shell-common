#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=docker/build-tags

usage() {
    echo "Usage: $prog" >&2
    exit 2
}

[ $# -eq 0 ] || usage

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

source "$dir/init"
source "$dir/image-source"

# git describe fails with no reachable annotated tag, stopping the build before
# any push: these images carry a release, unlike build-compose's, so an untagged
# copy has none to give. Only a HEAD exactly on an annotated tag adds the
# release as a tag, and its shorter prefixes where it is a plain version.
release=$(git describe --abbrev=0)
version=$(git describe)

# Each tag is taken once, since the branch tag can be the release itself, as on
# a tag push, where init takes the tag's name.
tags=()
declare -A seen=()

add_tag() {
    if [ -z "${seen[$1]:-}" ]; then
        seen[$1]=1
        tags+=("$1")
    fi
}

add_tag "$TAG"

# A plain version is digits and dots with an optional leading v. Only it gives
# its prefixes, since cutting anything else at its dots, such as v1.4.2-rc.1,
# would push v1.4 and v1 for a prerelease.
digits=0123456789
plain_version="^v?[$digits]+(\\.[$digits]+)*\$"

if [ "$version" = "$release" ]; then
    prefix=$release
    add_tag "$prefix"

    if [[ $release =~ $plain_version ]]; then
        while [ "${prefix%.*}" != "$prefix" ]; do
            prefix=${prefix%.*}
            add_tag "$prefix"
        done
    fi
fi

tag_args=()
caches=()

for tag in "${tags[@]}"; do
    tag_args+=(-t "$REPO:$tag")
    caches+=(--cache-from "$REPO:$tag")
done

docker build \
    --build-arg BUILDKIT_INLINE_CACHE=1 \
    --build-arg GIT_DESCRIBE="$version" \
    --build-arg IMAGE_SOURCE="$image_source" \
    "${caches[@]}" \
    "${tag_args[@]}" .

for tag in "${tags[@]}"; do
    docker push "$REPO:$tag"
    echo "$prog: pushed $REPO:$tag" >&2
done
