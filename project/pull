#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

# --ff-only here and below, whatever the caller's pull.rebase or pull.ff: a
# diverged branch stops the sweep, where a merge or a rebase would succeed,
# unseen, and a release would go on to push it.
git pull --ff-only --no-recurse-submodules

# One sweep, from here, whose submodules are the projects .projects names -- and
# --recursive reaches theirs in turn. Run from inside each project instead, the
# recursion would start one level too low: it would bring each project's own
# submodules current but never the project, so a stage that reports having
# pulled everything would leave every project on whatever commit its working
# tree happened to sit on.
#
# checkout before pull, because a submodule is checked out at a recorded commit
# and a detached HEAD has nothing to pull into. The branch comes from
# origin/HEAD rather than a literal, so a project whose default branch is not
# the usual one still follows its own -- not git submodule update --remote,
# which also defaults to the remote HEAD but under --rebase or --merge acts on
# whatever branch the submodule already has checked out.
# The string is for the sh foreach runs in each submodule, which expands it.
# shellcheck disable=SC2016
git submodule foreach --recursive '
    set -eu
    branch=$(git symbolic-ref --short refs/remotes/origin/HEAD | cut -d/ -f2)
    git checkout --no-recurse-submodules "$branch"
    git pull --ff-only --no-recurse-submodules'
