#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

prog=project/stop

usage() {
    echo "Usage: $prog" >&2
    exit 2
}

[ $# -eq 0 ] || usage

dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

# stop tolerates an empty selection where up does not, but the two halves state
# one policy rather than leaning on that difference.
# shellcheck disable=SC2016 # Expanded by bash in each project.
"$dir/each" bash -c '
    set -Eeuo pipefail
    shopt -s inherit_errexit failglob
    services=$("$1")
    [ -z "$services" ] || docker compose stop' _ "$dir/compose-services"
