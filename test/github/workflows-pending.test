#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

pending=$root/github/workflows-pending

# Nothing from the caller's configuration reaches the fixtures, and nothing
# above the scratch dir is taken for a repository.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_CEILING_DIRECTORIES=$test_tmp
# Fixes the order the glob lists entries in.
export LC_ALL=C

n=0

# A fresh repository in $r, with a subdirectory sub.
fixture() {
    n=$((n + 1))
    r=$test_tmp/$n
    git init -q "$r"
    mkdir "$r/sub"
}

fixture
test_check absent 0 '' '' env -C "$r" "$pending"

fixture
mkdir -p "$r/.github/workflows.new"
test_check empty 0 '' '' env -C "$r" "$pending"

# Every entry is listed, a dot file and a directory included, and the pointer to
# workflows-approve sits beside the path workflows-pending was run as, here a
# relative one from a subdirectory.
fixture
mkdir -p "$r/.github/workflows.new/dir"
: >"$r/.github/workflows.new/build.yml"
: >"$r/.github/workflows.new/.hidden"
rel=$(realpath --relative-to="$r/sub" "$root/github")
test_check pending 1 '' "github/workflows-pending: .github/workflows.new/.hidden
github/workflows-pending: .github/workflows.new/build.yml
github/workflows-pending: .github/workflows.new/dir
github/workflows-pending: proposals pending; approve them with $rel/workflows-approve" \
    env -C "$r/sub" "$rel/workflows-pending"

# Any argument is a usage error, even with proposals pending.
fixture
mkdir -p "$r/.github/workflows.new"
: >"$r/.github/workflows.new/build.yml"
test_usage usage github/workflows-pending env -C "$r" "$pending" x

fixture
mkdir -- "$r/.github"
: >"$r/.github/workflows.new"
test_check not-dir 1 '' \
    'github/workflows-pending: .github/workflows.new is not a directory' \
    env -C "$r" "$pending"

test_finish
