#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/init"

# git describe fails with no reachable annotated tag, stopping the build before
# any push: these images carry a release, unlike build-compose's, so an untagged
# copy has none to give. Only a HEAD exactly on an annotated tag adds the
# release and its shorter prefixes as tags.
release=$(git describe --abbrev=0)
version=$(git describe)

# Each tag is taken once, since the branch tag can be the release itself, as on
# a tag push, where init takes the tag's name.
tags=()
declare -A seen=()

add_tag() {
    if [ -z "${seen[$1]:-}" ]; then
        seen[$1]=1
        tags+=("$1")
    fi
}

add_tag "$TAG"

# Docker's tag grammar, its letters written out as docker/init's are. Only the
# release is checked, since each prefix of a valid release is valid too.
alnum=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789
tag_grammar="^[${alnum}_][${alnum}_.-]{0,127}\$"

if [ "$version" = "$release" ]; then
    if ! [[ $release =~ $tag_grammar ]]; then
        echo "${0##*/}: $release: release is not a valid image tag" >&2
        exit 1
    fi

    prefix=$release
    add_tag "$prefix"

    while [ "${prefix%.*}" != "$prefix" ]; do
        prefix=${prefix%.*}
        add_tag "$prefix"
    done
fi

tag_args=()
caches=()

for tag in "${tags[@]}"; do
    tag_args+=(-t "$REPO:$tag")
    caches+=(--cache-from "$REPO:$tag")
done

docker build \
    --build-arg BUILDKIT_INLINE_CACHE=1 \
    --build-arg GIT_DESCRIBE="$version" \
    "${caches[@]}" \
    "${tag_args[@]}" .

for tag in "${tags[@]}"; do
    docker push "$REPO:$tag"
    echo "${0##*/}: pushed $REPO:$tag" >&2
done
