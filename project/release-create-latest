#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

# :? rather than a bare ${1}, as project/tag-create already writes it. An empty
# argument passes a bare expansion untouched and was caught only by tag-create
# -- after the sweep had run and the release commit had been made.
tag=${1:?must be set to the tag to create}
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

source "$dir/release-onto"

release_onto "$dir" latest "$tag"
