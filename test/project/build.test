#!/usr/bin/env bash
#
# Tests project/build in place against real repositories in a scratch dir and
# real GNU make: app, whose submodules lib1 and lib2 are listed in its
# .projects, each cloned from a bare remote, with app's and lib1's remotes one
# commit ahead of the clone, so that a pull would move both. lib1 and app
# declare build, lib2 does not; a recipe logs the target and the project, and
# fails where the project holds a file named fail. A post-merge hook in app logs
# any pull that reaches it. Only app has a compose file, and docker is faked on
# PATH: compose config --services prints web, compose up logs "start" and the
# project and exits FAKE_UP_RC, compose stop logs "stop" and the project, ps
# does nothing, and any other call fails. Every case builds its fixture afresh
# and runs project/build in app.
#
# Run: test/project/build.test. Exits 1 naming each case that failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

build=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../../project")/build
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

# Nothing from the caller's configuration reaches the fixtures. File URLs are
# refused to submodules by default.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
export GIT_CONFIG_COUNT=4
export GIT_CONFIG_KEY_0=protocol.file.allow GIT_CONFIG_VALUE_0=always
export GIT_CONFIG_KEY_1=user.name GIT_CONFIG_VALUE_1=test
export GIT_CONFIG_KEY_2=user.email GIT_CONFIG_VALUE_2=test@example.com
export GIT_CONFIG_KEY_3=init.defaultBranch GIT_CONFIG_VALUE_3=main
# The cases match git's messages, which git translates.
export LC_ALL=C

mkdir "$work/bin"
cat >"$work/bin/docker" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
case $* in
"compose config --services") echo web ;;
"compose up -d --pull missing --wait --wait-timeout "*)
    echo "start ${PWD##*/}" >>"$FAKE_LOG"
    exit "${FAKE_UP_RC:-0}"
    ;;
"compose stop") echo "stop ${PWD##*/}" >>"$FAKE_LOG" ;;
ps) ;;
*) exit 2 ;;
esac
EOF
chmod +x "$work/bin/docker"
export PATH=$work/bin:$PATH
unset DC_WAIT_TIMEOUT

# The recipe logs the target and the project's directory. The string is for
# make, which expands it.
# shellcheck disable=SC2016
recipe='\t@test ! -f fail\n\t@echo "$@ $(notdir $(CURDIR))" >>"$$FAKE_LOG"\n'

# Reports a failure of case $1 at once, each line of $2 under the program and
# the case, so a later abort cannot hide it.
fail() {
    local line
    while IFS= read -r line <&3; do
        echo "${0##*/}: $1: $line" >&2
    done 3<<<"$2"
    failures=$((failures + 1))
}

failures=0
n=0

# Creates bare remote $w/$1.git and $w/$1.up, a clone committing to it, whose
# Makefile declares target $2.
mkrepo() {
    git init -q --bare "$w/$1.git"
    git init -q "$w/$1.up"
    printf %b "$2:\n$recipe" >"$w/$1.up/Makefile"
    git -C "$w/$1.up" add Makefile
    git -C "$w/$1.up" commit -q -m init
    git -C "$w/$1.up" remote add origin "$w/$1.git"
    git -C "$w/$1.up" push -q -u origin main
}

# A fresh fixture in $w, as the header describes.
fixture() {
    local sub
    n=$((n + 1))
    w=$work/$n
    mkdir "$w"
    mkrepo lib1 build
    mkrepo lib2 other
    mkrepo app build
    for sub in lib1 lib2; do
        git -C "$w/app.up" submodule add -q "$w/$sub.git" "$sub"
    done
    printf 'lib1\nlib2\n' >"$w/app.up/.projects"
    touch "$w/app.up/compose.yaml"
    git -C "$w/app.up" add .projects compose.yaml
    git -C "$w/app.up" commit -q -m projects
    git -C "$w/app.up" push -q
    git clone -q --recurse-submodules "$w/app.git" "$w/app"
    for sub in app lib1; do
        git -C "$w/$sub.up" commit -q --allow-empty -m ahead
        git -C "$w/$sub.up" push -q
    done
    cat >"$w/app/.git/hooks/post-merge" <<'EOF'
#!/bin/sh
echo "pull ${PWD##*/}" >>"$FAKE_LOG"
EOF
    chmod +x "$w/app/.git/hooks/post-merge"
    export FAKE_LOG=$w/log
    : >"$FAKE_LOG"
}

# Runs project/build in app and records a failure of case $1 unless its status
# is $2 and the log is $3. Its stdout is kept in $w/out and its stderr in
# $w/err.
check() {
    local rc=0
    (cd "$w/app" && "$build") >"$w/out" 2>"$w/err" || rc=$?
    if [ "$rc" != "$2" ]; then
        fail "$1" "exit $rc, not $2: $(<"$w/err")"
    elif [ "$(<"$FAKE_LOG")" != "$3" ]; then
        fail "$1" "the log is: $(<"$FAKE_LOG")"
    fi
}

# Records a failure of case $1 unless stderr holds $2.
expect_err() {
    if ! grep -qF -- "$2" "$w/err"; then
        fail "$1" "stderr lacks $2: $(<"$w/err")"
    fi
}

# The stages announced on stderr, one per line.
stages() {
    sed -n 's/^build: \([a-z]*\)$/\1/p' "$w/err"
}

# Builds each listed project declaring build and not app itself, starts and
# stops, announcing each stage on stderr and leaving stdout to the stages' own
# output. It builds the commits app records and moves nothing: app stays on its
# commit and every submodule on the one app records for it.
fixture
head=$(git -C "$w/app" rev-parse HEAD)
check whole 0 "$(printf '%s\n' "build lib1" "start app" "stop app")"
if [ "$(stages)" != "$(printf '%s\n' build start stop completed)" ]; then
    fail whole "the stages are: $(stages)"
fi
if [ "$(git -C "$w/app" rev-parse HEAD)" != "$head" ]; then
    fail whole "app moved from $head"
fi
moved=$(git -C "$w/app" status --porcelain --ignore-submodules=none)
if [ -n "$moved" ]; then
    fail whole "app's tree changed: $moved"
fi
if grep -q '^build: ' "$w/out"; then
    fail whole "stdout carries a stage: $(<"$w/out")"
fi
if grep -qxE '[[:space:]=-]*' "$w/err"; then
    fail whole "stderr carries a rule or a blank line: $(<"$w/err")"
fi

# With no list, nothing is swept, rather than the run completing having built
# nothing.
fixture
rm -- "$w/app/.projects"
check no-list 1 ""
expect_err no-list "build: $w/app: no .projects, so there is nothing to sweep"

# A failed build stops the run before anything starts.
fixture
touch "$w/app/lib1/fail"
check build-fails 2 ""

# A listed project that cannot be swept stops the run before any build.
fixture
mkdir "$w/app/sub"
printf 'lib1\nsub\n' >"$w/app/.projects"
check refused 1 ""
expect_err refused \
    "each-without-project: sub: not a submodule of $w/app, so it cannot be swept"

# A listed submodule not checked out stops the run before any build, rather
# than being checked out.
fixture
git -C "$w/app" submodule deinit -q lib1
check uninitialised 1 ""
expect_err uninitialised \
    "each-without-project: lib1: submodule of $w/app not checked out"
if [ -e "$w/app/lib1/Makefile" ]; then
    fail uninitialised "lib1 was checked out"
fi

# A failed start stops the run.
fixture
FAKE_UP_RC=1 check start-fails 1 "$(printf '%s\n' "build lib1" "start app")"

# Any argument is a usage error, refused before anything is built or started.
fixture
rc=0
(cd "$w/app" && "$build" x) >"$w/out" 2>"$w/err" || rc=$?
if [ "$rc" != 2 ] || [ -s "$w/out" ] ||
    [ "$(<"$w/err")" != "Usage: build" ]; then
    fail argument "exit $rc: $(<"$w/out")$(<"$w/err")"
elif [ -s "$FAKE_LOG" ]; then
    fail argument "the log is: $(<"$FAKE_LOG")"
fi

if [ "$failures" -gt 0 ]; then
    exit 1
fi
