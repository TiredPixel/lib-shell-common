#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

# :? rather than a bare ${1}, as project/tag-create already writes it. An empty
# argument passes a bare expansion untouched and was caught only by tag-create
# -- after the sweep had run and the release commit had been made.
tag=${1:?must be set to the tag to create}
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

source "$dir/release-onto"

release_onto "$dir" testing "$tag"

"$dir/each" git checkout stable --no-recurse-submodules

"$dir/each" git pull --ff-only --no-recurse-submodules

# --ff-only whatever the caller's merge.ff: stable only ever moves to a release,
# so a stable carrying commits of its own stops here rather than merging.
"$dir/each" git merge --ff-only "refs/tags/$tag"

"$dir/each" git push --no-follow-tags --recurse-submodules=check origin stable:stable
