#!/usr/bin/env bash
#
# Tests project/each against real repositories in a scratch dir: a project
# named ap\tp, backslash and all, whose submodules lib1 and lib2 are listed in
# its .projects, with a plain directory sub. The command swept is a recorder
# that logs its directory and arguments, a line to a call, and exits 3 where the
# directory holds a file named fail. Every case builds its fixture afresh.
#
# Run: test/project/each.test. Exits 1 naming each case that failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

each=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../../project")/each
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

# Nothing from the caller's configuration reaches the fixtures. File URLs are
# refused to submodules by default.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
export GIT_CONFIG_COUNT=4
export GIT_CONFIG_KEY_0=protocol.file.allow GIT_CONFIG_VALUE_0=always
export GIT_CONFIG_KEY_1=user.name GIT_CONFIG_VALUE_1=test
export GIT_CONFIG_KEY_2=user.email GIT_CONFIG_VALUE_2=test@example.com
export GIT_CONFIG_KEY_3=init.defaultBranch GIT_CONFIG_VALUE_3=main

cat >"$work/record" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
echo "$PWD $*" >>"$FAKE_LOG"
[ ! -f fail ] || exit 3
EOF
chmod +x "$work/record"

# Reports a failure of case $1 at once, each line of $2 under the program and
# the case, so a later abort cannot hide it.
fail() {
    local line
    while IFS= read -r line <&3; do
        echo "${0##*/}: $1: $line" >&2
    done 3<<<"$2"
    failures=$((failures + 1))
}

name='ap\tp'
failures=0
n=0

# A fresh fixture in $w, with the project at $app, its submodules lib1 and lib2
# checked out, sub created, and .projects listing lib1 and lib2.
fixture() {
    local sub
    n=$((n + 1))
    w=$work/$n
    app=$w/$name
    mkdir "$w"
    git init -q "$app"
    for sub in lib1 lib2; do
        git init -q "$w/$sub"
        git -C "$w/$sub" commit -q --allow-empty -m init
        git -C "$app" submodule add -q "$w/$sub" "$sub"
    done
    mkdir "$app/sub"
    printf 'lib1\nlib2\n' >"$app/.projects"
    export FAKE_LOG=$w/log
    : >"$FAKE_LOG"
}

# Runs the sweep of the recorder with arguments a b from directory $1 of the
# project, keeping its status in rc, its stdout in $w/out and its stderr in
# $w/err.
run() {
    rc=0
    (cd "$app/$1" && "$each" "$work/record" a b) >"$w/out" 2>"$w/err" ||
        rc=$?
}

# Records a failure of case $1 unless the status is $2 and the recorder was
# called as $3 has it.
expect() {
    if [ "$rc" != "$2" ]; then
        fail "$1" "exit $rc, not $2: $(<"$w/err")"
    elif [ "$(<"$FAKE_LOG")" != "$3" ]; then
        fail "$1" "the calls were: $(<"$FAKE_LOG")"
    fi
}

# The calls a whole sweep makes, in order.
swept() {
    printf '%s\n' "$app/lib1 a b" "$app/lib2 a b" "$app a b"
}

# Each listed project, then the project itself, each named on a line of stderr
# as it is, and stdout left to the command.
fixture
run .
expect top 0 "$(swept)"
want=$(printf '%s\n' "each-without-project: lib1" "each-without-project: lib2" \
    "each: $name")
if [ "$(<"$w/err")" != "$want" ]; then
    fail top "stderr is: $(<"$w/err")"
fi
if [ -s "$w/out" ]; then
    fail top "stdout is: $(<"$w/out")"
fi

# The command's stdout passes through untouched, a line it ends without a
# newline included, so a caller capturing it gets only the command's data.
fixture
rc=0
(cd "$app" && "$each" printf %s x) >"$w/out" 2>"$w/err" || rc=$?
expect stdout 0 ""
if [ "$(<"$w/out")" != xxx ]; then
    fail stdout "stdout is: $(<"$w/out")"
fi

# With no command, the usage is printed and nothing runs.
fixture
rc=0
(cd "$app" && "$each") >"$w/out" 2>"$w/err" || rc=$?
expect usage 2 ""
if [ "$(<"$w/err")" != "Usage: each COMMAND [ARG...]" ]; then
    fail usage "stderr is: $(<"$w/err")"
fi

# From a subdirectory, the command runs at the top level too.
fixture
run sub
expect subdirectory 0 "$(swept)"

# A refused entry stops the sweep before any command runs, in the project
# itself too.
fixture
git -C "$app" submodule deinit -q -f lib2
run .
expect refused 1 ""

# A failing command stops the sweep before it reaches the project itself.
fixture
touch "$app/lib2/fail"
run .
expect command-fails 3 "$(swept | head -n 2)"

# A missing list leaves the project itself.
fixture
rm -- "$app/.projects"
run .
expect no-list 0 "$app a b"

# Outside a repository, git's failure stops the sweep before any command runs.
# The ceiling keeps git from finding a repository above the scratch dir.
fixture
mkdir "$w/plain"
rc=0
(cd "$w/plain" && GIT_CEILING_DIRECTORIES=$work "$each" "$work/record" a b) \
    >/dev/null 2>"$w/err" || rc=$?
expect outside-repository 128 ""

if [ "$failures" -gt 0 ]; then
    exit 1
fi
