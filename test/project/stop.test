#!/usr/bin/env bash
#
# Runs against real repositories in a scratch dir, app and its submodule lib,
# listed in its .projects, with docker faked on PATH. The fake logs the project
# it runs in and its arguments, a line to a call. compose config --services
# prints the project's file fake-services, if any, or fails where it holds
# fake-config-fails; compose stop exits FAKE_STOP_RC. Any other call fails.
# Every case builds its fixture afresh and runs project/stop in app.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

root=$(readlink -f "$(dirname "$0")/../..")
# shellcheck source=testing/harness
source "$root/testing/harness"

stop=$root/project/stop

# Nothing from the caller's configuration reaches the fixtures. File URLs are
# refused to submodules by default.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
export GIT_CONFIG_COUNT=4
export GIT_CONFIG_KEY_0=protocol.file.allow GIT_CONFIG_VALUE_0=always
export GIT_CONFIG_KEY_1=user.name GIT_CONFIG_VALUE_1=test
export GIT_CONFIG_KEY_2=user.email GIT_CONFIG_VALUE_2=test@example.com
export GIT_CONFIG_KEY_3=init.defaultBranch GIT_CONFIG_VALUE_3=main

cat >"$test_tmp/path/docker" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
echo "${PWD##*/} $*" >>"$FAKE_LOG"
case $* in
"compose config --services")
    if [ -f fake-config-fails ]; then
        echo "fake docker: invalid compose project" >&2
        exit 1
    fi
    [ ! -f fake-services ] || cat fake-services
    ;;
"compose stop")
    exit "${FAKE_STOP_RC:-0}"
    ;;
*) exit 2 ;;
esac
EOF
chmod +x "$test_tmp/path/docker"

n=0

# A fresh fixture in $w: app and lib, each with a compose.yaml and the service
# web.
fixture() {
    local p
    n=$((n + 1))
    w=$test_tmp/$n
    mkdir "$w"
    git init -q "$w/lib"
    git -C "$w/lib" commit -q --allow-empty -m init
    git init -q "$w/app"
    git -C "$w/app" submodule add -q "$w/lib" lib
    echo lib >"$w/app/.projects"
    for p in app app/lib; do
        touch "$w/$p/compose.yaml"
        echo web >"$w/$p/fake-services"
    done
    export FAKE_LOG=$w/log
    : >"$FAKE_LOG"
}

# Runs project/stop in app and records a failure of case $1 unless its status is
# $2, docker was called as $3 has it, its stdout is empty and its stderr is $4
# exactly.
check() {
    local rc=0
    (cd "$w/app" && "$stop") >"$w/out" 2>"$w/err" || rc=$?
    if [ "$rc" != "$2" ]; then
        test_fail "$1" "exit $rc, not $2: $(<"$w/err")"
    elif [ "$(<"$FAKE_LOG")" != "$3" ]; then
        test_fail "$1" "docker was called as: $(<"$FAKE_LOG")"
    elif [ -s "$w/out" ]; then
        test_fail "$1" "stdout is: $(<"$w/out")"
    elif [ "$(<"$w/err")" != "$4" ]; then
        test_fail "$1" "stderr is: $(<"$w/err")"
    fi
}

# Project $1 asked for its services and stopped.
down() {
    printf '%s\n' "$1 compose config --services" "$1 compose stop"
}

# What the sweep writes to stderr as it enters lib, and then app.
lib="project/each-without-project: lib"
both="$lib"$'\n'"project/each: app"

# Each project is stopped.
fixture
check both 0 "$(down lib && down app)" "$both"

# A project with no service to stop, such as one whose services all sit behind a
# profile, is passed over.
fixture
: >"$w/app/lib/fake-services"
check no-services 0 "$(echo "lib compose config --services" && down app)" \
    "$both"

# A project whose configuration compose cannot read fails the sweep, rather than
# passing as one with nothing to stop.
fixture
touch "$w/app/lib/fake-config-fails"
check config-fails 1 "lib compose config --services" \
    "$lib"$'\n'"fake docker: invalid compose project"

# A project that fails to stop fails the sweep.
fixture
FAKE_STOP_RC=1 check stop-fails 1 "$(down lib)" "$lib"

# Any argument is a usage error, refused before docker is called.
fixture
test_usage argument project/stop env -C "$w/app" "$stop" x
if [ -s "$FAKE_LOG" ]; then
    test_fail argument "docker was called as: $(<"$FAKE_LOG")"
fi

test_finish
