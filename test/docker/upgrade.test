#!/usr/bin/env bash
#
# Tests docker/upgrade on Dockerfiles and workflows in a scratch directory, with
# docker, curl and git faked on PATH, so nothing is pulled or fetched. Each fake
# refuses, with exit 2, any arguments but the exact ones upgrade should give it,
# and names on stderr what it pulls or fetches. The fake docker answers every
# pull and gives each image it pulled, and no other, the digest FAKE_DIGEST
# names. Its run takes only docker/lock-resolve on stdin, through sh -c given
# as the entrypoint, as root, in an image it pulled, as pulled or at that
# digest, or in FAKE_HELD, and runs it on the host, reading the file
# FAKE_OS_RELEASE names for /etc/os-release, with PATH only a copy of the
# directory FAKE_CONTAINER names, holding the managers, bash, pip and npm the
# image has, and a few real tools: apt-get, dnf, microdnf, apk, python3 and
# npm are faked, each manager adding to the copy what it installs, and each
# reading its stdin to the end; pip runs only once its module is there, gives
# FAKE_PIP_VERSION, 24.0 where unset, and answers with the report in the file
# FAKE_REPORT names, and npm gives a version or writes the package-lock.json
# FAKE_NPM_LOCK names, each naming on stderr what it was given. The fake curl
# answers every /releases/latest with the redirect FAKE_REDIRECT names, every
# PyPI /pypi/NAME/VERSION/json with the file pypi/NAME/VERSION.json under
# FAKE_FILES, every npm /latest lookup with FAKE_NPM and every
# https://dl.test/PATH with the file PATH under FAKE_FILES, or a 404 where there
# is none. The fake git answers ls-remote, run under timeout with no prompt,
# with FAKE_LS_REMOTE where it is set, and otherwise with the file
# OWNER/REPO/TAG under FAKE_TAGS, or nothing where there is none; the status of
# one literal path, and a directory's top level, it passes to the real git,
# which a --record run asks for.
# FAKE_PULL=fail, FAKE_RUN=fail, FAKE_PIP=fail, FAKE_CURL=fail and FAKE_GIT=fail
# make each fail as the real one would, and FAKE_GIT=timeout exits silently
# with timeout's 124. A fake mktemp fails for the template FAKE_MKTEMP_FAIL
# names, and otherwise runs the real one. Where FAKE_GREP=fail, a fake grep
# fails as the real one would on an unreadable file, given exactly the search
# upgrade makes for FREEZE lines, and otherwise runs the real one.
#
# upgrade runs from a copy beside a fake lint/dockerfile-locks, which names on
# stderr the file it checks and passes it, unless FAKE_LINT=fail, where it
# refuses it as the real one would, FAKE_LINT=usage, where it fails as on a
# usage error, or FAKE_LINT=unreadable, where it fails as on a file it cannot
# read.
#
# Run: test/docker/upgrade.test. Exits 1 naming each case that failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

source=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../../docker")
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

mkdir -p "$work/lib/docker" "$work/lib/lint"
cp -- "$source/upgrade" "$source/lock-resolve" "$work/lib/docker/"
upgrade=$work/lib/docker/upgrade
export FAKE_RESOLVER=$work/lib/docker/lock-resolve
cat >"$work/lib/lint/dockerfile-locks" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
if [ $# != 1 ] || ! [ -f "$1" ]; then
    echo "fake lint: unexpected arguments: $*" >&2
    exit 2
fi
echo "fake lint: $1" >&2
case ${FAKE_LINT:-} in
fail)
    echo "$1:2: npm install reads no lock" >&2
    exit 1
    ;;
usage)
    echo "Usage: dockerfile-locks DOCKERFILE..." >&2
    exit 2
    ;;
unreadable)
    echo "dockerfile-locks: $1:2: a quote has no end" >&2
    exit 3
    ;;
esac
EOF
chmod +x "$work/lib/lint/dockerfile-locks"

mkdir "$work/bin" "$work/container"
cat >"$work/bin/docker" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
# Whether $1 was pulled, where $2 is empty, or is what was pulled at the
# digest, where $2 is @.
pulled() {
    local line
    [ -f "$FAKE_PULLED" ] || return 1
    while IFS= read -r line <&3; do
        if [ -z "$2" ] && [ "$1" = "$line" ]; then
            return 0
        elif [ -n "$2" ] && [ "$1" = "${line%:*}@$FAKE_DIGEST" ]; then
            return 0
        fi
    done 3<"$FAKE_PULLED"
    return 1
}
if [ $# = 2 ] && [ "$1" = pull ]; then
    echo "fake docker: pull $2" >&2
    echo "fake docker: pulled $2"
    printf '%s\n' "$2" >>"$FAKE_PULLED"
    if [ "${FAKE_PULL:-}" = fail ]; then
        echo "fake docker: pull $2 failed" >&2
        exit 1
    fi
elif [ $# = 3 ] && [ "$1" = inspect ] &&
    [ "$2" = '--format={{index .RepoDigests 0}}' ] && pulled "$3" ""; then
    echo "${3%:*}@$FAKE_DIGEST"
elif [ $# -ge 12 ] &&
    [ "$1 $2 $3 $4 $5 $6 $7" = "run -i --rm --entrypoint sh --user 0" ] &&
    { pulled "$8" @ || pulled "$8" "" || [ "$8" = "${FAKE_HELD:-}" ]; } &&
    [ "$9 ${11}" = "-c lock-resolve" ]; then
    script=$(cat)
    if [ "$script" != "$(<"$FAKE_RESOLVER")" ]; then
        echo "fake docker: run was not given lock-resolve" >&2
        exit 2
    fi
    echo "fake docker: run $8 ${*:12}" >&2
    if [ "${FAKE_RUN:-}" = fail ]; then
        echo "docker: Error response from daemon: no space left on device." >&2
        exit 125
    fi
    # A container of its own, so what one run installs no other sees.
    box=$(mktemp -d "$FAKE_BOXES/box.XXXXXX")
    cp -RP -- "$FAKE_CONTAINER/." "$box"
    exec env PATH="$box:$FAKE_TOOLS" sh -c "${10}" "${@:11}" \
        <<<"${script//\/etc\/os-release/$FAKE_OS_RELEASE}"
else
    echo "fake docker: unexpected arguments: $*" >&2
    exit 2
fi
EOF
# Each fake that lock-resolve runs reads its stdin to the end, as a tool that
# prompts may, so one given the script's own stdin would end it there.
mkdir "$work/fakes"
# Adds to the image's directory $1 what each package after it provides: pip's
# module, or npm.
cat >"$work/fakes/install" <<'EOF'
#!/bin/sh
set -eu
dir=$1
shift
for package in "$@"; do
    case $package in
    python3-pip | py3-pip) : >"$dir/pip-module" ;;
    npm) ln -sf "$FAKE_NPM_BIN" "$dir/npm" ;;
    esac
done
EOF
cat >"$work/container/apt-get" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
cat >/dev/null
if [ "$*" = update ]; then
    # On stdout, as apt-get prints it, which lock-resolve must keep off its own.
    echo "fake apt-get: $*"
elif [ "${DEBIAN_FRONTEND:-}" = noninteractive ] &&
    [ "$1 $2 $3" = "install -y --no-install-recommends" ]; then
    echo "fake apt-get: $*"
    "$FAKE_INSTALL" "$(dirname "$0")" "${@:4}"
else
    echo "fake apt-get: unexpected arguments or environment: $*" >&2
    exit 2
fi
EOF
cat >"$work/container/dnf" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
cat >/dev/null
if [ "$1 $2 $3" = "install -y --setopt=install_weak_deps=False" ]; then
    echo "fake dnf: $*"
    "$FAKE_INSTALL" "$(dirname "$0")" "${@:4}"
else
    echo "fake dnf: unexpected arguments: $*" >&2
    exit 2
fi
EOF
cat >"$work/container/microdnf" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
cat >/dev/null
if [ "$1 $2 $3" = "install -y --setopt=install_weak_deps=0" ]; then
    echo "fake microdnf: $*"
    "$FAKE_INSTALL" "$(dirname "$0")" "${@:4}"
else
    echo "fake microdnf: unexpected arguments: $*" >&2
    exit 2
fi
EOF
# In sh, as it may run before bash is there.
cat >"$work/container/apk" <<'EOF'
#!/bin/sh
set -eu
cat >/dev/null
if [ $# -lt 3 ] || [ "$1 $2" != "add --no-cache" ]; then
    echo "fake apk: unexpected arguments: $*" >&2
    exit 2
fi
echo "fake apk: $*"
if [ "$3" = bash ]; then
    ln -s "$FAKE_BASH" "$(dirname "$0")/bash"
fi
shift 2
"$FAKE_INSTALL" "$(dirname "$0")" "$@"
EOF
# pip runs only where the image's directory holds pip's module.
cat >"$work/container/python3" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
cat >/dev/null
if [ "$1 $2" = "-m pip" ] && ! [ -e "$(dirname "$0")/pip-module" ]; then
    echo "$0: No module named pip" >&2
    exit 1
fi
if [ "$*" = "-m pip --version" ]; then
    echo "pip ${FAKE_PIP_VERSION:-24.0} from /usr/lib/python3/dist-packages/pip (python 3.12)"
    exit
elif [ "$*" = "-m pip install -q --disable-pip-version-check --upgrade pip>=22.2" ]; then
    echo "fake pip: upgrade pip>=22.2" >&2
    # On stdout, as pip prints it, which lock-resolve must keep off its own.
    echo "Successfully installed pip-25.0"
    exit
fi
want=(-m pip install -q --isolated --disable-pip-version-check
    --root-user-action=ignore --index-url=https://pypi.org/simple/
    --only-binary=:all: --dry-run --ignore-installed --report -)
if [ $# -le ${#want[@]} ] || [ "${PIP_CONFIG_FILE-}" != /dev/null ] ||
    [ "$(printf '%q ' "${@:1:${#want[@]}}")" != "$(printf '%q ' "${want[@]}")" ]; then
    echo "fake pip: unexpected arguments: $*" >&2
    exit 2
fi
shift ${#want[@]}
echo "fake pip: install $*" >&2
if [ "${FAKE_PIP:-}" = fail ]; then
    echo "ERROR: No matching distribution found for ${!#}" >&2
    exit 1
fi
cat -- "$FAKE_REPORT"
EOF
cat >"$work/fakes/npm" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
cat >/dev/null
if [ "$*" = --version ]; then
    echo 10.9.2
    exit
elif [ $# != 8 ] || [ "$1 $2" != "install --prefix" ] || ! [ -d "$3" ] ||
    [ "${*:4}" != "--package-lock-only --ignore-scripts --no-audit --no-fund --registry=https://registry.npmjs.org/" ]; then
    echo "fake npm: unexpected arguments: $*" >&2
    exit 2
fi
# As the real npm does, one file is never loaded as both configurations; each
# is empty, so no .npmrc redirects a package.
user=${NPM_CONFIG_USERCONFIG:-} global=${NPM_CONFIG_GLOBALCONFIG:-}
if [ -z "$user" ] || [ -z "$global" ] || [ "$user" = "$global" ] ||
    ! [ -f "$user" ] || [ -s "$user" ] || ! [ -f "$global" ] || [ -s "$global" ]; then
    echo "fake npm: user and global configuration '$user' and '$global'" \
        "are not two empty files" >&2
    exit 2
fi
echo "fake npm: package.json in ${3##*/}: $(jq -c . "$3/package.json")" >&2
cp -- "$FAKE_NPM_LOCK" "$3/package-lock.json"
EOF
chmod +x "$work/container/apt-get" "$work/container/dnf" "$work/container/microdnf" \
    "$work/container/apk" "$work/container/python3" "$work/fakes/npm" "$work/fakes/install"
export FAKE_INSTALL=$work/fakes/install FAKE_NPM_BIN=$work/fakes/npm
mkdir "$work/boxes"
export FAKE_BOXES=$work/boxes
# The real tools lock-resolve and the fakes use, bash apart, which each image's
# directory holds or lacks.
mkdir "$work/tools"
for tool in sh cat cp dirname jq ln mkdir mktemp; do
    ln -s -- "$(command -v "$tool")" "$work/tools/$tool"
done
export FAKE_TOOLS=$work/tools
FAKE_BASH=$(command -v bash)
export FAKE_BASH
ln -s -- "$FAKE_BASH" "$work/container/bash"
export FAKE_CONTAINER=$work/container
# Images with microdnf and no dnf; with neither bash nor apk; with pip, as
# python's are, or npm, as node's are, and no manager; and RHEL-like with
# neither dnf nor microdnf.
mkdir "$work/container-micro" "$work/container-bare" "$work/container-pip" \
    "$work/container-node" "$work/container-nodnf"
for tool in bash microdnf python3; do
    ln -s -- "$work/container/$tool" "$work/container-micro/$tool"
done
ln -s -- "$work/container/python3" "$work/container-bare/python3"
for tool in bash python3; do
    ln -s -- "$work/container/$tool" "$work/container-pip/$tool"
    ln -s -- "$work/container/$tool" "$work/container-nodnf/$tool"
done
: >"$work/container-pip/pip-module"
ln -s -- "$work/container/bash" "$work/container-node/bash"
ln -s -- "$FAKE_NPM_BIN" "$work/container-node/npm"
# A Debian image whose npm is on PATH but does not run.
mkdir "$work/container-npm-broken"
for tool in bash apt-get; do
    ln -s -- "$work/container/$tool" "$work/container-npm-broken/$tool"
done
printf '#!/bin/sh\necho "npm: cannot find module" >&2\nexit 1\n' \
    >"$work/container-npm-broken/npm"
chmod +x "$work/container-npm-broken/npm"

# Makes $1 a fresh directory of an Alpine image without bash, which apk adds
# there.
nobash() {
    local tool
    rm -rf -- "$1"
    mkdir -- "$1"
    for tool in apk python3; do
        ln -s -- "$work/container/$tool" "$1/$tool"
    done
}

mkdir "$work/os"
printf 'PRETTY_NAME="Debian GNU/Linux 13 (trixie)"\nID=debian\n' >"$work/os/debian"
printf 'NAME="Ubuntu"\nID=ubuntu\nID_LIKE=debian\n' >"$work/os/ubuntu"
printf 'NAME="Linux Mint"\nID=linuxmint\nID_LIKE="ubuntu debian"\n' >"$work/os/mint"
printf 'NAME="Fedora Linux"\nID="fedora"\nID_LIKE=""\n' >"$work/os/fedora"
printf 'NAME="Red Hat Enterprise Linux"\nID="rhel"\nID_LIKE="fedora"\n' >"$work/os/rhel"
printf 'NAME="Rocky Linux"\nID="rocky"\nID_LIKE="rhel centos fedora"\n' >"$work/os/rocky"
printf 'NAME="Alpine Linux"\nID=alpine\n' >"$work/os/alpine"
printf "NAME='postmarketOS'\nID='postmarketos'\nID_LIKE='alpine'\n" >"$work/os/postmarketos"
printf 'NAME="Arch Linux"\nID=arch\n' >"$work/os/arch"
printf 'NAME="Nameless"\n' >"$work/os/none"
export FAKE_OS_RELEASE=$work/os/debian
cat >"$work/bin/curl" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
url=${!#}
echo "fake curl: $url" >&2
bound=(--connect-timeout 10 --max-time 60)
case $url in
https://github.com/*/releases/latest)
    want=("${bound[@]}" -fsS -o /dev/null -w '%{redirect_url}' "$url")
    body=${FAKE_REDIRECT:-}
    ;;
https://pypi.org/pypi/*/*/json)
    want=("${bound[@]}" -fsSL "$url")
    path=${url#https://pypi.org/pypi/}
    path=$FAKE_FILES/pypi/${path%/json}.json
    ;;
https://registry.npmjs.org/*/latest)
    want=("${bound[@]}" -fsS "$url")
    body=${FAKE_NPM:-}
    ;;
https://dl.test/*)
    want=("${bound[@]}" -fsSL "$url")
    path=$FAKE_FILES/${url#https://dl.test/}
    ;;
*)
    echo "fake curl: unexpected URL" >&2
    exit 2
    ;;
esac
if [ "$(printf '%q ' "$@")" != "$(printf '%q ' "${want[@]}")" ]; then
    echo "fake curl: unexpected arguments: $*" >&2
    exit 2
fi
if [ "${FAKE_CURL:-}" = fail ]; then
    host=${url#https://}
    echo "curl: (6) Could not resolve host: ${host%%/*}" >&2
    exit 6
fi
if [ -n "${path:-}" ]; then
    if ! [ -f "$path" ]; then
        echo "curl: (22) The requested URL returned error: 404" >&2
        exit 22
    fi
    cat -- "$path"
else
    printf '%s' "$body"
fi
EOF
cat >"$work/bin/git" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
if [ $# = 6 ] && [ "$1" = -C ] && [ "$3" = status ] && [ "$4" = --porcelain ] &&
    [ "$5" = -- ] && [[ "$6" == ":(literal)"* ]]; then
    exec "$REAL_GIT" "$@"
elif [ $# = 4 ] && [ "$1" = -C ] && [ "$3 $4" = "rev-parse --show-toplevel" ]; then
    exec "$REAL_GIT" "$@"
fi
echo "fake git: $*" >&2
if [ $# != 5 ] || [ "$1" != ls-remote ] || [ "$2" != --tags ] ||
    [[ "$3" != https://github.com/*/* ]] || [[ "$4" != refs/tags/* ]] ||
    [ "$5" != "$4^{}" ] || [ "${GIT_TERMINAL_PROMPT:-}" != 0 ] ||
    [ "$(</proc/$PPID/comm)" != timeout ]; then
    echo "fake git: unexpected arguments or environment" >&2
    exit 2
fi
case ${FAKE_GIT:-} in
fail)
    echo "fatal: unable to access '$3/': Could not resolve host: github.com" >&2
    exit 128
    ;;
timeout) exit 124 ;;
esac
tagged=$FAKE_TAGS/${3#https://github.com/}/${4#refs/tags/}
if [ -n "${FAKE_LS_REMOTE+set}" ]; then
    printf '%s' "$FAKE_LS_REMOTE"
elif [ -f "$tagged" ]; then
    cat -- "$tagged"
fi
EOF
cat >"$work/bin/mktemp" <<EOF
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
if [ "\$*" = "\${FAKE_MKTEMP_FAIL:-}" ]; then
    echo "mktemp: failed to create file via template '\$*': No space left on device" >&2
    exit 1
fi
exec "$(command -v mktemp)" "\$@"
EOF
cat >"$work/bin/grep" <<EOF
#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob
if [ -n "\${FAKE_GREP:-}" ]; then
    want=(-Hn -i -E
        -e '^[[:space:]]*#[[:space:]]*(from|args?|uses)[-_[:space:]]*freeze([^[:alnum:]_]|\$)' --)
    if [ \$# -le \${#want[@]} ] ||
        [ "\$(printf '%q ' "\${@:1:\${#want[@]}}")" != "\$(printf '%q ' "\${want[@]}")" ]; then
        echo "fake grep: unexpected arguments: \$*" >&2
        exit 2
    fi
    echo "grep: \${!#}: Permission denied" >&2
    exit 2
fi
exec "$(command -v grep)" "\$@"
EOF
chmod +x "$work/bin/docker" "$work/bin/curl" "$work/bin/git" "$work/bin/mktemp" \
    "$work/bin/grep"
mkdir "$work/files"

old=sha256:$(printf '0%.0s' {1..64})
new=sha256:$(printf 'a%.0s' {1..64})
export FAKE_DIGEST=$new
export FAKE_PULLED=$work/pulled
export FAKE_REDIRECT=https://github.com/o/p/releases/tag/v1.2.3
export FAKE_NPM='{"name": "n-d", "version": "3.4.5"}'
export FAKE_FILES=$work/files

# Writes to $1 a pip report installing each NAME==VERSION after it, requiring
# nothing.
report() {
    jq -n '{version: "1", install: [$ARGS.positional[] | split("==")
        | {metadata: {name: .[0], version: .[1]}, requested: false}]}' \
        --args "${@:2}" >"$1"
}
export FAKE_REPORT=$work/report.json
report "$FAKE_REPORT" m-d==2.0.1 Dep_A==1.1

# Writes PyPI's JSON for the release NAME/VERSION $1, listing a wheel with each
# SHA-256 after it, and an sdist.
hs=$(printf '4%.0s' {1..64})
wheels() {
    mkdir -p "$FAKE_FILES/pypi/${1%/*}"
    jq -n --arg sdist "$hs" '{urls: ([$ARGS.positional[]
        | {packagetype: "bdist_wheel", digests: {sha256: .}}]
        + [{packagetype: "sdist", digests: {sha256: $sdist}}])}' \
        --args "${@:2}" >"$FAKE_FILES/pypi/$1.json"
}
ha=$(printf '5%.0s' {1..64})
hb=$(printf '6%.0s' {1..64})
hc=$(printf '7%.0s' {1..64})
hd=$(printf '8%.0s' {1..64})
wheels m-d/2.0.1 "$hc" "$hb" "$hb"
wheels dep-a/1.1 "$ha"
wheels m-d/1.0 "$hd"
# The lock the default report and wheels make, each package's hashes sorted.
req=$'dep-a==1.1 --hash=sha256:'"$ha"$'\nm-d==2.0.1 --hash=sha256:'"$hb"
req+=" --hash=sha256:$hc"

# Writes to $1 a package-lock.json whose root depends on the packages named in
# $2, space-separated, listing each PATH@VERSION after it.
npm_lock() {
    jq -n --arg roots "$2" '{name: "js", lockfileVersion: 3, requires: true,
        packages: ({"": {dependencies: ($roots | split(" ") | map({(.): "*"})
            | add // {})}}
            + ([$ARGS.positional[] | capture("^(?<p>.+)@(?<v>[^@]+)$")
                | {(.p): {version: .v}}] | add // {}))}' \
        --args "${@:3}" >"$1"
}
export FAKE_NPM_LOCK=$work/npm-lock.json
npm_lock "$FAKE_NPM_LOCK" n-d node_modules/n-d@3.4.5 node_modules/dep-b@1.0.0
c1=$(printf '1%.0s' {1..40})
c2=$(printf '2%.0s' {1..40})
c3=$(printf '3%.0s' {1..40})
c4=$(printf '4%.0s' {1..40})
export FAKE_TAGS=$work/tags
mkdir -p "$work/tags/actions/checkout" "$work/tags/o/r" "$work/tags/o/a"
printf '%s\trefs/tags/v7\n' "$c2" >"$work/tags/actions/checkout/v7"
printf '%s\trefs/tags/v1\n' "$c3" >"$work/tags/o/r/v1"
printf '%s\trefs/tags/v2\n%s\trefs/tags/v2^{}\n' "$c4" "$c2" >"$work/tags/o/a/v2"
REAL_GIT=$(command -v git)
export REAL_GIT
export PATH=$work/bin:$PATH

# The real git, for the repositories a --record run needs, reads nothing from
# the caller's configuration and finds no repository above the scratch dir.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_CEILING_DIRECTORIES=$work
export GIT_CONFIG_COUNT=2
export GIT_CONFIG_KEY_0=user.name GIT_CONFIG_VALUE_0=test
export GIT_CONFIG_KEY_1=user.email GIT_CONFIG_VALUE_1=test@example.com

# Commits everything in $1, making it a repository where it is not one.
commit_all() {
    "$REAL_GIT" -C "$1" init -q
    "$REAL_GIT" -C "$1" add -A
    "$REAL_GIT" -C "$1" commit -q -m fixture
}

forms="NAME github:OWNER/PROJECT or NAME sha256:ASSET_URL [CHECKSUMS_URL]"
sources="github:OWNER/PROJECT or sha256:ASSET_URL [CHECKSUMS_URL]"
lockforms="NAME [stage=STAGE] pypi:PACKAGE[==VERSION]... or NAME [stage=STAGE] npm:PACKAGE[@VERSION]..."
specs="pypi:PACKAGE[==VERSION] or npm:PACKAGE[@VERSION]"

failures=0

# Reports a failure of case $1 at once, each line of $2 under the program and
# the case, so a later abort cannot hide it.
fail() {
    local line
    while IFS= read -r line <&3; do
        echo "${0##*/}: $1: $line" >&2
    done 3<<<"$2"
    failures=$((failures + 1))
}

# Runs upgrade on a Dockerfile holding $2, and checks its status is $3, its
# stderr holds $4 where that is not empty, with @F@ in it standing for the
# Dockerfile's path, and the file afterwards is $5, which is $2 when the run
# must change nothing. Where $6 is given, stderr must not hold it. Stdout must
# be empty, since everything upgrade prints is progress or a diagnostic.
check() {
    local name=$1 before=$2 status=$3 said=$4 after=$5 unsaid=${6:-} rc=0
    local file=$work/$name.Dockerfile
    said=${said//@F@/$file}
    printf '%s' "$before" >"$file"
    rm -f -- "$FAKE_PULLED"
    "$upgrade" "$file" >"$work/out" 2>"$work/err" || rc=$?
    if [ "$rc" != "$status" ]; then
        fail "$name" "exit $rc, not $status: $(<"$work/err")"
    elif [ -s "$work/out" ]; then
        fail "$name" "stdout is: $(<"$work/out")"
    elif [ -n "$said" ] && ! grep -qF -- "$said" "$work/err"; then
        fail "$name" "stderr lacks '$said': $(<"$work/err")"
    elif [ -n "$unsaid" ] && grep -qF -- "$unsaid" "$work/err"; then
        fail "$name" "stderr holds '$unsaid': $(<"$work/err")"
    elif [ "$(<"$file")" != "$after" ]; then
        fail "$name" "the file is now: $(<"$file")"
    fi
}

check no-pins $'FROM x:1\nRUN true\n' 0 \
    "upgrade: @F@: no # TRACK FROM, # TRACK ARG or # TRACK LOCK line, so there is nothing to re-pin" \
    $'FROM x:1\nRUN true'

file=$work/missing.Dockerfile
if "$upgrade" "$file" 2>"$work/err" ||
    [ "$(<"$work/err")" != "upgrade: $file: no such file" ]; then
    fail missing "not refused naming it"
fi

file=$work/directory.Dockerfile
mkdir "$file"
if "$upgrade" "$file" 2>"$work/err" ||
    [ "$(<"$work/err")" != "upgrade: $file: not a regular file" ]; then
    fail directory "not refused naming it: $(<"$work/err")"
fi

check from-rewrites $'# TRACK FROM r/x:1\nFROM r/x:1 AS dev\nFROM r/x@'"$old"$'\nFROM r/x:2\nFROM r/xy:1\nFROM base\n' \
    0 "" $'# TRACK FROM r/x:1\nFROM r/x@'"$new"$' AS dev\nFROM r/x@'"$new"$'\nFROM r/x@'"$new"$'\nFROM r/xy:1\nFROM base'

check from-bad-form $'# TRACK FROM nocolon\nFROM nocolon\n' 1 "@F@:1: TRACK FROM nocolon is not REPO:TAG" \
    $'# TRACK FROM nocolon\nFROM nocolon'

check from-names-nothing $'# TRACK FROM r/x:1\nFROM r/xy:1\n' 1 "names no FROM r/x line" \
    $'# TRACK FROM r/x:1\nFROM r/xy:1'

FAKE_PULL=fail check from-pull-fails $'# TRACK FROM r/x:1\nFROM r/x:1\n' 1 "pull r/x:1 failed" \
    $'# TRACK FROM r/x:1\nFROM r/x:1'

FAKE_DIGEST=nonsense check from-no-digest $'# TRACK FROM r/x:1\nFROM r/x:1\n' 1 "gave r/x:1 no digest" \
    $'# TRACK FROM r/x:1\nFROM r/x:1'

check arg-rewrites $'# TRACK ARG V github:o/p\nFROM s\nARG V=1.0.0\nRUN echo "$V"\nARG V=1.0.0\nARG VV=1.0.0\n' \
    0 "" $'# TRACK ARG V github:o/p\nFROM s\nARG V=1.2.3\nRUN echo "$V"\nARG V=1.2.3\nARG VV=1.0.0'

FAKE_REDIRECT=https://github.com/o/p/releases/tag/0.16.9 check arg-unprefixed-tag \
    $'# TRACK ARG V github:o/p\nARG V=0.1\n' 0 "" $'# TRACK ARG V github:o/p\nARG V=0.16.9'

check arg-bad-form $'# TRACK ARG V\nARG V=1\n' 1 \
    "@F@:1: TRACK ARG V is not $forms" \
    $'# TRACK ARG V\nARG V=1'

check arg-bad-name $'# TRACK ARG 1V github:o/p\nARG V=1\n' 1 \
    "is not $forms" \
    $'# TRACK ARG 1V github:o/p\nARG V=1'

check arg-bad-source $'# TRACK ARG V gitlab:o/p\nARG V=1\n' 1 \
    "@F@:1: TRACK ARG V: gitlab:o/p is not $sources" $'# TRACK ARG V gitlab:o/p\nARG V=1'

check arg-names-nothing $'# TRACK ARG V github:o/p\nARG W=1\n' 1 "names no ARG V line" \
    $'# TRACK ARG V github:o/p\nARG W=1'

check arg-no-default $'# TRACK ARG V github:o/p\nARG V=1\nARG V\n' 1 "@F@:3: TRACK ARG V: not ARG V=VALUE" \
    $'# TRACK ARG V github:o/p\nARG V=1\nARG V'

check arg-quoted $'# TRACK ARG V github:o/p\nARG V="1"\n' 1 "@F@:2: TRACK ARG V: not ARG V=VALUE" \
    $'# TRACK ARG V github:o/p\nARG V="1"'

check arg-beside-another $'# TRACK ARG V github:o/p\nARG W=2 V=1\n' 1 "@F@:2: TRACK ARG V: not ARG V=VALUE" \
    $'# TRACK ARG V github:o/p\nARG W=2 V=1'

check arg-differing $'# TRACK ARG V github:o/p\nARG V=1\nARG V=2\n' 1 "hold different values, 1 2" \
    $'# TRACK ARG V github:o/p\nARG V=1\nARG V=2'

FAKE_CURL=fail check arg-lookup-fails $'# TRACK ARG V github:o/p\nARG V=1\n' 6 "Could not resolve host" \
    $'# TRACK ARG V github:o/p\nARG V=1'

FAKE_REDIRECT=https://github.com/o/p/releases check arg-no-release \
    $'# TRACK ARG V github:o/p\nARG V=1\n' 1 "gave no latest release" $'# TRACK ARG V github:o/p\nARG V=1'

FAKE_REDIRECT='' check arg-no-redirect $'# TRACK ARG V github:o/p\nARG V=1\n' 1 "no redirect" \
    $'# TRACK ARG V github:o/p\nARG V=1'

FAKE_REDIRECT=https://github.com/o/p/releases/tag/nightly check arg-not-a-version \
    $'# TRACK ARG V github:o/p\nARG V=1\n' 1 "tag nightly is not a version" \
    $'# TRACK ARG V github:o/p\nARG V=1'

# The ARG's lookup fails after the FROM has resolved, and neither is written.
FAKE_CURL=fail check nothing-written-on-failure \
    $'# TRACK FROM r/x:1\n# TRACK ARG V github:o/p\nFROM r/x:1\nARG V=1\n' 6 "" \
    $'# TRACK FROM r/x:1\n# TRACK ARG V github:o/p\nFROM r/x:1\nARG V=1'

check from-blanks-before-as $'# TRACK FROM r/x:1\nFROM r/x:1\tAS a\nFROM r/x:1  AS b\n' 0 "" \
    $'# TRACK FROM r/x:1\nFROM r/x@'"$new"$'\tAS a\nFROM r/x@'"$new"$'  AS b'

check from-registry-port $'# TRACK FROM localhost:5000/x:1\nFROM localhost:5000/x:1 AS a\n' \
    0 "fake docker: pull localhost:5000/x:1" $'# TRACK FROM localhost:5000/x:1\nFROM localhost:5000/x@'"$new"$' AS a'

check from-port-no-tag $'# TRACK FROM localhost:5000/x\nFROM localhost:5000/x:1\n' 1 \
    "TRACK FROM localhost:5000/x is not REPO:TAG" $'# TRACK FROM localhost:5000/x\nFROM localhost:5000/x:1'

# The second FROM names x on the registry at localhost, not localhost itself.
check from-repo-on-host $'# TRACK FROM localhost:1\nFROM localhost:1\nFROM localhost:5000/x:1\n' 0 "" \
    $'# TRACK FROM localhost:1\nFROM localhost@'"$new"$'\nFROM localhost:5000/x:1'

check from-pinned-twice $'# TRACK FROM r/x:1\n# TRACK FROM r/x:2\nFROM r/x:1\n' 1 \
    "TRACK FROM r/x is pinned twice" $'# TRACK FROM r/x:1\n# TRACK FROM r/x:2\nFROM r/x:1'

# The first FROM r/x:1 continues the RUN before it, so it is no instruction.
check from-in-continuation $'# TRACK FROM r/x:1\nRUN echo \\\nFROM r/x:1\nFROM r/x:1\n' 0 "" \
    $'# TRACK FROM r/x:1\nRUN echo \\\nFROM r/x:1\nFROM r/x@'"$new"

check arg-pinned-twice $'# TRACK ARG V github:o/p\n# TRACK ARG V github:o/q\nARG V=1\n' 1 \
    "TRACK ARG V is pinned twice" $'# TRACK ARG V github:o/p\n# TRACK ARG V github:o/q\nARG V=1'

check arg-any-case $'# TRACK ARG V github:o/p\nARG V=1\narg V=1\nArg V=1\n' 0 "" \
    $'# TRACK ARG V github:o/p\nARG V=1.2.3\narg V=1.2.3\nArg V=1.2.3'

check arg-lower-case-beside-another $'# TRACK ARG V github:o/p\nARG V=1\narg W=2 V=1\n' 1 \
    "@F@:3: TRACK ARG V: not ARG V=VALUE" $'# TRACK ARG V github:o/p\nARG V=1\narg W=2 V=1'

check arg-continued $'# TRACK ARG V github:o/p\nARG V=1\nARG W=1 \\\n    V=1\n' 1 \
    "@F@:3: TRACK ARG V: not ARG V=VALUE" $'# TRACK ARG V github:o/p\nARG V=1\nARG W=1 \\\n    V=1'

check arg-continued-blanks-after $'# TRACK ARG V github:o/p\nARG V=1\nARG W=1 \\ \t\nV=1\n' 1 \
    "@F@:3: TRACK ARG V: not ARG V=VALUE" $'# TRACK ARG V github:o/p\nARG V=1\nARG W=1 \\ \t\nV=1'

check arg-continued-over-comment $'# TRACK ARG V github:o/p\nARG V=1\nARG W=1 \\\n  # V\n\n V=1\n' 1 \
    "@F@:3: TRACK ARG V: not ARG V=VALUE" $'# TRACK ARG V github:o/p\nARG V=1\nARG W=1 \\\n  # V\n\n V=1'

check arg-continued-at-end $'# TRACK ARG V github:o/p\nARG V=1 \\\n' 1 \
    "@F@:2: TRACK ARG V: not ARG V=VALUE" $'# TRACK ARG V github:o/p\nARG V=1 \\'

# A continued ARG naming only others is left alone, and an ARG V=1 continuing
# a RUN is no instruction.
check arg-continued-elsewhere $'# TRACK ARG V github:o/p\nARG V=1\nARG W=1 \\\n    X=2\nRUN echo \\\nARG V=1\n' \
    0 "" $'# TRACK ARG V github:o/p\nARG V=1.2.3\nARG W=1 \\\n    X=2\nRUN echo \\\nARG V=1'

check escape-backtick $'# syntax=docker/dockerfile:1\n# escape=`\n# TRACK ARG V github:o/p\nARG V=1\nARG W=1 `\n V=1\n' \
    1 "@F@:5: TRACK ARG V: not ARG V=VALUE" \
    $'# syntax=docker/dockerfile:1\n# escape=`\n# TRACK ARG V github:o/p\nARG V=1\nARG W=1 `\n V=1'

# With ` the escape character, a line ending in \ is not continued.
check escape-backtick-loosely $'#  ESCAPE = `  \n# TRACK ARG V github:o/p\nRUN echo \\\nARG V=1\n' 0 "" \
    $'#  ESCAPE = `  \n# TRACK ARG V github:o/p\nRUN echo \\\nARG V=1.2.3'

check escape-after-comment $'# TRACK ARG V github:o/p\n# escape=`\nARG V=1\nARG W=1 \\\n V=1\n' 1 \
    "@F@:4: TRACK ARG V: not ARG V=VALUE" $'# TRACK ARG V github:o/p\n# escape=`\nARG V=1\nARG W=1 \\\n V=1'

check escape-after-unknown $'# unknown=x\n# escape=`\n# TRACK ARG V github:o/p\nRUN echo \\\nARG V=1\nARG V=1\n' \
    0 "" $'# unknown=x\n# escape=`\n# TRACK ARG V github:o/p\nRUN echo \\\nARG V=1\nARG V=1.2.3'

check escape-twice $'# escape=`\n# escape=`\n# TRACK ARG V github:o/p\nARG V=1\n' 1 \
    "the escape directive appears twice" $'# escape=`\n# escape=`\n# TRACK ARG V github:o/p\nARG V=1'

check escape-bad $'# escape=x\n# TRACK ARG V github:o/p\nARG V=1\n' 1 \
    "escape directive x is not \\ or \`" $'# escape=x\n# TRACK ARG V github:o/p\nARG V=1'

check arg-continued-no-blank $'# TRACK ARG V github:o/p\nARG V=1\\\n  W=2\n' 1 \
    "@F@:2: TRACK ARG V: not ARG V=VALUE" $'# TRACK ARG V github:o/p\nARG V=1\\\n  W=2'

# The escape character, and whatever follows the reference before it, stays.
check from-continued $'# TRACK FROM r/x:1\nFROM r/x:1\\\n  AS a\nFROM r/x:1 AS b \\ \n\n  # c\n  AS b\n' 0 "" \
    $'# TRACK FROM r/x:1\nFROM r/x@'"$new"$'\\\n  AS a\nFROM r/x@'"$new"$' AS b \\ \n\n  # c\n  AS b'

check from-reference-split $'# TRACK FROM r/x:1\nFROM r/x:\\\n1\n' 1 \
    "@F@:2: TRACK FROM r/x: not FROM r/x:TAG or FROM r/x@DIGEST" $'# TRACK FROM r/x:1\nFROM r/x:\\\n1'

# Joined, the reference runs on into AS.
check from-reference-joined $'# TRACK FROM r/x:1\nFROM r/x:1\\\nAS a\n' 1 \
    "@F@:2: TRACK FROM r/x: not FROM r/x:TAG or FROM r/x@DIGEST" $'# TRACK FROM r/x:1\nFROM r/x:1\\\nAS a'

check from-after-escape $'# TRACK FROM r/x:1\nFROM \\\n  r/x:1\n' 1 \
    "@F@:2: TRACK FROM r/x: not FROM r/x:TAG or FROM r/x@DIGEST" $'# TRACK FROM r/x:1\nFROM \\\n  r/x:1'

check from-any-case $'# TRACK FROM r/x:1\nfrom r/x:1\nFrom r/x:1 AS a\n' 0 "" \
    $'# TRACK FROM r/x:1\nfrom r/x@'"$new"$'\nFrom r/x@'"$new"$' AS a'

check from-indented $'# TRACK FROM r/x:1\nFROM r/x:1\n  FROM r/x:1\n' 1 \
    "@F@:3: TRACK FROM r/x: not FROM r/x:TAG or FROM r/x@DIGEST" $'# TRACK FROM r/x:1\nFROM r/x:1\n  FROM r/x:1'

check from-untagged $'# TRACK FROM r/x:1\nFROM r/x:1\nFROM r/x AS dev\n' 1 \
    "@F@:3: TRACK FROM r/x: not FROM r/x:TAG or FROM r/x@DIGEST" $'# TRACK FROM r/x:1\nFROM r/x:1\nFROM r/x AS dev'

check from-flag $'# TRACK FROM r/x:1\nFROM --platform=linux/amd64 r/x:1\n' 1 \
    "@F@:2: TRACK FROM r/x: not FROM r/x:TAG or FROM r/x@DIGEST" $'# TRACK FROM r/x:1\nFROM --platform=linux/amd64 r/x:1'

# A flag naming no image, and a FROM naming another, are passed over.
check from-others $'# TRACK FROM r/x:1\nFROM --platform=x\nFROM --platform=x r/y:1\nRUN echo r/x:1\nFROM r/x:1\n' 0 "" \
    $'# TRACK FROM r/x:1\nFROM --platform=x\nFROM --platform=x r/y:1\nRUN echo r/x:1\nFROM r/x@'"$new"

# Each refusal comes before any pin is looked up.
check from-pinned-twice-early $'# TRACK FROM r/x:1\n# TRACK FROM r/y:1\n# TRACK FROM r/x:2\nFROM r/x:1\nFROM r/y:1\n' 1 \
    "TRACK FROM r/x is pinned twice" \
    $'# TRACK FROM r/x:1\n# TRACK FROM r/y:1\n# TRACK FROM r/x:2\nFROM r/x:1\nFROM r/y:1' "fake docker:"

check arg-pinned-twice-early $'# TRACK ARG V github:o/p\n# TRACK ARG W github:o/p\n# TRACK ARG V github:o/q\nARG V=1\nARG W=1\n' 1 \
    "TRACK ARG V is pinned twice" \
    $'# TRACK ARG V github:o/p\n# TRACK ARG W github:o/p\n# TRACK ARG V github:o/q\nARG V=1\nARG W=1' "fake curl:"

check arg-names-nothing-early $'# TRACK FROM r/x:1\n# TRACK ARG V github:o/p\nFROM r/x:1\n' 1 \
    "names no ARG V line" $'# TRACK FROM r/x:1\n# TRACK ARG V github:o/p\nFROM r/x:1' "fake docker:"

# A heredoc's body, pins and mistyped pins included, is no instruction.
check heredoc $'# TRACK ARG V github:o/p\nARG V=1\nRUN <<EOF\narg V=1\n# TRACK ARG W github:o/p\n#track from x\nEOF\nARG V=1\n' 0 "" \
    $'# TRACK ARG V github:o/p\nARG V=1.2.3\nRUN <<EOF\narg V=1\n# TRACK ARG W github:o/p\n#track from x\nEOF\nARG V=1.2.3'

# A comment line that reads as a mistyped TRACK line fails, as does a
# TRACK USES, before any pin is looked up.
n=0
for typo in "#TRACK FROM r/x:1" "  # TRACK FROM r/x:1" "# track from r/x:1" "# TRACKFROM r/x:1" \
    "# TRACK FROM" "# TRACK  ARG V github:o/p" "# Track Arg V github:o/p" "# TRACK ARG" \
    "# TRACK-ARG V github:o/p" "# TRACK_ARG V github:o/p" "# TRACK ARGS V github:o/p" \
    "# track - from r/x:1" "# TRACK_FROMS r/x:1" "#TRACK LOCK m pypi:m-d" "# track lock m pypi:m-d" \
    "# TRACK LOCK" "# TRACK-LOCK m pypi:m-d" "# TRACK LOCKS m pypi:m-d" "# TRACK  LOCK m pypi:m-d"; do
    n=$((n + 1))
    case $typo in
    *[Ff][Rr][Oo][Mm]*) form="not # TRACK FROM REPO:TAG" ;;
    *[Ll][Oo][Cc][Kk]*) form="not # TRACK LOCK NAME PACKAGE..." ;;
    *) form="not # TRACK ARG NAME SOURCE" ;;
    esac
    check "typo-$n" "# TRACK ARG V github:o/p"$'\n'"$typo"$'\nARG V=1\n' 1 "@F@:2: $form" \
        "# TRACK ARG V github:o/p"$'\n'"$typo"$'\nARG V=1' "fake curl:"
done
check track-uses-in-dockerfile $'# TRACK ARG V github:o/p\n#  TRACK USES o/r@v1\nARG V=1\n' 1 \
    "@F@:2: TRACK USES belongs in a workflow, not a Dockerfile" \
    $'# TRACK ARG V github:o/p\n#  TRACK USES o/r@v1\nARG V=1' "fake curl:"

# Words that only begin like a TRACK kind are no mistyped pin.
check track-prose $'# TRACK ARG V github:o/p\n# Track arguments here\n# tracks from x\n# trackuses_x\n# tracking from x\n# track-args_x\nARG V=1\n' 0 "" \
    $'# TRACK ARG V github:o/p\n# Track arguments here\n# tracks from x\n# trackuses_x\n# tracking from x\n# track-args_x\nARG V=1.2.3'

check heredoc-several $'# TRACK ARG V github:o/p\ncopy <<-"A" 2<<\'B\' \\\n  /d/\n\tARG V=1\n\tA\nARG V=1\nB\nADD <<C /f\n EOF\nC\nARG V=1\n' 0 "" \
    $'# TRACK ARG V github:o/p\ncopy <<-"A" 2<<\'B\' \\\n  /d/\n\tARG V=1\n\tA\nARG V=1\nB\nADD <<C /f\n EOF\nC\nARG V=1.2.3'

# Without <<-, a tab before the delimiter keeps it in the body.
check heredoc-tab-kept $'# TRACK ARG V github:o/p\nRUN <<EOF\n\tEOF\nARG V=1\nEOF\nARG V=1\n' 0 "" \
    $'# TRACK ARG V github:o/p\nRUN <<EOF\n\tEOF\nARG V=1\nEOF\nARG V=1.2.3'

# A quoted <<, one in another instruction and one with no delimiter open no
# heredoc.
check heredoc-not $'# TRACK ARG V github:o/p\nRUN echo \'<<EOF\' <<\nARG V=1\nCMD cat <<EOF\nARG V=1\n' 0 "" \
    $'# TRACK ARG V github:o/p\nRUN echo \'<<EOF\' <<\nARG V=1.2.3\nCMD cat <<EOF\nARG V=1.2.3'

check heredoc-unended $'# TRACK ARG V github:o/p\nARG V=1\nRUN <<EOF\nARG V=1\n' 1 \
    "a heredoc's body has no end line EOF" $'# TRACK ARG V github:o/p\nARG V=1\nRUN <<EOF\nARG V=1'

sha256_of() {
    local sum
    sum=$(printf '%s' "$1" | sha256sum)
    printf '%s' "${sum%% *}"
}
mkdir "$work/files/v1.2.3" "$work/files/v0.9" "$work/files/va&b"
printf 'tool' >"$work/files/v1.2.3/t_1.2.3_linux"
printf 'old tool' >"$work/files/v0.9/t_0.9_linux"
printf 'old tool' >"$work/files/va&b/t_a&b_linux"
ht=$(sha256_of tool)
hu=$(sha256_of 'old tool')
hx=$(printf 'c%.0s' {1..64})
hy=$(printf 'd%.0s' {1..64})
sums=$work/files/v1.2.3/sums

# A sha256 pin before the version pin its URLs name, which resolves first.
pins=$'# TRACK ARG H sha256:https://dl.test/v${V}/t_${V}_linux https://dl.test/v${V}/sums\n# TRACK ARG V github:o/p\n'
before=$pins$'ARG V=1.0.0\nARG H='"$hy"
sum_pinned() {
    printf '%s' "$pins"$'ARG V=1.2.3\nARG H='"$1"
}

printf '%s  t_1.2.3_darwin\n%s  t_1.2.3_linux\n%s  t_1.2.3_linux.sig\n%s  xt_1.2.3_linux\n' \
    "$hy" "$hx" "$hy" "$hy" >"$sums"
check sum-gnu "$before" 0 "fake curl: https://dl.test/v1.2.3/sums" "$(sum_pinned "$hx")"

printf '%s *t_1.2.3_linux\n' "$hx" >"$sums"
check sum-gnu-binary "$before" 0 "" "$(sum_pinned "$hx")"

printf '%s  ./dist/t_1.2.3_linux\n' "$hx" >"$sums"
check sum-gnu-path "$before" 0 "" "$(sum_pinned "$hx")"

printf 'MD5 (t_1.2.3_linux) = %s\nSHA256 (t_1.2.3_darwin) = %s\nSHA256 (t_1.2.3_linux) = %s\nSHA512 (t_1.2.3_linux) = %s%s\n' \
    "${hy:0:32}" "$hy" "$hx" "$hy" "$hy" >"$sums"
check sum-bsd "$before" 0 "" "$(sum_pinned "$hx")"

printf '%s  t_1.2.3_linux\n' "${ht^^}" >"$sums"
check sum-upper-case "$before" 0 "" "$(sum_pinned "$ht")"

printf '%s  t_1.2.3_linux\nSHA256 (dist/t_1.2.3_linux) = %s\n' "$hx" "$hx" >"$sums"
check sum-listed-twice "$before" 0 "" "$(sum_pinned "$hx")"

# A single space before the name is neither GNU's form nor BSD's.
printf '%s t_1.2.3_linux\nSHA1 (t_1.2.3_linux) = %s\n%s  t_1.2.3_linux.sig\n' "$hx" "${hx:0:40}" "$hx" >"$sums"
check sum-missing "$before" 1 "TRACK ARG H: https://dl.test/v1.2.3/sums gives no SHA-256 for t_1.2.3_linux" "$before"

printf '%s  t_1.2.3_linux\n%s  a/t_1.2.3_linux\n' "$hx" "$hy" >"$sums"
check sum-differing "$before" 1 "gives t_1.2.3_linux different SHA-256s, $hx $hy" "$before"

rm -- "$sums"
check sum-fetch-fails "$before" 22 "returned error: 404" "$before"

check hash-download $'# TRACK ARG H sha256:https://dl.test/v${V}/t_${V}_linux\n# TRACK ARG V github:o/p\nARG V=1\nARG H='"$hy"$'\n' \
    0 "fake curl: https://dl.test/v1.2.3/t_1.2.3_linux" \
    $'# TRACK ARG H sha256:https://dl.test/v${V}/t_${V}_linux\n# TRACK ARG V github:o/p\nARG V=1.2.3\nARG H='"$ht"

check hash-download-fails $'# TRACK ARG H sha256:https://dl.test/v1/t\nARG H='"$hy"$'\n' 22 "returned error: 404" \
    $'# TRACK ARG H sha256:https://dl.test/v1/t\nARG H='"$hy"

# An ARG nothing pins keeps its value, which the URL takes.
check hash-unpinned-var $'# TRACK ARG H sha256:https://dl.test/v${W}/t_${W}_linux\nARG W=0.9\nARG H='"$hy"$'\nARG W=0.9\n' 0 "" \
    $'# TRACK ARG H sha256:https://dl.test/v${W}/t_${W}_linux\nARG W=0.9\nARG H='"$hu"$'\nARG W=0.9'

# An & in the value is taken as it is, not as the ${VAR} it replaces.
check hash-var-ampersand $'# TRACK ARG H sha256:https://dl.test/v${W}/t_${W}_linux\nARG W=a&b\nARG H='"$hy"$'\n' 0 \
    "fake curl: https://dl.test/va&b/t_a&b_linux" \
    $'# TRACK ARG H sha256:https://dl.test/v${W}/t_${W}_linux\nARG W=a&b\nARG H='"$hu"

check hash-var-names-nothing $'# TRACK ARG H sha256:https://dl.test/${X}\nARG H=1\n' 1 \
    "TRACK ARG H: \${X} names no ARG X line" $'# TRACK ARG H sha256:https://dl.test/${X}\nARG H=1' "fake curl:"

check hash-var-differing $'# TRACK ARG H sha256:https://dl.test/${W}\nARG H=1\nARG W=1\nARG W=2\n' 1 \
    "TRACK ARG H: \${W}: its ARG lines hold different values, 1 2" \
    $'# TRACK ARG H sha256:https://dl.test/${W}\nARG H=1\nARG W=1\nARG W=2'

check hash-var-is-hash $'# TRACK ARG H sha256:https://dl.test/${G}\n# TRACK ARG G sha256:https://dl.test/g\nARG H=1\nARG G=1\n' 1 \
    "TRACK ARG H: \${G} is itself a sha256 pin" \
    $'# TRACK ARG H sha256:https://dl.test/${G}\n# TRACK ARG G sha256:https://dl.test/g\nARG H=1\nARG G=1' "fake curl:"

check hash-bare-dollar $'# TRACK ARG V github:o/p\n# TRACK ARG H sha256:https://dl.test/${V}/$V\nARG V=1\nARG H=1\n' 1 \
    "TRACK ARG H: https://dl.test/\${V}/\$V holds a \$ not in \${VAR}" \
    $'# TRACK ARG V github:o/p\n# TRACK ARG H sha256:https://dl.test/${V}/$V\nARG V=1\nARG H=1' "fake curl:"

check hash-var-not-literal $'# TRACK ARG H sha256:https://dl.test/${W}\nARG H=1\nARG W=$X\n' 1 \
    "TRACK ARG H: \${W} is \$X, not a literal" $'# TRACK ARG H sha256:https://dl.test/${W}\nARG H=1\nARG W=$X'

check hash-var-no-file $'# TRACK ARG H sha256:https://dl.test/${W}\nARG H=1\nARG W=a/\n' 1 \
    "TRACK ARG H: https://dl.test/a/ names no file" $'# TRACK ARG H sha256:https://dl.test/${W}\nARG H=1\nARG W=a/'

check hash-not-https $'# TRACK ARG H sha256:http://dl.test/t\nARG H=1\n' 1 "is not $sources" \
    $'# TRACK ARG H sha256:http://dl.test/t\nARG H=1'

check hash-three-urls $'# TRACK ARG H sha256:https://dl.test/t https://dl.test/s https://dl.test/u\nARG H=1\n' 1 \
    "is not $sources" $'# TRACK ARG H sha256:https://dl.test/t https://dl.test/s https://dl.test/u\nARG H=1'

check hash-names-directory $'# TRACK ARG H sha256:https://dl.test/t/\nARG H=1\n' 1 "is not $sources" \
    $'# TRACK ARG H sha256:https://dl.test/t/\nARG H=1'

# Runs upgrade on a Dockerfile holding $2 and a workflow holding $3, in
# $work/$1/.github/workflows, and checks its status is $4, its stderr holds $5
# where that is not empty, with @F@ in it standing for the Dockerfile's path and
# @W@ for the workflow's, and the Dockerfile afterwards is $6. The workflow must
# be untouched, and its proposal $7, or absent, with no workflows.new, where $7
# is the workflow as it was. Where $8 is given, stderr must not hold it. Stdout
# must be empty.
flow() {
    local name=$1 before=$2 wbefore=$3 status=$4 said=$5 after=$6 wafter=$7 unsaid=${8:-} rc=0
    local file=$work/$name.Dockerfile dir=$work/$name/.github
    local wfile=$dir/workflows/w.yml proposal=$dir/workflows.new/w.yml
    said=${said//@F@/$file}
    said=${said//@W@/$wfile}
    rm -rf -- "${work:?}/${name:?}"
    mkdir -p "$dir/workflows"
    printf '%s' "$before" >"$file"
    printf '%s' "$wbefore" >"$wfile"
    rm -f -- "$FAKE_PULLED"
    "$upgrade" "$file" "$wfile" >"$work/out" 2>"$work/err" || rc=$?
    if [ "$rc" != "$status" ]; then
        fail "$name" "exit $rc, not $status: $(<"$work/err")"
    elif [ -s "$work/out" ]; then
        fail "$name" "stdout is: $(<"$work/out")"
    elif [ -n "$said" ] && ! grep -qF -- "$said" "$work/err"; then
        fail "$name" "stderr lacks '$said': $(<"$work/err")"
    elif [ -n "$unsaid" ] && grep -qF -- "$unsaid" "$work/err"; then
        fail "$name" "stderr holds '$unsaid': $(<"$work/err")"
    elif [ "$(<"$file")" != "$after" ]; then
        fail "$name" "the Dockerfile is now: $(<"$file")"
    elif [ "$(<"$wfile")" != "$(printf '%s' "$wbefore")" ]; then
        fail "$name" "the workflow was written: $(<"$wfile")"
    elif [ "$wafter" = "$(printf '%s' "$wbefore")" ]; then
        if [ -e "$dir/workflows.new" ]; then
            fail "$name" "$dir/workflows.new was made"
        fi
    elif ! [ -f "$proposal" ]; then
        fail "$name" "no proposal was written"
    elif [ "$(<"$proposal")" != "$wafter" ]; then
        fail "$name" "the proposal is: $(<"$proposal")"
    fi
}

df=$'# TRACK ARG V github:o/p\nARG V=1'
dfafter=$'# TRACK ARG V github:o/p\nARG V=1.2.3'

# A TRACK USES is read wherever it falls. Each covered uses: moves, whatever
# its REF and whatever PATH follows OWNER/REPO, with blanks at its end dropped;
# the TRACK USES lines, an uncovered uses: and its comments stay.
wf=$(printf '%s\n' "# TRACK USES actions/checkout@v7" "steps:" \
    "  - uses: actions/checkout@$c1" "  - uses: o/r/sub/dir@$c1" "  - name: x" \
    "    uses: o/r@v1"$' \t' "  - uses: o/r@main" "  # v9.0.0" "  - uses: u/x@v9" \
    "  - uses: u/x@$c1 # v9.0.0" "  - uses: ./local" "  - uses: docker://alpine:3" \
    "  # uses: o/r@v0" "# TRACK USES o/r@v1")
wfafter=$(printf '%s\n' "# TRACK USES actions/checkout@v7" "steps:" \
    "  - uses: actions/checkout@$c2" "  - uses: o/r/sub/dir@$c3" "  - name: x" \
    "    uses: o/r@$c3" "  - uses: o/r@$c3" "  # v9.0.0" "  - uses: u/x@v9" \
    "  - uses: u/x@$c1 # v9.0.0" "  - uses: ./local" "  - uses: docker://alpine:3" \
    "  # uses: o/r@v0" "# TRACK USES o/r@v1")
flow wf-repins "$df" "$wf" 0 'fake git: ls-remote --tags https://github.com/o/r refs/tags/v1 refs/tags/v1^{}' \
    "$dfafter" "$wfafter" "fake curl: https://github.com/o/r/"
if [ "$(grep -c 'fake git: .* https://github.com/o/r ' "$work/err")" != 1 ]; then
    fail wf-repins "o/r not looked up once: $(<"$work/err")"
fi
if grep -qF 'https://github.com/u/x' "$work/err"; then
    fail wf-repins "the uncovered u/x was looked up: $(<"$work/err")"
fi

flow wf-dockerfile-unpinned $'FROM x\n' "$wf" 0 \
    "upgrade: @F@: no # TRACK FROM, # TRACK ARG or # TRACK LOCK line, so there is nothing to re-pin" \
    $'FROM x' "$wfafter"

# Peeled through the annotated tag to the commit.
flow wf-annotated "$df" $'# TRACK USES o/a@v2\n  - uses: o/a@v1\n' 0 "" \
    "$dfafter" $'# TRACK USES o/a@v2\n  - uses: o/a@'"$c2"

wf=$(printf '%s\n' "steps:" "  - uses: o/r@$c1 # v1" "  - uses: o/r@v1")
flow wf-uncovered "$df" "$wf" 0 "upgrade: @W@: no # TRACK USES line, so there is nothing to re-pin" \
    "$dfafter" "$wf" "fake git:"

# Neither a comment at another indent nor one naming no version is a tag.
n=0
for above in "    # v1" "# v1" "  # Checkout" "  # Step 2 of 3" "  # v1x"; do
    n=$((n + 1))
    wf=$(printf '%s\n' "# TRACK USES o/r@v1" "$above" "  - uses: o/r@$c1")
    flow "wf-not-above-$n" "$df" "$wf" 0 "" "$dfafter" \
        "$(printf '%s\n' "# TRACK USES o/r@v1" "$above" "  - uses: o/r@$c3")"
done

# Every pin in every file resolves before any is written: the second
# workflow's tag is missing, so neither it, the first nor the Dockerfile moves.
m=$work/multi/.github
mkdir -p "$m/workflows"
printf '%s' "$df" >"$work/multi.Dockerfile"
first=$'# TRACK USES o/r@v1\n  - uses: o/r@v0'
second=$'# TRACK USES o/r@v9\n  - uses: o/r@v0'
printf '%s\n' "$first" >"$m/workflows/1.yml"
printf '%s\n' "$second" >"$m/workflows/2.yml"
rc=0
"$upgrade" "$work/multi.Dockerfile" "$m/workflows/1.yml" "$m/workflows/2.yml" \
    >/dev/null 2>"$work/err" || rc=$?
if [ "$rc" != 1 ] ||
    ! grep -qF "upgrade: $m/workflows/2.yml: TRACK USES o/r@v9: o/r has no tag v9" "$work/err"; then
    fail wf-multi-fails "exit $rc, not refused naming it: $(<"$work/err")"
elif [ "$(<"$work/multi.Dockerfile")" != "$df" ] || [ -e "$m/workflows.new" ]; then
    fail wf-multi-fails "a file was written"
fi

# One OWNER/REPO@TAG named in two files is looked up once, and each file takes
# its own TAG's commit. A workflow nothing moves in gets no proposal, and the
# workflows.new already there keeps what it holds.
printf '%s\n' "$first" >"$m/workflows/2.yml"
printf '%s\n' $'# TRACK USES o/a@v2\n  - uses: o/a@v0' >"$m/workflows/3.yml"
printf '%s\n' $'# TRACK USES o/a@v2\n  - uses: o/a@'"$c2" >"$m/workflows/4.yml"
mkdir "$m/workflows.new"
printf 'other\n' >"$m/workflows.new/other.yml"
rc=0
"$upgrade" "$work/multi.Dockerfile" "$m/workflows/1.yml" "$m/workflows/2.yml" \
    "$m/workflows/3.yml" "$m/workflows/4.yml" >/dev/null 2>"$work/err" || rc=$?
if [ "$rc" != 0 ]; then
    fail wf-multi "exit $rc, not 0: $(<"$work/err")"
elif [ "$(grep -c 'fake git: .* https://github.com/o/r ' "$work/err")" != 1 ]; then
    fail wf-multi "o/r@v1 not looked up once: $(<"$work/err")"
elif [ "$(<"$m/workflows.new/1.yml")" != $'# TRACK USES o/r@v1\n  - uses: o/r@'"$c3" ] ||
    [ "$(<"$m/workflows.new/2.yml")" != $'# TRACK USES o/r@v1\n  - uses: o/r@'"$c3" ] ||
    [ "$(<"$m/workflows.new/3.yml")" != $'# TRACK USES o/a@v2\n  - uses: o/a@'"$c2" ] ||
    [ "$(<"$m/workflows.new/other.yml")" != other ]; then
    fail wf-multi "a proposal is wrong"
elif [ -e "$m/workflows.new/4.yml" ]; then
    fail wf-multi "4.yml, which nothing moved, has a proposal"
elif [ "$(<"$m/workflows/1.yml")" != "$first" ] ||
    [ "$(<"$m/workflows/3.yml")" != $'# TRACK USES o/a@v2\n  - uses: o/a@v0' ]; then
    fail wf-multi "a workflow was written"
fi

# A proposal already pending, even one dangling, is refused before any lookup.
printf '%s' "$df" >"$work/multi.Dockerfile"
for kind in file link; do
    rm -rf -- "$m/workflows.new"
    mkdir "$m/workflows.new"
    if [ "$kind" = file ]; then
        printf 'pending\n' >"$m/workflows.new/2.yml"
    else
        ln -s absent "$m/workflows.new/2.yml"
    fi
    said="upgrade: $(readlink -f "$m")/workflows.new/2.yml: is a proposal for"
    said+=" $m/workflows/2.yml already pending; approve or remove it first"
    rc=0
    "$upgrade" "$work/multi.Dockerfile" "$m/workflows/1.yml" "$m/workflows/2.yml" \
        >/dev/null 2>"$work/err" || rc=$?
    if [ "$rc" != 1 ] || [ "$(<"$work/err")" != "$said" ]; then
        fail "wf-pending-$kind" "exit $rc, not refused naming it: $(<"$work/err")"
    elif grep -qF "fake " "$work/err"; then
        fail "wf-pending-$kind" "looked up: $(<"$work/err")"
    elif [ "$(<"$work/multi.Dockerfile")" != "$df" ] || [ -e "$m/workflows.new/1.yml" ]; then
        fail "wf-pending-$kind" "a file was written"
    fi
done
rm -rf -- "$m/workflows.new"

# A workflow outside a .github/workflows directory is refused before any lookup.
mkdir -p "$work/loose/workflows" "$work/loose/x/.github"
for wfile in "$work/loose/w.yml" "$work/loose/workflows/w.yml" "$work/loose/x/.github/w.yml"; do
    printf '%s\n' "$first" >"$wfile"
    rc=0
    "$upgrade" "$work/multi.Dockerfile" "$wfile" >/dev/null 2>"$work/err" || rc=$?
    if [ "$rc" != 1 ] ||
        ! grep -qxF "upgrade: $wfile: is not in a .github/workflows directory" "$work/err"; then
        fail wf-loose "$wfile: exit $rc, not refused: $(<"$work/err")"
    elif grep -qF "fake " "$work/err"; then
        fail wf-loose "$wfile: looked up: $(<"$work/err")"
    fi
done

pinned=$'# TRACK USES o/r@v1\n  - uses: o/r@v0\n'
FAKE_LS_REMOTE=$c2$'\trefs/tags/v1^{}\n' flow wf-only-peeled "$df" "$pinned" 1 \
    "TRACK USES o/r@v1: o/r has no tag v1" "$df" "${pinned%$'\n'}"

flow wf-no-tag "$df" $'# TRACK USES o/r@v9\n  - uses: o/r@v0\n' 1 \
    "TRACK USES o/r@v9: o/r has no tag v9" "$df" $'# TRACK USES o/r@v9\n  - uses: o/r@v0'

FAKE_LS_REMOTE=$c2$'\trefs/tags/v10\n' flow wf-other-tag "$df" "$pinned" 1 \
    "TRACK USES o/r@v1: git ls-remote gave $c2 refs/tags/v10" "$df" "${pinned%$'\n'}"

FAKE_LS_REMOTE=$'abc\trefs/tags/v1\n' flow wf-not-a-commit "$df" "$pinned" 1 \
    "TRACK USES o/r@v1: git ls-remote gave abc refs/tags/v1" "$df" "${pinned%$'\n'}"

# The Dockerfile's pin has resolved, and neither file is written.
FAKE_GIT=fail flow wf-git-fails "$df" "$pinned" 1 "Could not resolve host" \
    "$df" "${pinned%$'\n'}"
if ! grep -qF "TRACK USES o/r@v1: git ls-remote failed or timed out" "$work/err"; then
    fail wf-git-fails "the failure is not named: $(<"$work/err")"
fi

FAKE_GIT=timeout flow wf-git-times-out "$df" "$pinned" 1 \
    "TRACK USES o/r@v1: git ls-remote failed or timed out" "$df" "${pinned%$'\n'}"

# Each refusal comes before any pin is looked up.
wf=$(printf '%s\n' "# TRACK USES o/r@v1" "  - uses: o/rr@v1" "  - uses: ./local")
flow wf-names-nothing "$df" "$wf" 1 "TRACK USES o/r@v1 names no uses: o/r line" \
    "$df" "$wf" "fake curl:"

wf=$(printf '%s\n' "# TRACK USES o/r@v1" "# TRACK USES o/r@v2" "  - uses: o/r@v0")
flow wf-pinned-twice "$df" "$wf" 1 "TRACK USES o/r is pinned twice" "$df" "$wf" "fake curl:"

n=0
for comment in " # v1" "  #v1" " # pinned by hand"; do
    n=$((n + 1))
    wf=$(printf '%s\n' "# TRACK USES o/r@v1" "  - uses: o/r@$c1$comment")
    flow "wf-comment-at-end-$n" "$df" "$wf" 1 \
        "@W@:2: uses: o/r@$c1 has a comment at its end; TRACK USES o/r@v1 says what it follows" \
        "$df" "$wf" "fake curl:"
done

# A version comment above, in any number of words and across blank lines.
n=0
for above in "  # v1" "  #v1"$' \t' "  # o/r v1.2.3" "  # 1.2"$'\n' $'  # v1\n\n \t'; do
    n=$((n + 1))
    wf=$(printf '%s\n' "# TRACK USES o/r@v1" "$above" "  - uses: o/r@$c1")
    flow "wf-comment-above-$n" "$df" "$wf" 1 \
        "uses: o/r@$c1 has a version comment above it; TRACK USES o/r@v1 says what it follows" \
        "$df" "$wf" "fake curl:"
done

# A uses: on the first line, or with only blank lines above it, has no line
# above it, whatever the last line holds.
n=0
for lead in "" $'\n \n'; do
    n=$((n + 1))
    wf=$lead$'  - uses: o/r@v0\n  # v1\n# TRACK USES o/r@v1'
    flow "wf-first-line-$n" "$df" "$wf" 0 "" "$dfafter" \
        "$lead"$'  - uses: o/r@'"$c3"$'\n  # v1\n# TRACK USES o/r@v1'
done

# OWNER/REPO is matched in any case, each uses: keeping its own.
wf=$(printf '%s\n' "# TRACK USES actions/checkout@v7" "  - uses: Actions/Checkout@v0" \
    "  - uses: actions/checkout@v0")
flow wf-any-case "$df" "$wf" 0 "" "$dfafter" "$(printf '%s\n' \
    "# TRACK USES actions/checkout@v7" "  - uses: Actions/Checkout@$c2" \
    "  - uses: actions/checkout@$c2")"

wf=$(printf '%s\n' "# TRACK USES o/r@v1" "# TRACK USES O/R@v2" "  - uses: o/r@v0")
flow wf-pinned-twice-case "$df" "$wf" 1 "TRACK USES O/R is pinned twice" "$df" "$wf" \
    "fake curl:"

# A comment line that reads as a mistyped TRACK USES fails, as does a
# TRACK FROM or TRACK ARG, mistyped or not.
n=0
for typo in "  # TRACK USES o/r@v1" "#TRACK USES o/r@v1" "#  TRACK USES o/r@v1" \
    "# track uses o/r@v1" "# TRACK USES" "# TRACK  USES o/r@v1" "# TRACKUSES o/r@v1" \
    "# TRACK-USES o/r@v1" "# track_uses o/r@v1" "# TRACK USESS o/r@v1"; do
    n=$((n + 1))
    wf=$(printf '%s\n' "  - uses: o/r@v0" "$typo")
    flow "wf-typo-$n" "$df" "$wf" 1 "@W@:2: not # TRACK USES OWNER/REPO@TAG" \
        "$df" "$wf" "fake curl:"
done
n=0
for typo in "# TRACK FROM r/x:1" "  #track from r/x:1" "# TRACK ARG V github:o/p" "# Track Arg" \
    "# TRACK-ARG V github:o/p" "# track_args V" "# TRACK-FROM r/x:1" "# TRACK LOCK m pypi:m-d" \
    "#track_locks m"; do
    n=$((n + 1))
    case $typo in
    *[Ff][Rr][Oo][Mm]*) kind=FROM ;;
    *[Ll][Oo][Cc][Kk]*) kind=LOCK ;;
    *) kind=ARG ;;
    esac
    wf=$(printf '%s\n' "  - uses: o/r@v0" "$typo")
    flow "wf-track-$kind-$n" "$df" "$wf" 1 \
        "@W@:2: TRACK $kind belongs in a Dockerfile, not a workflow" "$df" "$wf" "fake curl:"
done

n=0
for data in o/r o@v1 'o/r@v1*' o/r@ 'o/r@v1 v2' 'o/r/p@v1' ' o/r@v1'; do
    n=$((n + 1))
    wf=$(printf '%s\n' "# TRACK USES $data" "  - uses: o/r@v0")
    flow "wf-bad-trackuses-$n" "$df" "$wf" 1 "@W@:1: TRACK USES $data is not OWNER/REPO@TAG" \
        "$df" "$wf" "fake curl:"
done

# A line holding uses: that cannot be read fails where it names a covered
# OWNER/REPO, in any case.
n=0
for line in "  - uses: \"o/r@$c1\"" "  - uses: \"O/R@$c1\"" "  - uses: o/r@" \
    "  - uses: o/r" "  - run: grep 'uses: o/r/' x"; do
    n=$((n + 1))
    wf=$(printf '%s\n' "# TRACK USES o/r@v1" "  - uses: o/r@v0" "$line")
    flow "wf-form-$n" "$df" "$wf" 1 "@W@:3: names o/r but is not uses: OWNER/REPO[/PATH]@REF" \
        "$df" "$wf" "fake curl:"
done

# Any other line holding uses:, and prose that only begins like a TRACK line,
# is left alone, with or without a TRACK USES.
others=("  - uses: \"a/b@v4\"" "  - uses: checkout@$c1" "  - name: Check uses: lines"
    "      grep \"uses:\" x" "  - uses: o/rr" "  - uses: xo/r" "  - uses: o/r.x@"
    "  # Track arguments here" "  # tracks uses" "  # tracking uses" "  # track-uses_x")
wf=$(printf '%s\n' "# TRACK USES o/r@v1" "  - uses: o/r@v0" "${others[@]}")
flow wf-others "$df" "$wf" 0 "" "$dfafter" \
    "$(printf '%s\n' "# TRACK USES o/r@v1" "  - uses: o/r@$c3" "${others[@]}")"
wf=$(printf '%s\n' "${others[@]}")
flow wf-others-unpinned "$df" "$wf" 0 "upgrade: @W@: no # TRACK USES line, so there is nothing to re-pin" \
    "$dfafter" "$wf"

# A uses: already at its commit is left as it is, blanks at its end and all, so
# a workflow nothing moves in gets no proposal.
wf=$'# TRACK USES o/r@v1\n  - uses: o/r@'"$c3"$' \t\n'
flow wf-current "$df" "$wf" 0 "" "$dfafter" "$(printf '%s' "$wf")"

# Each workflow's TRACK USES must name a uses: in that workflow, whatever an
# earlier one covers.
printf '%s\n' "# TRACK USES o/r@v1" "  - uses: ./local" >"$m/workflows/3.yml"
rc=0
"$upgrade" "$work/multi.Dockerfile" "$m/workflows/1.yml" "$m/workflows/3.yml" \
    >/dev/null 2>"$work/err" || rc=$?
if [ "$rc" != 1 ] ||
    ! grep -qF "upgrade: $m/workflows/3.yml: TRACK USES o/r@v1 names no uses: o/r line" "$work/err"; then
    fail wf-multi-names-nothing "exit $rc, not refused naming it: $(<"$work/err")"
elif [ "$(<"$work/multi.Dockerfile")" != "$df" ] || [ -e "$m/workflows.new" ]; then
    fail wf-multi-names-nothing "a file was written"
fi

flow wf-nothing "$df" $'  - uses: ./local\n' 0 "upgrade: @W@: no # TRACK USES line, so there is nothing to re-pin" \
    "$dfafter" '  - uses: ./local'

# A file left as it was is not written at all.
file=$work/untouched.Dockerfile
printf 'FROM x\n' >"$file"
inode=$(ls -i "$file")
"$upgrade" "$file" >/dev/null 2>"$work/err" || fail untouched "failed: $(<"$work/err")"
[ "$(ls -i "$file")" = "$inode" ] || fail untouched "the Dockerfile was written"

file=$work/twice.Dockerfile
printf '%s' "$df" >"$file"
printf '%s' "$pinned" >"$work/twice.yml"
for list in "$work/twice.yml $work/twice.yml" "$file"; do
    read -r -a named <<<"$list"
    if "$upgrade" "$file" "${named[@]}" 2>"$work/err" ||
        ! grep -qxF "upgrade: ${named[-1]}: is named twice" "$work/err"; then
        fail named-twice "$list not refused: $(<"$work/err")"
    fi
done
if "$upgrade" "$file" "$work/absent.yml" 2>"$work/err" ||
    ! grep -qxF "upgrade: $work/absent.yml: no such file" "$work/err"; then
    fail wf-missing "not refused naming it: $(<"$work/err")"
fi
mkdir "$work/directory.yml"
if "$upgrade" "$file" "$work/directory.yml" 2>"$work/err" ||
    ! grep -qxF "upgrade: $work/directory.yml: not a regular file" "$work/err"; then
    fail wf-directory "not refused naming it: $(<"$work/err")"
fi

# The proposal's temporary file cannot be made once the Dockerfile's has been,
# so nothing is written, no temporary file is left and the workflows.new made
# for it is removed.
FAKE_MKTEMP_FAIL=$(readlink -f "$work")/wf-write-fails/.github/workflows.new/w.yml.XXXXXX \
    flow wf-write-fails "$df" "$pinned" 1 "No space left on device" "$df" "${pinned%$'\n'}"
if compgen -G "$work/wf-write-fails.Dockerfile.*" >/dev/null; then
    fail wf-write-fails "left $(compgen -G "$work/wf-write-fails.Dockerfile.*")"
fi

# Every FREEZE line, exact or mistyped, in every file named is listed as grep
# lists it, before anything is looked up or written.
f=$work/freeze
mkdir -p "$f/.github/workflows"
fdf=$'# FROMFREEZE r/x:1\nFROM r/x:1\n  #argfreeze V github:o/p\nARG V=1\n# TRACK ARG W github:o/p\nARG W=1\n'
fdf+=$'# ARG FREEZE V github:o/p\n# arg_freeze V github:o/p\n#ARGS-FREEZE V github:o/p\n# ARGFREEZER notes\n'
fwf=$'steps:\n# USESFREEZE o/r@v1\n  - uses: o/r@v0\n#UsesFreeze o/a@v2\n# uses - freeze o/r@v1\n'
printf '%s' "$fdf" >"$f/Dockerfile"
printf '%s' "$fwf" >"$f/.github/workflows/w.yml"
said=$(printf '%s\n' "Dockerfile:1:# FROMFREEZE r/x:1" "Dockerfile:3:  #argfreeze V github:o/p" \
    "Dockerfile:7:# ARG FREEZE V github:o/p" "Dockerfile:8:# arg_freeze V github:o/p" \
    "Dockerfile:9:#ARGS-FREEZE V github:o/p" \
    ".github/workflows/w.yml:2:# USESFREEZE o/r@v1" ".github/workflows/w.yml:4:#UsesFreeze o/a@v2" \
    ".github/workflows/w.yml:5:# uses - freeze o/r@v1" \
    "upgrade: FREEZE pins are now TRACK FROM, TRACK ARG and TRACK USES")
rc=0
(cd "$f" && "$upgrade" Dockerfile .github/workflows/w.yml) >"$work/out" 2>"$work/err" || rc=$?
if [ "$rc" != 1 ] || [ "$(<"$work/err")" != "$said" ]; then
    fail freeze "exit $rc, stderr: $(<"$work/err")"
elif [ -s "$work/out" ]; then
    fail freeze "something was looked up: $(<"$work/out")"
elif [ "$(<"$f/Dockerfile")" != "$(printf '%s' "$fdf")" ] ||
    [ "$(<"$f/.github/workflows/w.yml")" != "$(printf '%s' "$fwf")" ] ||
    [ -e "$f/.github/workflows.new" ]; then
    fail freeze "a file was written"
fi

# grep failing otherwise than by finding nothing stops the run with its status.
rc=0
FAKE_GREP=fail "$upgrade" "$f/Dockerfile" >"$work/out" 2>"$work/err" || rc=$?
if [ "$rc" != 2 ] || [ "$(<"$work/err")" != "grep: $f/Dockerfile: Permission denied" ]; then
    fail freeze-grep-fails "exit $rc, stderr: $(<"$work/err")"
elif [ -s "$work/out" ] || [ "$(<"$f/Dockerfile")" != "$(printf '%s' "$fdf")" ]; then
    fail freeze-grep-fails "carried on: $(<"$work/out")"
fi

# The record lists each file written, then a line for each value a pin's lines
# held that is not the new one, a FROM's tag as REPO:TAG; a pin nothing moved,
# and a workflow nothing moved in, are left out. Its directory is made.
r=$work/rec
mkdir -p "$r/.github/workflows"
printf '%s  t_1.2.3_linux\n' "$hx" >"$sums"
printf '%s\n' "# TRACK FROM r/x:1" "# TRACK ARG V github:o/p" "# TRACK ARG W github:o/p" \
    $'# TRACK ARG H sha256:https://dl.test/v${V}/t_${V}_linux https://dl.test/v${V}/sums' \
    "FROM r/x:1" "FROM r/x@$old" "FROM r/x@$new" "ARG V=1.0.0" "ARG W=1.2.3" "ARG H=$hy" \
    >"$r/Dockerfile"
printf '%s\n' "# TRACK USES o/r@v1" "  - uses: o/r@v0" "  - uses: o/r/sub@$c1" "  - uses: o/r@v0" \
    "# TRACK USES o/a@v2" "  - uses: o/a@$c2" >"$r/.github/workflows/1.yml"
printf '%s\n' "# TRACK USES o/a@v2" "  - uses: o/a@$c2" >"$r/.github/workflows/2.yml"
printf '%s\n' "# TRACK USES o/a@v2" "  - uses: o/a@v1" >"$r/.github/workflows/3.yml"
commit_all "$r"
real=$(readlink -f "$work")
said=$(printf '%s\n' "$real/rec/Dockerfile" "$real/rec/.github/workflows.new/1.yml" \
    "$real/rec/.github/workflows.new/3.yml" "" "r/x:1 r/x:1 -> sha256:aaaaaaaaaaaa" \
    "r/x:1 sha256:000000000000 -> sha256:aaaaaaaaaaaa" "V 1.0.0 -> 1.2.3" \
    "H dddddddddddd -> cccccccccccc" "o/r v1: v0 -> 3333333" "o/r v1: 1111111 -> 3333333" \
    "o/a v2: v1 -> 2222222")
rc=0
"$upgrade" --record "$work/recdir/sub/record" "$r/Dockerfile" "$r/.github/workflows/1.yml" \
    "$r/.github/workflows/2.yml" "$r/.github/workflows/3.yml" >"$work/out" 2>"$work/err" || rc=$?
if [ "$rc" != 0 ]; then
    fail record "exit $rc, not 0: $(<"$work/err")"
elif ! [ -f "$work/recdir/sub/record" ] || [ "$(<"$work/recdir/sub/record")" != "$said" ]; then
    fail record "the record is: $(cat -- "$work/recdir/sub/record" 2>&1)"
elif [ -e "$r/.github/workflows.new/2.yml" ]; then
    fail record "2.yml, which nothing moved, has a proposal"
fi

# Runs upgrade with the arguments $2 onwards, and checks it exits 1 with stderr
# $1, having looked nothing up, written no record at $work/recdir/sub/record
# where none was there and changed none that was, and left $r/Dockerfile as it
# was.
pending_refused() {
    local said=$1 rc=0 kept="" dockerfile
    dockerfile=$(<"$r/Dockerfile")
    [ ! -f "$work/recdir/sub/record" ] || kept=$(<"$work/recdir/sub/record")
    "$upgrade" "${@:2}" >"$work/out" 2>"$work/err" || rc=$?
    if [ "$rc" != 1 ] || [ "$(<"$work/err")" != "$said" ]; then
        fail "$name" "exit $rc, stderr: $(<"$work/err")"
    elif [ -s "$work/out" ]; then
        fail "$name" "something was looked up: $(<"$work/out")"
    elif [ "$(<"$r/Dockerfile")" != "$dockerfile" ]; then
        fail "$name" "the Dockerfile was written"
    elif [ -z "$kept" ] && [ -e "$work/recdir/sub/record" ]; then
        fail "$name" "a record was written"
    elif [ -n "$kept" ] && [ "$(<"$work/recdir/sub/record")" != "$kept" ]; then
        fail "$name" "the record was changed"
    fi
}

# A record an earlier run left is refused, since the commit it awaits would be
# lost.
name=record-pending
pending_refused "upgrade: $work/recdir/sub/record: is an earlier upgrade's record still pending; commit it with docker/upgrade-commit or remove it first" \
    --record "$work/recdir/sub/record" "$r/Dockerfile"

# A Dockerfile git holds changes to, or does not track, is refused, since the
# commit would carry what was there beside the pins; one outside a repository
# fails as git does.
rm -- "$work/recdir/sub/record"
name=record-dirty
pending_refused "upgrade: $real/rec/Dockerfile: has changes not committed; commit or stash them first" \
    --record "$work/recdir/sub/record" "$r/Dockerfile"
"$REAL_GIT" -C "$r" add Dockerfile
name=record-dirty-staged
pending_refused "upgrade: $real/rec/Dockerfile: has changes not committed; commit or stash them first" \
    --record "$work/recdir/sub/record" "$r/Dockerfile"
printf '%s' "$df" >"$r/untracked.Dockerfile"
name=record-untracked
pending_refused "upgrade: $real/rec/untracked.Dockerfile: has changes not committed; commit or stash them first" \
    --record "$work/recdir/sub/record" "$r/untracked.Dockerfile"
rm -- "$r/untracked.Dockerfile"
mkdir "$work/norepo"
printf '%s' "$df" >"$work/norepo/Dockerfile"
rc=0
"$upgrade" --record "$work/recdir/sub/record" "$work/norepo/Dockerfile" >"$work/out" 2>"$work/err" ||
    rc=$?
if [ "$rc" = 0 ] || ! grep -qF "not a git repository" "$work/err" || [ -s "$work/out" ] ||
    [ -e "$work/recdir/sub/record" ] || [ "$(<"$work/norepo/Dockerfile")" != "$df" ]; then
    fail record-no-repo "exit $rc, or carried on: $(<"$work/err")"
fi

# Through a symbolic link, the file it names is the one checked, as that is the
# one written.
mkdir -p "$work/linkrepo/real"
printf '%s' "$df" >"$work/linkrepo/real/Dockerfile"
ln -s real/Dockerfile "$work/linkrepo/Dockerfile"
commit_all "$work/linkrepo"
printf '# edit\n' >>"$work/linkrepo/real/Dockerfile"
rc=0
"$upgrade" --record "$work/recdir/sub/record" "$work/linkrepo/Dockerfile" >"$work/out" 2>"$work/err" ||
    rc=$?
if [ "$rc" != 1 ] || [ "$(<"$work/err")" != \
    "upgrade: $real/linkrepo/real/Dockerfile: has changes not committed; commit or stash them first" ] ||
    [ -s "$work/out" ] || [ -e "$work/recdir/sub/record" ]; then
    fail record-dirty-link "exit $rc, or carried on: $(<"$work/err")"
fi

# Where nothing moves, an empty record an earlier run left is replaced by an
# empty one.
commit_all "$r"
: >"$work/recdir/sub/record"
rc=0
"$upgrade" --record "$work/recdir/sub/record" "$r/Dockerfile" >/dev/null 2>"$work/err" || rc=$?
if [ "$rc" != 0 ] || ! [ -f "$work/recdir/sub/record" ] || [ -s "$work/recdir/sub/record" ]; then
    fail record-nothing-moved "exit $rc: $(<"$work/err"); record: $(cat -- "$work/recdir/sub/record" 2>&1)"
fi

# A refused run, or one that fails to write, writes no record and nothing else.
rc=0
"$upgrade" --record "$work/recdir/refused" "$r/Dockerfile" "$r/.github/workflows/1.yml" \
    >/dev/null 2>"$work/err" || rc=$?
if [ "$rc" != 1 ] || [ -e "$work/recdir/refused" ]; then
    fail record-refused "exit $rc, or the record was written: $(<"$work/err")"
fi
mkdir "$work/recfail"
printf '%s' "$df" >"$work/recfail/Dockerfile"
commit_all "$work/recfail"
rc=0
FAKE_MKTEMP_FAIL=$real/recdir/fails.XXXXXX "$upgrade" --record "$work/recdir/fails" \
    "$work/recfail/Dockerfile" >/dev/null 2>"$work/err" || rc=$?
if [ "$rc" != 1 ] || [ -e "$work/recdir/fails" ] ||
    [ "$(<"$work/recfail/Dockerfile")" != "$df" ] ||
    compgen -G "$work/recfail/Dockerfile.*" >/dev/null; then
    fail record-write-fails "exit $rc, or something was written: $(<"$work/err")"
fi

usage="Usage: upgrade [--record FILE] [DOCKERFILE [WORKFLOW...]]"
for empty in "" x; do
    rc=0
    if [ -n "$empty" ]; then
        "$upgrade" --record >/dev/null 2>"$work/err" || rc=$?
    else
        "$upgrade" --record "" "$work/recfail/Dockerfile" >/dev/null 2>"$work/err" || rc=$?
    fi
    if [ "$rc" != 2 ] || [ "$(<"$work/err")" != "$usage" ]; then
        fail "record-no-file${empty:+-at-end}" "exit $rc: $(<"$work/err")"
    fi
done

# Paths given relative to a directory below the workflow's own place it beside
# that workflow's .github/workflows all the same.
v=$work/relative
mkdir -p "$v/.github/workflows"
printf '%s' "$df" >"$v/Dockerfile"
printf '%s' "$pinned" >"$v/.github/workflows/w.yml"
commit_all "$v"
rc=0
(cd "$v/.github/workflows" && "$upgrade" --record ../../rec ../../Dockerfile w.yml) \
    >/dev/null 2>"$work/err" || rc=$?
said=$(printf '%s\n' "$real/relative/Dockerfile" "$real/relative/.github/workflows.new/w.yml" "" \
    "V 1 -> 1.2.3" "o/r v1: v0 -> 3333333")
if [ "$rc" != 0 ]; then
    fail relative "exit $rc, not 0: $(<"$work/err")"
elif [ "$(<"$v/rec")" != "$said" ] ||
    [ "$(<"$v/.github/workflows.new/w.yml")" != $'# TRACK USES o/r@v1\n  - uses: o/r@'"$c3" ]; then
    fail relative "the record or proposal is wrong: $(<"$v/rec")"
fi

# Progress goes to stderr, a line naming what each pin resolved to and each
# file written, and docker pull's own output with it; stdout stays empty.
p=$work/progress
mkdir -p "$p/.github/workflows" "$work/files/progress"
printf 'asset\n' >"$work/files/progress/t"
ht=$(sha256sum <"$work/files/progress/t")
ht=${ht%% *}
printf '%s  u\n' "$hx" >"$work/files/progress/sums"
printf '%s\n' "# TRACK FROM r/x:1" "# TRACK ARG V github:o/p" "# TRACK LOCK m pypi:m-d" \
    "# TRACK LOCK n npm:n-d" "# TRACK ARG T sha256:https://dl.test/progress/t" \
    "# TRACK ARG U sha256:https://dl.test/progress/u https://dl.test/progress/sums" \
    "FROM r/x:1" "ARG V=1" "ARG T=1" "ARG U=1" >"$p/Dockerfile"
printf '%s\n' "# TRACK USES o/a@v2" "  - uses: o/a@v1" >"$p/.github/workflows/w.yml"
said=$(printf '%s\n' "upgrade: pulling r/x:1" "upgrade: r/x:1 is $new" \
    "upgrade: o/p's latest release is 1.2.3" \
    "upgrade: SHA-256 of https://dl.test/progress/t is $ht" \
    "upgrade: SHA-256 of u in https://dl.test/progress/sums is $hx" \
    "upgrade: resolving TRACK LOCK m in r/x@$new" "upgrade: TRACK LOCK m resolved 2 package(s)" \
    "upgrade: n-d's latest version on npm is 3.4.5" \
    "upgrade: resolving TRACK LOCK n in r/x@$new" "upgrade: TRACK LOCK n resolved 2 package(s)" \
    "upgrade: o/a's commit for v2 is $c2" "upgrade: wrote $real/progress/Dockerfile" \
    "upgrade: wrote $real/progress/Dockerfile.lock/m/requirements.txt" \
    "upgrade: wrote $real/progress/Dockerfile.lock/n/package.json" \
    "upgrade: wrote $real/progress/Dockerfile.lock/n/package-lock.json" \
    "upgrade: wrote $real/progress/.github/workflows.new/w.yml")
rc=0
rm -f -- "$FAKE_PULLED"
"$upgrade" "$p/Dockerfile" "$p/.github/workflows/w.yml" >"$work/out" 2>"$work/err" || rc=$?
if [ "$rc" != 0 ]; then
    fail progress "exit $rc, not 0: $(<"$work/err")"
elif [ -s "$work/out" ]; then
    fail progress "stdout is: $(<"$work/out")"
elif [ "$(grep -e '^upgrade: ' -- "$work/err")" != "$said" ]; then
    fail progress "stderr is: $(<"$work/err")"
elif ! grep -qFx -e "fake docker: pulled r/x:1" -- "$work/err"; then
    fail progress "docker pull's output is not on stderr: $(<"$work/err")"
fi

# A symbolic link stays one, and its target is written.
printf '%s' "$df" >"$work/target.Dockerfile"
ln -s target.Dockerfile "$work/link.Dockerfile"
rc=0
"$upgrade" "$work/link.Dockerfile" >/dev/null 2>"$work/err" || rc=$?
if [ "$rc" != 0 ] || ! [ -L "$work/link.Dockerfile" ] ||
    [ "$(<"$work/target.Dockerfile")" != "$dfafter" ]; then
    fail symlink "exit $rc, link or target wrong: $(<"$work/err")"
fi

file=$work/mode.Dockerfile
printf '# TRACK ARG V github:o/p\nARG V=1\n' >"$file"
chmod 640 "$file"
rc=0
"$upgrade" "$file" >/dev/null 2>"$work/err" || rc=$?
if [ "$rc" != 0 ]; then
    fail mode "exit $rc, not 0: $(<"$work/err")"
elif [ "$(<"$file")" != $'# TRACK ARG V github:o/p\nARG V=1.2.3' ]; then
    fail mode "the file is now: $(<"$file")"
elif [ "$(stat -c %a "$file" 2>/dev/null || stat -f %Lp "$file")" != 640 ]; then
    fail mode "the Dockerfile's mode changed"
fi

# TRACK ARG pypi: and npm: pins, exact or mistyped, in every file named are
# listed as grep lists them, after any FREEZE line, before anything is looked up
# or written.
mkdir -p "$f/retired/.github/workflows"
rdf=$'# TRACK ARG V pypi:m-d\nARG V=1\n#track args W npm:n-d\n# TRACK ARG X github:o/p\n'
rdf+=$'# TRACK-ARG Y pypi:\n# FROMFREEZE r/x:1\n'
rwf=$'steps:\n  # TRACK ARG Z npm:@s/n\n'
printf '%s' "$rdf" >"$f/retired/Dockerfile"
printf '%s' "$rwf" >"$f/retired/.github/workflows/w.yml"
said=$(printf '%s\n' "Dockerfile:6:# FROMFREEZE r/x:1" \
    "upgrade: FREEZE pins are now TRACK FROM, TRACK ARG and TRACK USES" \
    "Dockerfile:1:# TRACK ARG V pypi:m-d" "Dockerfile:3:#track args W npm:n-d" \
    "Dockerfile:5:# TRACK-ARG Y pypi:" ".github/workflows/w.yml:2:  # TRACK ARG Z npm:@s/n" \
    "upgrade: pypi: and npm: pins are now TRACK LOCK")
rc=0
(cd "$f/retired" && "$upgrade" Dockerfile .github/workflows/w.yml) >"$work/out" 2>"$work/err" ||
    rc=$?
if [ "$rc" != 1 ] || [ "$(<"$work/err")" != "$said" ]; then
    fail retired "exit $rc, stderr: $(<"$work/err")"
elif [ -s "$work/out" ] || [ "$(<"$f/retired/Dockerfile")" != "$(printf '%s' "$rdf")" ]; then
    fail retired "carried on: $(<"$work/out")"
fi

# The lint runs on the Dockerfile before anything is looked up, and a failure of
# its own fails the run; its refusal is warned of, after the lock cases below.
FAKE_LINT=usage check lint-fails $'# TRACK FROM r/x:1\nFROM r/x:1\n' 1 \
    "upgrade: @F@: lint/dockerfile-locks failed with status 2" \
    $'# TRACK FROM r/x:1\nFROM r/x:1' "fake docker:"
FAKE_LINT=unreadable check lint-unreadable $'# TRACK FROM r/x:1\nFROM r/x:1\n' 1 \
    "upgrade: @F@: lint/dockerfile-locks failed with status 3" \
    $'# TRACK FROM r/x:1\nFROM r/x:1' "each line above"
check lint-passes $'# TRACK FROM r/x:1\nFROM r/x:1\n' 0 "fake lint: @F@" \
    $'# TRACK FROM r/x:1\nFROM r/x@'"$new"
printf 'FROM x\n' >"$work/-lead.Dockerfile"
rc=0
(cd "$work" && "$upgrade" -lead.Dockerfile) >/dev/null 2>"$work/err" || rc=$?
if [ "$rc" != 0 ] || ! grep -qxF "fake lint: ./-lead.Dockerfile" "$work/err"; then
    fail lint-leading-dash "exit $rc: $(<"$work/err")"
fi

# Each malformed TRACK LOCK is refused before anything is looked up.
n=0
for data in ".x pypi:a" "-x pypi:a" ".. pypi:a" "a/b pypi:a" "x" ""; do
    n=$((n + 1))
    dockerfile="# TRACK FROM r/x:1"$'\n'"# TRACK LOCK $data"$'\nFROM r/x:1\n'
    check "lock-bad-name-$n" "$dockerfile" 1 "@F@:2: TRACK LOCK $data is not $lockforms" \
        "${dockerfile%$'\n'}" "fake docker:"
done
n=0
for spec in gitlab:a pypi: pypi:a== pypi:a- 'pypi:a[b]' pypi:a==x npm:N npm:a@ npm:@s/ npm:a@x a; do
    n=$((n + 1))
    dockerfile="# TRACK FROM r/x:1"$'\n'"# TRACK LOCK x pypi:m-d $spec"$'\nFROM r/x:1\n'
    check "lock-bad-spec-$n" "$dockerfile" 1 "TRACK LOCK x: $spec is not $specs" \
        "${dockerfile%$'\n'}" "fake docker:"
done
n=0
for data in "x pypi:a npm:b|TRACK LOCK x mixes pypi: and npm: packages" \
    "x npm:b pypi:a|TRACK LOCK x mixes pypi: and npm: packages" \
    "x pypi:M_D pypi:m.d==1|TRACK LOCK x names m.d twice" \
    "x npm:@s/a npm:@s/a@1.0|TRACK LOCK x names @s/a twice"; do
    n=$((n + 1))
    dockerfile="# TRACK FROM r/x:1"$'\n'"# TRACK LOCK ${data%|*}"$'\nFROM r/x:1\n'
    check "lock-bad-$n" "$dockerfile" 1 "${data#*|}" "${dockerfile%$'\n'}" "fake docker:"
done
dockerfile=$'# TRACK FROM r/x:1\n# TRACK LOCK x pypi:a\n# TRACK LOCK x npm:b\nFROM r/x:1\n'
check lock-named-twice "$dockerfile" 1 "TRACK LOCK x is named twice" "${dockerfile%$'\n'}" \
    "fake docker:"
dockerfile=$'# TRACK LOCK x pypi:a\nFROM r/x:1\n'
check lock-no-from "$dockerfile" 1 "TRACK LOCK x has no stage=STAGE, so resolves in the image TRACK FROM pins, and needs exactly one TRACK FROM, not 0" \
    "${dockerfile%$'\n'}" "fake docker:"
dockerfile=$'# TRACK FROM r/x:1\n# TRACK FROM r/y:1\n# TRACK LOCK x pypi:a\nFROM r/x:1\nFROM r/y:1\n'
check lock-two-froms "$dockerfile" 1 "TRACK LOCK x has no stage=STAGE, so resolves in the image TRACK FROM pins, and needs exactly one TRACK FROM, not 2" \
    "${dockerfile%$'\n'}" "fake docker:"
# A lock naming its stage needs none, but one beside it naming none still does.
dockerfile=$'# TRACK FROM r/x:1\n# TRACK FROM r/y:1\n# TRACK LOCK x stage=a pypi:a\n# TRACK LOCK y pypi:a\nFROM r/x:1 AS a\nFROM r/y:1\n'
check lock-two-froms-one-staged "$dockerfile" 1 "TRACK LOCK y has no stage=STAGE" \
    "${dockerfile%$'\n'}" "fake docker:"

# A stage= is refused, before any pin is looked up, given twice, not in a
# stage name's form, naming no stage, or without a package beside it; and
# where its stage, or one it is FROM, is scratch, or its FROM holds a variable
# no ARG before the first FROM sets literally, its quotes unmatched or around
# anything else, or $ in another form.
n=0
for data in "x stage=a stage=b pypi:a|FROM r/x:1 AS a|TRACK LOCK x gives stage= twice" \
    "x stage= pypi:a|FROM r/x:1 AS a|TRACK LOCK x: stage= is not stage=STAGE" \
    "x stage=1a pypi:a|FROM r/x:1 AS 1a|TRACK LOCK x: stage=1a is not stage=STAGE" \
    "x stage=a|FROM r/x:1 AS a|TRACK LOCK x stage=a is not $lockforms" \
    "x stage=b pypi:a|FROM r/x:1 AS a|TRACK LOCK x: no FROM line names stage b" \
    "x stage=b pypi:a|FROM b AS a|TRACK LOCK x: no FROM line names stage b" \
    "x stage=a pypi:a|FROM scratch AS a|@F@:3: TRACK LOCK x: stage a is FROM scratch, which has nothing to resolve in" \
    "x stage=a pypi:a|FROM SCRATCH AS base\nFROM base AS a|@F@:3: TRACK LOCK x: stage a is FROM scratch" \
    "x stage=a pypi:a|ARG B=scratch\nFROM \$B AS a|@F@:4: TRACK LOCK x: stage a is FROM scratch" \
    "x stage=a pypi:a|FROM \${B} AS a|@F@:3: TRACK LOCK x: FROM \${B} holds a variable that no ARG VAR=VALUE before the first FROM sets, or a \$ not in \$VAR or \${VAR}" \
    "x stage=a pypi:a|ARG B\nFROM \$B AS a|@F@:4: TRACK LOCK x: FROM \$B holds a variable" \
    "x stage=a pypi:a|ARG B=r/h:1\nARG B\nFROM \$B AS a|@F@:5: TRACK LOCK x: FROM \$B holds a variable" \
    "x stage=a pypi:a|ARG B=\"r/h:1'\nFROM \$B AS a|@F@:4: TRACK LOCK x: FROM \$B holds a variable" \
    "x stage=a pypi:a|ARG B=\"\$C\"\nFROM \$B AS a|@F@:4: TRACK LOCK x: FROM \$B holds a variable" \
    "x stage=a pypi:a|ARG B=\"\"\nFROM \$B AS a|@F@:4: TRACK LOCK x: FROM \$B holds a variable" \
    "x stage=a pypi:a|ARG B=r/h:1\nFROM \${B:-r/h:2} AS a|@F@:4: TRACK LOCK x: FROM \${B:-r/h:2} holds a variable" \
    "x stage=a pypi:a|FROM r/h:1 AS base\nARG B=r/h:1\nFROM \$B AS a|@F@:5: TRACK LOCK x: FROM \$B holds a variable"; do
    n=$((n + 1))
    IFS='|' read -r spec body said <<<"$data"
    dockerfile="# TRACK LOCK $spec"$'\n'"# c"$'\n'"${body//\\n/$'\n'}"$'\n'
    check "lock-stage-bad-$n" "$dockerfile" 1 "$said" "${dockerfile%$'\n'}" "fake docker:"
done

# Sets d to a fresh directory $work/$1 holding a Dockerfile, or the file named
# $3, holding $2, and file to its path.
lockcase() {
    d=$work/$1
    file=$d/${3:-Dockerfile}
    rm -rf -- "$d"
    mkdir -p "$d"
    printf '%s' "$2" >"$file"
}

# Runs upgrade on $file with the arguments given before it, setting rc, and err
# to its stderr.
lockgo() {
    rc=0
    rm -f -- "$FAKE_PULLED"
    "$upgrade" "$@" "$file" >"$work/out" 2>"$work/err" || rc=$?
    err=$(<"$work/err")
}

# Fails case $1, returning 1, unless rc is $2, stdout is empty, stderr holds
# each line in $3 where it is not empty and holds no line of $4.
expect() {
    local said
    if [ "$rc" != "$2" ]; then
        fail "$1" "exit $rc, not $2: $err"
        return 1
    elif [ -s "$work/out" ]; then
        fail "$1" "stdout is: $(<"$work/out")"
        return 1
    fi
    while IFS= read -r said <&3; do
        [ -n "$said" ] || continue
        if ! grep -qF -- "$said" "$work/err"; then
            fail "$1" "stderr lacks '$said': $err"
            return 1
        fi
    done 3<<<"$3"
    while IFS= read -r said <&3; do
        [ -n "$said" ] || continue
        if grep -qF -- "$said" "$work/err"; then
            fail "$1" "stderr holds '$said': $err"
            return 1
        fi
    done 3<<<"${4:-}"
}

# Fails case $1 unless the file $2 holds $3.
holds() {
    if ! [ -f "$2" ]; then
        fail "$1" "$2 is missing"
    elif [ "$(<"$2")" != "$3" ]; then
        fail "$1" "$2 is: $(<"$2")"
    fi
}

# Fails case $1 unless the file $2's mode is $3.
mode_is() {
    local mode
    mode=$(stat -c %a "$2" 2>/dev/null || stat -f %Lp "$2")
    [ "$mode" = "$3" ] || fail "$1" "$2's mode is $mode, not $3"
}

# Fails case $1 unless the record at $work/lockrec holds the paths after it,
# each under $real, a blank line and the moves in moves.
recorded() {
    local name=$1 want=() path
    for path in "${@:2}"; do
        want+=("$real/$path")
    done
    want+=("" "${moves[@]}")
    if ! [ -f "$work/lockrec" ]; then
        fail "$name" "no record was written"
    elif [ "$(<"$work/lockrec")" != "$(printf '%s\n' "${want[@]}")" ]; then
        fail "$name" "the record is: $(<"$work/lockrec")"
    fi
}

pdf=$'# TRACK FROM r/x:1\n# TRACK LOCK m pypi:m-d\nFROM r/x@'"$new"$'\n'
ndf=$'# TRACK FROM r/x:1\n# TRACK LOCK js npm:n-d\nFROM r/x@'"$new"

# A first lock is made, with each directory above it, at 0644, the FROM already
# at its digest left alone; pip runs in the pinned image, installed with
# Debian's apt-get, whose output stays off the report.
lockcase lock-created "$pdf"
commit_all "$d"
rm -f -- "$work/lockrec"
lockgo --record "$work/lockrec"
said=$(printf '%s\n' "fake docker: run r/x@$new pypi m-d" "fake apt-get: update" \
    "fake apt-get: install -y --no-install-recommends python3-pip" "fake pip: install m-d" \
    "fake curl: https://pypi.org/pypi/m-d/2.0.1/json" "fake curl: https://pypi.org/pypi/dep-a/1.1/json")
if expect lock-created 0 "$said" "fake dnf:"; then
    holds lock-created "$d/Dockerfile.lock/m/requirements.txt" "$req"
    mode_is lock-created "$d/Dockerfile.lock/m/requirements.txt" 644
    holds lock-created "$file" "${pdf%$'\n'}"
    moves=("LOCK m m-d none -> 2.0.1" "LOCK m: 1 dependency moved")
    recorded lock-created lock-created/Dockerfile.lock/m/requirements.txt
fi

# The lint's refusal stands on stderr above a warning, and the upgrade carries
# on: the Dockerfile and its lock are written and recorded.
lockcase lint-refuses $'# TRACK FROM r/x:1\n# TRACK LOCK m pypi:m-d\nFROM r/x:1\n'
commit_all "$d"
rm -f -- "$work/lockrec"
FAKE_LINT=fail lockgo --record "$work/lockrec"
said=$(printf '%s\n' "$file:2: npm install reads no lock" \
    "upgrade: $file: each line above is refused by lint/dockerfile-locks")
if expect lint-refuses 0 "$said"; then
    if ! grep -A 1 -xF -- "$file:2: npm install reads no lock" "$work/err" |
        grep -qxF -- "${said#*$'\n'}"; then
        fail lint-refuses "the warning does not follow the lint's line: $err"
    fi
    holds lint-refuses "$file" $'# TRACK FROM r/x:1\n# TRACK LOCK m pypi:m-d\nFROM r/x@'"$new"
    holds lint-refuses "$d/Dockerfile.lock/m/requirements.txt" "$req"
    moves=("r/x:1 r/x:1 -> sha256:aaaaaaaaaaaa" "LOCK m m-d none -> 2.0.1" "LOCK m: 1 dependency moved")
    recorded lint-refuses lint-refuses/Dockerfile lint-refuses/Dockerfile.lock/m/requirements.txt
fi

# Packages are sorted by name alone, as pip-compile sorts them.
wheels m-d-x/1 "$ha"
report "$work/report-sorted.json" m-d-x==1 m-d==2.0.1
lockcase lock-sorted "$pdf"
FAKE_REPORT=$work/report-sorted.json lockgo
if expect lock-sorted 0 ""; then
    holds lock-sorted "$d/Dockerfile.lock/m/requirements.txt" \
        "m-d==2.0.1 --hash=sha256:$hb --hash=sha256:$hc"$'\n'"m-d-x==1 --hash=sha256:$ha"
fi
d=$work/lock-created
file=$d/Dockerfile

# A lock that would not change is not written, and nothing is recorded.
inode=$(ls -i "$d/Dockerfile.lock/m/requirements.txt")
commit_all "$d"
rm -f -- "$work/lockrec"
lockgo --record "$work/lockrec"
if expect lock-unchanged 0 ""; then
    [ "$(ls -i "$d/Dockerfile.lock/m/requirements.txt")" = "$inode" ] ||
        fail lock-unchanged "the lock was written"
    if ! [ -f "$work/lockrec" ] || [ -s "$work/lockrec" ]; then
        fail lock-unchanged "the record is not empty: $(cat -- "$work/lockrec" 2>&1)"
    fi
fi

# A lock with changes not committed is refused, as the Dockerfile is, before
# anything is looked up.
printf '# edit\n' >>"$d/Dockerfile.lock/m/requirements.txt"
rm -f -- "$work/lockrec"
lockgo --record "$work/lockrec"
if expect lock-dirty 1 "upgrade: $d/Dockerfile.lock: has changes not committed; commit or stash them first" \
    "fake "; then
    [ ! -e "$work/lockrec" ] || fail lock-dirty "a record was written"
fi
rm -- "$d/Dockerfile.lock/m/requirements.txt"
lockgo --record "$work/lockrec"
expect lock-dirty-removed 1 "upgrade: $d/Dockerfile.lock: has changes not committed" "fake " || true
mkdir "$d/Dockerfile.lock/new"
printf 'x\n' >"$d/Dockerfile.lock/new/f"
"$REAL_GIT" -C "$d" checkout -q -- Dockerfile.lock
lockgo --record "$work/lockrec"
expect lock-dirty-untracked 1 "upgrade: $d/Dockerfile.lock: has changes not committed" "fake " || true

# A version that moves, a dependency added and one dropped are each recorded;
# an existing lock keeps its mode.
lockcase lock-moved "$pdf"
mkdir -p "$d/Dockerfile.lock/m"
printf 'm-d==1.0 --hash=sha256:%s\n' "$hd" >"$d/Dockerfile.lock/m/requirements.txt"
chmod 600 "$d/Dockerfile.lock/m/requirements.txt"
commit_all "$d"
rm -f -- "$work/lockrec"
lockgo --record "$work/lockrec"
if expect lock-moved 0 ""; then
    holds lock-moved "$d/Dockerfile.lock/m/requirements.txt" "$req"
    mode_is lock-moved "$d/Dockerfile.lock/m/requirements.txt" 600
    moves=("LOCK m m-d 1.0 -> 2.0.1" "LOCK m: 1 dependency moved")
    recorded lock-moved lock-moved/Dockerfile.lock/m/requirements.txt
fi
lockcase lock-shrunk "$pdf"
mkdir -p "$d/Dockerfile.lock/m"
printf '%s\n' "$req" "gone==0.1 --hash=sha256:$hd" "also-gone==0.2 --hash=sha256:$hd" \
    >"$d/Dockerfile.lock/m/requirements.txt"
commit_all "$d"
rm -f -- "$work/lockrec"
lockgo --record "$work/lockrec"
if expect lock-shrunk 0 ""; then
    holds lock-shrunk "$d/Dockerfile.lock/m/requirements.txt" "$req"
    moves=("LOCK m: 2 dependencies moved")
    recorded lock-shrunk lock-shrunk/Dockerfile.lock/m/requirements.txt
fi

# A lock whose versions stay but whose content changes is recorded as such.
lockcase lock-content-only "$pdf"
mkdir -p "$d/Dockerfile.lock/m"
printf '%s\n' "dep-a==1.1 --hash=sha256:$hd" "m-d==2.0.1 --hash=sha256:$hb --hash=sha256:$hc" \
    >"$d/Dockerfile.lock/m/requirements.txt"
commit_all "$d"
rm -f -- "$work/lockrec"
lockgo --record "$work/lockrec"
if expect lock-content-only 0 ""; then
    holds lock-content-only "$d/Dockerfile.lock/m/requirements.txt" "$req"
    moves=("LOCK m: files changed")
    recorded lock-content-only lock-content-only/Dockerfile.lock/m/requirements.txt
fi

# An old lock is read only as this writes it; one that reads otherwise, as
# another tool or a hand might write it, is recorded as changed. Each case's
# lines are separated by \n.
n=0
for data in "# c\\nm-d==1.0 --hash=sha256:$hd" "m-d==1.0" "M_D==1.0 --hash=sha256:$hd" \
    "m-d>=1.0 --hash=sha256:$hd" "m-d==1.0 --hash=sha256:$hd\\nm-d==1.1 --hash=sha256:$hd" \
    "--index-url https://x.test/simple\\nm-d==1.0 --hash=sha256:$hd"; do
    n=$((n + 1))
    lockcase "lock-foreign-$n" "$pdf"
    mkdir -p "$d/Dockerfile.lock/m"
    printf '%s\n' "${data//\\n/$'\n'}" >"$d/Dockerfile.lock/m/requirements.txt"
    commit_all "$d"
    rm -f -- "$work/lockrec"
    lockgo --record "$work/lockrec"
    if expect "lock-foreign-$n" 0 ""; then
        holds "lock-foreign-$n" "$d/Dockerfile.lock/m/requirements.txt" "$req"
        moves=("LOCK m: files changed")
        recorded "lock-foreign-$n" "lock-foreign-$n/Dockerfile.lock/m/requirements.txt"
    fi
done

# A version held back is passed to pip as it is.
wheels m-d/1.5 "$hd"
report "$work/report-held.json" m-d==1.5
lockcase lock-held $'# TRACK FROM r/x:1\n# TRACK LOCK m pypi:m-d==1.5\nFROM r/x@'"$new"
FAKE_REPORT=$work/report-held.json lockgo
if expect lock-held 0 "fake pip: install m-d==1.5"; then
    holds lock-held "$d/Dockerfile.lock/m/requirements.txt" "m-d==1.5 --hash=sha256:$hd"
fi

# A lock no TRACK LOCK names is held back whole: never read or written.
lockcase lock-whole-held $'# TRACK FROM r/x:1\n# TRACK LOCK m pypi:m-d\nFROM r/x@'"$new"
mkdir -p "$d/Dockerfile.lock/other" "$d/Dockerfile.lock/m"
printf 'unreadable >< \\\n' >"$d/Dockerfile.lock/other/requirements.txt"
printf '%s\n' "$req" >"$d/Dockerfile.lock/m/requirements.txt"
lockgo
if expect lock-whole-held 0 ""; then
    holds lock-whole-held "$d/Dockerfile.lock/other/requirements.txt" "unreadable >< \\"
fi
lockcase lock-none-tracked $'# TRACK FROM r/x:1\nFROM r/x@'"$new"
mkdir -p "$d/Dockerfile.lock/m"
printf 'unreadable\n' >"$d/Dockerfile.lock/m/requirements.txt"
lockgo
if expect lock-none-tracked 0 "" "fake docker: run"; then
    holds lock-none-tracked "$d/Dockerfile.lock/m/requirements.txt" unreadable
fi

# On Fedora, pip and npm come from dnf.
lockcase lock-fedora "$pdf"
FAKE_OS_RELEASE=$work/os/fedora lockgo
if expect lock-fedora 0 "fake dnf: install -y --setopt=install_weak_deps=False python3-pip" \
    "fake apt-get:"; then
    holds lock-fedora "$d/Dockerfile.lock/m/requirements.txt" "$req"
fi
lockcase lock-fedora-npm "$ndf"
FAKE_OS_RELEASE=$work/os/fedora lockgo
expect lock-fedora-npm 0 "fake dnf: install -y --setopt=install_weak_deps=False npm" \
    "fake apt-get:" || true

# Each family is chosen by ID, or else by the first word of ID_LIKE naming one,
# its values quoted or not, and installs pip or npm with its own manager:
# microdnf where dnf is missing, and apk adding bash first where it is missing.
# Each case is OS, the image's directory, pypi or npm, then the lines its
# manager prints, separated by ;, and a line no other manager's may hold.
n=0
for data in "ubuntu|container|pypi|fake apt-get: update;fake apt-get: install -y --no-install-recommends python3-pip" \
    "ubuntu|container|npm|fake apt-get: update;fake apt-get: install -y --no-install-recommends npm" \
    "mint|container|pypi|fake apt-get: install -y --no-install-recommends python3-pip" \
    "rhel|container|pypi|fake dnf: install -y --setopt=install_weak_deps=False python3-pip" \
    "rocky|container|pypi|fake dnf: install -y --setopt=install_weak_deps=False python3-pip" \
    "rocky|container|npm|fake dnf: install -y --setopt=install_weak_deps=False npm" \
    "rhel|container-micro|pypi|fake microdnf: install -y --setopt=install_weak_deps=0 python3-pip" \
    "rocky|container-micro|npm|fake microdnf: install -y --setopt=install_weak_deps=0 npm" \
    "alpine|container|pypi|fake apk: add --no-cache py3-pip" \
    "alpine|container|npm|fake apk: add --no-cache npm" \
    "postmarketos|container|pypi|fake apk: add --no-cache py3-pip" \
    "alpine|nobash|pypi|fake apk: add --no-cache bash;fake apk: add --no-cache py3-pip" \
    "alpine|nobash|npm|fake apk: add --no-cache bash;fake apk: add --no-cache npm"; do
    n=$((n + 1))
    IFS='|' read -r os dir kind said <<<"$data"
    container=$work/$dir
    if [ "$dir" = nobash ]; then
        container=$work/container-family-$n
        nobash "$container"
    fi
    unsaid=$(printf '%s\n' "fake apt-get:" "fake dnf:" "fake microdnf:" "fake apk:" |
        grep -vF -- "${said%%:*}:")
    [ "$dir" = nobash ] || unsaid+=$'\nfake apk: add --no-cache bash'
    if [ "$kind" = pypi ]; then
        lockcase "lock-family-$n" "$pdf"
    else
        lockcase "lock-family-$n" "$ndf"
    fi
    FAKE_CONTAINER=$container FAKE_OS_RELEASE=$work/os/$os lockgo
    if expect "lock-family-$n" 0 "${said//;/$'\n'}" "$unsaid"; then
        if [ "$kind" = pypi ]; then
            holds "lock-family-$n" "$d/Dockerfile.lock/m/requirements.txt" "$req"
        else
            holds "lock-family-$n" "$d/Dockerfile.lock/js/package-lock.json" "$(<"$FAKE_NPM_LOCK")"
        fi
    fi
done

# Any other distribution, none named, or no /etc/os-release is refused where
# the image lacks the tool, as is an image with neither bash nor apk.
for os in arch none missing bare arch-npm; do
    if [ "$os" = arch-npm ]; then
        lockcase "lock-os-$os" "$ndf"
        lock=js
    else
        lockcase "lock-os-$os" "$pdf"
        lock=m
    fi
    case $os in
    bare)
        FAKE_CONTAINER=$work/container-bare FAKE_OS_RELEASE=$work/os/alpine lockgo
        said="lock-resolve: the image has no bash, nor apk to add it"
        ;;
    arch)
        FAKE_OS_RELEASE=$work/os/$os lockgo
        said="names arch, which is not Debian, Ubuntu, Fedora, a RHEL-like or Alpine, nor like one, and the image has no python3 -m pip of its own"
        ;;
    none)
        FAKE_OS_RELEASE=$work/os/$os lockgo
        said="names no ID, which is not"
        ;;
    missing)
        FAKE_OS_RELEASE=$work/os/$os lockgo
        said="lock-resolve: the image has no $work/os/missing to name its distribution, and no python3 -m pip of its own"
        ;;
    arch-npm)
        FAKE_OS_RELEASE=$work/os/arch lockgo
        said="names arch, which is not Debian, Ubuntu, Fedora, a RHEL-like or Alpine, nor like one, and the image has no npm of its own"
        ;;
    esac
    if expect "lock-os-$os" 1 "$said"$'\n'"upgrade: $file: TRACK LOCK $lock: resolving it in r/x@$new failed" \
        $'fake pip:\nfake npm:'; then
        [ ! -e "$d/Dockerfile.lock" ] || fail "lock-os-$os" "a lock was written"
    fi
done

# Any other distribution, none named, or no /etc/os-release resolves with the
# image's own pip or npm where it has one.
for os in arch none missing; do
    lockcase "lock-os-own-pip-$os" "$pdf"
    FAKE_CONTAINER=$work/container-pip FAKE_OS_RELEASE=$work/os/$os lockgo
    if expect "lock-os-own-pip-$os" 0 "fake pip: install m-d"; then
        holds "lock-os-own-pip-$os" "$d/Dockerfile.lock/m/requirements.txt" "$req"
    fi
    lockcase "lock-os-own-npm-$os" "$ndf"
    FAKE_CONTAINER=$work/container-node FAKE_OS_RELEASE=$work/os/$os lockgo
    if expect "lock-os-own-npm-$os" 0 "fake npm: package.json in js"; then
        holds "lock-os-own-npm-$os" "$d/Dockerfile.lock/js/package-lock.json" "$(<"$FAKE_NPM_LOCK")"
    fi
done

# An image with pip or npm of its own, which holds no manager, resolves with it
# and installs nothing.
lockcase lock-own-pip "$pdf"
FAKE_CONTAINER=$work/container-pip lockgo
if expect lock-own-pip 0 "fake pip: install m-d" "fake apt-get:"; then
    holds lock-own-pip "$d/Dockerfile.lock/m/requirements.txt" "$req"
fi
lockcase lock-own-npm "$ndf"
FAKE_CONTAINER=$work/container-node lockgo
if expect lock-own-npm 0 "fake npm: package.json in js" "fake apt-get:"; then
    holds lock-own-npm "$d/Dockerfile.lock/js/package-lock.json" "$(<"$FAKE_NPM_LOCK")"
fi

# An npm on PATH that does not run is not the image's own, so the
# distribution's is installed.
lockcase lock-broken-npm "$ndf"
FAKE_CONTAINER=$work/container-npm-broken lockgo
if expect lock-broken-npm 0 $'fake apt-get: install -y --no-install-recommends npm\nfake npm: package.json in js'; then
    holds lock-broken-npm "$d/Dockerfile.lock/js/package-lock.json" "$(<"$FAKE_NPM_LOCK")"
fi

# A RHEL-like image that must install pip with neither dnf nor microdnf is
# refused, naming its ID.
lockcase lock-no-dnf "$pdf"
FAKE_CONTAINER=$work/container-nodnf FAKE_OS_RELEASE=$work/os/rocky lockgo
if expect lock-no-dnf 1 "names rocky, like Fedora or RHEL, but the image has neither dnf nor microdnf" \
    "fake pip: install"; then
    [ ! -e "$d/Dockerfile.lock" ] || fail lock-no-dnf "a lock was written"
fi

# Runs case $1 on a Dockerfile holding $2, with FAKE_HELD set to $5, and checks
# stderr holds each line of $3 and none of $4, and the lock is the default
# one.
staged() {
    lockcase "$1" "$2"
    FAKE_HELD=${5:-} lockgo
    if expect "$1" 0 "$3" "${4:-}"; then
        holds "$1" "$d/Dockerfile.lock/m/requirements.txt" "$req"
    fi
}

# A lock naming a stage resolves in the image its FROM line names: at the
# digest this run pins where a TRACK FROM covers the line, whatever other
# TRACK FROMs the file holds; through each FROM naming an earlier stage, each
# name in any case; and otherwise as written, pulling a tag first, as a build
# would.
staged lock-stage-tracked $'# TRACK FROM r/x:1\n# TRACK FROM r/y:1\n# TRACK LOCK m stage=b pypi:m-d\nFROM r/x:1 AS a\nFROM r/y:1 AS b\n' \
    "fake docker: run r/y@$new pypi m-d" "fake docker: run r/x"
holds lock-stage-tracked "$file" $'# TRACK FROM r/x:1\n# TRACK FROM r/y:1\n# TRACK LOCK m stage=b pypi:m-d\nFROM r/x@'"$new"$' AS a\nFROM r/y@'"$new"' AS b'
staged lock-stage-via $'# TRACK FROM r/x:1\n# TRACK FROM r/y:1\n# TRACK LOCK m stage=Dev pypi:m-d\nFROM r/y:1 as Base\nFROM r/x:1 AS other\nFROM BASE AS dev\n' \
    "fake docker: run r/y@$new pypi m-d" "fake docker: run r/x"
staged lock-stage-held-tag $'# TRACK FROM r/x:1\n# TRACK LOCK m stage=held pypi:m-d\nFROM r/x:1 AS a\nFROM r/h:2 AS held\n' \
    "$(printf '%s\n' "upgrade: pulling r/h:2" "fake docker: pull r/h:2" "fake docker: run r/h:2 pypi m-d")" \
    "fake docker: run r/x"
holds lock-stage-held-tag "$file" $'# TRACK FROM r/x:1\n# TRACK LOCK m stage=held pypi:m-d\nFROM r/x@'"$new"$' AS a\nFROM r/h:2 AS held'
staged lock-stage-held-digest $'# TRACK LOCK m stage=s pypi:m-d\nFROM r/h@'"$old"$' AS s\n' \
    "fake docker: run r/h@$old pypi m-d" "fake docker: pull" "r/h@$old"
staged lock-stage-later $'# TRACK LOCK m stage=a pypi:m-d\nFROM later AS a\nFROM r/h:4 AS later\n' \
    "fake docker: run later pypi m-d" "fake docker: run r/h"
staged lock-stage-arg $'# TRACK LOCK m stage=s pypi:m-d\nARG BASE=r/h:3\nFROM --platform=$BUILDPLATFORM ${BASE} AS s\n' \
    "fake docker: run r/h:3 pypi m-d"
# A stage named through a tracked ARG is found by the ARG's new value.
staged lock-stage-arg-tracked-name $'# TRACK ARG V github:o/p\n# TRACK LOCK m stage=s pypi:m-d\nARG V=1.0.0\nFROM r/a:1 AS base1.0.0\nFROM r/b:1 AS base1.2.3\nFROM base${V} AS s\n' \
    "fake docker: run r/b:1 pypi m-d" "fake docker: run r/a"
# A value in one pair of matching quotes is taken without them, as Docker takes
# it.
staged lock-stage-arg-dquoted $'# TRACK LOCK m stage=s pypi:m-d\nARG BASE="r/h:3"\nFROM $BASE AS s\n' \
    "fake docker: run r/h:3 pypi m-d"
staged lock-stage-arg-squoted $'# TRACK LOCK m stage=s pypi:m-d\nARG BASE=\'r/h:3\'\nFROM $BASE AS s\n' \
    "fake docker: run r/h:3 pypi m-d"
staged lock-stage-arg-stage $'# TRACK LOCK m stage=s pypi:m-d\nARG A=x B=base\nFROM r/h:5 AS base\nFROM $B AS s\n' \
    "fake docker: run r/h:5 pypi m-d"
# A variable a TRACK ARG pins takes its new value.
staged lock-stage-arg-tracked $'# TRACK ARG V github:o/p\n# TRACK LOCK m stage=s pypi:m-d\nARG V=1.0\nFROM r/h:$V AS s\n' \
    "fake docker: run r/h:1.2.3 pypi m-d" "fake docker: run r/h:1.0"
holds lock-stage-arg-tracked "$file" $'# TRACK ARG V github:o/p\n# TRACK LOCK m stage=s pypi:m-d\nARG V=1.2.3\nFROM r/h:$V AS s'
lockcase lock-stage-npm $'# TRACK LOCK js stage=s npm:n-d\nFROM r/h:6 AS s\n'
lockgo
if expect lock-stage-npm 0 "fake docker: run r/h:6 npm js"; then
    holds lock-stage-npm "$d/Dockerfile.lock/js/package-lock.json" "$(<"$FAKE_NPM_LOCK")"
fi

# A pip older than 22.2 is upgraded first, its output kept off the report; a
# version pip does not give as one is refused.
n=0
for data in "21.3.1|0|fake pip: upgrade pip>=22.2|" "22.1|0|fake pip: upgrade pip>=22.2|" \
    "22.2|0||fake pip: upgrade" "24.0|0||fake pip: upgrade" \
    "x.1|1|lock-resolve: pip --version gave pip x.1 from|fake pip: install"; do
    n=$((n + 1))
    IFS='|' read -r version status said unsaid <<<"$data"
    lockcase "lock-pip-$n" "$pdf"
    FAKE_PIP_VERSION=$version lockgo
    if expect "lock-pip-$n" "$status" "$said" "$unsaid" && [ "$status" = 0 ]; then
        holds "lock-pip-$n" "$d/Dockerfile.lock/m/requirements.txt" "$req"
    fi
done

# npm's latest version is looked up for each package not held back, and the
# lock npm writes for a package.json of them is kept as it is, beside the
# package.json, key-sorted; a Dockerfile's lock directory takes its name.
npm_lock "$work/npm-two.json" "n-d @s/n.d" node_modules/n-d@3.4.5 node_modules/@s/n.d@1.0.0 \
    node_modules/dep-b@1.0.0 node_modules/n-d/node_modules/dep-b@0.5.0
lockcase lock-npm $'# TRACK FROM r/x:1\n# TRACK LOCK js npm:n-d npm:@s/n.d@1.0.0\nFROM r/x@'"$new" \
    test.Dockerfile
commit_all "$d"
rm -f -- "$work/lockrec"
FAKE_NPM_LOCK=$work/npm-two.json lockgo --record "$work/lockrec"
said=$(printf '%s\n' "fake curl: https://registry.npmjs.org/n-d/latest" \
    "fake apt-get: install -y --no-install-recommends npm" \
    'fake npm: package.json in js: {"dependencies":{"@s/n.d":"1.0.0","n-d":"3.4.5"},"private":true}')
if expect lock-npm 0 "$said" "registry.npmjs.org/@s/n.d"; then
    holds lock-npm "$d/test.Dockerfile.lock/js/package.json" \
        "$(printf '%s\n' '{' '  "dependencies": {' '    "@s/n.d": "1.0.0",' '    "n-d": "3.4.5"' '  },' \
            '  "private": true' '}')"
    holds lock-npm "$d/test.Dockerfile.lock/js/package-lock.json" "$(<"$work/npm-two.json")"
    moves=("LOCK js n-d none -> 3.4.5" "LOCK js @s/n.d none -> 1.0.0" "LOCK js: 2 dependencies moved")
    recorded lock-npm lock-npm/test.Dockerfile.lock/js/package.json \
        lock-npm/test.Dockerfile.lock/js/package-lock.json
fi

# A package an npm lock's root depended on and no longer does is recorded as
# dropped; one whose version moved, as moved.
lockcase lock-npm-dropped "$ndf"
mkdir -p "$d/Dockerfile.lock/js"
npm_lock "$d/Dockerfile.lock/js/package-lock.json" "n-d gone" node_modules/n-d@3.0.0 \
    node_modules/gone@2.0.0 node_modules/dep-b@0.9.0 node_modules/dep-c@1.0.0
printf '{}\n' >"$d/Dockerfile.lock/js/package.json"
commit_all "$d"
rm -f -- "$work/lockrec"
lockgo --record "$work/lockrec"
if expect lock-npm-dropped 0 ""; then
    holds lock-npm-dropped "$d/Dockerfile.lock/js/package-lock.json" "$(<"$FAKE_NPM_LOCK")"
    moves=("LOCK js n-d 3.0.0 -> 3.4.5" "LOCK js gone 2.0.0 -> none" "LOCK js: 2 dependencies moved")
    recorded lock-npm-dropped lock-npm-dropped/Dockerfile.lock/js/package.json \
        lock-npm-dropped/Dockerfile.lock/js/package-lock.json
fi

# An old npm lock is read only as npm writes it, each package under packages
# with a version, and each its root depends on; one that reads otherwise is
# recorded as changed.
n=0
for data in '{"packages": {"": {}}}|LOCK js n-d none -> 3.4.5;LOCK js: 1 dependency moved' \
    '{"lockfileVersion": 1, "dependencies": {"n-d": {"version": "3.0.0"}}}|LOCK js: files changed' \
    '{"packages": {"node_modules/n-d": {"link": true}}}|LOCK js: files changed' \
    '[1]|LOCK js: files changed' 'lockfileVersion: 3|LOCK js: files changed'; do
    n=$((n + 1))
    lockcase "lock-npm-foreign-$n" "$ndf"
    mkdir -p "$d/Dockerfile.lock/js"
    printf '%s\n' "${data%%|*}" >"$d/Dockerfile.lock/js/package-lock.json"
    commit_all "$d"
    rm -f -- "$work/lockrec"
    lockgo --record "$work/lockrec"
    if expect "lock-npm-foreign-$n" 0 ""; then
        holds "lock-npm-foreign-$n" "$d/Dockerfile.lock/js/package-lock.json" "$(<"$FAKE_NPM_LOCK")"
        IFS=';' read -r -a moves <<<"${data#*|}"
        recorded "lock-npm-foreign-$n" "lock-npm-foreign-$n/Dockerfile.lock/js/package.json" \
            "lock-npm-foreign-$n/Dockerfile.lock/js/package-lock.json"
    fi
done

# The other registry's lock in a lock's directory is the project's own, and
# left alone.
for kind in npm pypi; do
    if [ "$kind" = npm ]; then
        lockcase lock-other-kind-npm "$ndf"
        other=js/requirements.txt
    else
        lockcase lock-other-kind-pypi "$pdf"
        other=m/package.json
    fi
    mkdir -p "$d/Dockerfile.lock/${other%/*}"
    printf 'x\n' >"$d/Dockerfile.lock/$other"
    lockgo
    if expect "lock-other-kind-$kind" 0 ""; then
        holds "lock-other-kind-$kind" "$d/Dockerfile.lock/$other" x
    fi
done
# What npm gives that is not the lock asked for fails the run, writing nothing.
printf 'not JSON\n' >"$work/npm-bad.json"
npm_lock "$work/npm-old.json" n-d node_modules/n-d@3.0.0
npm_lock "$work/npm-missing.json" n-d node_modules/dep-b@1.0.0
n=0
for data in "npm-bad|TRACK LOCK js: lock-resolve gave no package-lock.json listing packages, each with a version" \
    "npm-old|TRACK LOCK js: npm locked n-d at 3.0.0, not 3.4.5" \
    "npm-missing|TRACK LOCK js: npm locked n-d at nothing, not 3.4.5"; do
    n=$((n + 1))
    lockcase "lock-npm-gives-$n" "$ndf"
    FAKE_NPM_LOCK=$work/${data%%|*}.json lockgo
    if expect "lock-npm-gives-$n" 1 "${data#*|}"; then
        [ ! -e "$d/Dockerfile.lock" ] || fail "lock-npm-gives-$n" "a lock was written"
    fi
done
n=0
for data in '{}|latest version on npm, none, is not a version' \
    '{"version": "x.1"}|latest version on npm, x.1, is not a version' \
    '<html>|TRACK LOCK js: registry.npmjs.org/n-d/latest is not npm'"'"'s JSON'; do
    n=$((n + 1))
    lockcase "lock-npm-latest-$n" "$ndf"
    FAKE_NPM=${data%%|*} lockgo
    expect "lock-npm-latest-$n" 1 "${data#*|}" "fake docker: run" || true
done

# A requirement whose marker turns on the machine or kernel is refused, unless
# it is gated on an extra, only by extra == "EXTRA" and nothing else but by
# and, that nothing resolved asks for; one turning on the operating system
# alone is not, every image being Linux.
marked() {
    jq -n --arg r "$1" --arg also "${2:-}" '{install: [
        {metadata: {name: "m-d", version: "2.0.1",
            requires_dist: ["dep-a>=1", $r]}, requested: true},
        {metadata: {name: "Dep_A", version: "1.1",
            requires_dist: (if $also == "" then null else [$also] end)}}]}' \
        >"$work/report-marked.json"
}
n=0
for data in 'x ;platform_machine=="x86_64"|' \
    'x; platform_release >= "6" and python_version < "3"|' \
    'x; platform_version == "#1 SMP"|' \
    'x; extra == "a" or platform_machine == "aarch64"|' \
    'x; extra == '"'"'arm'"'"' and platform_machine == "aarch64"|M.D[Arm] >= 1' \
    'x; platform_machine == "aarch64" and extra == "b"|m-d [a, b]' \
    'x; platform_machine == "aarch64" and extra != "test"|' \
    'x; "arm" == extra and platform_machine == "aarch64"|'; do
    n=$((n + 1))
    marked "${data%|*}" "${data#*|}"
    lockcase "lock-marker-$n" "$pdf"
    FAKE_REPORT=$work/report-marked.json lockgo
    if expect "lock-marker-$n" 1 "upgrade: m-d: ${data%|*}"$'\n'"TRACK LOCK m: each requirement above turns on the platform, so its lock would not hold on another architecture" \
        "fake curl: https://pypi.org/"; then
        [ ! -e "$d/Dockerfile.lock" ] || fail "lock-marker-$n" "a lock was written"
    fi
done
n=0
for data in 'x; extra == "arm" and platform_machine == "aarch64"|' \
    'x; extra == "arm" and platform_machine == "aarch64"|m-d[other]' \
    'pywin32; sys_platform == "win32"|' 'colorama; platform_system == "Windows"|' \
    'x; os_name == "nt" or sys_platform == "darwin"|' \
    'x; platform_python_implementation == "CPython"|' \
    'x; my_platform_machine_x == "a"|' 'x; python_version < "3.11"|'; do
    n=$((n + 1))
    marked "${data%|*}" "${data#*|}"
    lockcase "lock-marker-passed-$n" "$pdf"
    FAKE_REPORT=$work/report-marked.json lockgo
    if expect "lock-marker-passed-$n" 0 ""; then
        holds "lock-marker-passed-$n" "$d/Dockerfile.lock/m/requirements.txt" "$req"
    fi
done

# Each failure to resolve fails the run, writing nothing.
printf 'not JSON' >"$work/report-bad.json"
printf '{"install": []}' >"$work/report-empty.json"
report "$work/report-lacks.json" Dep_A==1.1
report "$work/report-twice.json" m-d==2.0.1 M.D==2.0.1
report "$work/report-nightly.json" m-d==nightly
report "$work/report-absent.json" m-d==9.9
mkdir -p "$FAKE_FILES/pypi/m-d"
printf '<html>' >"$FAKE_FILES/pypi/m-d/3.0.json"
report "$work/report-html.json" m-d==3.0
jq -n '{urls: [{packagetype: "sdist", digests: {sha256: "'"$hs"'"}}]}' >"$FAKE_FILES/pypi/m-d/4.0.json"
report "$work/report-sdist.json" m-d==4.0
wheels m-d/5.0 XYZ
report "$work/report-badhash.json" m-d==5.0
n=0
for data in "run|1|TRACK LOCK m: resolving it in r/x@$new failed" \
    "pip|1|No matching distribution found for m-d" \
    "bad|1|TRACK LOCK m: lock-resolve gave no pip report" \
    "empty|1|TRACK LOCK m: lock-resolve gave no pip report" \
    "lacks|1|TRACK LOCK m: pip's report installs no m-d" \
    "twice|1|TRACK LOCK m: pip's report installs m-d twice" \
    "nightly|1|TRACK LOCK m: pip's report installs m-d nightly" \
    "absent|22|returned error: 404" \
    "html|1|TRACK LOCK m: pypi.org/pypi/m-d/3.0/json is not PyPI's JSON" \
    "sdist|1|TRACK LOCK m: PyPI lists no wheel for m-d 4.0" \
    "badhash|1|TRACK LOCK m: PyPI gives m-d 5.0 the SHA-256 XYZ" \
    "curl|6|Could not resolve host: pypi.org"; do
    n=$((n + 1))
    IFS='|' read -r how status said <<<"$data"
    lockcase "lock-fails-$how" "$pdf"
    case $how in
    run) FAKE_RUN=fail lockgo ;;
    pip) FAKE_PIP=fail lockgo ;;
    curl) FAKE_CURL=fail lockgo ;;
    *) FAKE_REPORT=$work/report-$how.json lockgo ;;
    esac
    if expect "lock-fails-$how" "$status" "$said"; then
        [ ! -e "$d/Dockerfile.lock" ] || fail "lock-fails-$how" "a lock was written"
    fi
done

# A write that fails once the Dockerfile's and a first lock's temporary files
# are made leaves nothing behind: no temporary file and no directory made.
lockcase lock-write-fails $'# TRACK FROM r/x:1\n# TRACK LOCK a pypi:m-d\n# TRACK LOCK b pypi:m-d\nFROM r/x:1\n'
FAKE_MKTEMP_FAIL=$real/lock-write-fails/Dockerfile.lock/b/requirements.txt.XXXXXX lockgo
if expect lock-write-fails 1 "No space left on device"; then
    holds lock-write-fails "$file" $'# TRACK FROM r/x:1\n# TRACK LOCK a pypi:m-d\n# TRACK LOCK b pypi:m-d\nFROM r/x:1'
    if [ -e "$d/Dockerfile.lock" ] || compgen -G "$d/Dockerfile.*" >/dev/null; then
        fail lock-write-fails "left $(find "$d" -mindepth 1 | sort)"
    fi
fi
lockcase lock-write-fails-kept "$pdf"
mkdir -p "$d/Dockerfile.lock/kept"
FAKE_MKTEMP_FAIL=$real/lock-write-fails-kept/Dockerfile.lock/m/requirements.txt.XXXXXX lockgo
if expect lock-write-fails-kept 1 "No space left on device"; then
    if ! [ -d "$d/Dockerfile.lock/kept" ] || [ -e "$d/Dockerfile.lock/m" ]; then
        fail lock-write-fails-kept "left $(find "$d" -mindepth 1 | sort)"
    fi
fi

# Through a symbolic link, the locks sit beside the link, in the repository
# holding it, and the Dockerfile it names is written.
lockcase lock-link $'# TRACK FROM r/x:1\n# TRACK LOCK m pypi:m-d\nFROM r/x:1\n'
mkdir "$d/lib"
mv -- "$file" "$d/lib/Dockerfile"
ln -s lib/Dockerfile "$file"
commit_all "$d"
rm -f -- "$work/lockrec"
lockgo --record "$work/lockrec"
if expect lock-link 0 ""; then
    holds lock-link "$d/Dockerfile.lock/m/requirements.txt" "$req"
    if ! [ -L "$d/Dockerfile" ] || [ -e "$d/lib/Dockerfile.lock" ]; then
        fail lock-link "the link or the lock's place is wrong"
    fi
    moves=("r/x:1 r/x:1 -> sha256:aaaaaaaaaaaa" "LOCK m m-d none -> 2.0.1" "LOCK m: 1 dependency moved")
    recorded lock-link lock-link/lib/Dockerfile lock-link/Dockerfile.lock/m/requirements.txt
fi

# A link into another repository, such as a submodule, is refused with
# --record, before anything is looked up, since the commit could not add the
# file it names; without --record, that file is written.
dockerfile=$'# TRACK FROM r/x:1\nFROM r/x:1\n'
lockcase lock-link-other "$dockerfile"
mkdir "$d/lib"
mv -- "$file" "$d/lib/Dockerfile"
ln -s lib/Dockerfile "$file"
commit_all "$d/lib"
"$REAL_GIT" -C "$d" init -q
rm -f -- "$work/lockrec"
lockgo --record "$work/lockrec"
if expect lock-link-other 1 "upgrade: $file: links to $real/lock-link-other/lib/Dockerfile, in the repository $real/lock-link-other/lib, not $real/lock-link-other, so docker/upgrade-commit could not commit it; re-pin it in its own repository, or without --record" \
    "fake docker:"; then
    holds lock-link-other "$d/lib/Dockerfile" "${dockerfile%$'\n'}"
    [ ! -e "$work/lockrec" ] || fail lock-link-other "a record was written"
fi
lockgo
if expect lock-link-other-unrecorded 0 ""; then
    holds lock-link-other-unrecorded "$d/lib/Dockerfile" $'# TRACK FROM r/x:1\nFROM r/x@'"$new"
fi

# A lock's directory, its NAME directory or a lock file that is a symbolic link
# is refused before anything is looked up, and what it names is left alone.
lockcase lock-file-link "$pdf"
mkdir -p "$d/Dockerfile.lock/m" "$d/shared"
printf 'm-d==1.0 --hash=sha256:%s\n' "$hd" >"$d/shared/req.txt"
ln -s ../../shared/req.txt "$d/Dockerfile.lock/m/requirements.txt"
lockgo
if expect lock-file-link 1 "upgrade: $d/Dockerfile.lock/m/requirements.txt: is a symbolic link, which a lock is never written through" \
    "fake "; then
    holds lock-file-link "$d/shared/req.txt" "m-d==1.0 --hash=sha256:$hd"
fi
rm -- "$d/Dockerfile.lock/m/requirements.txt"
rmdir -- "$d/Dockerfile.lock/m"
ln -s ../shared "$d/Dockerfile.lock/m"
lockgo
expect lock-name-link 1 "upgrade: $d/Dockerfile.lock/m: is a symbolic link" "fake " || true
rm -- "$d/Dockerfile.lock/m"
rmdir -- "$d/Dockerfile.lock"
ln -s shared "$d/Dockerfile.lock"
lockgo
expect lock-dir-link 1 "upgrade: $d/Dockerfile.lock: is a symbolic link" "fake " || true

# Nor is a lock written in a repository nested in the Dockerfile's, such as a
# submodule, at its NAME directory or at the lock's directory.
lockcase lock-name-nested "$pdf"
commit_all "$d"
mkdir -p "$d/Dockerfile.lock/m"
"$REAL_GIT" -C "$d/Dockerfile.lock/m" init -q
lockgo
if expect lock-name-nested 1 "upgrade: $d/Dockerfile.lock/m: is in the repository $d/Dockerfile.lock/m, not $d, which a lock is never written in" \
    "fake "; then
    [ ! -e "$d/Dockerfile.lock/m/requirements.txt" ] ||
        fail lock-name-nested "the lock was written"
fi
rm -rf -- "$d/Dockerfile.lock/m/.git"
"$REAL_GIT" -C "$d/Dockerfile.lock" init -q
lockgo
expect lock-dir-nested 1 "upgrade: $d/Dockerfile.lock: is in the repository $d/Dockerfile.lock, not $d" "fake " || true

# lock-resolve refuses what docker/upgrade would never give it.
for given in "" pypi "npm a" "npm a b c" "npm .a b" "gem a"; do
    read -r -a words <<<"$given"
    rc=0
    "$FAKE_RESOLVER" "${words[@]}" >"$work/out" 2>"$work/err" || rc=$?
    if [ "$rc" != 2 ] || [ -s "$work/out" ] ||
        [ "$(<"$work/err")" != $'Usage: lock-resolve pypi PACKAGE[==VERSION]...\n       lock-resolve npm NAME PACKAGE_JSON' ]; then
        fail resolve-usage "'$given': exit $rc: $(<"$work/err")"
    fi
done

if [ "$failures" -gt 0 ]; then
    exit 1
fi
