#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/init"

# Resolved here rather than inline, for the reason docker/build-compose states.
describe=$(git describe 2>/dev/null || true)

docker build \
    --target prd \
    --cache-from "$REPO:$TAG.dev" \
    --cache-from "$REPO:$TAG.prd" \
    --cache-from "$REPO:latest.dev" \
    --cache-from "$REPO:latest.prd" \
    --build-arg BUILDKIT_INLINE_CACHE=1 \
    --build-arg GIT_DESCRIBE="$describe" \
    -t "$REPO:$TAG.prd" .

docker push "$REPO:$TAG.prd"
