#!/usr/bin/env bash
#
# Writing counterpart to bin/lint: every pass here rewrites, and bin/lint checks
# the same files from bin/files for drift afterwards. Runs from the root of the
# repository.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

bin=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

source "$bin/files"

echo "bin/format: formatting ${#shell_files[@]} shell file(s)" >&2
# No ShellCheck pass: ShellCheck has no fix mode, only suggestions -f diff
# prints, many of which change meaning, so they are left to review.
shfmt "${shfmt_args[@]}" -w "${shell_files[@]}"

echo "bin/format: formatting ${#yaml_files[@]} YAML file(s)" >&2
# -P, since yq otherwise keeps each value's flow or block style and quoting, so
# the same data could pass in several layouts.
for f in "${yaml_files[@]}"; do
    yq -i -P 'sort_keys(..)' "$f"
done

echo "bin/format: formatting ${#docker_files[@]} Dockerfile(s)" >&2
dockerfmt "${dockerfmt_args[@]}" --write "${docker_files[@]}"

echo "bin/format: formatting ${#markdown_files[@]} Markdown file(s)" >&2
mdformat "${mdformat_args[@]}" "${markdown_files[@]}"

echo "bin/format: formatting ${#dotenv_files[@]} dotenv file(s)" >&2
# --no-backup, since a backup beside each file would be left in the tree, where
# .gitignore's /.env* would hide it.
dotenv-linter fix --no-backup "${dotenv_files[@]}"
