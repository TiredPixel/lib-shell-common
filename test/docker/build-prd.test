#!/usr/bin/env bash
#
# Tests docker/build-prd-latest and docker/build-prd-stable in a scratch project
# with docker and git faked on PATH, so nothing is built, pushed or read from a
# repository. The fake docker logs each call's arguments, a line to a call, and
# exits with FAKE_BUILD's status from a build and FAKE_PUSH's from a push. The
# fake git puts HEAD on branch a/b and describes it as FAKE_DESCRIBE, failing as
# an untagged repository does where that is empty, or as a broken one does
# where it is "broken".
#
# Run: test/docker/build-prd.test. Exits 1 naming each case that failed.
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../../docker")
fixtures=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../fixtures/docker/build-prd")
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

mkdir "$work/bin" "$work/project"
cp -p -- "$fixtures/docker" "$fixtures/git" "$work/bin/"
echo r/x >"$work/project/.dockerrepo"

export FAKE_LOG=$work/log
export FAKE_DESCRIBE=v1.2-3-gabcdef0
export PATH=$work/bin:$PATH
cd "$work/project"

failures=0
# Reports a failure of case $1 at once, each line of $2 under the program and
# the case, so a later abort cannot hide it.
fail() {
    local line
    while IFS= read -r line <&3; do
        echo "${0##*/}: $1: $line" >&2
    done 3<<<"$2"
    failures=$((failures + 1))
}

# Runs docker/$2 and checks its status is $3, docker was called as $4 has it, a
# line to a call, and its stdout is $5 and its stderr $6.
check() {
    local name=$1 script=$2 status=$3 calls=$4 out=$5 err=$6 rc=0
    : >"$FAKE_LOG"
    "$dir/$script" >"$work/out" 2>"$work/err" || rc=$?
    if [ "$rc" != "$status" ]; then
        fail "$name" "exit $rc, not $status: $(<"$work/err")"
    elif [ "$(<"$FAKE_LOG")" != "$calls" ]; then
        fail "$name" "docker was called as: $(<"$FAKE_LOG")"
    elif [ "$(<"$work/out")" != "$out" ]; then
        fail "$name" "stdout is: $(<"$work/out")"
    elif [ "$(<"$work/err")" != "$err" ]; then
        fail "$name" "stderr is: $(<"$work/err")"
    fi
}

# The build docker is called for, from the cache tags $1 and stamped $2.
build() {
    echo "build --target prd $1 --build-arg BUILDKIT_INLINE_CACHE=1" \
        "--build-arg GIT_DESCRIBE=$2 -t r/x:a-b.prd ."
}

push="push r/x:a-b.prd"
pushed="fake docker: pushed r/x:a-b.prd"
broken="fatal: bad object HEAD"$'\n'

for model in latest stable; do
    caches="--cache-from r/x:a-b.dev --cache-from r/x:a-b.prd"
    caches+=" --cache-from r/x:latest.dev --cache-from r/x:latest.prd"
    if [ "$model" = stable ]; then
        caches+=" --cache-from r/x:testing.dev --cache-from r/x:testing.prd"
        caches+=" --cache-from r/x:stable.dev --cache-from r/x:stable.prd"
    fi
    built=$(build "$caches" "$FAKE_DESCRIBE")
    unstamped=$(build "$caches" "")

    check "$model" "build-prd-$model" 0 "$built"$'\n'"$push" \
        "fake docker: built"$'\n'"$pushed" "fake docker: building"

    # Stamped with nothing, and git's fatal: kept off the console.
    FAKE_DESCRIBE='' check "$model-untagged" "build-prd-$model" 0 \
        "$unstamped"$'\n'"$push" "fake docker: built"$'\n'"$pushed" \
        "fake docker: building"

    # Any other failure of git's stops the build before docker is called.
    FAKE_DESCRIBE=broken check "$model-describe-fails" "build-prd-$model" 1 \
        "" "" "${broken}build-prd-$model: git describe failed"

    FAKE_BUILD=3 check "$model-build-fails" "build-prd-$model" 3 "$built" \
        "fake docker: built" "fake docker: building"

    FAKE_PUSH=4 check "$model-push-fails" "build-prd-$model" 4 \
        "$built"$'\n'"$push" "fake docker: built"$'\n'"$pushed" \
        "fake docker: building"
done

if [ "$failures" -gt 0 ]; then
    exit 1
fi
